#!/bin/sh
# Disposable VM preview only; Flea is not installed as a system package or default.
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
D=$(CDPATH= cd -- "$HERE/../out/ipad-simulator/vm" && pwd)
ARCHIVE="$D/flea-preview-v0.3.12-aarch64.tar.gz"
EXPECTED=4d8327c16ff4dca485c7cb21dc85fd35fb4247db7f29ce5ab6897334cd603ceb
if "$HERE/vm" status >/dev/null; then
    echo 'Stop the simulator VM before installing the Flea preview.' >&2
    exit 1
fi
if [ ! -f "$ARCHIVE" ]; then
    tmp="$ARCHIVE.download"
    trap 'rm -f "$tmp"' EXIT INT TERM
    curl -fL --retry 2 https://github.com/thisisgm/flea/releases/download/v0.3.12/flea-v0.3.12-linux-aarch64.tar.gz -o "$tmp"
    mv "$tmp" "$ARCHIVE"
    trap - EXIT INT TERM
fi
ACTUAL=$(shasum -a 256 "$ARCHIVE" | awk '{print $1}')
[ "$ACTUAL" = "$EXPECTED" ] || { echo 'Flea release digest mismatch.' >&2; exit 1; }
# Recreate a clean release tree before applying our small, version-pinned patch.
rm -rf "$D/flea-release"
mkdir -p "$D/flea-release"
tar -xzf "$ARCHIVE" --strip-components=1 -C "$D/flea-release"
(cd "$D/flea-release" && patch --batch --fuzz=0 -p1 < "$HERE/../../omarchy-a/desktop/files/flea-0.3.12-touch.patch")
podman machine ssh "sudo '$HERE/vm-support/install-flea-preview-linux.sh'"
