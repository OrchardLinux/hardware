#!/bin/sh
# Fetch the signed Arch Linux ARM package and install the VM-only greeter.
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
D=$(CDPATH= cd -- "$HERE/../out/simulator/vm" && pwd)
if "$HERE/vm" status >/dev/null; then
    echo 'Stop the simulator VM before installing or updating its greeter.' >&2
    exit 1
fi
URL=http://mirror.archlinuxarm.org/aarch64/extra/greetd-0.10.3-2-aarch64.pkg.tar.xz
# HTTP is used because the mirror redirect has no matching TLS certificate;
# the installer verifies the detached signature against the VM's trusted keyring.
for suffix in '' .sig; do
    if [ ! -f "$D/greetd.pkg.tar.xz$suffix" ]; then
        tmp="$D/greetd.download$suffix"
        trap 'rm -f "$tmp"' EXIT INT TERM
        curl -fL --retry 2 "$URL$suffix" -o "$tmp"
        mv "$tmp" "$D/greetd.pkg.tar.xz$suffix"
        trap - EXIT INT TERM
    fi
done
podman machine ssh "sudo '$HERE/vm-support/install-greeter-linux.sh'"
