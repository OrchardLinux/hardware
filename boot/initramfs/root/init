#!/bin/busybox sh
# orchard's initrd for installed systems: load storage, mount the root that
# root=PARTUUID= names, start its init. The same for every distribution and
# init system; only BusyBox and the platform's storage modules are inside.
export PATH=/bin
/bin/busybox --install -s /bin
mount -t proc -o nodev,noexec,nosuid proc /proc
mount -t sysfs -o nodev,noexec,nosuid sysfs /sys
mount -t devtmpfs -o mode=0755,nosuid dev /dev
exec </dev/console >/dev/console 2>&1

stop() {
    echo "orchard initrd: $1"
    echo 'Starting a shell on the console; the system did not start.'
    exec sh
}

root= mode=rw flags= fstype= init=/sbin/init
for argument in $(cat /proc/cmdline); do
    case "$argument" in
    root=PARTUUID=*) root=$(echo "${argument#root=PARTUUID=}" | tr A-F a-f) ;;
    rootfstype=*) fstype=${argument#rootfstype=} ;;
    rootflags=*) flags=${argument#rootflags=} ;;
    ro | rw) mode=$argument ;;
    init=*) init=${argument#init=} ;;
    esac
done
[ -n "$root" ] || stop 'the boot entry names no root=PARTUUID='

for module in $(cat /etc/orchard/modules); do
    modprobe "$module" || stop "could not load $module"
done

# gpt_partuuid DISK SECTOR_SIZE NUMBER: the unique GUID of GPT entry NUMBER,
# read from the disk itself: the kernel's uevent does not report PARTUUID.
gpt_partuuid() {
    set -- $(od -An -tx1 -v -j "$2" -N 92 "$1") "$1" "$2" "$3"
    [ "$1$2$3$4$5$6$7$8" = 4546492050415254 ] || return 1
    lba=$((0x${80}${79}${78}${77}${76}${75}${74}${73}))
    size=$((0x${88}${87}${86}${85}))
    disk=${93} sector=${94} number=${95}
    set -- $(od -An -tx1 -v -j $((lba * sector + (number - 1) * size + 16)) -N 16 "$disk")
    [ "$*" != '00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00' ] || return 1
    echo "$4$3$2$1-$6$5-$8$7-$9${10}-${11}${12}${13}${14}${15}${16}"
}

device=
seconds=0
while [ -z "$device" ]; do
    for number in /sys/class/block/*/partition; do
        [ -e "$number" ] || continue
        part=${number%/partition}
        disk=$(basename "$(dirname "$(readlink -f "$part")")")
        sector=$(cat "/sys/class/block/$disk/queue/logical_block_size")
        if [ "$(gpt_partuuid "/dev/$disk" "$sector" "$(cat "$number")")" = "$root" ]; then
            device=/dev/${part##*/}
            break
        fi
    done
    [ -n "$device" ] && break
    seconds=$((seconds + 1))
    [ "$seconds" -le 30 ] || stop "no partition $root after 30 s"
    sleep 1
done

mkdir -p /newroot
mount ${fstype:+-t "$fstype"} -o "$mode${flags:+,$flags}" "$device" /newroot || stop "could not mount $device"
[ -x "/newroot$init" ] || [ -L "/newroot$init" ] || stop "the root has no $init"
for name in dev proc sys; do
    mount --move "/$name" "/newroot/$name"
done
exec switch_root /newroot "$init"
