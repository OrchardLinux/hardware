#!/bin/sh
# SSH starts only after the host has provisioned its key over USB serial.
set -eu
dir=${RECOVERY_SSH_DIR:-/root/.ssh}
[ -s "$dir/authorized_keys" ] && [ ! -L "$dir/authorized_keys" ] || {
    echo 'Provision a public key over USB serial first' >&2; exit 1;
}
umask 077
mkdir -p /run/recovery
hostkey=/run/recovery/ssh_host_ed25519_key
if [ ! -e "$hostkey" ]; then
    /usr/bin/dropbearkey -t ed25519 -f "$hostkey" >/dev/null
fi
/usr/bin/dropbearkey -y -f "$hostkey" | awk '$1 == "ssh-ed25519" {print $1, $2}' \
    > /run/recovery/ssh_host_ed25519_key.pub
echo 'SSH host public key (pin this from the USB serial connection):'
cat /run/recovery/ssh_host_ed25519_key.pub
# -W: Dropbear's default 24 KiB receive window halves USB transfers (5.7 vs
# 12.4 MB/s for an install stream on J71b); 4 MiB keeps the link full.
exec /usr/sbin/dropbear -F -E -s -g -j -k -W 4194304 -P /run/recovery/dropbear.pid -r "$hostkey" -p 172.16.42.1:22
