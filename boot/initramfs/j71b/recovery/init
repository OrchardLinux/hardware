#!/bin/busybox sh
# RAM-only J71b recovery. No internal storage is mounted or written.
set -eu
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
cd /
/bin/busybox --install -s
mount -t proc -o nodev,noexec,nosuid proc /proc
mount -t sysfs -o nodev,noexec,nosuid sysfs /sys
mount -t devtmpfs -o mode=0755,nosuid dev /dev
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
mkdir -p /dev/pts /run/recovery /run/orchard
mount -t devpts -o mode=0620,ptmxmode=0666 devpts /dev/pts
exec </dev/console >/dev/console 2>&1

[ "$(tr '\000' '\n' < /proc/device-tree/compatible | head -1)" = apple,j71b ] || {
    echo 'Wrong device for J71b recovery image'
    exec sh
}
/sbin/recovery-usb
ip address add 172.16.42.1/30 dev usb0
ip link set usb0 up
udhcpd -f /etc/udhcpd.conf &
echo 'J71b recovery: USB serial ready; provision an SSH key before SSH starts.'
(
    while getty -n -l /bin/sh ttyGS0 115200 vt100; do sleep 1; done
) &
# Only PID 1 may retire the RAM userspace. A separate writer must first install
# and verify a new sibling root, then arm this one-shot request in /run.
while [ ! -e /run/orchard/handoff.json ]; do sleep 1; done
exec /usr/bin/python3 /usr/libexec/orchard-j71b/handoff.py
