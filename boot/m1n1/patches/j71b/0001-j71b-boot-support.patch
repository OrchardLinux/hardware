+/* J71b diagnostic: publish firmware-owned HMB; no PCIe/NVMe HW changes. */
+static int dt_set_nvme_hmb(void)
+{
+    u64 region[2];
+    fdt64_t reg[2];
+    int node = fdt_path_offset(dt, "nvme-hmb");
+    if (node < 0)
+        return 0;
+    int adt_node = adt_path_offset(adt, "/arm-io/nvme-mmu0");
+    if (adt_node < 0)
+        bail("ADT: /arm-io/nvme-mmu0 not found\n");
+    if (ADT_GETPROP_ARRAY(adt, adt_node, "sart-region", region) < 0 ||
+        !region[0] || !region[1] ||
+        (region[0] & 0xfffff) || (region[1] & 0xfffff) ||
+        region[0] + region[1] < region[0])
+        bail("ADT: invalid firmware HMB region\n");
+    fdt64_st(&reg[0], region[0]);
+    fdt64_st(&reg[1], region[1]);
+    if (fdt_setprop(dt, node, "reg", reg, sizeof(reg)))
+        bail("FDT: failed to publish firmware HMB\n");
+    printf("FDT: firmware HMB 0x%lx size 0x%lx\n", region[0], region[1]);
+    return 0;
+}
