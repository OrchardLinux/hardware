+static int dt_set_wifi_j71b(void)
+{
+    const char *path = fdt_get_alias(dt, "wifi0");
+    if (!path)
+        return 0;
+
+    int node = fdt_path_offset(dt, path);
+    if (node < 0)
+        bail("FDT: J71b wifi0 alias points at nonexistent node\n");
+    if (fdt_getprop(dt, node, "local-mac-address", NULL) ||
+        fdt_getprop(dt, node, "brcm,cal-blob", NULL))
+        bail("FDT: J71b Wi-Fi identity already present; use generic public DTB\n");
+
+    int anode = adt_path_offset(adt, "/arm-io/uart2/wlan");
+    if (anode < 0) {
+        printf("ADT: J71b UART2 Wi-Fi node absent; not provisioning Wi-Fi\n");
+        return 0;
+    }
+    int chosen = adt_path_offset(adt, "/chosen");
+    if (chosen < 0)
+        bail("ADT: /chosen not found\n");
+
+    u32 mac_len, chosen_len, cal_len;
+    const u8 *mac = adt_getprop(adt, anode, "local-mac-address", &mac_len);
+    const u8 *chosen_mac = adt_getprop(adt, chosen, "mac-address-wifi0", &chosen_len);
+    const u8 *cal = adt_getprop(adt, anode, "wifi-calibration-msf", &cal_len);
+    const u8 empty_mac[6] = {0};
+    const u8 broadcast_mac[6] = {0xff, 0xff, 0xff, 0xff, 0xff, 0xff};
+    if (!mac || !chosen_mac || !cal || mac_len != 6 || chosen_len != 6 ||
+        !cal_len || (mac[0] & 1) ||
+        !memcmp(mac, empty_mac, sizeof(empty_mac)) ||
+        !memcmp(mac, broadcast_mac, sizeof(broadcast_mac)) ||
+        memcmp(mac, chosen_mac, 6)) {
+        printf("ADT: J71b Wi-Fi identity/calibration invalid or inconsistent; not provisioning\n");
+        return 0;
+    }
+
+    if (fdt_setprop(dt, node, "local-mac-address", mac, mac_len) < 0 ||
+        fdt_setprop(dt, node, "brcm,cal-blob", cal, cal_len) < 0)
+        bail("FDT: failed to set J71b Wi-Fi properties\n");
+    printf("FDT: J71b Wi-Fi MAC and calibration copied from live ADT (values suppressed)\n");
+    return 0;
+}
