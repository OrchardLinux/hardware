+        reply.msg |= FIELD_PREP(MSG_BUFFER_REQUEST_IOVA, bfr->dva | rtk->dva_base);
 
-    if (!asc_send(rtk->asc, &reply)) {
+    if (!rtk->iop_ops->send(rtk, &reply)) {
