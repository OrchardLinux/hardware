From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nick Chan <towinchenmi@gmail.com>
Date: Sat, 11 Jul 2026 00:53:55 +0800
Subject: [PATCH 26/47] rtkit: Add HW abstraction between IOP hardware and
 rtkit

Support for RTKit behind a 64-bit AKF mailbox will be added.
Add HW abstraction to facilitate the addition.

Signed-off-by: Nick Chan <towinchenmi@gmail.com>
---
 src/dcp.c   |   2 +-
 src/nvme.c  |   4 +-
 src/rtkit.c | 229 ++++++++++++++++++++++++++++++++++------------------
 src/rtkit.h |   9 ++-
 src/smc.c   |   2 +-
 5 files changed, 162 insertions(+), 84 deletions(-)

diff --git a/src/dcp.c b/src/dcp.c
index fb7b6cc1..ce1dc01b 100644
--- a/src/dcp.c
+++ b/src/dcp.c
@@ -209,7 +209,7 @@ dcp_dev_t *dcp_init(const display_config_t *cfg)
         goto out_iovad;
     }
 
-    dcp->rtkit = rtkit_init("dcp", dcp->asc, dcp->dart_dcp, dcp->iovad_dcp, NULL, false);
+    dcp->rtkit = rtkit_init_asc("dcp", dcp->asc, dcp->dart_dcp, dcp->iovad_dcp, NULL, false);
     if (!dcp->rtkit) {
         printf("dcp: failed to initialize RTKit\n");
         goto out_iovad;
diff --git a/src/nvme.c b/src/nvme.c
