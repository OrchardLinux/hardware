+    return rtk->iop_ops->can_recv(rtk);
 }
 
 int rtkit_recv(rtkit_dev_t *rtk, struct rtkit_message *msg)
 {
-    struct asc_message asc_msg;
     bool ok = true;
 
     if (rtk->crashed)
         return -1;
 
