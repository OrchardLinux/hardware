{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchardlinux.org/schemas/v1/firmware.schema.json",
  "title": "Orchard firmware recipe",
  "description": "Where a device's firmware inputs come from and the declarative steps that turn them into installed files. See docs/firmware-recipes.md.",
  "type": "object",
  "required": ["schema", "device", "ipsw", "inputs", "outputs"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 2},
    "device": {"type": "string", "pattern": "^[A-Za-z]+[0-9]+,[0-9]+$"},
    "ipsw": {
      "type": "object",
      "required": ["version", "build", "url", "bytes", "sha256"],
      "additionalProperties": false,
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "build": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://updates\\.cdn-apple\\.com/"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._,-]*$"},
      "additionalProperties": {"$ref": "#/$defs/input"}
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/output"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._,/+-]*$"},
    "input": {
      "type": "object",
      "required": ["ipsw"],
      "additionalProperties": false,
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "ipsw": {
          "oneOf": [
            {"type": "object", "required": ["rootfs"], "additionalProperties": false,
             "properties": {"rootfs": {"$ref": "#/$defs/relative"}}},
            {"type": "object", "required": ["zip"], "additionalProperties": false,
             "properties": {"zip": {"$ref": "#/$defs/relative"}}},
            {"type": "object", "required": ["kernelcache"], "additionalProperties": false,
             "properties": {"kernelcache": {"const": true}}}
          ]
        },
        "device": {
          "oneOf": [
            {"type": "string", "pattern": "^/[A-Za-z0-9][A-Za-z0-9._,/+-]*$"},
            {"type": "object", "required": ["kernelcache"], "additionalProperties": false,
             "properties": {"kernelcache": {"const": "active"}}}
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["destination", "sha256", "steps"],
      "additionalProperties": false,
      "properties": {
        "destination": {"type": "string", "pattern": "^lib/firmware/[A-Za-z0-9][A-Za-z0-9._,/+-]*$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["step", "input"],
            "properties": {
              "step": {"type": "string", "pattern": "^[a-z0-9-]+@[1-9][0-9]*$"},
              "input": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
