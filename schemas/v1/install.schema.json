{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orchard install manifest v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "device": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "boot_method": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "min_orchard": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "protocol": {
      "type": "integer",
      "minimum": 1
    },
    "boot": {
      "$ref": "#/$defs/receipt"
    },
    "pongo": {
      "$ref": "#/$defs/receipt"
    },
    "kind": {
      "const": "orchard.install"
    },
    "distro": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "install": {
      "type": "object",
      "properties": {
        "default_root": {
          "type": "string",
          "pattern": "^/(?:[A-Za-z0-9][A-Za-z0-9._-]{0,63})?$"
        }
      },
      "required": [
        "default_root"
      ],
      "additionalProperties": false
    },
    "root": {
      "$ref": "#/$defs/root"
    }
  },
  "required": [
    "schema",
    "kind",
    "distro",
    "name",
    "version",
    "device",
    "boot_method",
    "min_orchard",
    "protocol",
    "install",
    "root",
    "boot"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "boot_method": {
            "const": "checkm8-pongo"
          }
        },
        "required": [
          "boot_method"
        ]
      },
      "then": {
        "required": [
          "pongo"
        ]
      }
    }
  ],
  "$defs": {
    "receipt": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "bytes",
        "sha256"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "file"
          ],
          "not": {
            "required": [
              "url"
            ]
          }
        },
        {
          "required": [
            "url"
          ],
          "not": {
            "required": [
              "file"
            ]
          }
        }
      ]
    },
    "root": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "compression": {
          "enum": [
            "gzip",
            "zstd"
          ]
        },
        "expanded_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "members": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "bytes",
        "sha256",
        "compression",
        "expanded_bytes",
        "members"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "file"
          ],
          "not": {
            "required": [
              "url"
            ]
          }
        },
        {
          "required": [
            "url"
          ],
          "not": {
            "required": [
              "file"
            ]
          }
        }
      ]
    }
  }
}
