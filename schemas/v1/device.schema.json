{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hardware device descriptor v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "kind": {
      "const": "hardware.device"
    },
    "device": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "apple_products": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^i(?:Pad|Phone|Pod)[0-9]+,[0-9]+$"
          }
        },
        "dt_compatible": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": [
        "profile",
        "name",
        "apple_products",
        "dt_compatible"
      ],
      "additionalProperties": false
    },
    "match": {
      "type": "object",
      "properties": {
        "dfu": {
          "type": "object",
          "properties": {
            "chip": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "board": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "required": [
            "chip",
            "board"
          ],
          "additionalProperties": false
        },
        "linux": {
          "type": "object",
          "properties": {
            "recovery": {
              "const": true
            }
          },
          "required": [
            "recovery"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "dfu"
      ],
      "additionalProperties": false
    },
    "boot": {
      "type": "object",
      "properties": {
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        }
      },
      "required": [
        "methods"
      ],
      "additionalProperties": false
    },
    "kernel": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "dtb": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        }
      },
      "required": [
        "platform",
        "dtb"
      ],
      "additionalProperties": false
    },
    "firmware": {
      "type": "object",
      "properties": {
        "recipe": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "recipe"
      ],
      "additionalProperties": false
    },
    "support": {
      "type": "object",
      "properties": {
        "wifi": {
          "type": "boolean"
        },
        "usb_serial": {
          "type": "boolean"
        },
        "usb_network": {
          "type": "boolean"
        },
        "install": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "supported",
            "experimental"
          ]
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "wifi",
        "usb_serial",
        "usb_network"
      ],
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "properties": {
        "display": {
          "enum": [
            "working",
            "partial",
            "untested",
            "missing",
            "none"
          ]
        },
        "touch": {
          "enum": [
            "working",
            "partial",
            "untested",
            "missing",
            "none"
          ]
        },
        "wifi": {
          "enum": [
            "working",
            "partial",
            "untested",
            "missing",
            "none"
          ]
        },
        "bluetooth": {
          "enum": [
            "working",
            "partial",
            "untested",
            "missing",
            "none"
          ]
        },
        "storage": {
          "enum": [
            "working",
            "partial",
            "untested",
            "missing",
            "none"
          ]
        },
        "battery": {
          "enum": [
            "working",
            "partial",
            "untested",
            "missing",
            "none"
          ]
        },
        "charging": {
          "enum": [
            "working",
            "partial",
            "untested",
            "missing",
            "none"
          ]
        },
        "backlight": {
          "enum": [
            "working",
            "partial",
            "untested",
            "missing",
            "none"
          ]
        },
        "buttons": {
          "enum": [
            "working",
            "partial",
            "untested",
            "missing",
            "none"
          ]
        },
        "audio": {
          "enum": [
            "working",
            "partial",
            "untested",
            "missing",
            "none"
          ]
        },
        "camera": {
          "enum": [
            "working",
            "partial",
            "untested",
            "missing",
            "none"
          ]
        },
        "cellular": {
          "enum": [
            "working",
            "partial",
            "untested",
            "missing",
            "none"
          ]
        },
        "suspend": {
          "enum": [
            "working",
            "partial",
            "untested",
            "missing",
            "none"
          ]
        },
        "gpu": {
          "enum": [
            "working",
            "partial",
            "untested",
            "missing",
            "none"
          ]
        }
      },
      "required": [
        "display",
        "touch",
        "wifi",
        "bluetooth",
        "storage",
        "battery",
        "charging",
        "backlight",
        "buttons",
        "audio",
        "camera",
        "cellular",
        "suspend",
        "gpu"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "kind",
    "device",
    "match",
    "kernel",
    "boot",
    "firmware",
    "support",
    "features"
  ],
  "additionalProperties": false
}
