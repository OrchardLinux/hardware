{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hardware device descriptor v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "kind": {
      "const": "hardware.device"
    },
    "device": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "apple_products": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^i(?:Pad|Phone|Pod)[0-9]+,[0-9]+$"
          }
        },
        "dt_compatible": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": [
        "profile",
        "name",
        "apple_products",
        "dt_compatible"
      ],
      "additionalProperties": false
    },
    "match": {
      "type": "object",
      "properties": {
        "dfu": {
          "type": "object",
          "properties": {
            "chip": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "board": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "required": [
            "chip",
            "board"
          ],
          "additionalProperties": false
        },
        "linux": {
          "type": "object",
          "properties": {
            "product": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": ["product"],
          "additionalProperties": false
        }
      },
      "required": [
        "dfu"
      ],
      "additionalProperties": false
    },
    "boot": {
      "type": "object",
      "properties": {
        "launch_manifest": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        }
      },
      "required": [
        "methods"
      ],
      "additionalProperties": false
    },
    "firmware": {
      "type": "object",
      "properties": {
        "recipe": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["recipe"],
      "additionalProperties": false
    },
    "support": {
      "type": "object",
      "properties": {
        "wifi": {
          "type": "boolean"
        },
        "usb_serial": {
          "type": "boolean"
        },
        "usb_network": {
          "type": "boolean"
        }
      },
      "required": [
        "wifi",
        "usb_serial",
        "usb_network"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "kind",
    "device",
    "match",
    "boot",
    "firmware",
    "support"
  ],
  "additionalProperties": false
}
