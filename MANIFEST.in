include README.md BUILD.md
recursive-include boot *.md
recursive-include kernel *.md
recursive-include tests *.py
recursive-include ci *.py
include ci/install-toolchains
recursive-include docs *.md
recursive-include .github/workflows *.yml
prune boot/m1n1/.work
prune boot/quiet/.work
global-exclude __pycache__ *.py[cod] .DS_Store

recursive-include devices/p105 *.md *.toml *.json
recursive-include kernel/p105 *.md *.lock *.fragment *.patch *.sh Containerfile prepare-source build
recursive-include runtime/p105 *.py *.md *.patch
recursive-include runtime/p105/overlay *
recursive-include runtime/p105/recovery *.py init
prune runtime/p105/build
prune kernel/p105/.work
