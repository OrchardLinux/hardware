+/* AppleT801xPCIePort::enablePortHardware, 0xfffffff006aa3144;
+ * AppleT8011PCIePort::_waitForPipeClock, 0xfffffff006aa5b4c.
+ * Only port 2 is accepted by probe. All waits are bounded for the RAM test.
+ */
+static int apple_j208_enable_port(struct apple_h9p_pcie *pcie)
+{
+	ktime_t deadline;
+	unsigned int stable = 0;
+	int ret;
+
+	h9p_rmw(pcie->base_rc + 0x234, BIT(0), 0);
+	h9p_rmw(pcie->base_rc + 0x224, 0, BIT(0));
+	ret = apple_h9p_wait(pcie->base_rc + 0x24, BIT(4), BIT(4),
+			     BIT(4), 250000);
+	if (ret)
+		return ret;
+	usleep_range(100, 200);
+	h9p_rmw(pcie->base_rc + 0x228, BIT(4), 0);
+	ret = apple_h9p_wait(pcie->base_rc + 0x204, BIT(0), 0, 0, 250000);
+	if (ret)
+		return ret;
+	h9p_rmw(pcie->base_rc + 0x200, 0, BIT(0));
+	h9p_rmw(pcie->base_rc + 0x200, BIT(8), 0);
+	/* t-refclk-to-perst = 100, passed to IODelay without scaling. */
+	usleep_range(100, 200);
+	h9p_rmw(pcie->base_rc + 0x234, 0, BIT(0));
+	deadline = ktime_add_ms(ktime_get(), 250);
+	do {
+		if (readl(pcie->base_port[2] + 0x208) & BIT(2))
+			stable = 0;
+		else if (++stable == 2)
+			break;
+		usleep_range(5000, 6000);
+	} while (ktime_before(ktime_get(), deadline));
+	if (stable < 2)
+		return -ETIMEDOUT;
+
+	writel(3, pcie->base_rc + 0x40a0);
+	h9p_rmw(pcie->base_rc + 0x224, BIT(8), 0);
+	return 0;
+}
