+/* AppleT8011PCIe::_commonInit, 21H461, 0xfffffff006aa4f04.
+ * Unlike H9P, 0x24 is status and 0x28 is a tunable. No port-0 control write.
+ * The common table is restricted to global registers and the Wi-Fi port.
+ */
+static int apple_j208_setup_common(struct apple_h9p_pcie *pcie)
+{
+	int ret;
 
+	writel(0x10, pcie->base_rc + 0x4); /* J208 lane-cfg = 0 */
+	apple_h9p_apply_tunables(pcie->base_phy, j208_phy_adt_tunables,
+				 ARRAY_SIZE(j208_phy_adt_tunables));
+	writel(1, pcie->base_rc + 0x34);
+	ret = apple_h9p_wait(pcie->base_rc + 0x24, BIT(0), BIT(0),
+			     BIT(0), 250000);
+	if (ret)
+		return dev_err_probe(pcie->dev, ret, "J208 common ready timeout\n");
+	h9p_rmw(pcie->base_rc + 0x30, BIT(0), 0);
+	apple_h9p_apply_tunables(pcie->base_rc, j208_rc_wifi_tunables,
+				 ARRAY_SIZE(j208_rc_wifi_tunables));
+	return 0;
+}
