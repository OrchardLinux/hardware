+static int apple_j208_setup_port(struct apple_h9p_pcie *pcie,
+				enum apple_h9p_port_result *result)
+{
+	void __iomem *config = pcie->base_config + 2 * H9P_CFG_PORT_STRIDE;
+	void __iomem *port = pcie->base_port[2];
+	u32 linksts;
+	u64 cap;
+	int ret;
+
+	*result = APPLE_H9P_PORT_DISABLED;
+	ret = gpiod_direction_output(pcie->perst[2], 1);
+	if (ret)
+		return ret;
+	/* Original host property perst-to-refclk-delay-us = 60. */
+	usleep_range(60, 100);
+	ret = apple_j208_enable_port(pcie);
+	if (ret)
+		return dev_err_probe(pcie->dev, ret, "J208 port2 clock timeout\n");
+	ret = apple_dart_reload_configuration(pcie->manual_dart[2], 0);
+	if (ret)
+		return dev_err_probe(pcie->dev, ret, "J208 DART2 reload failed\n");
+
+	cap = apple_h9p_read_pci_cap(pcie, 2 << 3, PCI_CAP_ID_EXP);
+	if (!cap)
+		return dev_err_probe(pcie->dev, -ENODEV, "J208 missing PCIe capability\n");
+	pcie->pcie_cap[2] = cap;
+	h9p_rmww(config + cap + PCI_EXP_LNKCTL2, PCI_EXP_LNKCTL2_TLS,
+		 H9P_LINK_SPEED_2_5GT);
+	apple_h9p_apply_tunables(port, j208_port_adt_tunables,
+				 ARRAY_SIZE(j208_port_adt_tunables));
+	apple_h9p_apply_tunables(config, j208_config_adt_tunables,
+				 ARRAY_SIZE(j208_config_adt_tunables));
+	/* T8011 enablePortHardware override, 0xfffffff006aa5814. */
+	h9p_rmw(config + 0x8e0, 0, BIT(0));
+	h9p_rmw(config + 0x80c, 0, BIT(17));
+	h9p_rmw(config + 0x890, 0, BIT(9) | BIT(12));
+
+	writel(H9P_PORT_IRQMASK_PRE_LINK, port + H9P_PORT_IRQMASK);
+	writel(H9P_PORT_IRQSTAT_PRE_LINK, port + H9P_PORT_IRQSTAT);
+	h9p_rmw(port + H9P_PORT_ENABLE, 0, H9P_PORT_ENABLE_APPLE);
+	/* Original MSI constructor: count 4 and global vector base 16. */
+	writel(0x21, port + H9P_PORT_PWRCTL);
+	writel(0x00100010, port + H9P_PORT_MSIVECBASE);
+	writel(H9P_PORT_IRQMASK_LINK_UP, port + H9P_PORT_IRQMASK);
+	ret = gpiod_direction_output(pcie->perst[2], 0);
+	if (ret)
+		return ret;
+	h9p_rmw(port + H9P_PORT_LTSSMCTL, 0, H9P_PORT_LTSSM_ENABLE);
+	ret = apple_h9p_wait_link(pcie, 2, &linksts);
+	if (ret) {
+		writel(H9P_PORT_IRQMASK_ALL, port + H9P_PORT_IRQMASK);
+		dev_warn(pcie->dev, "J208 port2 link timeout (linksts=%#x)\n", linksts);
+		return ret;
+	}
+	*result = APPLE_H9P_PORT_READY;
+	dev_info(pcie->dev, "J208 port2 link ready; endpoint DMA %s\n",
+		 pcie->enumeration_only ? "disabled" : "permitted for 14e4:43dc");
+	return 0;
+}
