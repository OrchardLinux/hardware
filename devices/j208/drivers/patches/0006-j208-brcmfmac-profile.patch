 MODULE_DEVICE_TABLE(pci, brcmf_pcie_devid_table);
+
+
+/* Quiesce only the observed J208 profile; retain all DMA allocations. */
+static void brcmf_pcie_shutdown(struct pci_dev *pdev)
+{
+	struct brcmf_bus *bus = dev_get_drvdata(&pdev->dev);
+	struct brcmf_pciedev_info *devinfo;
+	u16 command;
+	u32 irq_mask;
+	int ret;
 
+	if (!of_machine_is_compatible("apple,j208") ||
+	    pdev->vendor != 0x14e4 || pdev->device != 0x43dc || !bus)
+		return;
+	devinfo = bus->bus_priv.pcie->devinfo;
+	if (!devinfo->j208_profile_matched)
+		return;
 
+	WRITE_ONCE(devinfo->j208_shutdown_started, true);
+	/* Do not hold the reset gate while waiting for its IRQ-using worker. */
+	mutex_lock(&bus->bus_reset_lock);
+	bus->removing = true;
+	mutex_unlock(&bus->bus_reset_lock);
+	if (bus->drvr && bus->drvr->bus_reset.func)
+		cancel_work_sync(&bus->drvr->bus_reset);
+	/* The reset worker only launches the asynchronous firmware request. */
+	mutex_lock(&devinfo->j208_shutdown_lock);
+	brcmf_bus_change_state(bus, BRCMF_BUS_DOWN);
+	WRITE_ONCE(devinfo->state, BRCMFMAC_PCIE_STATE_DOWN);
+#ifdef DEBUG
+	WRITE_ONCE(devinfo->console_active, false);
+	timer_shutdown_sync(&devinfo->timer);
+#endif
+	brcmf_pcie_intr_disable(devinfo);
+	/* Flush the posted interrupt-mask write before draining handlers. */
+	brcmf_pcie_read_reg32(devinfo, devinfo->reginfo->mailboxmask);
+	if (devinfo->irq_allocated)
+		synchronize_irq(pdev->irq);
+	/* A handler already past its UP check could have re-enabled it. */
+	brcmf_pcie_intr_disable(devinfo);
+	irq_mask = brcmf_pcie_read_reg32(devinfo, devinfo->reginfo->mailboxmask);
+	pci_clear_master(pdev);
+	ret = pci_read_config_word(pdev, PCI_COMMAND, &command);
+	if (irq_mask || ret || (command & PCI_COMMAND_MASTER))
+		pci_err(pdev, "J208_WIFI_SHUTDOWN quiesce readback failed\n");
+	else
+		pci_info(pdev,
+			 "J208_WIFI_SHUTDOWN irq_mask=0 bus_master=0 buffers_retained=1\n");
+	mutex_unlock(&devinfo->j208_shutdown_lock);
+}
