+static int apple_z2_read_device_info_locked(struct apple_z2 *z2)
+{
+	unsigned int attempts = apple_z2_is_j208(z2) ? 4 : 1;
+	unsigned int attempt;
+	bool invalid_reply;
+	int error;
+
+	/* Native getDeviceInfo (21H461, 0x5dafd58) permits four attempts,
+	 * separated by 5 ms after an invalid reply. Do not retry a Linux
+	 * transport error: controller/DMA quiescence is not established there.
+	 */
+	for (attempt = 1; attempt <= attempts; attempt++) {
+		error = apple_z2_read_device_info_attempt_locked(z2, attempt,
+							       &invalid_reply);
+		if (!invalid_reply || attempt == attempts)
+			return error;
+		msleep(5);
+	}
+
+	return -EPROTO;
+}
