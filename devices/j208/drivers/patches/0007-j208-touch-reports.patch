+/* RAM-only evidence: reads copy captured bytes, never initiate SPI traffic.
+ * Includes the Gen2 transport header/checksum; keep captures private on host.
+ */
+static ssize_t apple_z2_diagnostic_frame_read(struct file *file,
+		struct kobject *kobj, const struct bin_attribute *attr,
+		char *buf, loff_t offset, size_t count)
+{
+	struct apple_z2 *z2 = dev_get_drvdata(kobj_to_dev(kobj));
+
+	if (offset < 0)
+		return -EINVAL;
+	mutex_lock(&z2->io_lock);
+	if (offset >= z2->diagnostic_frame_len)
+		count = 0;
+	else {
+		count = min_t(size_t, count, z2->diagnostic_frame_len - offset);
+		memcpy(buf, z2->diagnostic_frame + offset, count);
+	}
+	mutex_unlock(&z2->io_lock);
+	return count;
+}
+
+/* Public surface geometry only. Return one complete immutable snapshot;
+ * no query or other SPI operation is performed from this sysfs read.
+ */
+static ssize_t apple_z2_diagnostic_surface_read(struct file *file,
+		struct kobject *kobj, const struct bin_attribute *attr,
+		char *buf, loff_t offset, size_t count)
+{
+	struct apple_z2 *z2 = dev_get_drvdata(kobj_to_dev(kobj));
+	ssize_t result;
+
+	if (offset < 0)
+		return -EINVAL;
+	mutex_lock(&z2->io_lock);
+	if (!z2->surface_descriptor_valid)
+		result = -ENODATA;
+	else if (offset >= APPLE_Z2_SURFACE_DESCRIPTOR_SIZE)
+		result = 0;
+	else if (offset || count < APPLE_Z2_SURFACE_DESCRIPTOR_SIZE)
+		result = -EINVAL;
+	else {
+		memcpy(buf, z2->diagnostic_surface,
+		       APPLE_Z2_SURFACE_DESCRIPTOR_SIZE);
+		result = APPLE_Z2_SURFACE_DESCRIPTOR_SIZE;
+	}
+	mutex_unlock(&z2->io_lock);
+	return result;
+}
+
+/* An explicit computed-geometry API; never presented as raw D9 bytes. */
+static ssize_t diagnostic_geometry_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct apple_z2 *z2 = dev_get_drvdata(dev);
+	ssize_t len;
+
+	mutex_lock(&z2->io_lock);
+	if (!z2->grid_fallback_valid)
+		len = -ENODATA;
+	else
+		len = sysfs_emit(buf,
+			"source=family28-region1-native-v1 d9_all_zero=1 family=28 endian=1 rows=52 columns=53 region=1 min_x=%d max_x=%d min_y=%d max_y=%d raw_to_bound_ratio=10\n",
+			z2->sensor_min_x, z2->sensor_max_x,
+			z2->sensor_min_y, z2->sensor_max_y);
+	mutex_unlock(&z2->io_lock);
+	return len;
+}
+
+static ssize_t diagnostic_status_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct apple_z2 *z2 = dev_get_drvdata(dev);
+	ssize_t len;
+
+	mutex_lock(&z2->io_lock);
+	len = sysfs_emit(buf,
+		"frames=%llu last_bytes=%zu reads=%llu no_data=%llu invalid=%llu header_command=%02x packet_bytes=%zu transport_error=%d capacity=%zu empty=%llu raw_len=%u header_checksum=%d\n",
+		z2->diagnostic_frames, z2->diagnostic_frame_len,
+		z2->diagnostic_reads, z2->diagnostic_no_data,
+		z2->diagnostic_invalid, z2->diagnostic_command,
+		z2->diagnostic_packet_len, z2->diagnostic_error, z2->rx_buf_size,
+		z2->diagnostic_empty, z2->diagnostic_result_len,
+		z2->diagnostic_header_checksum);
+	mutex_unlock(&z2->io_lock);
+	return len;
+}
