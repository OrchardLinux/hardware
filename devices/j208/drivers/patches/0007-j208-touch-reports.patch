+/* Native 21H461 getReportGated caps property payloads at 512 bytes.
+ * These read-only queries identify the native grid fallback profile;
+ * they do not enable reports or input events.
+ */
+static int apple_z2_j208_read_property_locked(struct apple_z2 *z2, u8 report,
+					    u16 *payload_len)
+{
+	struct spi_transfer xfer = { };
+	unsigned int i, wire_len;
+	u16 len, min_len, max_len;
+	u8 command;
+	int error;
+
+	switch (report) {
+	case 0xd1: min_len = 1; max_len = 512; break;
+	case 0xd3: min_len = 5; max_len = 512; break;
+	case 0xd0: min_len = 1; max_len = 1 + 20 * 7; break;
+	default: return -EINVAL;
+	}
+	if (z2->rx_buf_size < APPLE_Z2_CMD_SIZE)
+		return -EMSGSIZE;
+
+	/* E3 twice is the native two-stage metadata transaction, not retry. */
+	for (i = 0; i < 2; i++) {
+		error = apple_z2_z2_cmd_locked(z2, APPLE_Z2_CMD_REPORT_INFO,
+					       report, "j208-property-info");
+		if (error) {
+			dev_info(&z2->spidev->dev,
+				 "J208 property=%02x stage=info transfer=%u transport-error=%d\n",
+				 report, i + 1, error);
+			return error;
+		}
+	}
+	len = get_unaligned_le16(z2->rx_buf + 3);
+	dev_info(&z2->spidev->dev,
+		 "J208 property=%02x stage=info command=%02x header1=%02x status=%u length=%u checksum=%u\n",
+		 report, z2->rx_buf[0], z2->rx_buf[1], z2->rx_buf[2], len,
+		 apple_z2_z2_checksum_valid(z2->rx_buf, APPLE_Z2_CMD_SIZE));
+	/* Native getReportInfo checks command/checksum, then status and size.
+	 * Response byte 1 has no proven echo requirement; retain it in logs.
+	 */
+	if (z2->rx_buf[0] != APPLE_Z2_CMD_REPORT_INFO || z2->rx_buf[2] ||
+	    !apple_z2_z2_checksum_valid(z2->rx_buf, APPLE_Z2_CMD_SIZE))
+		return -EPROTO;
+	if (len < min_len || len > max_len)
+		return -EMSGSIZE;
+	wire_len = len <= 11 ? APPLE_Z2_CMD_SIZE : len + 5;
+	if (wire_len > z2->rx_buf_size)
+		return -EMSGSIZE;
+
+	/* deviceGetReport 0x5db1168 selects E6 for <= 11, otherwise E7. */
+	command = len <= 11 ? APPLE_Z2_CMD_CTRL_READ_SHORT :
+			      APPLE_Z2_CMD_CTRL_READ_LONG;
+	memset(z2->tx_buf, 0, APPLE_Z2_CMD_SIZE);
+	memset(z2->rx_buf, 0, APPLE_Z2_CMD_SIZE);
+	z2->tx_buf[0] = command;
+	z2->tx_buf[1] = report;
+	put_unaligned_le16(len, z2->tx_buf + 3);
+	error = apple_z2_z2_xfer_locked(z2, "j208-property-read");
+	if (error) {
+		dev_info(&z2->spidev->dev,
+			 "J208 property=%02x stage=body-request transport-error=%d\n",
+			 report, error);
+		return error;
+	}
+
+	/* Native stage 2: short TX E1 + checksum, RX command E6; long TX
+	 * A5 x 16 followed by zeroes, exact len + 5, RX command E7.
+	 */
+	if (len <= 11) {
+		error = apple_z2_z2_cmd_locked(z2, APPLE_Z2_CMD_LAST, 0,
+					       "j208-property-last");
+	} else {
+		memset(z2->rx_buf, 0, wire_len);
+		memset(z2->rx_buf, 0xa5, APPLE_Z2_CMD_SIZE);
+		xfer.tx_buf = z2->rx_buf;
+		xfer.rx_buf = z2->rx_buf;
+		xfer.len = wire_len;
+		apple_z2_apply_z2_delays(z2);
+		error = spi_sync_transfer(z2->spidev, &xfer, 1);
+		if (!error)
+			apple_z2_post_z2_xfer_delay(z2);
+	}
+	if (error) {
+		dev_info(&z2->spidev->dev,
+			 "J208 property=%02x stage=body transport-error=%d\n",
+			 report, error);
+		return error;
+	}
+	dev_info(&z2->spidev->dev,
+		 "J208 property=%02x stage=body command=%02x header1=%02x header2=%u length=%u wire-bytes=%u checksum=%u\n",
+		 report, z2->rx_buf[0], z2->rx_buf[1], z2->rx_buf[2], len,
+		 wire_len, apple_z2_z2_checksum_valid(z2->rx_buf, wire_len));
+	/* Native deviceGetReport validates command and checksum. Header bytes
+	 * 1/2 have no proven acceptance semantics and remain diagnostic only.
+	 */
+	if (z2->rx_buf[0] != command ||
+	    !apple_z2_z2_checksum_valid(z2->rx_buf, wire_len))
+		return -EPROTO;
+	*payload_len = len;
+	return 0;
+}
