+	z2->platform_powered = true;
+	return apple_z2_advance_protocol(z2, APPLE_Z2_STATE_OFF,
+					 APPLE_Z2_STATE_POWERED);
+power_off:
+	apple_z2_platform_power_off(z2);
+	return error;
