+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/apple,s8000-display-pipe.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple A9 display pipe (disp0)
+
+maintainers:
+  - Berkay Kösebay <brkosebay@users.noreply.github.com>
+
+description:
+  The display subsystem of the Apple A9 SoCs (S8000/S8003), called "disp0"
+  with the compatible "adbe0,s8000" in the Apple device tree. It contains
+  the ADP/ADBE display pipe that scans out to the internal eDP panel. The
+  bootloader leaves the pipe, the eDP link and the panel running; the pipe
+  reads memory through the display DART, which the bootloader leaves in
+  bypass.
+
+properties:
+  compatible:
+    const: apple,s8000-display-pipe
+
+  reg:
+    items:
+      - description:
+          ADP window, with the control and interrupt registers, the
+          parameter FIFO port and the pipe layer registers
+      - description: Display block window A
+      - description: Display block window B
+      - description: Display block window C
+      - description: Display block window D
+      - description: Seven-register side block
+
+  interrupts:
+    items:
+      - description:
+          Pipe interrupt; carries vblank, parameter packet completion
+          and pipe errors
+      - description: Back-end interrupt
+      - description: Third display interrupt
+      - description: Fourth display interrupt
+      - description: Fifth display interrupt
+
+  power-domains:
+    items:
+      - description: Display pipe (disp0)
+      - description: DisplayPort/eDP controller (dp)
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - power-domains
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/apple-aic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        display-controller@206200000 {
+            compatible = "apple,s8000-display-pipe";
+            reg = <0x2 0x06200000 0x0 0x100000>,
+                  <0x2 0x06400000 0x0 0x8000>,
+                  <0x2 0x06440000 0x0 0x8000>,
+                  <0x2 0x06480000 0x0 0x8000>,
+                  <0x2 0x064c0000 0x0 0x8000>,
+                  <0x2 0x06500000 0x0 0x1c>;
+            interrupt-parent = <&aic>;
+            interrupts = <AIC_IRQ 140 IRQ_TYPE_LEVEL_HIGH>,
+                         <AIC_IRQ 143 IRQ_TYPE_LEVEL_HIGH>,
+                         <AIC_IRQ 144 IRQ_TYPE_LEVEL_HIGH>,
+                         <AIC_IRQ 145 IRQ_TYPE_LEVEL_HIGH>,
+                         <AIC_IRQ 146 IRQ_TYPE_LEVEL_HIGH>;
+            power-domains = <&ps_disp0>, <&ps_dp>;
+        };
+    };
