+static int adbe_dumb_create(struct drm_file *file, struct drm_device *drm,
+			    struct drm_mode_create_dumb *args)
+{
+	int ret;
+
+	ret = drm_mode_size_dumb(drm, args, ADBE_ALIGN, 0);
+	if (ret)
+		return ret;
+
+	return drm_gem_dma_dumb_create_internal(file, drm, args);
+}
