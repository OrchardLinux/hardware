From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Orchard migration <noreply@orchardlinux>
Date: Wed, 28 Oct 2026 18:39:05 +0800
Subject: [PATCH] dt-bindings: power: supply: Add Apple Tristar Lightning
 charging

Apple devices with a Tristar (NXP CBTL1610) Lightning port controller,
such as the iPad 5 and iPad 6, charge through a D2365-family PMIC. The
charger node is a PMIC child: it names the PMIC banks it uses, the PMU
event interrupt, the Tristar and the board's maximum input current.

Also list the CBTL1610 as a trivial I2C device.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../power/supply/apple,tristar-charger.yaml   | 90 +++++++++++++++++++
 .../devicetree/bindings/trivial-devices.yaml  |  2 +
 2 files changed, 92 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/apple,tristar-charger.yaml

diff --git a/Documentation/devicetree/bindings/power/supply/apple,tristar-charger.yaml b/Documentation/devicetree/bindings/power/supply/apple,tristar-charger.yaml
new file mode 100644
index 000000000..629dbaf92
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/apple,tristar-charger.yaml
@@ -0,0 +1,90 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/apple,tristar-charger.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple Tristar Lightning charging
+
+maintainers:
+  - Henrik Klee <henrik@goat-code.com>
+
+description: |
+  Charging on Apple devices whose Lightning port uses a Tristar (NXP CBTL1610)
+  port controller and a D2365-family PMIC. The node is a child of the PMIC.
+  It identifies the attached source through the Tristar and the PMIC ADC and
+  sets the PMIC input-current limit, which iBoot leaves at 100 mA.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    items:
+      - enum:
+          - apple,j71b-tristar-charger
+      - const: apple,tristar-charger
+
+  reg:
+    items:
+      - description: Charger status register bank.
+      - description: Charger control register bank.
+      - description: PMU event register block, read to acknowledge.
+      - description: ADC register bank.
+
+  reg-names:
+    items:
+      - const: status
+      - const: control
+      - const: event
+      - const: adc
+
+  interrupts:
+    maxItems: 1
+    description: PMU event interrupt, active low.
+
+  apple,tristar:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The Tristar (CBTL1610) port controller on its I2C bus.
+
+  input-current-limit-microamp:
+    description: Board maximum input current.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - apple,tristar
+  - input-current-limit-microamp
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        tristar: port-controller@1a {
+            compatible = "nxp,cbtl1610";
+            reg = <0x1a>;
+        };
+    };
+
+    pmic {
+        #address-cells = <1>;
+        #size-cells = <1>;
+
+        charger@180 {
+            compatible = "apple,j71b-tristar-charger", "apple,tristar-charger";
+            reg = <0x180 0x10>, <0xa00 0x04>, <0x140 0x1e>, <0x4000 0x03>;
+            reg-names = "status", "control", "event", "adc";
+            interrupts = <38 IRQ_TYPE_LEVEL_LOW>;
+            apple,tristar = <&tristar>;
+            input-current-limit-microamp = <2400000>;
+        };
+    };
+...
diff --git a/Documentation/devicetree/bindings/trivial-devices.yaml b/Documentation/devicetree/bindings/trivial-devices.yaml
index 2de8eb09c..d6d97623f 100644
--- a/Documentation/devicetree/bindings/trivial-devices.yaml
+++ b/Documentation/devicetree/bindings/trivial-devices.yaml
@@ -392,6 +392,8 @@ properties:
           - national,lm92
             # Nuvoton Temperature Sensor
           - nuvoton,w83773g
+            # NXP CBTL1610 (Apple Tristar) Lightning port controller
+          - nxp,cbtl1610
             # NXP ISP1301 USB transceiver
           - nxp,isp1301
             # OKI ML86V7667 video decoder
