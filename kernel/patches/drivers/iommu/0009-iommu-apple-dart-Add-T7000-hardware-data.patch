From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Martin=20Pu=C5=A1k=C3=A1=C4=8D?= <martin@icebear.sk>
Date: Thu, 29 Oct 2026 16:54:18 +0800
Subject: [PATCH] iommu: apple-dart: Add T7000 hardware data

The A8X (T7000/T7001) DARTs are S5L8960X-style DARTs and so far bound
through the "apple,s5l8960x-dart" fallback. Bringing up the PCIe DART of
the iPad Air 2 found two things that set them apart:

- iOS 8.1 brings the DART up with the error reflector written before
  any other register access. Without the reflector a DART fault resets
  the SoC instead of raising an interrupt. Do the same on T7000; on the
  other S5L8960X DARTs the reflector is still written after the reset,
  as before.

- iOS writes leaf entries without the no-read and no-write bits, and
  the Wi-Fi DMA was brought up that way. Keep the protection bits on
  T7000 for now, since brcmfmac maps RX buffers bidirectionally, and
  make the iOS format a single hw-data field so it can be selected if
  the device shows this DART needs it.

The table and leaf entry layout (bits 1:0 set, no subpage fields) and
the error reflector, fetch and diag configuration from the device tree
are already shared with the other S5L8960X DARTs.

[Orchard: from mattonik/ipad-nixos b94d42f kernel/patches/0081-apple-dart-s5l8960x-ios-pte-format.patch, 0085-apple-dart-h1b-apple-init-order.patch, 0088-io-pgtable-dart-ios-leaf-bits.patch, 0089-apple-dart-j81-options-from-device-tree.patch, handed to Orchard by micro23 (ipadair2-omarchy 7ea2b2b); per-compatible hw data instead of the apple,ios-pte/apple,pci-alias DT properties and module parameters; the entry format is the existing S5L8960X quirk; protection bits kept by default; the device-name match, PCI IOVA window/rebase and alias mapping, fault walk and debugfs dump dropped]
Signed-off-by: Martin Puškáč <martin@icebear.sk>
Co-developed-by: Henrik Klee <henrik@goat-code.com>
Signed-off-by: Henrik Klee <henrik@goat-code.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/iommu/apple-dart.c | 56 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 56 insertions(+)

diff --git a/drivers/iommu/apple-dart.c b/drivers/iommu/apple-dart.c
index 3ed0500e0..1ee6add55 100644
--- a/drivers/iommu/apple-dart.c
+++ b/drivers/iommu/apple-dart.c
@@ -283,6 +283,11 @@ struct apple_dart_hw {
 	u32 ttbr_addr_field_shift;
 	u32 ttbr_shift;
 	int ttbr_count;
+
+	/* S5L8960X family: write the error reflector before any other access */
+	bool early_error_reflector;
+	/* S5L8960X family: map leaves without no-read/no-write bits */
+	bool no_perms;
 };
 
 /*
@@ -642,6 +647,9 @@ static int apple_dart_hw_reset(struct apple_dart *dart)
 	struct apple_dart_stream_map stream_map;
 	int i;
 
+	if (dart->hw->early_error_reflector)
+		apple_dart_s5l8960x_set_reflector(dart);
+
 	config = readl(dart->regs + dart->hw->lock);
 	if (config & dart->hw->lock_bit) {
 		dev_err(dart->dev, "DART is locked down until reboot: %08x\n",
@@ -1049,6 +1057,8 @@ static int apple_dart_finalize_domain(struct apple_dart_domain *dart_domain,
 	};
 	if (dart->hw->type == DART_S5L8960X)
 		pgtbl_cfg.quirks |= IO_PGTABLE_QUIRK_APPLE_DART_S5L8960X;
+	if (dart->hw->no_perms)
+		pgtbl_cfg.quirks |= IO_PGTABLE_QUIRK_NO_PERMS;
 
 	dart_domain->pgtbl_ops = alloc_io_pgtable_ops(dart->hw->fmt, &pgtbl_cfg,
 						      &dart_domain->domain);
@@ -1821,6 +1831,51 @@ static const struct apple_dart_hw apple_dart_hw_s5l8960x = {
 	.ttbr_count = 4,
 };
 
+static const struct apple_dart_hw apple_dart_hw_t7000 = {
+	.type = DART_S5L8960X,
+	.irq_handler = apple_dart_s5l8960x_irq,
+	.invalidate_tlb = apple_dart_s5l8960x_hw_invalidate_tlb,
+	.read_tcr = apple_dart_s5l8960x_read_tcr,
+	.write_tcr = apple_dart_s5l8960x_write_tcr,
+	.oas = 36,
+	.fmt = APPLE_DART,
+	.max_sid_count = DART_S5L8960X_MAX_STREAMS,
+
+	.enable_streams = 0,
+	.lock = 0,
+	.lock_bit = 0,
+
+	.error = DART_S5L8960X_ERROR,
+
+	.tcr = DART_S5L8960X_TCR,
+	.tcr_enabled = DART_T8020_TCR_TRANSLATE_ENABLE,
+	.tcr_disabled = 0,
+	.tcr_bypass = 0,
+
+	.ttbr = DART_S5L8960X_TTBR,
+	.ttbr_valid = DART_T8020_TTBR_VALID,
+	.ttbr_addr_field_shift = DART_T8020_TTBR_ADDR_FIELD_SHIFT,
+	.ttbr_shift = DART_T8020_TTBR_SHIFT,
+	.ttbr_count = 4,
+
+	/*
+	 * iOS 8.1 (AppleS5L8960XDART::_dartRecoverFromPowerdown,
+	 * 0xffffff80026c5d40 in the J81 kernelcache) writes the error
+	 * reflector before it reads or writes anything else.
+	 */
+	.early_error_reflector = true,
+	/*
+	 * Leaf protection bits. iOS's AppleS5L8960XDART writes A8X leaves as
+	 * (pfn << 12) | 3, without the no-read (bit 8) and no-write (bit 7)
+	 * bits, and the J81 PCIe DART was brought up with such leaves. Linux
+	 * keeps the bits by default (RX buffers are mapped bidirectionally in
+	 * brcmfmac for this reason). Whether this DART enforces them hasn't
+	 * been tested: if device DMA faults with them, set this to true to map
+	 * every page read/write as iOS does.
+	 */
+	.no_perms = false,
+};
+
 static const struct apple_dart_hw apple_dart_hw_t8103 = {
 	.type = DART_T8020,
 	.irq_handler = apple_dart_t8020_irq,
@@ -1974,6 +2029,7 @@ static DEFINE_SIMPLE_DEV_PM_OPS(apple_dart_pm_ops, apple_dart_suspend, apple_dar
 
 static const struct of_device_id apple_dart_of_match[] = {
 	{ .compatible = "apple,s5l8960x-dart", .data = &apple_dart_hw_s5l8960x },
+	{ .compatible = "apple,t7000-dart", .data = &apple_dart_hw_t7000 },
 	{ .compatible = "apple,t8103-dart", .data = &apple_dart_hw_t8103 },
 	{ .compatible = "apple,t8103-usb4-dart", .data = &apple_dart_hw_t8103_usb4 },
 	{ .compatible = "apple,t8110-dart", .data = &apple_dart_hw_t8110 },
