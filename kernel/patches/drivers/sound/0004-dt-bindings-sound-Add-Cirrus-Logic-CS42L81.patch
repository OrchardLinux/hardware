From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Wed, 28 Oct 2026 21:36:19 +0800
Subject: [PATCH] dt-bindings: sound: Add Cirrus Logic CS42L81
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The CS42L81 is an Apple-specific Cirrus Logic codec with integrated
speaker drivers, a headphone driver and DMIC inputs, controlled over
SPI. The A9 iPad 5 uses it with an MCA as the I2S consumer.

The speaker volume is capped per board: the iPad 5 ADT gives -3.0 dB
(spkr-gain-db), which iOS applies as the maximum speaker gain.

Signed-off-by: Berkay Kösebay <brkosebay@users.noreply.github.com>
[Orchard: from brkosebay/linux 519401b6, 9b03d9f8 and 3e47c1c2 (J71t
 ledger 10.6); apple,max-speaker-gain-db-q8 became
 cirrus,speaker-max-gain in 0.01 dB units; dropped apple,speaker-mode
 (the iPad 5 drives both speaker outputs; a mono board can add it back)
 and hs-switch-gpios (only read for diagnostics, direction unknown);
 MCLK is required.]
Co-developed-by: Henrik Klee <henrik@goat-code.com>
Signed-off-by: Henrik Klee <henrik@goat-code.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/sound/cirrus,cs42l81.yaml        | 79 +++++++++++++++++++
 1 file changed, 79 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/cirrus,cs42l81.yaml

diff --git a/Documentation/devicetree/bindings/sound/cirrus,cs42l81.yaml b/Documentation/devicetree/bindings/sound/cirrus,cs42l81.yaml
new file mode 100644
index 000000000..b46bdb6db
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/cirrus,cs42l81.yaml
@@ -0,0 +1,79 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/cirrus,cs42l81.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Cirrus Logic CS42L81 audio codec
+
+maintainers:
+  - Berkay Kösebay <brkosebay@users.noreply.github.com>
+
+description: |
+  Apple-specific Cirrus Logic codec with integrated speaker drivers, a
+  headphone driver and digital microphone inputs, used in the A9 iPad 5.
+  It is controlled over SPI with a 5-byte paged register protocol.
+
+  Codec pins for the machine's routing: outputs SPKOUT and HPOUT, digital
+  microphone inputs DMIC1A and DMIC1B.
+
+allOf:
+  - $ref: dai-common.yaml#
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: cirrus,cs42l81
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: mclk
+
+  mute-gpios:
+    maxItems: 1
+    description: Speaker mute line, asserted while the speakers are muted.
+
+  cirrus,speaker-max-gain:
+    $ref: /schemas/types.yaml#/definitions/int32
+    minimum: -10200
+    maximum: 1200
+    description:
+      Maximum speaker gain the volume control allows, in 0.01 dB units.
+      Without it, the control goes up to +12 dB.
+
+  '#sound-dai-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - '#sound-dai-cells'
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    spi {
+      #address-cells = <1>;
+      #size-cells = <0>;
+
+      audio-codec@0 {
+        compatible = "cirrus,cs42l81";
+        reg = <0>;
+        spi-max-frequency = <1000000>;
+        clocks = <&mca0>;
+        clock-names = "mclk";
+        mute-gpios = <&pinctrl_ap 64 GPIO_ACTIVE_LOW>;
+        cirrus,speaker-max-gain = <(-300)>;
+        #sound-dai-cells = <0>;
+      };
+    };
