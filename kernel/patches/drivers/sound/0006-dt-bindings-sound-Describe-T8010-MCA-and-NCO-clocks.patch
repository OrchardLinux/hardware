From 16d0bc4a0dfbee297406d826199b5dcb8061f92e Mon Sep 17 00:00:00 2001
From: Dalton Alexandre <alley.nightly_0b@icloud.com>
Date: Fri, 30 Oct 2026 09:21:23 -0700
Subject: [PATCH] dt-bindings: sound: Describe T8010 MCA and NCO clocks

Describe the v5 playback path and its AP NCO input. Keep the S8000
clock-consumer contract unchanged and describe the T8010 switch syscon.

Signed-off-by: Dalton Alexandre <alley.nightly_0b@icloud.com>
---
 .../devicetree/bindings/clock/apple,nco.yaml  |  1 +
 .../devicetree/bindings/mfd/syscon.yaml       |  1 +
 .../bindings/sound/apple,s8000-mca.yaml       | 33 +++++++++++++++++--
 3 files changed, 32 insertions(+), 3 deletions(-)

diff --git a/Documentation/devicetree/bindings/clock/apple,nco.yaml b/Documentation/devicetree/bindings/clock/apple,nco.yaml
index 080454f..9a1997e 100644
--- a/Documentation/devicetree/bindings/clock/apple,nco.yaml
+++ b/Documentation/devicetree/bindings/clock/apple,nco.yaml
@@ -20,6 +20,7 @@ description: |
 properties:
   compatible:
     oneOf:
+      - const: apple,t8010-nco
       - items:
           - const: apple,t6020-nco
           - const: apple,t8103-nco
diff --git a/Documentation/devicetree/bindings/mfd/syscon.yaml b/Documentation/devicetree/bindings/mfd/syscon.yaml
index 6efc0da..f7c5623 100644
--- a/Documentation/devicetree/bindings/mfd/syscon.yaml
+++ b/Documentation/devicetree/bindings/mfd/syscon.yaml
@@ -47,6 +47,7 @@ properties:
               - apm,xgene-rb
               - apm,xgene-scu
               - apple,s8000-i2s-switch
+              - apple,t8010-i2s-switch
               - atmel,sama5d2-sfrbu
               - atmel,sama5d3-nfc-io
               - atmel,sama5d3-sfrbu
diff --git a/Documentation/devicetree/bindings/sound/apple,s8000-mca.yaml b/Documentation/devicetree/bindings/sound/apple,s8000-mca.yaml
index 1e38385..923894a 100644
--- a/Documentation/devicetree/bindings/sound/apple,s8000-mca.yaml
+++ b/Documentation/devicetree/bindings/sound/apple,s8000-mca.yaml
@@ -4,7 +4,7 @@
 $id: http://devicetree.org/schemas/sound/apple,s8000-mca.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Apple S8000 (A9) MCA I2S controller
+title: Apple S8000/T8010 MCA I2S controller
 
 maintainers:
   - Berkay Kösebay <brkosebay@users.noreply.github.com>
@@ -14,14 +14,41 @@ description: |
   window and a 32-bit MCLK control word, which the driver exports as the
   clock feeding the codec's MCLK. Its pads are connected to the outside
   through the i2s-switch, a routing block shared by all MCAs. Samples are
-  moved by SmartIO DMA.
+  moved by SmartIO DMA. T8010 uses the same register layout (version 5),
+  with an AP NCO bitclock for the playback-only digital speaker path.
 
 allOf:
   - $ref: dai-common.yaml#
+  - if:
+      properties:
+        compatible:
+          const: apple,t8010-mca
+    then:
+      properties:
+        dmas:
+          maxItems: 1
+        dma-names:
+          maxItems: 1
+      required:
+        - clocks
+        - clock-names
+    else:
+      properties:
+        clocks: false
+        clock-names: false
 
 properties:
   compatible:
-    const: apple,s8000-mca
+    enum:
+      - apple,s8000-mca
+      - apple,t8010-mca
+
+  clocks:
+    maxItems: 1
+    description: AP NCO channel supplying the T8010 bitclock
+
+  clock-names:
+    const: bitclk
 
   reg:
     items:
-- 
2.56.0

