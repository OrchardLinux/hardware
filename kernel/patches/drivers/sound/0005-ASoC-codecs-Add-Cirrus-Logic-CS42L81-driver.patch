+static int cs42l81_check_id(struct cs42l81 *cs)
+{
+	unsigned int id[3] = {}, i;
+	int ret = 0;
+
+	/* MCLK is not known to be needed for the control port; keep it on */
+	ret = clk_prepare_enable(cs->mclk);
+	if (ret)
+		return dev_err_probe(cs->dev, ret, "failed to enable MCLK\n");
+
+	for (i = 0; i < ARRAY_SIZE(id); i++) {
+		ret = regmap_read(cs->regmap, CS42L81_DEVID_AB + i, &id[i]);
+		if (ret)
+			break;
+	}
+	clk_disable_unprepare(cs->mclk);
+
+	if (ret)
+		return dev_err_probe(cs->dev, ret, "failed to read the ID\n");
+
+	if (id[0] != 0x42 || id[1] != 0xa8 || (id[2] & 0xf0) != 0x10)
+		return dev_err_probe(cs->dev, -ENODEV,
+				     "unexpected ID %02x %02x %02x\n",
+				     id[0], id[1], id[2]);
+	return 0;
+}
+
+static int cs42l81_spi_probe(struct spi_device *spi)
+{
+	struct device *dev = &spi->dev;
+	struct cs42l81 *cs;
+	s32 max_gain;
+	int ret;
+
+	cs = devm_kzalloc(dev, sizeof(*cs), GFP_KERNEL);
+	if (!cs)
+		return -ENOMEM;
+
+	cs->dev = dev;
+	cs->spi = spi;
+	cs->xfer_buf = devm_kzalloc(dev, 2 * CS42L81_SPI_LEN, GFP_KERNEL);
+	if (!cs->xfer_buf)
+		return -ENOMEM;
+	spi_set_drvdata(spi, cs);
+
+	cs->regmap = devm_regmap_init(dev, &cs42l81_bus, cs, &cs42l81_regmap);
+	if (IS_ERR(cs->regmap))
+		return dev_err_probe(dev, PTR_ERR(cs->regmap),
+				     "failed to init regmap\n");
+
+	cs->mclk = devm_clk_get(dev, "mclk");
+	if (IS_ERR(cs->mclk))
+		return dev_err_probe(dev, PTR_ERR(cs->mclk),
+				     "failed to get MCLK\n");
+
+	/* logical 1 = muted */
+	cs->mute_gpio = devm_gpiod_get_optional(dev, "mute", GPIOD_OUT_HIGH);
+	if (IS_ERR(cs->mute_gpio))
+		return dev_err_probe(dev, PTR_ERR(cs->mute_gpio),
+				     "failed to get mute GPIO\n");
+
+	/*
+	 * Maximum speaker gain in 0.01 dB (the ADT's spkr-gain-db, -3.0 dB
+	 * on the iPad 5): the volume control stops there.
+	 */
+	cs->spk_vol_max = CS42L81_SPK_VOL_MAX;
+	if (!device_property_read_u32(dev, "cirrus,speaker-max-gain",
+				      (u32 *)&max_gain))
+		cs->spk_vol_max = clamp(CS42L81_SPK_VOL_0DB + max_gain / 50, 0,
+					CS42L81_SPK_VOL_MAX);
+	cs->spk_vol = min_t(unsigned int, CS42L81_SPK_VOL_DEFAULT,
+			    cs->spk_vol_max);
+	cs->spk_switch = true;
+	cs->rate_code = 0xc;	/* 48 kHz */
+	cs->slot_bytes = 2;
+	cs->hp_vol = CS42L81_HP_VOL_DEFAULT;
+	cs->hp_switch = 1;
+	cs->adc_vol = CS42L81_ADC_VOL_0DB;
+	cs->adc_switch = 1;
+
+	ret = cs42l81_check_id(cs);
+	if (ret)
+		return ret;
+
+	return devm_snd_soc_register_component(dev, &cs42l81_component,
+					       &cs42l81_dai, 1);
+}
