+/* --- vb2 / m2m / media ops --------------------------------------------- */
+
+static int apple_vxd_queue_setup(struct vb2_queue *vq, unsigned int *num_buffers,
+				 unsigned int *num_planes, unsigned int sizes[],
+				 struct device *alloc_devs[])
+{
+	struct apple_vxd_ctx *ctx = vb2_get_drv_priv(vq);
+	struct v4l2_format *f;
+	unsigned int i;
+
+	f = V4L2_TYPE_IS_OUTPUT(vq->type) ? &ctx->coded_fmt : &ctx->decoded_fmt;
+
+	if (*num_planes) {
+		if (*num_planes != f->fmt.pix_mp.num_planes)
+			return -EINVAL;
+
+		for (i = 0; i < f->fmt.pix_mp.num_planes; i++) {
+			if (sizes[i] < f->fmt.pix_mp.plane_fmt[i].sizeimage)
+				return -EINVAL;
+		}
+	} else {
+		*num_planes = f->fmt.pix_mp.num_planes;
+		for (i = 0; i < f->fmt.pix_mp.num_planes; i++)
+			sizes[i] = f->fmt.pix_mp.plane_fmt[i].sizeimage;
+	}
+
+	return 0;
+}
+
+static int apple_vxd_buf_prepare(struct vb2_buffer *vb)
+{
+	struct apple_vxd_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+	struct v4l2_format *f;
+	unsigned int i;
+
+	f = V4L2_TYPE_IS_OUTPUT(vb->vb2_queue->type) ? &ctx->coded_fmt :
+		&ctx->decoded_fmt;
+
+	for (i = 0; i < f->fmt.pix_mp.num_planes; ++i) {
+		u32 sizeimage = f->fmt.pix_mp.plane_fmt[i].sizeimage;
+
+		if (vb2_plane_size(vb, i) < sizeimage)
+			return -EINVAL;
+	}
+
+	/*
+	 * Buffer's bytesused must be written by driver for CAPTURE buffers.
+	 * (for OUTPUT buffers, if userspace passes 0 bytesused, v4l2-core
+	 * sets it to buffer length).
+	 */
+	if (V4L2_TYPE_IS_CAPTURE(vb->vb2_queue->type))
+		vb2_set_plane_payload(vb, 0,
+				      f->fmt.pix_mp.plane_fmt[0].sizeimage);
+
+	return 0;
+}
+
+static struct apple_vxd_buffer *vxd_buf(struct vb2_v4l2_buffer *vbuf)
+{
+	return container_of(vbuf, struct apple_vxd_buffer, base.vb);
+}
+
+/*
+ * Every buffer gets a GART mapping for its whole life.  The command
+ * stream names the bitstream by device address (the 0xa load command,
+ * ds-vxd-cmdstream.md section 3.3) and the render target / DPB surfaces
+ * the same way (section 6).  The mapping is the identity window
+ * (low 32 bits of the DMA address), 4 KiB granular; vb2
+ * dma-contig buffers are physically contiguous here (no IOMMU on this
+ * node) and start page aligned.  Only page-table memory is written: no
+ * register access, so this is safe with the firmware down.
+ */
+static int apple_vxd_buf_init(struct vb2_buffer *vb)
+{
+	struct apple_vxd_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+	struct apple_vxd_buffer *buf = vxd_buf(to_vb2_v4l2_buffer(vb));
+	dma_addr_t dma = vb2_dma_contig_plane_dma_addr(vb, 0);
+	dma_addr_t start = ALIGN_DOWN(dma, VXD_GART_PAGE_SIZE);
+	size_t len = vb2_plane_size(vb, 0);
+	int ret;
+
+	ret = apple_vxd_gart_map(ctx->vxd, start,
+				 ALIGN(dma + len, VXD_GART_PAGE_SIZE) - start,
+				 &buf->map);
+	if (ret) {
+		dev_err(ctx->vxd->dev,
+			"%s buffer %u: GART map of %pad (+%zu) failed: %d\n",
+			V4L2_TYPE_IS_OUTPUT(vb->type) ? "output" : "capture",
+			vb->index, &dma, len, ret);
+		return ret;
+	}
+	buf->va = buf->map.va + (u32)(dma - start);
+
+	if (V4L2_TYPE_IS_CAPTURE(vb->type) &&
+	    ctx->coded_fmt_desc->ops->capture_aux_size) {
+		size_t aux = ctx->coded_fmt_desc->ops->capture_aux_size(ctx);
+
+		if (aux) {
+			ret = apple_vxd_dev_buf_alloc(ctx->vxd, aux, &buf->aux);
+			if (ret) {
+				dev_err(ctx->vxd->dev,
+					"capture buffer %u: %zu-byte side buffer: %d\n",
+					vb->index, aux, ret);
+				apple_vxd_gart_unmap(ctx->vxd, &buf->map);
+				buf->va = 0;
+				return ret;
+			}
+		}
+	}
+	return 0;
+}
+
+static void apple_vxd_buf_cleanup(struct vb2_buffer *vb)
+{
+	struct apple_vxd_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+	struct apple_vxd_buffer *buf = vxd_buf(to_vb2_v4l2_buffer(vb));
+
+	apple_vxd_dev_buf_free(ctx->vxd, &buf->aux);
+	apple_vxd_gart_unmap(ctx->vxd, &buf->map);
+	buf->va = 0;
+}
+
+/* Device VA of plane 0 of a queued buffer (valid between buf_init and cleanup). */
+u32 apple_vxd_buf_va(struct vb2_v4l2_buffer *vbuf)
+{
+	return vxd_buf(vbuf)->va;
+}
+
+/* Device VA of a CAPTURE buffer's side buffer, 0 if it has none. */
+u32 apple_vxd_buf_aux_va(struct vb2_v4l2_buffer *vbuf)
+{
+	return vxd_buf(vbuf)->aux.va;
+}
+
+static void apple_vxd_buf_queue(struct vb2_buffer *vb)
+{
+	struct apple_vxd_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+
+	v4l2_m2m_buf_queue(ctx->fh.m2m_ctx, vbuf);
+}
+
+static int apple_vxd_buf_out_validate(struct vb2_buffer *vb)
+{
+	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+
+	vbuf->field = V4L2_FIELD_NONE;
+	return 0;
+}
+
+static void apple_vxd_buf_request_complete(struct vb2_buffer *vb)
+{
+	struct apple_vxd_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+
+	v4l2_ctrl_request_complete(vb->req_obj.req, &ctx->ctrl_hdl);
+}
+
+static int apple_vxd_start_streaming(struct vb2_queue *q, unsigned int count)
+{
+	struct apple_vxd_ctx *ctx = vb2_get_drv_priv(q);
+	int ret;
+
+	if (V4L2_TYPE_IS_CAPTURE(q->type))
+		return 0;
+
+	if (!ctx->coded_fmt_desc->ops->start)
+		return 0;
+
+	ret = ctx->coded_fmt_desc->ops->start(ctx);
+	if (ret) {
+		dev_err(ctx->vxd->dev,
+			"failed to start decode context: %d\n", ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void apple_vxd_queue_cleanup(struct vb2_queue *vq, u32 state)
+{
+	struct apple_vxd_ctx *ctx = vb2_get_drv_priv(vq);
+
+	while (true) {
+		struct vb2_v4l2_buffer *vbuf;
+
+		if (V4L2_TYPE_IS_OUTPUT(vq->type))
+			vbuf = v4l2_m2m_src_buf_remove(ctx->fh.m2m_ctx);
+		else
+			vbuf = v4l2_m2m_dst_buf_remove(ctx->fh.m2m_ctx);
+
+		if (!vbuf)
+			break;
+
+		v4l2_ctrl_request_complete(vbuf->vb2_buf.req_obj.req,
+					   &ctx->ctrl_hdl);
+		v4l2_m2m_buf_done(vbuf, state);
+	}
+}
+
+static void apple_vxd_stop_streaming(struct vb2_queue *q)
+{
+	struct apple_vxd_ctx *ctx = vb2_get_drv_priv(q);
+
+	if (V4L2_TYPE_IS_OUTPUT(q->type) && ctx->coded_fmt_desc->ops->stop)
+		ctx->coded_fmt_desc->ops->stop(ctx);
+
+	apple_vxd_queue_cleanup(q, VB2_BUF_STATE_ERROR);
+}
+
+static const struct vb2_ops apple_vxd_queue_ops = {
+	.queue_setup = apple_vxd_queue_setup,
+	.buf_init = apple_vxd_buf_init,
+	.buf_cleanup = apple_vxd_buf_cleanup,
+	.buf_prepare = apple_vxd_buf_prepare,
+	.buf_queue = apple_vxd_buf_queue,
+	.buf_out_validate = apple_vxd_buf_out_validate,
+	.buf_request_complete = apple_vxd_buf_request_complete,
+	.start_streaming = apple_vxd_start_streaming,
+	.stop_streaming = apple_vxd_stop_streaming,
+};
+
+/* The media node's only driver hooks are the request ops. */
+static int apple_vxd_request_validate(struct media_request *req)
+{
+	unsigned int count;
+
+	count = vb2_request_buffer_cnt(req);
+	if (!count)
+		return -ENOENT;
+	else if (count > 1)
+		return -EINVAL;
+
+	return vb2_request_validate(req);
+}
+
+static const struct media_device_ops apple_vxd_media_ops = {
+	.req_validate = apple_vxd_request_validate,
+	.req_queue = v4l2_m2m_request_queue,
+};
+
+static void apple_vxd_device_run(void *priv)
+{
+	struct apple_vxd_ctx *ctx = priv;
+	struct apple_vxd_dev *vxd = ctx->vxd;
+	const struct apple_vxd_coded_fmt_desc *desc = ctx->coded_fmt_desc;
+	int ret;
+
+	if (WARN_ON(!desc))
+		return;
+
+	ret = pm_runtime_resume_and_get(vxd->dev);
+	if (ret < 0) {
+		apple_vxd_job_finish_no_pm(ctx, VB2_BUF_STATE_ERROR);
+		return;
+	}
+
+	ret = desc->ops->run(ctx);
+	if (ret)
+		apple_vxd_job_finish(ctx, VB2_BUF_STATE_ERROR);
+}
+
+static const struct v4l2_m2m_ops apple_vxd_m2m_ops = {
+	.device_run = apple_vxd_device_run,
+};
+
+static int apple_vxd_queue_init(void *priv, struct vb2_queue *src_vq,
+				struct vb2_queue *dst_vq)
+{
+	struct apple_vxd_ctx *ctx = priv;
+	struct apple_vxd_dev *vxd = ctx->vxd;
+	int ret;
+
+	src_vq->type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+	src_vq->io_modes = VB2_MMAP | VB2_DMABUF;
+	src_vq->drv_priv = ctx;
+	src_vq->ops = &apple_vxd_queue_ops;
+	src_vq->mem_ops = &vb2_dma_contig_memops;
+	/*
+	 * Frame-based decode: the driver walks the access unit and parses
+	 * the slice headers itself, so the bitstream needs a kernel mapping.
+	 */
+	src_vq->dma_attrs = DMA_ATTR_ALLOC_SINGLE_PAGES;
+	src_vq->buf_struct_size = sizeof(struct apple_vxd_buffer);
+	src_vq->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	src_vq->lock = &vxd->vdev_lock;
+	src_vq->dev = vxd->v4l2_dev.dev;
+	src_vq->supports_requests = true;
+	src_vq->requires_requests = true;
+
+	ret = vb2_queue_init(src_vq);
+	if (ret)
+		return ret;
+
+	dst_vq->bidirectional = true;
+	dst_vq->mem_ops = &vb2_dma_contig_memops;
+	/*
+	 * The VXD is not DMA-coherent, so coherent buffers are uncached for
+	 * the CPU. Applications that read decoded pictures on the CPU can
+	 * ask for cacheable buffers with V4L2_MEMORY_FLAG_NON_COHERENT; vb2
+	 * then cleans them at QBUF and invalidates them at DQBUF.
+	 * dma_alloc_noncontiguous() takes no other attribute, so the
+	 * coherent path keeps a kernel mapping as well.
+	 */
+	dst_vq->dma_attrs = DMA_ATTR_ALLOC_SINGLE_PAGES;
+	dst_vq->allow_cache_hints = 1;
+	dst_vq->type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+	dst_vq->io_modes = VB2_MMAP | VB2_DMABUF;
+	dst_vq->drv_priv = ctx;
+	dst_vq->ops = &apple_vxd_queue_ops;
+	dst_vq->buf_struct_size = sizeof(struct apple_vxd_buffer);
+	dst_vq->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	dst_vq->lock = &vxd->vdev_lock;
+	dst_vq->dev = vxd->v4l2_dev.dev;
+
+	return vb2_queue_init(dst_vq);
+}
+
+/* --- open / release ---------------------------------------------------- */
+
+/*
+ * The driver half of open(): everything except the v4l2_fh bookkeeping.
+ * Order matters: the control handler setup runs s_ctrl, which inspects
+ * the m2m queues, so the m2m context comes first.
+ */
+static int apple_vxd_ctx_init(struct apple_vxd_ctx *ctx)
+{
+	struct apple_vxd_dev *vxd = ctx->vxd;
+	int ret;
+
+	apple_vxd_reset_coded_fmt(ctx);
+	apple_vxd_reset_decoded_fmt(ctx);
+
+	ctx->fh.m2m_ctx = v4l2_m2m_ctx_init(vxd->m2m_dev, ctx,
+					    apple_vxd_queue_init);
+	if (IS_ERR(ctx->fh.m2m_ctx)) {
+		ret = PTR_ERR(ctx->fh.m2m_ctx);
+		ctx->fh.m2m_ctx = NULL;
+		return ret;
+	}
+
+	ret = apple_vxd_init_ctrls(ctx);
+	if (ret) {
+		v4l2_m2m_ctx_release(ctx->fh.m2m_ctx);
+		ctx->fh.m2m_ctx = NULL;
+		return ret;
+	}
+
+	return 0;
+}
+
+/* The driver half of release(). */
+static void apple_vxd_ctx_fini(struct apple_vxd_ctx *ctx)
+{
+	v4l2_m2m_ctx_release(ctx->fh.m2m_ctx);
+	v4l2_ctrl_handler_free(&ctx->ctrl_hdl);
+}
+
+static int apple_vxd_open(struct file *filp)
+{
+	struct video_device *vdev = video_devdata(filp);
+	struct apple_vxd_dev *vxd = video_drvdata(filp);
+	struct apple_vxd_ctx *ctx;
+	int ret;
+
+	/*
+	 * The DEVA firmware boots on the first open, when the firmware file
+	 * can be read, and keeps running (and the block powered) until the
+	 * driver is unbound. Later opens find it running.
+	 */
+	ret = apple_vxd_boot_firmware(vxd);
+	if (ret)
+		return ret;
+
+	ctx = kzalloc_obj(*ctx);
+	if (!ctx)
+		return -ENOMEM;
+
+	ctx->vxd = vxd;
+	v4l2_fh_init(&ctx->fh, vdev);
+
+	ret = apple_vxd_ctx_init(ctx);
+	if (ret) {
+		v4l2_fh_exit(&ctx->fh);
+		kfree(ctx);
+		return ret;
+	}
+
+	v4l2_fh_add(&ctx->fh, filp);
+	return 0;
+}
+
+static int apple_vxd_release(struct file *filp)
+{
+	struct apple_vxd_ctx *ctx = file_to_vxd_ctx(filp);
+
+	v4l2_fh_del(&ctx->fh, filp);
+	apple_vxd_ctx_fini(ctx);
+	v4l2_fh_exit(&ctx->fh);
+	kfree(ctx);
+
+	return 0;
+}
+
+static const struct v4l2_file_operations apple_vxd_fops = {
+	.owner = THIS_MODULE,
+	.open = apple_vxd_open,
+	.release = apple_vxd_release,
+	.poll = v4l2_m2m_fop_poll,
+	.unlocked_ioctl = video_ioctl2,
+	.mmap = v4l2_m2m_fop_mmap,
+};
+
+/* --- registration ------------------------------------------------------ */
+
+int apple_vxd_v4l2_init(struct apple_vxd_dev *vxd)
+{
+	int ret;
+
+	if (!vxd->coded_fmts || !vxd->num_coded_fmts) {
+		dev_err(vxd->dev, "v4l2: no coded formats registered, not exposing a node\n");
+		return -ENODEV;
+	}
+
+	ret = v4l2_device_register(vxd->dev, &vxd->v4l2_dev);
+	if (ret) {
+		dev_err(vxd->dev, "failed to register v4l2 device\n");
+		return ret;
+	}
+
+	vxd->m2m_dev = v4l2_m2m_init(&apple_vxd_m2m_ops);
+	if (IS_ERR(vxd->m2m_dev)) {
+		ret = PTR_ERR(vxd->m2m_dev);
+		vxd->m2m_dev = NULL;
+		v4l2_err(&vxd->v4l2_dev, "failed to init mem2mem device\n");
+		goto err_unregister_v4l2;
+	}
+
+	vxd->vdev.lock = &vxd->vdev_lock;
+	vxd->vdev.v4l2_dev = &vxd->v4l2_dev;
+	vxd->vdev.fops = &apple_vxd_fops;
+	vxd->vdev.release = video_device_release_empty;
+	vxd->vdev.vfl_dir = VFL_DIR_M2M;
+	vxd->vdev.device_caps = V4L2_CAP_STREAMING |
+				V4L2_CAP_VIDEO_M2M_MPLANE;
+	vxd->vdev.ioctl_ops = &apple_vxd_ioctl_ops;
+	video_set_drvdata(&vxd->vdev, vxd);
+	strscpy(vxd->vdev.name, APPLE_VXD_DRV_NAME, sizeof(vxd->vdev.name));
+
+	/* bus_info stays empty: media_device_init() derives it from mdev.dev. */
+	vxd->mdev.dev = vxd->dev;
+	strscpy(vxd->mdev.model, APPLE_VXD_DRV_NAME, sizeof(vxd->mdev.model));
+	media_device_init(&vxd->mdev);
+	vxd->mdev.ops = &apple_vxd_media_ops;
+	vxd->v4l2_dev.mdev = &vxd->mdev;
+
+	ret = video_register_device(&vxd->vdev, VFL_TYPE_VIDEO, -1);
+	if (ret) {
+		v4l2_err(&vxd->v4l2_dev, "failed to register video device\n");
+		goto err_cleanup_mc;
+	}
+
+	ret = v4l2_m2m_register_media_controller(vxd->m2m_dev, &vxd->vdev,
+						 MEDIA_ENT_F_PROC_VIDEO_DECODER);
+	if (ret) {
+		v4l2_err(&vxd->v4l2_dev,
+			 "failed to initialize v4l2 m2m media controller\n");
+		goto err_unregister_vdev;
+	}
+
+	ret = media_device_register(&vxd->mdev);
+	if (ret) {
+		v4l2_err(&vxd->v4l2_dev, "failed to register media device\n");
+		goto err_unregister_mc;
+	}
+	return 0;
+
+err_unregister_mc:
+	v4l2_m2m_unregister_media_controller(vxd->m2m_dev);
+err_unregister_vdev:
+	video_unregister_device(&vxd->vdev);
+err_cleanup_mc:
+	vxd->v4l2_dev.mdev = NULL;
+	media_device_cleanup(&vxd->mdev);
+	v4l2_m2m_release(vxd->m2m_dev);
+	vxd->m2m_dev = NULL;
+err_unregister_v4l2:
+	v4l2_device_unregister(&vxd->v4l2_dev);
+	return ret;
+}
+
+void apple_vxd_v4l2_cleanup(struct apple_vxd_dev *vxd)
+{
+	media_device_unregister(&vxd->mdev);
+	v4l2_m2m_unregister_media_controller(vxd->m2m_dev);
+	video_unregister_device(&vxd->vdev);
+	media_device_cleanup(&vxd->mdev);
+	v4l2_m2m_release(vxd->m2m_dev);
+	vxd->m2m_dev = NULL;
+	v4l2_device_unregister(&vxd->v4l2_dev);
+}
diff --git a/drivers/media/platform/apple/vxd/apple-vxd.h b/drivers/media/platform/apple/vxd/apple-vxd.h
new file mode 100644
index 000000000..03de522d8
--- /dev/null
+++ b/drivers/media/platform/apple/vxd/apple-vxd.h
@@ -0,0 +1,491 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Apple VXD (Imagination MSVDX) video decoder driver
+ *
+ * Driver for the S8000/S8003 "VXD" block: PowerVR MSVDX with the resident
+ * DEVA (MTX) firmware, following the iOS 16.7.10 AppleD5500 kext:
+ *
+ *   - core identity and the core's own GART (apple-vxd-core.c, -gart.c)
+ *   - DEVA firmware boot on the MTX (apple-vxd-fw.c)
+ *   - host<->firmware mailbox: ring geometry, 0x80 init message, push,
+ *     IRQ drain, fences (apple-vxd-mbox.c)
+ *   - command buffers and their encoders (apple-vxd-cmdbuf.c, -cmd.c)
+ *   - the V4L2 stateless H.264 decoder (apple-vxd-v4l2.c, -h264*.c)
+ *
+ * [E] marks facts taken from the kext.
+ */
+#ifndef __APPLE_VXD_H__
+#define __APPLE_VXD_H__
+
+#include <linux/bitfield.h>
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+#include <linux/sizes.h>
+#include <linux/spinlock.h>
+#include <linux/types.h>
+#include <linux/workqueue.h>
+
+#include <media/media-device.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-mem2mem.h>
+#include <media/videobuf2-core.h>
+#include <media/videobuf2-v4l2.h>
+
+#include "apple-vxd-cmd.h"
+#include "apple-vxd-regs.h"
+
+#define APPLE_VXD_DRV_NAME		"apple-vxd"
+#define APPLE_VXD_FW_NAME		"apple/vxd-deva.bin"
+#define APPLE_VXD_FW_MAX_WORDS		0x10000
+
+/*
+ * DT advertises h264-playback-level = 42: H.264 level 4.2, 1920x1088 [E].
+ * Tile decode exists (H264DecoderSupportsTileDecode = true) and could lift
+ * the pixel bound, but that path is not explored yet.
+ */
+#define APPLE_VXD_MIN_PIC_W		16
+#define APPLE_VXD_MIN_PIC_H		16
+#define APPLE_VXD_MAX_PIC_W		1920
+#define APPLE_VXD_MAX_PIC_H		1088
+
+/* Output image formats.  P010/NV16 follow once HEVC/4:2:2 are proven. */
+enum apple_vxd_image_fmt {
+	APPLE_VXD_IMG_FMT_ANY = 0,
+	APPLE_VXD_IMG_FMT_420_8BIT,
+};
+
+/* SoC variant data (compatible table). */
+struct apple_vxd_variant {
+	unsigned int vxd_version;	/* ADT "vxd-version" */
+	u32 num_gart_pts;		/* mapped page tables (512 = 2 GiB) */
+	bool hevc_supported;
+};
+
+/*
+ * The core's own two-level "GART" (there is no DART on this node): a 1024
+ * entry directory of 4 KiB page tables covering 4 GiB of device address
+ * space, entries beyond the mapped page tables pointing at a dummy page.
+ *
+ * GART pages are always 4 KiB, whatever the kernel page size (the device
+ * kernel runs 16 KiB pages).  Entries are ((PA >> 8) & 0xfffffff0) | 1,
+ * computed on the full 40-bit physical address exactly as
+ * AppleD5500::initialize_gart does [E]: DRAM sits at 0x8_0000_0000 here,
+ * so truncating to 32 bits first would point every entry below DRAM.
+ *
+ * The directory is 64 KiB aligned: Apple allocates it that way
+ * (withOptions(0x403, 0x1000, alignment 0x10000)) because the decode
+ * message carries (MMU_DIR_ADR value & ~0xff) | hwContextID in one word
+ * (SubmitCommandBufferInternal, ds-vxd-decode-protocol.md correction).
+ *
+ * We identity-map the low 32 bits of every DMA address, so device address
+ * == dma_addr & 0xffffffff for the whole 2 GiB of DRAM on this device, and
+ * the mapped page tables (indices 0..num_gart_pts) cover it.
+ */
+#define VXD_GART_PAGE_SHIFT		12
+#define VXD_GART_PAGE_SIZE		BIT(VXD_GART_PAGE_SHIFT)
+#define VXD_GART_DIR_ENTRIES		1024
+#define VXD_GART_PT_ENTRIES		1024
+#define VXD_GART_PT_SIZE		(VXD_GART_PT_ENTRIES * sizeof(u32))
+#define VXD_GART_DIR_ALIGN		SZ_64K
+#define VXD_GART_PA_BITS		40
+#define VXD_GART_PTE_VALID		BIT(0)
+#define VXD_GART_PTE(phys)		(((u32)((u64)(phys) >> 8) & 0xfffffff0) | \
+					 VXD_GART_PTE_VALID)
+
+struct apple_vxd_mapping {
+	struct list_head list;
+	dma_addr_t dma;
+	size_t size;
+	u32 va;				/* device address, == low 32 of dma */
+};
+
+/*
+ * A coherent DMA buffer whose bus address is aligned beyond PAGE_SIZE.
+ * dma_alloc_coherent() makes no alignment promise past the page, so the
+ * buffer is over-allocated when the first try is misaligned.
+ */
+struct apple_vxd_dma_buf {
+	void *vaddr;			/* aligned CPU address */
+	dma_addr_t dma;			/* aligned bus address */
+	size_t size;			/* usable bytes from vaddr */
+	void *raw_vaddr;		/* what dma_free_coherent() needs */
+	dma_addr_t raw_dma;
+	size_t raw_size;
+};
+
+/* A zeroed, GART-mapped buffer the core reads or writes (decode context). */
+struct apple_vxd_dev_buf {
+	struct apple_vxd_dma_buf mem;
+	struct apple_vxd_mapping map;
+	u32 va;				/* device address of mem.vaddr */
+};
+
+struct apple_vxd_gart {
+	struct mutex lock;		/* serializes table updates */
+	struct apple_vxd_dma_buf dir_buf; /* directory, 64 KiB aligned */
+	u32 *dir;			/* directory table, VXD_GART_DIR_ENTRIES */
+	dma_addr_t dir_dma;
+	u32 *dummy;			/* unmapped VAs resolve here */
+	dma_addr_t dummy_dma;
+	u32 *pts;			/* num_gart_pts consecutive 4 KiB tables */
+	dma_addr_t pts_dma;
+	u32 num_pts;
+	struct list_head mappings;	/* every live apple_vxd_mapping */
+	/*
+	 * Set by every map/unmap.  Apple rewrites 0x1008 = 0xf00 before the
+	 * next decode submit when its GART changed (AppleD5500+0x27a0 [E]);
+	 * the decode submit path consumes and clears it.
+	 */
+	bool dirty;
+};
+
+/*
+ * One message ring as published by the firmware after the ready magic:
+ * word i lives at VXD_RING_WINDOW + base + 4 * i.  Read once per boot,
+ * validated against the MMIO window, never trusted beyond it.
+ */
+struct apple_vxd_ring {
+	u32 base;			/* byte offset from VXD_RING_WINDOW */
+	u32 cap;			/* capacity in words */
+};
+
+/* Where a pushed message sits in TO_MTX, for the consumption check. */
+struct apple_vxd_msg_ticket {
+	u32 start;			/* write index before the push */
+	u32 nwords;
+	u32 end;			/* write index after the push */
+};
+
+/*
+ * Fence tracking.  The fence is the 16-bit tag in w0[31:16] of every
+ * message; the firmware echoes it in the 0xc0 completion.  Apple builds it
+ * as (submission << 4) | (packet * 2 & 0xe) | core (0xfffffff00628a8d4
+ * [E]), and routes completions to core (fence & 1).  A slot is armed
+ * before the push and signalled from the IRQ drain.
+ */
+#define APPLE_VXD_NUM_FENCES		16
+
+enum apple_vxd_fence_state {
+	APPLE_VXD_FENCE_FREE = 0,
+	APPLE_VXD_FENCE_ARMED,		/* message pushed, completion pending */
+	APPLE_VXD_FENCE_SIGNALLED,	/* 0xc0 seen (or failed by panic/teardown) */
+};
+
+struct apple_vxd_fence {
+	enum apple_vxd_fence_state state;
+	u16 id;				/* w0[31:16] */
+	u8 type;			/* message type it tagged */
+	bool error;			/* fault bits, panic or teardown */
+	u32 status;			/* 0xc0 word 2 */
+	struct apple_vxd_cmdbuf *cmdbuf; /* freed by a clean completion */
+	bool job;			/* last packet of a decode job */
+	struct completion done;
+};
+
+/*
+ * Command buffers.  Apple allocates eight 0x40000-byte register
+ * programs and eight 0x10000-byte packet lists per H.264 decoder
+ * (DecodeCreateH264VLD 0xfffffff0062c3d98, ds-vxd-cmdstream.md section
+ * 16.5 [E]); a B slice with weight tables takes about 1.5 KiB, so 256 KiB
+ * holds APPLE_VXD_JOB_MAX_PACKETS of the largest.  Each one is two things:
+ *
+ *   - the device-visible register program, GART-mapped, filled with the
+ *     ds-vxd-cmdstream.md command words one 64-byte-aligned chunk per
+ *     slice, and read by the core's command processor;
+ *   - a host-only packet list (one {0x80000007, 0x78, 0xabcdefab} +
+ *     payload per slice) that the submit path turns into one mailbox
+ *     message each and never hands to the device.
+ *
+ * Ownership: FREE (pool) -> HOST (CPU writes it) -> DEVICE (submitted,
+ * bound to the fence of its last message) -> FREE when that fence
+ * completes.  A buffer whose fence was failed by a panic or a teardown
+ * stays DEVICE: the core may still be reading it, so only
+ * apple_vxd_cmdbufs_reclaim() after the firmware is stopped frees it.
+ */
+#define APPLE_VXD_NUM_CMDBUFS		8
+#define APPLE_VXD_CMDBUF_SIZE		SZ_256K
+#define APPLE_VXD_CMDBUF_ALIGN		SZ_64K
+#define APPLE_VXD_PKTLIST_SIZE		SZ_32K	/* 128 x (12 + 0x78) bytes */
+
+struct apple_vxd_cmdbuf_pool {
+	struct apple_vxd_dma_buf mem;		/* NUM x SIZE, 64 KiB aligned */
+	struct apple_vxd_mapping map;
+	u8 *pkt_mem;
+	struct apple_vxd_cmdbuf bufs[APPLE_VXD_NUM_CMDBUFS];
+	bool ready;
+};
+
+/*
+ * V4L2 buffer with its GART mapping: the 0xa load command takes the
+ * bitstream by device address, and the render target / DPB registers take
+ * the capture surfaces the same way (ds-vxd-cmdstream.md sections 3.3, 6).
+ */
+struct apple_vxd_buffer {
+	struct v4l2_m2m_buffer base;
+	struct apple_vxd_mapping map;
+	u32 va;				/* device VA of plane 0's first byte */
+	/*
+	 * CAPTURE only: the per-picture side buffer the core keeps with the
+	 * reconstructed surface (H.264: stored macroblock parameters, BE
+	 * register 0x62ec), allocated with the buffer.
+	 */
+	struct apple_vxd_dev_buf aux;
+};
+
+/*
+ * Active decode job.  Submission is one picture: one stateless request, one
+ * bitstream buffer, one capture surface.  Completion arrives from the
+ * firmware through the TO_HOST ring as a 0xc0 message.
+ */
+struct apple_vxd_run {
+	struct vb2_v4l2_buffer *src;
+	struct vb2_v4l2_buffer *dst;
+};
+
+/*
+ * One submission in flight: one picture, one command buffer, one message
+ * per packet.  Every message carries a fence of the same submission,
+ * (seq << 4) | (packet * 2 & 0xe) as Apple computes it, so the tags repeat
+ * after eight packets.  Up to eight packets every fence is armed and a
+ * 0xc0 for any of them is recognised (on the device only the 0x4004
+ * message answers); past eight only the last packet's is, since
+ * the firmware never answers a 0x2000 message.  The job completes on the
+ * last packet's fence or on the watchdog.
+ */
+#define APPLE_VXD_JOB_MAX_FENCES	8
+#define APPLE_VXD_JOB_MAX_PACKETS	128
+#define APPLE_VXD_JOB_TIMEOUT_MS	1000
+
+struct apple_vxd_job {
+	struct apple_vxd_ctx *ctx;
+	struct apple_vxd_fence *fences[APPLE_VXD_JOB_MAX_FENCES];
+	unsigned int nfences;		/* armed; the last one is the job's */
+	unsigned int npackets;
+	u16 seq;
+	ktime_t submitted;
+};
+
+struct apple_vxd_dev {
+	struct device *dev;
+	const struct apple_vxd_variant *variant;
+
+	void __iomem *regs;
+	resource_size_t regs_size;	/* bounds every ring access */
+	int irq;
+
+	/* Core state. */
+	struct mutex power_lock;	/* boot vs. runtime suspend */
+	bool hw_ready;			/* firmware took its init message */
+	u32 core_id;
+	u32 core_rev;
+	u32 num_entropy_pipes;
+	u32 num_pixel_pipes;
+	u32 mtx_mem_size;		/* KiB, from MTX_MEM_CFG */
+	bool mmu_40bit;
+	bool mmu_tiling_ctx;
+	u32 pipe_status;		/* raw 0x40c0 after power-up */
+	u32 pipe_status_cfg;		/* OR of per-pipe 0x40c0 (core discovery) */
+	u32 pipe_status_2_max;		/* max per-pipe 0x40c4 & 3 */
+	u32 cfg_flags;			/* InitializeCoreConfig core[0x54] */
+
+	/* Firmware buffer and boot results. */
+	bool fw_loaded;			/* MTX up: ready magic seen */
+	void *fw_vaddr;
+	dma_addr_t fw_dma;
+	size_t fw_size;			/* PAGE_ALIGNed allocation */
+	size_t fw_blob_size;		/* image bytes (init message pages) */
+	u32 fw_dev_va;
+	struct apple_vxd_mapping fw_map;	/* GART mapping of fw_dev_va */
+
+	struct apple_vxd_gart gart;
+
+	/*
+	 * Host<->MTX mailbox.  mbox_lock covers ring MMIO in both
+	 * directions and the fence table; it is taken from the
+	 * hard IRQ handler.  mbox_ready/hw_ready/irq_armed change only under
+	 * power_lock.
+	 */
+	spinlock_t mbox_lock;
+	struct apple_vxd_ring to_mtx;
+	struct apple_vxd_ring to_host;
+	bool mbox_ready;		/* geometry read and valid */
+	bool irq_armed;			/* IRQ line enabled */
+	bool irq_storm;			/* disabled by the storm guard */
+	u32 irq_empty;			/* consecutive IRQs with nothing to drain */
+	bool fw_panicked;		/* 0xc7 seen since boot */
+	u16 init_seq;			/* InitMessageBuffers core[0x70] */
+	u16 fence_seq;			/* submission counter, fence[15:4] */
+	struct apple_vxd_fence fences[APPLE_VXD_NUM_FENCES];
+
+	/* Command buffers, allocated and mapped before the MTX starts. */
+	struct apple_vxd_cmdbuf_pool cmdbufs;
+
+	/* Active decode job. */
+	spinlock_t job_lock;
+	bool job_active;
+	struct apple_vxd_job job;	/* under job_lock while job_active */
+	struct work_struct job_done_work;
+	struct delayed_work watchdog_work;
+
+	/* V4L2 stateless device. */
+	struct v4l2_device v4l2_dev;
+	struct media_device mdev;
+	struct video_device vdev;
+	struct v4l2_m2m_dev *m2m_dev;
+	struct mutex vdev_lock;		/* serializes ioctls */
+	/*
+	 * Coded formats, filled by apple_vxd_h264_register() during probe
+	 * before any V4L2 node exists.
+	 */
+	const struct apple_vxd_coded_fmt_desc *coded_fmts;
+	unsigned int num_coded_fmts;
+};
+
+struct apple_vxd_ctx {
+	struct v4l2_fh fh;
+	struct apple_vxd_dev *vxd;
+	struct v4l2_format coded_fmt;
+	struct v4l2_format decoded_fmt;
+	const struct apple_vxd_coded_fmt_desc *coded_fmt_desc;
+	struct v4l2_ctrl_handler ctrl_hdl;
+	enum apple_vxd_image_fmt image_fmt;
+	void *priv;
+};
+
+struct apple_vxd_coded_fmt_ops {
+	int (*adjust_fmt)(struct apple_vxd_ctx *ctx, struct v4l2_format *f);
+	int (*start)(struct apple_vxd_ctx *ctx);
+	void (*stop)(struct apple_vxd_ctx *ctx);
+	int (*run)(struct apple_vxd_ctx *ctx);
+	int (*try_ctrl)(struct apple_vxd_ctx *ctx, struct v4l2_ctrl *ctrl);
+	enum apple_vxd_image_fmt (*get_image_fmt)(struct apple_vxd_ctx *ctx,
+						  struct v4l2_ctrl *ctrl);
+	/* Bytes of per-CAPTURE side buffer, 0 for none. */
+	size_t (*capture_aux_size)(struct apple_vxd_ctx *ctx);
+};
+
+struct apple_vxd_decoded_fmt_desc {
+	u32 fourcc;
+	enum apple_vxd_image_fmt image_fmt;
+};
+
+struct apple_vxd_ctrl_desc {
+	struct v4l2_ctrl_config cfg;
+};
+
+struct apple_vxd_ctrls {
+	const struct apple_vxd_ctrl_desc *ctrls;
+	unsigned int num_ctrls;
+};
+
+struct apple_vxd_coded_fmt_desc {
+	u32 fourcc;
+	struct v4l2_frmsize_stepwise frmsize;
+	const struct apple_vxd_ctrls *ctrls;
+	const struct apple_vxd_coded_fmt_ops *ops;
+	unsigned int num_decoded_fmts;
+	const struct apple_vxd_decoded_fmt_desc *decoded_fmts;
+};
+
+/* Message header word: (fence << 16) | (type << 8) | nwords. */
+static inline u32 apple_vxd_msg_hdr(u16 fence, u8 type, u32 nwords)
+{
+	return FIELD_PREP(VXD_MSG_FENCE, fence) |
+	       FIELD_PREP(VXD_MSG_TYPE, type) |
+	       FIELD_PREP(VXD_MSG_NWORDS, nwords);
+}
+
+/* Register access (CPVDECCore::ReadReg/WriteReg [E], native endian). */
+static inline void vxd_write(struct apple_vxd_dev *vxd, u32 off, u32 val)
+{
+	writel(val, vxd->regs + off);
+}
+
+static inline u32 vxd_read(struct apple_vxd_dev *vxd, u32 off)
+{
+	return readl(vxd->regs + off);
+}
