diff --git a/drivers/media/platform/apple/vxd/apple-vxd-cmd.c b/drivers/media/platform/apple/vxd/apple-vxd-cmd.c
new file mode 100644
index 000000000..03340ed33
--- /dev/null
+++ b/drivers/media/platform/apple/vxd/apple-vxd-cmd.c
@@ -0,0 +1,393 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Apple VXD - command-stream encoders
+ *
+ * The H.264 command stream is an MSVDX register program
+ * (docs/periph/ds-vxd-cmdstream.md): per slice one chunk of command words
+ * in a GART-mapped buffer, padded to 64 bytes, plus one 0x78-byte packet
+ * describing that chunk; per picture one more chunk of single-register
+ * writes (the kind-4 / mailbox 0x88 packet).
+ *
+ * What the kext does, byte for byte [E]:
+ *
+ *   CH264Decoder::HOST_H264DecodeFrame, per slice (0xfffffff0062967cc):
+ *     bytes = wptr - base - chunk_start            (payload +0x0c)
+ *     zero-fill 64 - (wptr & 63) bytes, advance by that & 0x7c
+ *     packet = addCommand(pktlist, 0x80000007, 0x78)   <- a second object
+ *     payload +0x10 = chunk_start + cmd->[0x18]
+ *   after the slice loop, 0x62b7ab0: one chunk of 0x000f0000 pairs, padded
+ *     by 0x40 - (pairs & 7) * 8 bytes, payload +0x0c counting the pad
+ *   CmdBuf::addCommand (0xfffffff0062982f8): {magic, size, 0xabcdefab} at
+ *     the list's own offset, gate offset + size + 0xc < capacity
+ *   SubmitCommandBufferInternal (0xfffffff00628a8d4): walk the packet list
+ *     from its base, check both magics, one mailbox message per packet
+ *
+ * The packet list and the register program are therefore two buffers:
+ * the walker starts at the list's base and would reject the first command
+ * word (0x90000000) otherwise.  Only the register program is device
+ * memory.
+ *
+ * Register runs (0xfffffff00629b068) are written through a scoped writer
+ * that asserts exclusive use of the buffer: consecutive registers merge
+ * into one 0x1 header (count += 1) only inside one group, so groups are
+ * explicit here (apple_vxd_cmd_group_open/close) and no other command may
+ * be emitted while one is open.
+ *
+ * Every emitter is bounds-checked; a failure sets a sticky error that the
+ * caller checks once at the end of a chunk.  Nothing here touches MMIO,
+ * the DMA API or a lock, so the file builds unchanged on the host.
+ */
+#include <linux/align.h>
+#include <linux/bitfield.h>
+#include <linux/errno.h>
+#include <linux/limits.h>
+#include <linux/string.h>
+
+#include "apple-vxd-cmd.h"
+
+void apple_vxd_cmdbuf_reset(struct apple_vxd_cmdbuf *cb)
+{
+	cb->used = 0;
+	cb->chunk_start = 0;
+	cb->group_open = false;
+	cb->group_flags = 0;
+	cb->run_hdr = SIZE_MAX;
+	cb->run_next_reg = 0;
+	cb->npairs = 0;
+	cb->error = false;
+	cb->pkt_used = 0;
+	cb->npackets = 0;
+}
+
+static bool vxd_cmd_room(struct apple_vxd_cmdbuf *cb, size_t bytes)
+{
+	if (cb->error)
+		return false;
+	if (bytes > cb->size - cb->used) {
+		cb->error = true;
+		return false;
+	}
+	return true;
+}
+
+static void vxd_cmd_put(struct apple_vxd_cmdbuf *cb, u32 word)
+{
+	cb->vaddr[cb->used / 4] = word;
+	cb->used += 4;
+}
+
+/* Every non-0x1 command: no open register group, room for @words. */
+static bool vxd_cmd_begin(struct apple_vxd_cmdbuf *cb, size_t words)
+{
+	if (cb->group_open) {
+		cb->error = true;
+		return false;
+	}
+	return vxd_cmd_room(cb, words * 4);
+}
+
+void apple_vxd_cmd_word(struct apple_vxd_cmdbuf *cb, u32 word)
+{
+	if (vxd_cmd_begin(cb, 1))
+		vxd_cmd_put(cb, word);
+}
+
+/* Open a 0x1 register group; @flags is OR-ed into every run header. */
+void apple_vxd_cmd_group_open(struct apple_vxd_cmdbuf *cb, u32 flags)
+{
+	if (cb->group_open) {
+		cb->error = true;
+		return;
+	}
+	cb->group_open = true;
+	cb->group_flags = flags;
+	cb->run_hdr = SIZE_MAX;
+}
+
+/*
+ * 0x1 form: 0x10010000 | flags | reg, value; a write to the register right
+ * after the previous one extends that run instead (0xfffffff00629b068).
+ */
+void apple_vxd_cmd_reg(struct apple_vxd_cmdbuf *cb, u32 reg, u32 val)
+{
+	u32 *hdr;
+
+	if (!cb->group_open) {
+		cb->error = true;
+		return;
+	}
+
+	hdr = cb->run_hdr != SIZE_MAX ? &cb->vaddr[cb->run_hdr / 4] : NULL;
+	if (hdr && cb->run_next_reg == reg &&
+	    FIELD_GET(VXD_CMD_REG_RUN_COUNT, *hdr) < FIELD_MAX(VXD_CMD_REG_RUN_COUNT)) {
+		if (!vxd_cmd_room(cb, 4))
+			return;
+		*hdr += VXD_CMD_REG_RUN_ONE;
+	} else {
+		if (!vxd_cmd_room(cb, 8))
+			return;
+		cb->run_hdr = cb->used;
+		vxd_cmd_put(cb, (reg & VXD_CMD_REG_ADDR) | cb->group_flags |
+				VXD_CMD_REG_RUN | VXD_CMD_REG_RUN_ONE);
+	}
+	vxd_cmd_put(cb, val);
+	cb->run_next_reg = reg + 4;
+}
+
+void apple_vxd_cmd_group_close(struct apple_vxd_cmdbuf *cb)
+{
+	if (!cb->group_open)
+		cb->error = true;
+	cb->group_open = false;
+	cb->run_hdr = SIZE_MAX;
+}
+
+/* 0x000f0000 form: one register, (flags & 0xf0) << 16 (0xfffffff00629aa5c). */
+void apple_vxd_cmd_reg1(struct apple_vxd_cmdbuf *cb, u32 reg, u32 val,
+			u32 flags)
+{
+	if (!vxd_cmd_begin(cb, 2))
+		return;
+	vxd_cmd_put(cb, ((flags & VXD_CMD_REG1_FLAGS) << 16) |
+			(reg & VXD_CMD_REG_ADDR) | VXD_CMD_REG1);
+	vxd_cmd_put(cb, val);
+	cb->npairs++;
+}
+
+/* 0x9: the 0x28-byte per-slice block, emitted all zero by Apple. */
+void apple_vxd_cmd_slice_block(struct apple_vxd_cmdbuf *cb)
+{
+	unsigned int i;
+
+	if (!vxd_cmd_begin(cb, VXD_CMD_SLICE_BLOCK_WORDS))
+		return;
+	vxd_cmd_put(cb, VXD_CMD_SLICE_BLOCK);
+	for (i = 1; i < VXD_CMD_SLICE_BLOCK_WORDS; i++)
+		vxd_cmd_put(cb, 0);
+}
+
+/*
+ * 0x9 with its payload: the AVC path fills the ten-word CTRL_ALLOC_HEADER
+ * (0xfffffff0062c4c98, ds-vxd-cmdstream.md section 16.4).
+ */
+void apple_vxd_cmd_ctrl_alloc(struct apple_vxd_cmdbuf *cb,
+			      const u32 words[VXD_CMD_SLICE_BLOCK_WORDS - 1])
+{
+	unsigned int i;
+
+	if (!vxd_cmd_begin(cb, VXD_CMD_SLICE_BLOCK_WORDS))
+		return;
+	vxd_cmd_put(cb, VXD_CMD_SLICE_BLOCK);
+	for (i = 0; i < VXD_CMD_SLICE_BLOCK_WORDS - 1; i++)
+		vxd_cmd_put(cb, words[i]);
+}
+
+/*
+ * 0x5: one block of @n consecutive registers from @reg, never merged with
+ * a neighbour (0xfffffff00629a568 / 0x629a6c0 / 0x629a81c: the header
+ * count is patched when the block is closed, boundaries are kept).
+ */
+void apple_vxd_cmd_block(struct apple_vxd_cmdbuf *cb, u32 reg, u32 flags,
+			 const u32 *vals, unsigned int n)
+{
+	unsigned int i;
+
+	if (!n || n > FIELD_MAX(VXD_CMD_BLOCK_COUNT) ||
+	    (flags & ~VXD_CMD_BLOCK_FLAG_REFS)) {
+		cb->error = true;
+		return;
+	}
+	if (!vxd_cmd_begin(cb, 1 + n))
+		return;
+	vxd_cmd_put(cb, VXD_CMD_BLOCK | flags |
+			FIELD_PREP(VXD_CMD_BLOCK_COUNT, n) | (reg & VXD_CMD_REG_ADDR));
+	for (i = 0; i < n; i++)
+		vxd_cmd_put(cb, vals[i]);
+}
+
+/* 0xe: DMA @bytes from @va into the core, @type selects the target. */
+void apple_vxd_cmd_dma(struct apple_vxd_cmdbuf *cb, u32 type, u32 bytes,
+		       u32 va)
+{
+	if (bytes & ~VXD_CMD_DMA_BYTES) {
+		cb->error = true;
+		return;
+	}
+	if (!vxd_cmd_begin(cb, 2))
+		return;
+	vxd_cmd_put(cb, VXD_CMD_DMA | type | bytes);
+	vxd_cmd_put(cb, va);
+}
+
+/* 0xb: {0xb0000001, header bits consumed, slice bytes} (0x62b5b00). */
+void apple_vxd_cmd_slice_desc(struct apple_vxd_cmdbuf *cb, u32 w1, u32 w2)
+{
+	if (!vxd_cmd_begin(cb, 3))
+		return;
+	vxd_cmd_put(cb, VXD_CMD_SLICE_DESC);
+	vxd_cmd_put(cb, w1);
+	vxd_cmd_put(cb, w2);
+}
+
+/*
+ * 0xa: load @bytes from device address @va (0xfffffff00629a444, asserts
+ * bytes < 1 << 28).  This is how the slice bitstream reaches the core:
+ * @va is the GART VA of the OUTPUT buffer plus the slice offset.
+ */
+void apple_vxd_cmd_load(struct apple_vxd_cmdbuf *cb, u32 va, u32 bytes)
+{
+	if (bytes & ~VXD_CMD_LOAD_MAX) {
+		cb->error = true;
+		return;
+	}
+	if (!vxd_cmd_begin(cb, 2))
+		return;
+	vxd_cmd_put(cb, VXD_CMD_LOAD | bytes);
+	vxd_cmd_put(cb, va);
+}
+
+/* 0xf: install @bytes at @va into destination @dst (0x62b5fcc). */
+void apple_vxd_cmd_table_xfer(struct apple_vxd_cmdbuf *cb, u32 bytes,
+			      u32 va, u32 dst)
+{
+	if (bytes & ~VXD_CMD_LOAD_MAX) {
+		cb->error = true;
+		return;
+	}
+	if (!vxd_cmd_begin(cb, 3))
+		return;
+	vxd_cmd_put(cb, VXD_CMD_TABLE_XFER | bytes);
+	vxd_cmd_put(cb, va);
+	vxd_cmd_put(cb, dst);
+}
+
+void apple_vxd_cmd_end_slice(struct apple_vxd_cmdbuf *cb)
+{
+	apple_vxd_cmd_word(cb, VXD_CMD_END_SLICE);
+}
+
+static int vxd_cmd_pad(struct apple_vxd_cmdbuf *cb, size_t pad)
+{
+	if (!vxd_cmd_room(cb, pad))
+		return -ENOSPC;
+	memset((u8 *)cb->vaddr + cb->used, 0, pad);
+	cb->used += pad;
+	cb->chunk_start = cb->used;
+	cb->npairs = 0;
+	return 0;
+}
+
+/*
+ * Close the current slice chunk: report its offset and its byte count
+ * (payload +0x0c, before padding), then zero-fill 64 - (used & 63) bytes
+ * as Apple does (a full 64 when already aligned).  The next chunk starts
+ * 64-byte aligned.  Returns -ENOSPC on a sticky error.
+ */
+int apple_vxd_cmdbuf_chunk_end(struct apple_vxd_cmdbuf *cb, u32 *offset,
+			       u32 *bytes)
+{
+	if (cb->group_open)
+		cb->error = true;
+	if (cb->error)
+		return -ENOSPC;
+
+	*offset = cb->chunk_start;
+	*bytes = cb->used - cb->chunk_start;
+	return vxd_cmd_pad(cb, VXD_CMD_CHUNK_ALIGN -
+			   (cb->used & (VXD_CMD_CHUNK_ALIGN - 1)));
+}
+
+/*
+ * Close an AVC slice chunk: the AVC emitter records the exact used bytes
+ * and starts the next chunk right behind it, with no pad (0x62c4c98,
+ * ds-vxd-cmdstream.md section 16.3).
+ */
+int apple_vxd_cmdbuf_chunk_end_exact(struct apple_vxd_cmdbuf *cb,
+				     u32 *offset, u32 *bytes)
+{
+	if (cb->group_open)
+		cb->error = true;
+	if (cb->error)
+		return -ENOSPC;
+
+	*offset = cb->chunk_start;
+	*bytes = cb->used - cb->chunk_start;
+	cb->chunk_start = cb->used;
+	cb->npairs = 0;
+	return 0;
+}
+
+/*
+ * Close a chunk made only of 0x000f0000 pairs (the per-picture kind-4
+ * chunk, 0x62b7ab0): pad by 0x40 - (pairs & 7) * 8 bytes, a full 64 when
+ * the pair count is a multiple of eight, and report the byte count
+ * including that pad (the kext measures it after the pad; the message
+ * sends it as a pair count, >> 3).
+ */
+int apple_vxd_cmdbuf_pair_chunk_end(struct apple_vxd_cmdbuf *cb, u32 *offset,
+				    u32 *bytes)
+{
+	size_t pad;
+	int ret;
+
+	if (cb->group_open || cb->used - cb->chunk_start != cb->npairs * 8)
+		cb->error = true;
+	if (cb->error)
+		return -ENOSPC;
+
+	*offset = cb->chunk_start;
+	pad = VXD_CMD_CHUNK_ALIGN - (cb->npairs & 7) * 8;
+	ret = vxd_cmd_pad(cb, pad);
+	if (!ret)
+		*bytes = cb->used - *offset;
+	return ret;
+}
+
+/*
+ * CmdBuf::addCommand: append {magic, size, 0xabcdefab} and a zeroed
+ * payload of @size bytes to the host packet list.  Same gate as the kext
+ * (offset + size + 0xc < capacity).  Returns the payload or NULL.
+ */
+u32 *apple_vxd_cmdbuf_add_packet(struct apple_vxd_cmdbuf *cb, u32 magic,
+				 u32 size)
+{
+	u32 *hdr;
+
+	if (!IS_ALIGNED(size, 4) ||
+	    (u64)cb->pkt_used + size + VXD_PKT_HDR_BYTES >= cb->pkt_size) {
+		cb->error = true;
+		return NULL;
+	}
+
+	hdr = (u32 *)(cb->pkt + cb->pkt_used);
+	hdr[0] = magic;
+	hdr[1] = size;
+	hdr[2] = VXD_PKT_MAGIC1;
+	memset(&hdr[3], 0, size);
+	cb->pkt_used += VXD_PKT_HDR_BYTES + size;
+	cb->npackets++;
+	return &hdr[3];
+}
+
+/*
+ * The submit path's container check (0xfffffff00628ac78): from the list
+ * base, both magics on every packet, size + 0xc steps, landing exactly on
+ * the end.  Returns the packet count or -EINVAL.
+ */
+int apple_vxd_cmdbuf_validate(const struct apple_vxd_cmdbuf *cb)
+{
+	size_t off = 0;
+	int n = 0;
+
+	while (off < cb->pkt_used) {
+		const u32 *hdr = (const u32 *)(cb->pkt + off);
+
+		if (cb->pkt_used - off < VXD_PKT_HDR_BYTES ||
+		    hdr[0] != VXD_PKT_MAGIC0 || hdr[2] != VXD_PKT_MAGIC1 ||
+		    hdr[1] > cb->pkt_used - off - VXD_PKT_HDR_BYTES)
+			return -EINVAL;
+		off += VXD_PKT_HDR_BYTES + hdr[1];
+		n++;
+	}
+	return n == cb->npackets ? n : -EINVAL;
+}
diff --git a/drivers/media/platform/apple/vxd/apple-vxd-cmd.h b/drivers/media/platform/apple/vxd/apple-vxd-cmd.h
new file mode 100644
index 000000000..94fc4848d
--- /dev/null
+++ b/drivers/media/platform/apple/vxd/apple-vxd-cmd.h
@@ -0,0 +1,86 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Apple VXD - command-stream encoders
+ *
+ * The containers and encodings of docs/periph/ds-vxd-cmdstream.md, with
+ * no MMIO, no DMA API and no locking, so the H.264 builder on top of them
+ * also compiles on the host (scripts/vdec/host/) and its output can be
+ * diffed word for word against the reference generator.
+ */
+#ifndef __APPLE_VXD_CMD_H__
+#define __APPLE_VXD_CMD_H__
+
+#include <linux/bitfield.h>
+#include <linux/types.h>
+
+#include "apple-vxd-regs.h"
+
+struct apple_vxd_fence;
+
+enum apple_vxd_cmdbuf_state {
+	APPLE_VXD_CMDBUF_FREE = 0,
+	APPLE_VXD_CMDBUF_HOST,
+	APPLE_VXD_CMDBUF_DEVICE,
+};
+
+/*
+ * One command buffer: the device-visible register program plus the
+ * host-only packet list that the submit path turns into mailbox messages
+ * (see apple-vxd.h for the pool and the ownership rules).
+ */
+struct apple_vxd_cmdbuf {
+	unsigned int index;
+	enum apple_vxd_cmdbuf_state state;	/* under mbox_lock */
+	struct apple_vxd_fence *fence;		/* releases it, while DEVICE */
+
+	/* Register program (device-visible). */
+	u32 *vaddr;			/* 64 KiB aligned */
+	dma_addr_t dma;
+	u32 va;				/* GART device VA */
+	size_t size;
+	size_t used;			/* byte cursor, 4-byte granular */
+	size_t chunk_start;		/* current chunk, 64 B aligned */
+	bool group_open;		/* inside a 0x1 register group */
+	u32 group_flags;		/* OR-ed into every run header */
+	size_t run_hdr;			/* open run header, or SIZE_MAX */
+	u32 run_next_reg;		/* register that extends the run */
+	unsigned int npairs;		/* 0x000f0000 writes in this chunk */
+	bool error;			/* sticky: overflow or misuse */
+
+	/* Packet list (host-only). */
+	u8 *pkt;
+	size_t pkt_size;
+	size_t pkt_used;
+	unsigned int npackets;
+};
+
+void apple_vxd_cmdbuf_reset(struct apple_vxd_cmdbuf *cb);
+void apple_vxd_cmd_word(struct apple_vxd_cmdbuf *cb, u32 word);
+void apple_vxd_cmd_group_open(struct apple_vxd_cmdbuf *cb, u32 flags);
+void apple_vxd_cmd_reg(struct apple_vxd_cmdbuf *cb, u32 reg, u32 val);
+void apple_vxd_cmd_group_close(struct apple_vxd_cmdbuf *cb);
+void apple_vxd_cmd_reg1(struct apple_vxd_cmdbuf *cb, u32 reg, u32 val,
+			u32 flags);
+void apple_vxd_cmd_slice_block(struct apple_vxd_cmdbuf *cb);
+void apple_vxd_cmd_ctrl_alloc(struct apple_vxd_cmdbuf *cb,
+			      const u32 words[VXD_CMD_SLICE_BLOCK_WORDS - 1]);
+void apple_vxd_cmd_block(struct apple_vxd_cmdbuf *cb, u32 reg, u32 flags,
+			 const u32 *vals, unsigned int n);
+void apple_vxd_cmd_dma(struct apple_vxd_cmdbuf *cb, u32 type, u32 bytes,
+		       u32 va);
+void apple_vxd_cmd_slice_desc(struct apple_vxd_cmdbuf *cb, u32 w1, u32 w2);
+void apple_vxd_cmd_load(struct apple_vxd_cmdbuf *cb, u32 va, u32 bytes);
+void apple_vxd_cmd_table_xfer(struct apple_vxd_cmdbuf *cb, u32 bytes,
+			      u32 va, u32 dst);
+void apple_vxd_cmd_end_slice(struct apple_vxd_cmdbuf *cb);
+int apple_vxd_cmdbuf_chunk_end(struct apple_vxd_cmdbuf *cb, u32 *offset,
+			       u32 *bytes);
+int apple_vxd_cmdbuf_chunk_end_exact(struct apple_vxd_cmdbuf *cb,
+				     u32 *offset, u32 *bytes);
+int apple_vxd_cmdbuf_pair_chunk_end(struct apple_vxd_cmdbuf *cb, u32 *offset,
+				    u32 *bytes);
+u32 *apple_vxd_cmdbuf_add_packet(struct apple_vxd_cmdbuf *cb, u32 magic,
+				 u32 size);
+int apple_vxd_cmdbuf_validate(const struct apple_vxd_cmdbuf *cb);
+
+#endif /* __APPLE_VXD_CMD_H__ */
diff --git a/drivers/media/platform/apple/vxd/apple-vxd-cmdbuf.c b/drivers/media/platform/apple/vxd/apple-vxd-cmdbuf.c
new file mode 100644
index 000000000..bc7b18a45
--- /dev/null
+++ b/drivers/media/platform/apple/vxd/apple-vxd-cmdbuf.c
@@ -0,0 +1,262 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Apple VXD - command buffers
+ *
+ * The pool of eight 256 KiB GART-mapped command buffers with their
+ * host-only packet lists and the packet -> mailbox message arithmetic.
+ * The encoders themselves are in apple-vxd-cmd.c.
+ */
+#include <linux/bitfield.h>
+#include <linux/slab.h>
+
+#include "apple-vxd.h"
+
+/*
+ * Decode message word 3.  The kext builds it from the GART directory
+ * descriptor (+0x27a8, the object it also programs into MTX_MMU_DIR_ADR
+ * 0x1020): (u32)(dir >> 8), low byte replaced by the hwContextID
+ * (0xfffffff00628ae5c: lsr x8, x0, #8; str w8; strb w21).  It is the MMU
+ * page-table context, not the command buffer's address; the 64 KiB
+ * directory alignment is what keeps the replaced byte zero.
+ */
+u32 apple_vxd_mmu_ctx_word(struct apple_vxd_dev *vxd, u8 hw_ctx)
+{
+	return ((u32)(vxd->gart.dir_dma >> 8) & 0xffffff00) | hw_ctx;
+}
+
+/*
+ * One mailbox message from one packet, SubmitCommandBufferInternal's
+ * arithmetic for the three kinds AppleD5500 produces [E]:
+ *
+ *   kind 1 -> 0x81: w1 = (bytes >> 2) << 16 | flags | (last ? 0x4004 : 0x2000),
+ *                   the flag OR-ed back into the packet as the kext does
+ *   kind 3 -> 0x87: w1 = (bytes >> 2) << 16 | flags,
+ *                   w4 = (payload +0x08 & ~0x6000) | 0x4000
+ *   kind 4 -> 0x88: w1 = (bytes >> 3) << 16 | flags | (last ? 0x4004 : 0)
+ *   all:            w2 = payload +0x10, w3 = MMU context word,
+ *                   w4 = payload +0x08, w5 = payload +0x24
+ *
+ * Six-word form only (the kext adds w6 = payload +0x28 when the core has
+ * a second pipe flag set; this core does not).  @pkt points at the packet
+ * header.  Before pushing a 0x81 the submit path must rewrite 0x1008 =
+ * 0xf00 if gart.dirty (the kext's +0x27a0 rule).  Returns the message type
+ * or -EINVAL.
+ */
+int apple_vxd_packet_msg(struct apple_vxd_dev *vxd, u32 *pkt, u16 fence,
+			 u8 hw_ctx, bool last, u32 msg[VXD_DECODE_MSG_WORDS])
+{
+	u32 *p = &pkt[VXD_PKT_HDR_BYTES / 4];
+	u32 flags, words, w4;
+	u8 type;
+
+	if (pkt[0] != VXD_PKT_MAGIC0 || pkt[2] != VXD_PKT_MAGIC1 ||
+	    pkt[1] < VXD_PKT_H264_PAYLOAD)
+		return -EINVAL;
+
+	w4 = p[VXD_PKT_W4 / 4];
+	switch (p[VXD_PKT_KIND / 4]) {
+	case VXD_PKT_KIND_PICTURE:
+		type = VXD_MSG_DECODE;
+		words = p[VXD_PKT_CMD_BYTES / 4] >> 2;
+		p[VXD_PKT_FLAGS / 4] |= last ? VXD_MSG_FLAG_LAST : VXD_MSG_FLAG_MORE;
+		flags = p[VXD_PKT_FLAGS / 4];
+		break;
+	case VXD_PKT_KIND_DEBLOCK:
+		type = VXD_MSG_DEBLOCK;
+		words = p[VXD_PKT_CMD_BYTES / 4] >> 2;
+		flags = p[VXD_PKT_FLAGS / 4];
+		w4 = (w4 & ~0x6000) | 0x4000;
+		break;
+	case VXD_PKT_KIND_RENDER_TARGET:
+		type = VXD_MSG_RENDER_TARGET;
+		words = p[VXD_PKT_CMD_BYTES / 4] >> 3;
+		flags = p[VXD_PKT_FLAGS / 4] | (last ? VXD_MSG_FLAG_LAST : 0);
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	msg[0] = apple_vxd_msg_hdr(fence, type, VXD_DECODE_MSG_WORDS);
+	msg[1] = (words << 16) | (flags & 0xffff);
+	msg[2] = p[VXD_PKT_W2 / 4];
+	msg[3] = apple_vxd_mmu_ctx_word(vxd, hw_ctx);
+	msg[4] = w4;
+	msg[5] = p[VXD_PKT_W5 / 4];
+	return type;
+}
+
+/* --- pool ---------------------------------------------------------------- */
+
+struct apple_vxd_cmdbuf *apple_vxd_cmdbuf_get(struct apple_vxd_dev *vxd)
+{
+	struct apple_vxd_cmdbuf_pool *pool = &vxd->cmdbufs;
+	struct apple_vxd_cmdbuf *cb = NULL;
+	unsigned long flags;
+	unsigned int i;
+
+	spin_lock_irqsave(&vxd->mbox_lock, flags);
+	for (i = 0; pool->ready && i < APPLE_VXD_NUM_CMDBUFS; i++) {
+		if (pool->bufs[i].state == APPLE_VXD_CMDBUF_FREE) {
+			cb = &pool->bufs[i];
+			cb->state = APPLE_VXD_CMDBUF_HOST;
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+
+	if (cb)
+		apple_vxd_cmdbuf_reset(cb);
+	return cb;
+}
+
+/* HOST -> FREE: a buffer that was built but never submitted. */
+void apple_vxd_cmdbuf_put(struct apple_vxd_dev *vxd,
+			  struct apple_vxd_cmdbuf *cb)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&vxd->mbox_lock, flags);
+	WARN_ON(cb->state != APPLE_VXD_CMDBUF_HOST);
+	cb->state = APPLE_VXD_CMDBUF_FREE;
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+}
+
+/*
+ * HOST -> DEVICE, before the message that @fence tags is pushed: from now
+ * on the core may read the buffer, and only that fence's completion (or a
+ * reclaim after the firmware is stopped) gives it back.
+ */
+int apple_vxd_cmdbuf_bind(struct apple_vxd_dev *vxd,
+			  struct apple_vxd_cmdbuf *cb,
+			  struct apple_vxd_fence *fence)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	spin_lock_irqsave(&vxd->mbox_lock, flags);
+	if (cb->state != APPLE_VXD_CMDBUF_HOST || cb->error ||
+	    fence->state != APPLE_VXD_FENCE_ARMED || fence->cmdbuf) {
+		ret = -EINVAL;
+	} else {
+		cb->state = APPLE_VXD_CMDBUF_DEVICE;
+		cb->fence = fence;
+		fence->cmdbuf = cb;
+	}
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+
+	return ret;
+}
+
+/* DEVICE -> FREE on its fence's 0xc0.  mbox_lock held. */
+void apple_vxd_cmdbuf_retire_locked(struct apple_vxd_cmdbuf *cb)
+{
+	cb->state = APPLE_VXD_CMDBUF_FREE;
+	cb->fence = NULL;
+}
+
+/* The firmware is stopped: nothing reads any buffer any more. */
+void apple_vxd_cmdbufs_reclaim(struct apple_vxd_dev *vxd)
+{
+	struct apple_vxd_cmdbuf_pool *pool = &vxd->cmdbufs;
+	unsigned long flags;
+	unsigned int i;
+
+	spin_lock_irqsave(&vxd->mbox_lock, flags);
+	for (i = 0; i < APPLE_VXD_NUM_CMDBUFS; i++) {
+		struct apple_vxd_cmdbuf *cb = &pool->bufs[i];
+
+		if (cb->state == APPLE_VXD_CMDBUF_DEVICE) {
+			if (cb->fence)
+				cb->fence->cmdbuf = NULL;
+			apple_vxd_cmdbuf_retire_locked(cb);
+		}
+	}
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+}
+
+/*
+ * Boot path, before the MTX starts: allocate and GART-map the eight
+ * buffers once, so the core's MMU never sees them change under it.
+ */
+int apple_vxd_cmdbufs_init(struct apple_vxd_dev *vxd)
+{
+	struct apple_vxd_cmdbuf_pool *pool = &vxd->cmdbufs;
+	size_t total = (size_t)APPLE_VXD_NUM_CMDBUFS * APPLE_VXD_CMDBUF_SIZE;
+	unsigned int i;
+	int ret;
+
+	ret = apple_vxd_dma_alloc_aligned(vxd, total, APPLE_VXD_CMDBUF_ALIGN,
+					  &pool->mem);
+	if (ret)
+		return ret;
+
+	ret = apple_vxd_gart_map(vxd, pool->mem.dma, total, &pool->map);
+	if (ret)
+		goto err_free;
+	if (!IS_ALIGNED(pool->map.va, APPLE_VXD_CMDBUF_ALIGN)) {
+		dev_err(vxd->dev,
+			"command buffers at device VA %#x are not 64 KiB aligned\n",
+			pool->map.va);
+		ret = -EINVAL;
+		goto err_unmap;
+	}
+
+	pool->pkt_mem = kvcalloc(APPLE_VXD_NUM_CMDBUFS, APPLE_VXD_PKTLIST_SIZE,
+				 GFP_KERNEL);
+	if (!pool->pkt_mem) {
+		ret = -ENOMEM;
+		goto err_unmap;
+	}
+
+	for (i = 0; i < APPLE_VXD_NUM_CMDBUFS; i++) {
+		struct apple_vxd_cmdbuf *cb = &pool->bufs[i];
+		size_t off = (size_t)i * APPLE_VXD_CMDBUF_SIZE;
+
+		cb->index = i;
+		cb->state = APPLE_VXD_CMDBUF_FREE;
+		cb->vaddr = pool->mem.vaddr + off;
+		cb->dma = pool->mem.dma + off;
+		cb->va = pool->map.va + off;
+		cb->size = APPLE_VXD_CMDBUF_SIZE;
+		cb->pkt = pool->pkt_mem + (size_t)i * APPLE_VXD_PKTLIST_SIZE;
+		cb->pkt_size = APPLE_VXD_PKTLIST_SIZE;
+		apple_vxd_cmdbuf_reset(cb);
+	}
+	pool->ready = true;
+
+	dev_dbg(vxd->dev,
+		"command buffers: %u x %u KiB at %pad, device VA %#x..%#x\n",
+		APPLE_VXD_NUM_CMDBUFS, APPLE_VXD_CMDBUF_SIZE / SZ_1K,
+		&pool->mem.dma, pool->map.va, pool->map.va + (u32)total - 1);
+	return 0;
+
+err_unmap:
+	apple_vxd_gart_unmap(vxd, &pool->map);
+err_free:
+	apple_vxd_dma_free_aligned(vxd, &pool->mem);
+	memset(pool, 0, sizeof(*pool));
+	return ret;
+}
+
+/* After the mailbox is stopped. */
+void apple_vxd_cmdbufs_fini(struct apple_vxd_dev *vxd)
+{
+	struct apple_vxd_cmdbuf_pool *pool = &vxd->cmdbufs;
+	unsigned long flags;
+	unsigned int i;
+
+	if (!pool->mem.raw_vaddr)
+		return;
+
+	apple_vxd_cmdbufs_reclaim(vxd);
+	spin_lock_irqsave(&vxd->mbox_lock, flags);
+	pool->ready = false;
+	for (i = 0; i < APPLE_VXD_NUM_CMDBUFS; i++)
+		WARN_ON(pool->bufs[i].state != APPLE_VXD_CMDBUF_FREE);
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+
+	apple_vxd_gart_unmap(vxd, &pool->map);
+	kvfree(pool->pkt_mem);
+	apple_vxd_dma_free_aligned(vxd, &pool->mem);
+	memset(pool, 0, sizeof(*pool));
+}
diff --git a/drivers/media/platform/apple/vxd/apple-vxd-core.c b/drivers/media/platform/apple/vxd/apple-vxd-core.c
new file mode 100644
index 000000000..2ed33f1ec
--- /dev/null
+++ b/drivers/media/platform/apple/vxd/apple-vxd-core.c
@@ -0,0 +1,374 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Apple VXD (Imagination MSVDX) video decoder driver - core
+ *
+ * Copyright (c) 2026 Berkay Kösebay <brkosebay@users.noreply.github.com>
+ *
+ * Probe powers the vdec domain, maps the 1 MiB register window, reads the
+ * core identity and registers the V4L2 decoder. The DEVA firmware boots
+ * on the first open of the video node (apple-vxd-fw.c).
+ */
+
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/pm_runtime.h>
+#include <linux/slab.h>
+
+#include "apple-vxd.h"
+
+/*
+ * Take the active job if @last_signalled says it is done (the completion
+ * path) or unconditionally (the watchdog).  job_lock makes the two paths
+ * exclusive: exactly one of them finishes a job.
+ */
+static bool vxd_job_take(struct apple_vxd_dev *vxd, bool need_signal,
+			 struct apple_vxd_job *job)
+{
+	unsigned long flags;
+	bool taken = false;
+
+	spin_lock_irqsave(&vxd->job_lock, flags);
+	if (vxd->job_active && vxd->job.nfences &&
+	    (!need_signal ||
+	     READ_ONCE(vxd->job.fences[vxd->job.nfences - 1]->state) ==
+			APPLE_VXD_FENCE_SIGNALLED)) {
+		*job = vxd->job;
+		vxd->job_active = false;
+		taken = true;
+	}
+	spin_unlock_irqrestore(&vxd->job_lock, flags);
+	return taken;
+}
+
+/*
+ * Every fence of the job goes back to the pool.  A packet whose 0xc0 did
+ * not arrive (the firmware answers only the 0x4004 message) is simply
+ * released; a fault on any armed packet that did answer fails the picture.
+ */
+static void vxd_job_complete(struct apple_vxd_dev *vxd,
+			     const struct apple_vxd_job *job, bool timed_out)
+{
+	struct apple_vxd_fence *last = job->fences[job->nfences - 1];
+	unsigned int i, answered = 0;
+	bool error = timed_out;
+	u32 status = 0;
+
+	for (i = 0; i < job->nfences; i++) {
+		struct apple_vxd_fence *f = job->fences[i];
+
+		if (READ_ONCE(f->state) == APPLE_VXD_FENCE_SIGNALLED) {
+			answered++;
+			error |= f->error;
+			status |= f->status;
+		}
+	}
+	dev_dbg(vxd->dev,
+		"decode: %s: fence %#x (seq %#x), %u of %u packets answered, status %#x, %lld us -> %s\n",
+		timed_out ? "TIMEOUT" : "completion", last->id, job->seq,
+		answered, job->npackets, status,
+		ktime_us_delta(ktime_get(), job->submitted),
+		error ? "ERROR" : "DONE");
+	for (i = 0; i < job->nfences; i++)
+		apple_vxd_fence_release(vxd, job->fences[i]);
+	apple_vxd_job_finish(job->ctx, error ? VB2_BUF_STATE_ERROR :
+						 VB2_BUF_STATE_DONE);
+}
+
+void apple_vxd_job_done(struct work_struct *work)
+{
+	struct apple_vxd_dev *vxd = container_of(work, struct apple_vxd_dev,
+						 job_done_work);
+	struct apple_vxd_job job;
+
+	if (!vxd_job_take(vxd, true, &job))
+		return;
+	cancel_delayed_work(&vxd->watchdog_work);
+	vxd_job_complete(vxd, &job, false);
+}
+
+/*
+ * No 0xc0 for the last packet in APPLE_VXD_JOB_TIMEOUT_MS: fail the
+ * picture.  The command buffer stays quarantined (the core may still
+ * read it) until the firmware is stopped.
+ */
+void apple_vxd_watchdog(struct work_struct *work)
+{
+	struct apple_vxd_dev *vxd = container_of(work, struct apple_vxd_dev,
+						 watchdog_work.work);
+	struct apple_vxd_job job;
+
+	if (!vxd_job_take(vxd, false, &job))
+		return;
+
+	dev_warn(vxd->dev,
+		 "decode job timed out: no completion for fence %#x in %u ms (TO_MTX rd %u wr %u, TO_HOST rd %u wr %u, 0x200c %#x, irq status %#x)\n",
+		 job.fences[job.nfences - 1]->id, APPLE_VXD_JOB_TIMEOUT_MS,
+		 vxd_read(vxd, VXD_REG_TO_MTX_RD_INDEX),
+		 vxd_read(vxd, VXD_REG_TO_MTX_WR_INDEX),
+		 vxd_read(vxd, VXD_REG_TO_HOST_RD_INDEX),
+		 vxd_read(vxd, VXD_REG_TO_HOST_WR_INDEX),
+		 vxd_read(vxd, VXD_REG_FW_PC), vxd_read(vxd, VXD_REG_IRQ_STATUS));
+	vxd_job_complete(vxd, &job, true);
+}
+
+/* Power on and read the identity and feature registers.  Read-only. */
+static int apple_vxd_probe_hw(struct apple_vxd_dev *vxd)
+{
+	u32 memcfg, id, rev;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(vxd->dev);
+	if (ret) {
+		dev_err_probe(vxd->dev, ret, "failed to power the vdec domain\n");
+		return ret;
+	}
+
+	rev = vxd_read(vxd, VXD_REG_CORE_REV);
+	id = vxd_read(vxd, VXD_REG_CORE_ID);
+	vxd->core_rev = rev;
+	vxd->core_id = id;
+
+	/*
+	 * AppleD5500::GetCoreRev rejects MSVDX cores whose coreId high half
+	 * is <= 6 ("MSVDX is unsupported").  Note the register semantics:
+	 * the gate value is the high u16 of 0x630 (on this A9: 0x0303 = 771,
+	 * well above 6), while the ADT's "vxd-version 7" most plausibly
+	 * matches the 0x7 nibble of coreRev 0x70b00.  AppleD5500 itself
+	 * never parses coreRev further; feature gating in iOS uses the ADT
+	 * vxd-version property.  (j71t device run 1, 2026-10-23.)
+	 */
+	if ((id >> VXD_CORE_ID_MAJOR_SH) <= 6) {
+		dev_err(vxd->dev, "MSVDX is unsupported (coreId %#x)\n", id);
+		pm_runtime_put_autosuspend(vxd->dev);
+		return -ENODEV;
+	}
+
+	vxd->num_entropy_pipes = id & VXD_CORE_ID_ENT_PIPES;
+	vxd->num_pixel_pipes = FIELD_GET(VXD_CORE_ID_PIX_PIPES, id);
+
+	memcfg = vxd_read(vxd, VXD_REG_MTX_MEM_CFG);
+	vxd->mtx_mem_size = (u32)((FIELD_GET(VXD_MTX_MEM_BANK_COUNT, memcfg) - 1) *
+				  (4 << FIELD_GET(VXD_MTX_MEM_BANK_SIZE, memcfg))) +
+			    (4 << FIELD_GET(VXD_MTX_MEM_LAST_BANK, memcfg));
+
+	vxd->mmu_40bit = ((vxd_read(vxd, VXD_REG_MTX_MMU_CFG0) & 0xf0) ==
+			  VXD_MTX_MMU_CFG0_40BIT);
+	vxd->mmu_tiling_ctx = !!(vxd_read(vxd, VXD_REG_MTX_MMU_CFG1) &
+				 VXD_MTX_MMU_CFG1_TILING_CTX);
+
+	/* Raw pipe status; per-pipe selection (0x460) needs a write. */
+	vxd->pipe_status = vxd_read(vxd, VXD_REG_PIPE_STATUS);
+
+	dev_dbg(vxd->dev,
+		"coreId %#x, coreRev %#x, entropy pipes %u, pixel pipes %u, mtx mem %u KiB, mmu40 %u, tiling-ctx %u, pipe status %#x\n",
+		id, rev, vxd->num_entropy_pipes, vxd->num_pixel_pipes,
+		vxd->mtx_mem_size, vxd->mmu_40bit, vxd->mmu_tiling_ctx,
+		vxd->pipe_status);
+
+	pm_runtime_put_autosuspend(vxd->dev);
+	return 0;
+}
+
+/* Job plumbing shared by the m2m device and the watchdog. */
+void apple_vxd_job_finish_no_pm(struct apple_vxd_ctx *ctx,
+				enum vb2_buffer_state result)
+{
+	v4l2_m2m_buf_done_and_job_finish(ctx->vxd->m2m_dev, ctx->fh.m2m_ctx,
+					 result);
+}
+
+void apple_vxd_job_finish(struct apple_vxd_ctx *ctx,
+			  enum vb2_buffer_state result)
+{
+	struct apple_vxd_dev *vxd = ctx ? ctx->vxd : NULL;
+
+	if (vxd) {
+		unsigned long flags;
+
+		spin_lock_irqsave(&vxd->job_lock, flags);
+		vxd->job_active = false;
+		spin_unlock_irqrestore(&vxd->job_lock, flags);
+		pm_runtime_put_autosuspend(vxd->dev);
+	}
+
+	if (ctx)
+		apple_vxd_job_finish_no_pm(ctx, result);
+}
+
+void apple_vxd_run_preamble(struct apple_vxd_ctx *ctx,
+			    struct apple_vxd_run *run)
+{
+	struct media_request *src_req;
+
+	memset(run, 0, sizeof(*run));
+
+	run->src = v4l2_m2m_next_src_buf(ctx->fh.m2m_ctx);
+	run->dst = v4l2_m2m_next_dst_buf(ctx->fh.m2m_ctx);
+
+	/* Apply request(s) controls if needed. */
+	src_req = run->src->vb2_buf.req_obj.req;
+	if (src_req)
+		v4l2_ctrl_request_setup(src_req, &ctx->ctrl_hdl);
+
+	v4l2_m2m_buf_copy_metadata(run->src, run->dst);
+}
+
+void apple_vxd_run_postamble(struct apple_vxd_ctx *ctx,
+			     struct apple_vxd_run *run)
+{
+	struct media_request *src_req = run->src->vb2_buf.req_obj.req;
+
+	if (src_req)
+		v4l2_ctrl_request_complete(src_req, &ctx->ctrl_hdl);
+}
+
+/* Runtime PM stubs: the genpd (ps_vdec) does all the work. */
+static int apple_vxd_runtime_resume(struct device *dev)
+{
+	return 0;
+}
+
+static int apple_vxd_runtime_suspend(struct device *dev)
+{
+	return 0;
+}
+
+static const struct dev_pm_ops apple_vxd_pm_ops = {
+	RUNTIME_PM_OPS(apple_vxd_runtime_suspend, apple_vxd_runtime_resume, NULL)
+};
+
+static const struct apple_vxd_variant s8000_vxd_variant = {
+	.vxd_version	= 7,
+	.num_gart_pts	= 512,		/* "setting 2GB mapping" [E] */
+	/* HEVCSupported = ((rev - 7) < 4) && ((0xD >> (rev - 7)) & 1) [E] */
+	.hevc_supported	= true,
+};
+
+static const struct of_device_id apple_vxd_of_match[] = {
+	{ .compatible = "apple,s8000-vxd", .data = &s8000_vxd_variant },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, apple_vxd_of_match);
+
+static int apple_vxd_probe(struct platform_device *pdev)
+{
+	const struct apple_vxd_variant *variant;
+	struct apple_vxd_dev *vxd;
+	struct resource *res;
+	unsigned int i;
+	int ret, irq;
+
+	variant = of_device_get_match_data(&pdev->dev);
+	if (!variant)
+		return -EINVAL;
+
+	vxd = devm_kzalloc(&pdev->dev, sizeof(*vxd), GFP_KERNEL);
+	if (!vxd)
+		return -ENOMEM;
+
+	vxd->dev = &pdev->dev;
+	vxd->variant = variant;
+	platform_set_drvdata(pdev, vxd);
+
+	mutex_init(&vxd->vdev_lock);
+	mutex_init(&vxd->power_lock);
+	spin_lock_init(&vxd->job_lock);
+	spin_lock_init(&vxd->mbox_lock);
+	for (i = 0; i < APPLE_VXD_NUM_FENCES; i++)
+		init_completion(&vxd->fences[i].done);
+	INIT_DELAYED_WORK(&vxd->watchdog_work, apple_vxd_watchdog);
+	INIT_WORK(&vxd->job_done_work, apple_vxd_job_done);
+
+	vxd->regs = devm_platform_get_and_ioremap_resource(pdev, 0, &res);
+	if (IS_ERR(vxd->regs))
+		return dev_err_probe(&pdev->dev, PTR_ERR(vxd->regs),
+				     "failed to map the vxd registers\n");
+	vxd->regs_size = resource_size(res);
+
+	/* The block has no DART; DMA addresses are physical and the core's
+	 * own GART translates the low 32 bits into device address space.
+	 * GART entries hold PA >> 8 in 32 bits: 40-bit physical addresses.
+	 */
+	ret = dma_set_mask_and_coherent(&pdev->dev,
+					DMA_BIT_MASK(VXD_GART_PA_BITS));
+	if (ret) {
+		dev_err_probe(&pdev->dev, ret,
+			      "failed to set the DMA mask\n");
+		return ret;
+	}
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+	vxd->irq = irq;
+
+	/*
+	 * Level interrupt, enabled only once the firmware has taken its init
+	 * message (apple_vxd_mbox_start()).
+	 */
+	ret = devm_request_irq(&pdev->dev, irq, apple_vxd_irq, IRQF_NO_AUTOEN,
+			       dev_name(&pdev->dev), vxd);
+	if (ret) {
+		dev_err_probe(&pdev->dev, ret, "failed to request vxd IRQ\n");
+		return ret;
+	}
+
+	pm_runtime_set_autosuspend_delay(&pdev->dev, 100);
+	pm_runtime_use_autosuspend(&pdev->dev);
+	pm_runtime_enable(&pdev->dev);
+
+	ret = apple_vxd_probe_hw(vxd);
+	if (ret)
+		goto err_disable_runtime_pm;
+
+	ret = apple_vxd_gart_init(vxd);
+	if (ret)
+		goto err_disable_runtime_pm;
+
+	ret = apple_vxd_h264_register(vxd);
+	if (!ret)
+		ret = apple_vxd_v4l2_init(vxd);
+	if (ret)
+		goto err_gart_fini;
+
+	return 0;
+
+err_gart_fini:
+	apple_vxd_gart_fini(vxd);
+err_disable_runtime_pm:
+	pm_runtime_dont_use_autosuspend(&pdev->dev);
+	pm_runtime_disable(&pdev->dev);
+	return ret;
+}
+
+static void apple_vxd_remove(struct platform_device *pdev)
+{
+	struct apple_vxd_dev *vxd = platform_get_drvdata(pdev);
+
+	cancel_delayed_work_sync(&vxd->watchdog_work);
+	apple_vxd_v4l2_cleanup(vxd);
+	apple_vxd_fw_cleanup(vxd);
+	/* fw_cleanup failed every fence: let a pending job finish first. */
+	flush_work(&vxd->job_done_work);
+	cancel_delayed_work_sync(&vxd->watchdog_work);
+	apple_vxd_gart_fini(vxd);
+	pm_runtime_dont_use_autosuspend(&pdev->dev);
+	pm_runtime_disable(&pdev->dev);
+}
+
+static struct platform_driver apple_vxd_driver = {
+	.probe = apple_vxd_probe,
+	.remove = apple_vxd_remove,
+	.driver = {
+		.name = APPLE_VXD_DRV_NAME,
+		.pm = &apple_vxd_pm_ops,
+		.of_match_table = apple_vxd_of_match,
+	},
+};
+module_platform_driver(apple_vxd_driver);
+
+MODULE_DESCRIPTION("Apple VXD (PowerVR MSVDX) video decoder driver");
+MODULE_FIRMWARE(APPLE_VXD_FW_NAME);
+MODULE_AUTHOR("Berkay Kösebay <brkosebay@users.noreply.github.com>");
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/platform/apple/vxd/apple-vxd-fw.c b/drivers/media/platform/apple/vxd/apple-vxd-fw.c
new file mode 100644
index 000000000..753ca4944
--- /dev/null
+++ b/drivers/media/platform/apple/vxd/apple-vxd-fw.c
@@ -0,0 +1,459 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Apple VXD - boot the resident DEVA firmware on the MTX core
+ *
+ * The DEVA image (REL_812.0_14_Deva, 97,944 bytes, built 08/11/2016) ships
+ * inside the iOS AppleD5500 kext; it is loaded as apple/vxd-deva.bin
+ * (sha256 bf5167652e81540471aaca141943fd33d71c3990c137f145471305f5f5ade83b).
+ *
+ * The sequence follows AppleD5500/CPVDECCore's call and write order:
+ *
+ *   PrepareCore:
+ *     known state v1, core discovery (InitializeCoreConfig), firmware
+ *     buffer allocation (dma + GART map + copy)
+ *   LoadFirmwareAndStartCore:
+ *     known state v1 (again), the clock save/quiesce/restore sequence,
+ *     known state v2, ProcessorInitialise (MMU + comms rings), the MTX
+ *     boot block, 0x418 = 0x100000, post-boot-init registers
+ *   poll 0x2014 for 0xa5a5a5a5, then read 0x2024 / 0x2018
+ */
+#include <linux/dma-mapping.h>
+#include <linux/firmware.h>
+#include <linux/iopoll.h>
+#include <linux/pm_runtime.h>
+#include <linux/slab.h>
+
+#include "apple-vxd.h"
+
+/*
+ * PollMSVDX [E]: poll until (val & mask) == match, 1 ms steps, until the
+ * millisecond timeout.
+ */
+static int vxd_poll_msvdx(struct apple_vxd_dev *vxd, u32 off, u32 mask,
+			  u32 match, unsigned long timeout_ms)
+{
+	u32 val;
+
+	return readl_poll_timeout(vxd->regs + off, val, (val & mask) == match,
+				  1000, timeout_ms * 1000);
+}
+
+/*
+ * SetClocks [E]: write default, verify the read-back, then write the
+ * value.  The kext's read-back check is an assert-and-continue (only the
+ * register polls below decide), so a mismatch is a warning here, not a
+ * boot abort.
+ */
+static void vxd_set_clocks(struct apple_vxd_dev *vxd, u32 val)
+{
+	u32 readback;
+
+	vxd_write(vxd, VXD_REG_CR_PVDEC_MAN_CLK_ENABLE, VXD_CLK_ENABLE_DEFAULT);
+	readback = vxd_read(vxd, VXD_REG_CR_PVDEC_MAN_CLK_ENABLE);
+	if (readback != VXD_CLK_ENABLE_DEFAULT)
+		dev_warn(vxd->dev,
+			 "SetClocks - core register write differs from read (wrote %#x, read %#x): core not powered/clocked?\n",
+			 VXD_CLK_ENABLE_DEFAULT, readback);
+
+	vxd_write(vxd, VXD_REG_CR_PVDEC_MAN_CLK_ENABLE, val);
+}
+
+/*
+ * Known state v1 [E] (CPVDECCore fffffff006297f94) - called by both
+ * PrepareCore and LoadFirmwareAndStartCore; two attempts, then the
+ * epilogue writes.  Every attempt: clocks on, pipe resets, CMD_CTRL
+ * pulse 0xffff0000/0/1 with a busy-clear poll, then the MTX clock select
+ * poll.
+ */
+static int vxd_known_state_v1(struct apple_vxd_dev *vxd, const char *which)
+{
+	unsigned int attempt, pipe;
+	int ret;
+
+	for (attempt = 0; attempt < 2; attempt++) {
+		vxd_set_clocks(vxd, VXD_CLK_ENABLE_ALL);
+
+		for (pipe = 1; pipe <= vxd->num_pixel_pipes; pipe++) {
+			vxd_write(vxd, VXD_REG_CMD_KICK, pipe);
+			vxd_write(vxd, VXD_REG_PIPE_CTRL, 0xffffffff);
+		}
+
+		for (pipe = 1; pipe <= vxd->num_entropy_pipes; pipe++) {
+			vxd_write(vxd, VXD_REG_CMD_KICK, pipe);
+			vxd_write(vxd, VXD_REG_PIPE_SET_0, 0xffffffff);
+		}
+
+		vxd_write(vxd, VXD_REG_CMD_CTRL, VXD_CMD_CTRL_RESET);
+		vxd_read(vxd, VXD_REG_CMD_CTRL);	/* APB flush read [E] */
+		vxd_write(vxd, VXD_REG_CMD_CTRL, 0);
+		vxd_write(vxd, VXD_REG_CMD_CTRL, 1);
+
+		ret = vxd_poll_msvdx(vxd, VXD_REG_CMD_CTRL, 1, 0, 100);
+		if (ret) {
+			dev_err(vxd->dev,
+				"known state v1 (%s): 0x400 busy poll attempt %u failed: %d\n",
+				which, attempt, ret);
+			return ret;
+		}
+
+		vxd_write(vxd, VXD_REG_MTX_MAN_CLK_ENABLE, VXD_MTX_CLK_SEL);
+		ret = vxd_poll_msvdx(vxd, VXD_REG_MTX_MAN_CLK_ENABLE,
+				     VXD_MTX_CLK_SEL, 0, 100);
+		if (ret) {
+			dev_err(vxd->dev,
+				"known state v1 (%s): 0x1008 poll attempt %u failed: %d\n",
+				which, attempt, ret);
+			return ret;
+		}
+	}
+
+	/* Epilogue [E]: host interrupt disabled, pending causes cleared. */
+	vxd_write(vxd, VXD_REG_IRQ_ENABLE, 0);
+	vxd_write(vxd, VXD_REG_IRQ_CLEAR, 0xffff0000);
+	return 0;
+}
+
+/*
+ * Known state v2 [E] (fffffff0062980fc) - immediately before
+ * ProcessorInitialise; same reset value, but the MTX clock poll runs on
+ * the first attempt only and the epilogue differs.
+ */
+static int vxd_known_state_v2(struct apple_vxd_dev *vxd)
+{
+	unsigned int attempt, pipe;
+	int ret;
+
+	for (attempt = 0; attempt < 2; attempt++) {
+		vxd_set_clocks(vxd, VXD_CLK_ENABLE_ALL);
+
+		for (pipe = 1; pipe <= vxd->num_pixel_pipes; pipe++) {
+			vxd_write(vxd, VXD_REG_CMD_KICK, pipe);
+			vxd_write(vxd, VXD_REG_PIPE_CTRL, 0xffffffff);
+		}
+
+		for (pipe = 1; pipe <= vxd->num_entropy_pipes; pipe++) {
+			vxd_write(vxd, VXD_REG_CMD_KICK, pipe);
+			vxd_write(vxd, VXD_REG_PIPE_SET_0, 0xffffffff);
+		}
+
+		vxd_write(vxd, VXD_REG_CMD_CTRL, VXD_CMD_CTRL_RESET);
+		vxd_read(vxd, VXD_REG_CMD_CTRL);	/* APB flush read [E] */
+		vxd_write(vxd, VXD_REG_CMD_CTRL, 0);
+
+		if (!attempt) {
+			vxd_write(vxd, VXD_REG_MTX_MAN_CLK_ENABLE,
+				  VXD_MTX_CLK_SEL);
+			ret = vxd_poll_msvdx(vxd, VXD_REG_MTX_MAN_CLK_ENABLE,
+					     VXD_MTX_CLK_SEL, 0, 100);
+			if (ret)
+				return ret;
+		}
+	}
+
+	vxd_read(vxd, VXD_REG_COMMS_STATE);
+	vxd_write(vxd, VXD_REG_IRQ_CLEAR, 0xffffffff);
+	return 0;
+}
+
+/*
+ * Core discovery [E] (InitializeCoreConfig fffffff006299330, head only):
+ * the entropy-pipe feature flag, a clock save-and-set to the firmware
+ * value, and the per-pixel-pipe config write with the pipe status reads.
+ * The kext's per-pipe register recompute (a few hundred lines of bitfield
+ * algebra on the statuses) is not reproduced; the boot works with the
+ * constructor defaults.
+ */
+static void vxd_discover_core(struct apple_vxd_dev *vxd)
+{
+	u32 pipe, status = 0, maxa = 0;
+
+	vxd->cfg_flags = ((vxd->num_entropy_pipes != 0) << 21);
+
+	/*
+	 * save 0x440, set the firmware clock value [E].  The saved value is
+	 * not restored in this prologue, so only the read is kept, in the
+	 * kext's order.
+	 */
+	vxd_read(vxd, VXD_REG_CR_PVDEC_MAN_CLK_ENABLE);
+	vxd_set_clocks(vxd, VXD_CLK_ENABLE_FW);
+
+	for (pipe = 1; pipe <= vxd->num_pixel_pipes; pipe++) {
+		vxd_write(vxd, VXD_REG_CMD_KICK, pipe);
+		vxd_write(vxd, VXD_REG_PIPE_CTRL, 0x20000);
+		status |= vxd_read(vxd, VXD_REG_PIPE_STATUS);
+		maxa = max(maxa, vxd_read(vxd, VXD_REG_PIPE_STATUS_2) & 0x3);
+	}
+	vxd->pipe_status_cfg = status;
+	vxd->pipe_status_2_max = maxa;
+}
+
+/*
+ * The clock quiesce sequence [E] (sub_fffffff0062995cc, between the second known
+ * state v1 and the boot): save 0x440, set the firmware value, touch the
+ * pixel pipes with 0x20000, then restore the saved value.
+ */
+static void vxd_quiesce_clocks(struct apple_vxd_dev *vxd)
+{
+	u32 saved, pipe;
+
+	saved = vxd_read(vxd, VXD_REG_CR_PVDEC_MAN_CLK_ENABLE);
+	vxd_set_clocks(vxd, VXD_CLK_ENABLE_FW);
+
+	for (pipe = 1; pipe <= vxd->num_pixel_pipes; pipe++) {
+		vxd_write(vxd, VXD_REG_CMD_KICK, pipe);
+		vxd_write(vxd, VXD_REG_PIPE_CTRL, 0x20000);
+	}
+
+	vxd_set_clocks(vxd, saved);
+}
+
+/*
+ * ProcessorInitialise [E]: message ring setup and MMU programming.  The
+ * 0x202c flags take the !core[0xc0] branch (0x1000000); the 0x1003000
+ * branch and the meaning of core[0xc0] are not known.
+ */
+static void vxd_processor_initialise(struct apple_vxd_dev *vxd)
+{
+	/* This core always programs its GART before MTX boot: there is no
+	 * DART and no other address path [E].
+	 */
+	vxd_read(vxd, VXD_REG_MTX_MMU_CFG0);
+	vxd_write(vxd, VXD_REG_MTX_MMU_0, 0);
+	vxd_write(vxd, VXD_REG_MTX_MMU_DIR_ADR,
+		  (u32)((u64)vxd->gart.dir_dma >> 8));
+	vxd_write(vxd, VXD_REG_MTX_MMU_MODE,
+		  vxd->mmu_40bit ? VXD_MTX_MMU_MODE_40BIT : 0);
+
+	vxd_write(vxd, VXD_REG_FW_READY_MAGIC, 0);
+	vxd_write(vxd, VXD_REG_COMMS_MSG_COUNT, 200);
+	vxd_write(vxd, VXD_REG_FW_PC, 0);
+	vxd_write(vxd, VXD_REG_TO_HOST_RD_INDEX, 0);
+	vxd_write(vxd, VXD_REG_TO_HOST_WR_INDEX, 0);
+	vxd_write(vxd, VXD_REG_TO_MTX_RD_INDEX, 0);
+	vxd_write(vxd, VXD_REG_TO_MTX_WR_INDEX, 0);
+	vxd_write(vxd, VXD_REG_COMMS_2008, 0);
+	vxd_write(vxd, VXD_REG_COMMS_FLAGS, 0x1000000 | 0x60);
+
+	vxd_read(vxd, VXD_REG_COMMS_STATE);
+}
+
+/* MTX boot block programming [E] (BootFirmware). */
+static void vxd_boot_mtx(struct apple_vxd_dev *vxd, u32 fw_words)
+{
+	vxd_write(vxd, VXD_REG_CMD_KICK, 1);
+	vxd_set_clocks(vxd, VXD_CLK_ENABLE_FW);
+
+	vxd_write(vxd, VXD_REG_PIPE_CTRL, 0x30000);
+	vxd_write(vxd, VXD_REG_ENTDEC_0_CFG, 0);
+	vxd_write(vxd, VXD_REG_ENTDEC_0_SIZE,
+		  (((fw_words + 15) & ~7) & ~0x10000) | 0x10000);
+	vxd_write(vxd, VXD_REG_DMAC_STATUS, VXD_DMAC_STATUS_FLUSH);
+	vxd_write(vxd, VXD_REG_PIPE_4004, 0);
+
+	/* Boot block; BOOT_5 first (MTX clock enable; order is [E]). */
+	vxd_write(vxd, VXD_REG_MTX_BOOT_5, VXD_MTX_BOOT_5_ENABLE);
+	vxd_write(vxd, VXD_REG_MTX_BOOT_3, 0);
+	vxd_write(vxd, VXD_REG_MTX_BOOT_FW_ADR, vxd->fw_dev_va);
+	vxd_write(vxd, VXD_REG_MTX_BOOT_4, VXD_MTX_BOOT_4_VALUE);
+	vxd_write(vxd, VXD_REG_MTX_BOOT_2, VXD_MTX_BOOT_2_VALUE);
+	vxd_write(vxd, VXD_REG_MTX_BOOT_1,
+		  VXD_MTX_BOOT_1_STAGE0 | fw_words);
+	vxd_write(vxd, VXD_REG_MTX_BOOT_1,
+		  VXD_MTX_BOOT_1_STAGE1 | fw_words);
+
+	vxd_read(vxd, VXD_REG_COMMS_STATE);
+}
+
+/*
+ * Post-boot-init [E]: comms flags, MTX_CTRL read-modify-write (bits 0 and
+ * 16 come from core flags, zero on a fresh core) and the per-pipe
+ * registers.  The pipe configuration values are the CPVDECCore constructor
+ * defaults recovered from __TEXT.__const (the per-pipe recompute in
+ * InitializeCoreConfig is not reproduced).
+ */
+static void vxd_post_boot_init(struct apple_vxd_dev *vxd)
+{
+	u32 val;
+
+	vxd_write(vxd, VXD_REG_COMMS_FLAGS, 0x1000000 | 0x60);
+
+	val = vxd_read(vxd, VXD_REG_MTX_CTRL);
+	val &= VXD_MTX_CTRL_KEEP_MASK;
+	vxd_write(vxd, VXD_REG_MTX_CTRL, val);
+
+	vxd_write(vxd, VXD_REG_CMD_KICK, 1);
+	vxd_write(vxd, VXD_REG_PIPE_CR0, 0);
+	vxd_write(vxd, VXD_REG_PIPE_CR1, 0x4ce);
+	vxd_write(vxd, VXD_REG_PIPE_CR2, 0);
+	vxd_write(vxd, VXD_REG_PIPE_CR3, 0x2008);
+	vxd_write(vxd, VXD_REG_PIPE_SET_1, 0);
+	vxd_write(vxd, VXD_REG_PIPE_SET_2, 0x334);
+}
+
+int apple_vxd_boot_firmware(struct apple_vxd_dev *vxd)
+{
+	const struct firmware *fw;
+	u32 fw_words;
+	int ret;
+
+	mutex_lock(&vxd->power_lock);
+	if (vxd->fw_loaded) {
+		/* Up, but a mailbox that never took the init message stays an error. */
+		ret = vxd->hw_ready ? 0 : -EIO;
+		mutex_unlock(&vxd->power_lock);
+		return ret;
+	}
+
+	ret = pm_runtime_resume_and_get(vxd->dev);
+	if (ret) {
+		mutex_unlock(&vxd->power_lock);
+		return ret;
+	}
+
+	/*
+	 * AllocateFirmwareBuffer [E]: a 4-byte-aligned coherent buffer of
+	 * blob_size, GART-mapped (the MTX fetches through its own MMU), and
+	 * the firmware must fit under 0x10000 MTX words.
+	 */
+	ret = request_firmware(&fw, APPLE_VXD_FW_NAME, vxd->dev);
+	if (ret) {
+		dev_err(vxd->dev, "firmware %s not available: %d\n",
+			APPLE_VXD_FW_NAME, ret);
+		goto out_put;
+	}
+
+	if (!fw->size || (fw->size & 3) ||
+	    fw->size / sizeof(u32) >= APPLE_VXD_FW_MAX_WORDS) {
+		dev_err(vxd->dev, "firmware size %zu is not usable (< 0x10000 words)\n",
+			fw->size);
+		ret = -EINVAL;
+		goto out_release;
+	}
+	fw_words = fw->size / sizeof(u32);
+	vxd->fw_blob_size = fw->size;
+
+	vxd->fw_size = PAGE_ALIGN(fw->size);
+	vxd->fw_vaddr = dma_alloc_coherent(vxd->dev, vxd->fw_size,
+					   &vxd->fw_dma, GFP_KERNEL);
+	if (!vxd->fw_vaddr) {
+		ret = -ENOMEM;
+		goto out_release;
+	}
+
+	/* Device VA = low 32 bits of the DMA address (identity GART). */
+	vxd->fw_dev_va = (u32)vxd->fw_dma;
+	ret = apple_vxd_gart_map_at(vxd, vxd->fw_dma, vxd->fw_size,
+				    vxd->fw_dev_va, &vxd->fw_map);
+	if (ret) {
+		dev_err(vxd->dev,
+			"failed to GART-map the firmware buffer (va %#x): %d\n",
+			vxd->fw_dev_va, ret);
+		goto out_fwbuf;
+	}
+
+	memcpy(vxd->fw_vaddr, fw->data, fw->size);
+	release_firmware(fw);
+	/* Every later failure unwinds through out_release: no double free. */
+	fw = NULL;
+
+	/*
+	 * The eight command buffers are mapped now, before the MTX and its
+	 * MMU start, so no mapping changes under a running core.
+	 */
+	ret = apple_vxd_cmdbufs_init(vxd);
+	if (ret) {
+		dev_err(vxd->dev, "command buffers: %d\n", ret);
+		goto out_unmap;
+	}
+
+	/* PrepareCore [E], in the kext's order. */
+	ret = vxd_known_state_v1(vxd, "PrepareCore");
+	if (ret)
+		goto out_cmdbufs;
+
+	vxd_discover_core(vxd);
+
+	/* LoadFirmwareAndStartCore [E], in the kext's order. */
+	ret = vxd_known_state_v1(vxd, "LoadFirmwareAndStartCore");
+	if (ret)
+		goto out_cmdbufs;
+
+	vxd_quiesce_clocks(vxd);
+
+	ret = vxd_known_state_v2(vxd);
+	if (ret)
+		goto out_cmdbufs;
+
+	vxd_processor_initialise(vxd);
+	vxd_boot_mtx(vxd, fw_words);
+
+	vxd_write(vxd, VXD_REG_IRQ_ENABLE, VXD_IRQ_FW_MSG);
+	vxd_post_boot_init(vxd);
+
+	ret = vxd_poll_msvdx(vxd, VXD_REG_FW_READY_MAGIC, 0xffffffff,
+			     VXD_FW_READY_MAGIC, 1000);
+	if (ret) {
+		dev_err(vxd->dev, "firmware did not come up: %d\n", ret);
+		goto out_cmdbufs;
+	}
+
+	/* 0x2024/0x2018: the ring geometry the firmware publishes with the magic. */
+	ret = apple_vxd_mbox_open(vxd);
+	if (ret)
+		goto out_cmdbufs;
+
+	/*
+	 * The MTX runs from here on: keep the image, its mapping and the PM
+	 * reference until apple_vxd_fw_cleanup(), whatever the mailbox does.
+	 */
+	vxd->fw_loaded = true;
+
+	ret = apple_vxd_mbox_start(vxd);
+	if (ret) {
+		dev_err(vxd->dev,
+			"firmware did not take the init message: %d\n", ret);
+		mutex_unlock(&vxd->power_lock);
+		return ret;
+	}
+
+	vxd->hw_ready = true;
+	mutex_unlock(&vxd->power_lock);
+	return 0;
+
+out_cmdbufs:
+	apple_vxd_cmdbufs_fini(vxd);
+out_unmap:
+	apple_vxd_gart_unmap(vxd, &vxd->fw_map);
+out_fwbuf:
+	dma_free_coherent(vxd->dev, vxd->fw_size, vxd->fw_vaddr, vxd->fw_dma);
+	vxd->fw_vaddr = NULL;
+out_release:
+	release_firmware(fw);
+out_put:
+	pm_runtime_put_autosuspend(vxd->dev);
+	mutex_unlock(&vxd->power_lock);
+	return ret;
+}
+
+void apple_vxd_fw_cleanup(struct apple_vxd_dev *vxd)
+{
+	bool was_loaded;
+
+	mutex_lock(&vxd->power_lock);
+	was_loaded = vxd->fw_loaded;
+	/* IRQ off and every fence waiter woken before the buffers go. */
+	apple_vxd_mbox_stop(vxd);
+	apple_vxd_cmdbufs_fini(vxd);
+	if (vxd->fw_vaddr) {
+		apple_vxd_gart_unmap(vxd, &vxd->fw_map);
+		dma_free_coherent(vxd->dev, vxd->fw_size, vxd->fw_vaddr,
+				  vxd->fw_dma);
+		vxd->fw_vaddr = NULL;
+	}
+	vxd->fw_loaded = false;
+	vxd->hw_ready = false;
+	mutex_unlock(&vxd->power_lock);
+
+	if (was_loaded)
+		pm_runtime_put_autosuspend(vxd->dev);
+}
diff --git a/drivers/media/platform/apple/vxd/apple-vxd-gart.c b/drivers/media/platform/apple/vxd/apple-vxd-gart.c
new file mode 100644
index 000000000..1d90de475
--- /dev/null
+++ b/drivers/media/platform/apple/vxd/apple-vxd-gart.c
@@ -0,0 +1,277 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Apple VXD - the core's own two-level memory translation unit ("GART")
+ *
+ * The vxd node has no iommu-parent; instead AppleD5500 programs a page
+ * table hierarchy of its own (AppleD5500::initialize_gart [E]):
+ *
+ *   - directory table: 1024 x 4-byte entries, one per 4 MiB of device VA,
+ *     in a 4 KiB buffer allocated 64 KiB aligned
+ *   - page tables:     1024 x 4-byte entries, one per 4 KiB of device VA,
+ *     num_pts consecutive 4 KiB tables
+ *   - a dummy page filling every unmapped directory/page slot
+ *   - entries: ((PA >> 8) & 0xfffffff0) | 1 on the 40-bit physical address
+ *   - the directory table address is programmed through MTX_MMU_DIR_ADR
+ *     (0x1020) as (PA >> 8) in ProcessorInitialise [E]
+ *
+ * GART pages are 4 KiB whatever the kernel page size: every table walk
+ * below steps VXD_GART_PAGE_SIZE, never PAGE_SIZE (the device kernel runs
+ * 16 KiB pages).
+ *
+ * We pre-allocate variant->num_gart_pts page tables (512 = the kext's
+ * "2GB mapping" for a 2 GiB device) and identity-map the low 32 bits of
+ * every DMA address, so mapping is just writing the slot selected by the
+ * address itself.  The tables are dma_alloc_coherent memory, so no cache
+ * maintenance is needed when they change.
+ */
+#include <linux/dma-mapping.h>
+#include <linux/slab.h>
+
+#include "apple-vxd.h"
+
+/*
+ * Coherent buffer with a bus-address alignment beyond PAGE_SIZE.  The
+ * direct allocator hands out naturally aligned blocks in practice, so the
+ * exact size is tried first; only a misaligned result is retried with
+ * enough slack to align inside it.
+ */
+int apple_vxd_dma_alloc_aligned(struct apple_vxd_dev *vxd, size_t size,
+				size_t align, struct apple_vxd_dma_buf *buf)
+{
+	struct device *dev = vxd->dev;
+	size_t off;
+
+	if (WARN_ON(!size || !is_power_of_2(align)))
+		return -EINVAL;
+
+	memset(buf, 0, sizeof(*buf));
+	buf->raw_size = PAGE_ALIGN(size);
+	buf->raw_vaddr = dma_alloc_coherent(dev, buf->raw_size, &buf->raw_dma,
+					    GFP_KERNEL);
+	if (!buf->raw_vaddr)
+		return -ENOMEM;
+
+	if (buf->raw_dma & (align - 1)) {
+		dma_free_coherent(dev, buf->raw_size, buf->raw_vaddr,
+				  buf->raw_dma);
+		buf->raw_size = PAGE_ALIGN(size + align);
+		buf->raw_vaddr = dma_alloc_coherent(dev, buf->raw_size,
+						    &buf->raw_dma, GFP_KERNEL);
+		if (!buf->raw_vaddr)
+			return -ENOMEM;
+	}
+
+	off = ALIGN(buf->raw_dma, align) - buf->raw_dma;
+	buf->vaddr = buf->raw_vaddr + off;
+	buf->dma = buf->raw_dma + off;
+	buf->size = size;
+	return 0;
+}
+
+void apple_vxd_dma_free_aligned(struct apple_vxd_dev *vxd,
+				struct apple_vxd_dma_buf *buf)
+{
+	if (buf->raw_vaddr)
+		dma_free_coherent(vxd->dev, buf->raw_size, buf->raw_vaddr,
+				  buf->raw_dma);
+	memset(buf, 0, sizeof(*buf));
+}
+
+int apple_vxd_gart_init(struct apple_vxd_dev *vxd)
+{
+	struct apple_vxd_gart *gart = &vxd->gart;
+	struct device *dev = vxd->dev;
+	u32 num_pts = vxd->variant->num_gart_pts;
+	u32 i;
+	int ret;
+
+	mutex_init(&gart->lock);
+	INIT_LIST_HEAD(&gart->mappings);
+
+	ret = apple_vxd_dma_alloc_aligned(vxd,
+					  VXD_GART_DIR_ENTRIES * sizeof(u32),
+					  VXD_GART_DIR_ALIGN, &gart->dir_buf);
+	if (ret)
+		goto err;
+	gart->dir = gart->dir_buf.vaddr;
+	gart->dir_dma = gart->dir_buf.dma;
+
+	gart->dummy = dma_alloc_coherent(dev, PAGE_SIZE, &gart->dummy_dma,
+					 GFP_KERNEL);
+	if (!gart->dummy) {
+		ret = -ENOMEM;
+		goto err_free_dir;
+	}
+
+	/* Page tables are one contiguous DMA block of num_pts 4 KiB tables:
+	 * table i sits at pts_dma + i * 4 KiB, which is what the directory
+	 * entry for i points at.
+	 */
+	gart->pts = dma_alloc_coherent(dev, (size_t)num_pts * VXD_GART_PT_SIZE,
+				       &gart->pts_dma, GFP_KERNEL);
+	if (!gart->pts) {
+		ret = -ENOMEM;
+		goto err_free_dummy;
+	}
+	gart->num_pts = num_pts;
+
+	if (upper_32_bits(gart->pts_dma) >> (VXD_GART_PA_BITS - 32) ||
+	    upper_32_bits(gart->dir_dma) >> (VXD_GART_PA_BITS - 32) ||
+	    upper_32_bits(gart->dummy_dma) >> (VXD_GART_PA_BITS - 32)) {
+		dev_err(dev, "GART tables above the %u-bit PA range\n",
+			VXD_GART_PA_BITS);
+		ret = -ERANGE;
+		goto err_free_pts;
+	}
+
+	/* Unmapped VAs resolve to the dummy page, as in AppleD5500. */
+	for (i = 0; i < num_pts * VXD_GART_PT_ENTRIES; i++)
+		gart->pts[i] = VXD_GART_PTE(gart->dummy_dma);
+	for (i = 0; i < VXD_GART_DIR_ENTRIES; i++) {
+		if (i < num_pts)
+			gart->dir[i] = VXD_GART_PTE(gart->pts_dma +
+						   (dma_addr_t)i * VXD_GART_PT_SIZE);
+		else
+			gart->dir[i] = VXD_GART_PTE(gart->dummy_dma);
+	}
+
+	return 0;
+
+err_free_pts:
+	dma_free_coherent(dev, (size_t)num_pts * VXD_GART_PT_SIZE, gart->pts,
+			  gart->pts_dma);
+err_free_dummy:
+	dma_free_coherent(dev, PAGE_SIZE, gart->dummy, gart->dummy_dma);
+err_free_dir:
+	apple_vxd_dma_free_aligned(vxd, &gart->dir_buf);
+err:
+	memset(gart, 0, sizeof(*gart));
+	return ret;
+}
+
+void apple_vxd_gart_fini(struct apple_vxd_dev *vxd)
+{
+	struct apple_vxd_gart *gart = &vxd->gart;
+	struct device *dev = vxd->dev;
+
+	WARN_ON(gart->pts && !list_empty(&gart->mappings));
+
+	if (gart->pts)
+		dma_free_coherent(dev, (size_t)gart->num_pts * VXD_GART_PT_SIZE,
+				  gart->pts, gart->pts_dma);
+	if (gart->dummy)
+		dma_free_coherent(dev, PAGE_SIZE, gart->dummy, gart->dummy_dma);
+	apple_vxd_dma_free_aligned(vxd, &gart->dir_buf);
+	memset(gart, 0, sizeof(*gart));
+}
+
+/* Slot of device VA @va in the page-table block. */
+static u32 *vxd_gart_slot(struct apple_vxd_gart *gart, u32 va)
+{
+	u32 dir_idx = va >> 22;		/* 4 MiB per page table */
+	u32 ent_idx = (va >> VXD_GART_PAGE_SHIFT) & (VXD_GART_PT_ENTRIES - 1);
+
+	if (dir_idx >= gart->num_pts)
+		return NULL;
+	return &gart->pts[dir_idx * VXD_GART_PT_ENTRIES + ent_idx];
+}
+
+int apple_vxd_gart_map_at(struct apple_vxd_dev *vxd, dma_addr_t dma,
+			  size_t size, u32 va_base,
+			  struct apple_vxd_mapping *map)
+{
+	struct apple_vxd_gart *gart = &vxd->gart;
+	u32 npages, i;
+
+	memset(map, 0, sizeof(*map));
+	INIT_LIST_HEAD(&map->list);
+
+	if (!size || !IS_ALIGNED(size, VXD_GART_PAGE_SIZE) ||
+	    !IS_ALIGNED(dma, VXD_GART_PAGE_SIZE) ||
+	    !IS_ALIGNED(va_base, VXD_GART_PAGE_SIZE) ||
+	    upper_32_bits(dma + size - 1) >> (VXD_GART_PA_BITS - 32))
+		return -EINVAL;
+
+	npages = size >> VXD_GART_PAGE_SHIFT;
+	if ((u64)va_base + size > (u64)gart->num_pts << 22) {
+		/* Device aperture beyond the mapped window. */
+		dev_err(vxd->dev,
+			"GART: VA %#x (DMA %pad+0x%zx) maps outside the %u page-table window\n",
+			va_base, &dma, size, gart->num_pts);
+		return -ENOSPC;
+	}
+
+	mutex_lock(&gart->lock);
+	for (i = 0; i < npages; i++)
+		*vxd_gart_slot(gart, va_base + (i << VXD_GART_PAGE_SHIFT)) =
+			VXD_GART_PTE(dma + ((dma_addr_t)i << VXD_GART_PAGE_SHIFT));
+	map->dma = dma;
+	map->size = size;
+	map->va = va_base;
+	list_add_tail(&map->list, &gart->mappings);
+	gart->dirty = true;
+	mutex_unlock(&gart->lock);
+	return 0;
+}
+
+int apple_vxd_gart_map(struct apple_vxd_dev *vxd, dma_addr_t dma, size_t size,
+		       struct apple_vxd_mapping *map)
+{
+	return apple_vxd_gart_map_at(vxd, dma, size, (u32)dma, map);
+}
+
+void apple_vxd_gart_unmap(struct apple_vxd_dev *vxd, struct apple_vxd_mapping *map)
+{
+	struct apple_vxd_gart *gart = &vxd->gart;
+	u32 npages, i;
+	u32 *slot;
+
+	if (!map->size)
+		return;
+
+	mutex_lock(&gart->lock);
+	npages = map->size >> VXD_GART_PAGE_SHIFT;
+	for (i = 0; i < npages; i++) {
+		slot = vxd_gart_slot(gart, map->va + (i << VXD_GART_PAGE_SHIFT));
+		if (slot)
+			*slot = VXD_GART_PTE(gart->dummy_dma);
+	}
+	list_del(&map->list);
+	gart->dirty = true;
+	mutex_unlock(&gart->lock);
+	memset(map, 0, sizeof(*map));
+}
+
+/*
+ * A zeroed coherent buffer, 4 KiB aligned (every MSVDX base-address
+ * register drops the low 12 bits), GART-mapped for its lifetime.
+ */
+int apple_vxd_dev_buf_alloc(struct apple_vxd_dev *vxd, size_t size,
+			    struct apple_vxd_dev_buf *buf)
+{
+	int ret;
+
+	ret = apple_vxd_dma_alloc_aligned(vxd, ALIGN(size, VXD_GART_PAGE_SIZE),
+					  VXD_GART_PAGE_SIZE, &buf->mem);
+	if (ret)
+		return ret;
+	memset(buf->mem.vaddr, 0, buf->mem.size);
+
+	ret = apple_vxd_gart_map(vxd, buf->mem.dma, buf->mem.size, &buf->map);
+	if (ret) {
+		apple_vxd_dma_free_aligned(vxd, &buf->mem);
+		return ret;
+	}
+	buf->va = buf->map.va;
+	return 0;
+}
+
+void apple_vxd_dev_buf_free(struct apple_vxd_dev *vxd,
+			    struct apple_vxd_dev_buf *buf)
+{
+	if (!buf->mem.raw_vaddr)
+		return;
+	apple_vxd_gart_unmap(vxd, &buf->map);
+	apple_vxd_dma_free_aligned(vxd, &buf->mem);
+	buf->va = 0;
+}
diff --git a/drivers/media/platform/apple/vxd/apple-vxd-h264-cmd.c b/drivers/media/platform/apple/vxd/apple-vxd-h264-cmd.c
new file mode 100644
index 000000000..62d28da38
--- /dev/null
+++ b/drivers/media/platform/apple/vxd/apple-vxd-h264-cmd.c
@@ -0,0 +1,587 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Apple VXD - H.264 (AVC) command-stream builder
+ *
+ * The AVC path of the kext (CH264Decoder::HOST_H264DecodeFrame
+ * 0xfffffff0062a15f0 -> DecodePictureInternal 0x62a0c00 ->
+ * DecodeExecuteH264VLD 0x62c4c98, docs/periph/ds-vxd-cmdstream.md section
+ * 16.3-16.6) builds one command chunk and one kind-1 packet (mailbox
+ * 0x81) per slice, in Imagination's DXVA control-allocation format
+ * (psb_video's dxva_fw_ctrl.h):
+ *
+ *   CTRL_ALLOC_HEADER        0x90000000 + 9 words (slice params, strides,
+ *                            first/last MB, chroma format)
+ *   CMD_DMA                  the 0x440-byte CAVLC table, type VLC
+ *   REGVALPAIR               26 constant VLC table address registers
+ *   SR_SETUP + BITSTREAM_DMA the slice NAL from the OUTPUT buffer, with
+ *                            the core stripping emulation prevention
+ *   REGVALPAIR               entropy front end: control, SPS0, PPS0, PIC0,
+ *                            SLICE0, SLICE1, first MB
+ *   RENDEC_BLOCK x n         entropy back end, scaling lists, B-slice POCs
+ *                            and co-located picture, reference lists,
+ *                            reference surfaces, prediction weights,
+ *                            picture geometry, intra buffer, cache policy,
+ *                            stride
+ *   CMD_COMPLETION           0x60000000
+ *
+ * The chunks follow each other with no pad; there is no per-picture
+ * (kind-4) chunk in the AVC path.  Apple's register numbers map onto the
+ * public MSVDX layout as 0x6000 + off = VEC + off and 0x7000 + off =
+ * CMDS + off (FE_SPS0 0x200, BE_FOC0 0x250, BE_SPS0 0x2d8,
+ * BE_BASE_ADDR_CUR_PIC 0x2ec, BE_REF0 0x2f0, BE_COL_PIC0 0x2f4,
+ * BE_LIST0 0x33c, H264_WEIGHTED_FACTORS_A 0x200, VLC_TABLE_ADDR0 0xec,
+ * ENTDEC_FE/BE_CONTROL 0xc/0x10).
+ *
+ * Supported here, by apple_vxd_h264_validate() and the slice checks:
+ * progressive frames, 8-bit 4:2:0, I, P and B slices, CAVLC and CABAC,
+ * 8x8 transform and scaling matrices (High profile), explicit and implicit
+ * weighted prediction.  Not supported: interlace (field pictures, MBAFF),
+ * FMO/ASO, SP/SI slices, the second deblock pass, alternate output.
+ */
+#include <linux/bitfield.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+
+#include "apple-vxd-h264-cmd.h"
+
+/* Entropy decoder (Apple 0x6000 bank = MSVDX VEC). */
+#define VXD_H264_FE_CONTROL		0x600c
+#define VXD_H264_BE_CONTROL		0x6010
+#define VXD_H264_VLC_ADDR0		0x60ec	/* + 22 */
+#define VXD_H264_VLC_ADDR_HI		0x61c0	/* + 2, the 4:2:2 tables */
+#define VXD_H264_FE_SPS0		0x6200	/* SPS0 PPS0 PIC0 SLICE0 SLICE1 */
+#define VXD_H264_FE_SLICE2		0x6218
+#define VXD_H264_BE_FOC0		0x6250	/* current, then per DPB slot */
+#define VXD_H264_BE_SPS0		0x62d8	/* ... SLICE1, CUR_PIC, REF0 */
+#define VXD_H264_BE_COL_PIC0		0x62f4	/* COL_PIC, LIST0_INVERSE, LIST1 */
+#define VXD_H264_BE_L0			0x633c
+#define VXD_H264_SCALING		0xe000
+/* Render commands (Apple 0x7000 bank = MSVDX CMDS). */
+#define VXD_H264_CMDS_SIZE		0x7000	/* display, coded, mode, Y, UV */
+#define VXD_H264_CMDS_INTRA		0x7018
+#define VXD_H264_CMDS_CACHE		0x701c
+#define VXD_H264_CMDS_WEIGHT_DENOM	0x7024
+#define VXD_H264_CMDS_STRIDE		0x7040
+#define VXD_H264_CMDS_REFS		0x7100	/* Y, UV per DPB slot */
+#define VXD_H264_CMDS_CHROMA		0x71b4
+#define VXD_H264_CMDS_WEIGHTS(list)	(0x7200 + 0x100 * (list))
+
+/* Apple's forced profile 3 translates to 0x11 on both ends (0x62c6564). */
+#define VXD_H264_ENTDEC_CONTROL		0x11
+#define VXD_H264_CACHE_POLICY		0x013c000c	/* 0x62c4788 */
+#define VXD_H264_WEIGHTS_DEFAULT	0x55		/* 5 / 5 */
+#define VXD_H264_SCALING_WORDS		56		/* 2 x 8x8 + 6 x 4x4 */
+#define VXD_H264_SCALING_FLAT		0x10
+#define VXD_H264_FIELD_FRAME		2		/* progressive */
+#define VXD_H264_WEIGHT_WORDS		64		/* 32 factors, 32 offsets */
+
+/* Slice codes of the core: I 0, P 1, B 2 (0xfffffff007a6e7b4). */
+#define VXD_H264_CODE_I			0
+#define VXD_H264_CODE_P			1
+#define VXD_H264_CODE_B			2
+
+/* The 26 constant VLC table registers (0xfffffff005597148 [E]). */
+static const u32 vxd_h264_vlc_addr[] = {
+	0x00026000, 0x000738a0, 0x000828f4, 0x000a312d, 0x000b5959,
+	0x000c517b, 0x000d1196, 0x000db1ad, 0x000e21be, 0x000e59c8,
+	0x000e79cd, 0x000eb1d3, 0x000ed1d8, 0x000f09dd, 0x000f71e7,
+	0x001041f6, 0x1256a4dd, 0x01489292, 0x11248050, 0x000022a2,
+	0x00002a02, 0x8108282a, 0x00000012,
+};
+
+static const u32 vxd_h264_vlc_addr_hi[] = {
+	0x0010920e, 0x0010d216, 0x0010f21c,
+};
+
+/*
+ * The scaling-list block (0x62c66b0 L39756-39766 of the dump): Inter Y and
+ * Intra Y 8x8, then the 4x4 lists in this order of the H.264 list index
+ * (Intra Y, Inter Y, Inter Cb, Intra Cb, Inter Cr, Intra Cr), each in
+ * raster order: AppleD5500's scaling_list() parser (0xfffffff00629c918)
+ * stores list[zigzag[i]], and its defaults (0xfffffff005596170) are raster
+ * tables, which is also V4L2's order.
+ */
+static const u8 vxd_h264_scaling_4x4_order[6] = { 0, 3, 4, 1, 5, 2 };
+
+static int vxd_h264_slice_code(u8 slice_type)
+{
+	switch (slice_type) {
+	case V4L2_H264_SLICE_TYPE_I:
+		return VXD_H264_CODE_I;
+	case V4L2_H264_SLICE_TYPE_P:
+		return VXD_H264_CODE_P;
+	case V4L2_H264_SLICE_TYPE_B:
+		return VXD_H264_CODE_B;
+	default:
+		return -EINVAL;
+	}
+}
+
+u32 apple_vxd_h264_colocated_size(unsigned int width_mbs,
+				  unsigned int height_mbs)
+{
+	/* (W * H * 0x80 + 0x41ff) & ~0xfff, 0xfffffff0062c3b8c [E] */
+	return (width_mbs * height_mbs * 0x80 + 0x41ff) & ~0xfffU;
+}
+
+static bool vxd_h264_has_scaling(const struct v4l2_ctrl_h264_pps *pps)
+{
+	return pps->flags & V4L2_H264_PPS_FLAG_SCALING_MATRIX_PRESENT;
+}
+
+/* A scaling factor is 1..255: a zero list means the control was never set. */
+static bool vxd_h264_scaling_set(const struct v4l2_ctrl_h264_pps *pps,
+				 const struct v4l2_ctrl_h264_scaling_matrix *m)
+{
+	unsigned int i, j;
+
+	if (!m)
+		return false;
+	for (i = 0; i < 6; i++)
+		for (j = 0; j < 16; j++)
+			if (!m->scaling_list_4x4[i][j])
+				return false;
+	if (!(pps->flags & V4L2_H264_PPS_FLAG_TRANSFORM_8X8_MODE))
+		return true;
+	for (i = 0; i < 2; i++)
+		for (j = 0; j < 64; j++)
+			if (!m->scaling_list_8x8[i][j])
+				return false;
+	return true;
+}
+
+int apple_vxd_h264_validate(const struct v4l2_ctrl_h264_sps *sps,
+			    const struct v4l2_ctrl_h264_pps *pps,
+			    const struct v4l2_ctrl_h264_scaling_matrix *scaling,
+			    const char **why)
+{
+	if (!(sps->flags & V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY))
+		*why = "interlaced coding (frame_mbs_only_flag = 0)";
+	else if (sps->flags & V4L2_H264_SPS_FLAG_SEPARATE_COLOUR_PLANE)
+		*why = "separate colour planes";
+	else if (V4L2_H264_SPS_HAS_CHROMA_FORMAT(sps) && sps->chroma_format_idc != 1)
+		*why = "chroma format other than 4:2:0";
+	else if (sps->bit_depth_luma_minus8 || sps->bit_depth_chroma_minus8)
+		*why = "bit depth above 8";
+	else if (sps->flags & V4L2_H264_SPS_FLAG_QPPRIME_Y_ZERO_TRANSFORM_BYPASS)
+		*why = "lossless transform bypass";
+	else if (pps->num_slice_groups_minus1)
+		*why = "slice groups (FMO)";
+	else if (pps->weighted_bipred_idc > 2)
+		*why = "weighted_bipred_idc out of range";
+	else if (vxd_h264_has_scaling(pps) && !vxd_h264_scaling_set(pps, scaling))
+		*why = "scaling matrices signalled but the SCALING_MATRIX control is not set";
+	else
+		return 0;
+	return -EINVAL;
+}
+
+/* Bits of the slice NAL before slice_data(), escaped, NAL header included. */
+static u32 vxd_h264_header_bits(const struct v4l2_ctrl_h264_pps *pps,
+				const struct apple_vxd_h264_slice *sl)
+{
+	u32 bits = 8 + sl->header_bits_raw;
+
+	/* CABAC slice data starts after cabac_alignment_one_bit padding. */
+	if (pps->flags & V4L2_H264_PPS_FLAG_ENTROPY_CODING_MODE)
+		bits = ALIGN(bits, 8);
+	return bits;
+}
+
+/* POC registers: 17 bits, sign in bit 16 (0x62c66b0 L39779-39792). */
+static u32 vxd_h264_poc(s32 poc)
+{
+	return ((u32)poc >> 15 & 0x10000) | ((u32)poc & 0xffff);
+}
+
+/* Explicit weights in the bitstream (the kext's 0x62be348 condition). */
+static bool vxd_h264_explicit_weights(const struct v4l2_ctrl_h264_pps *pps,
+				      int code)
+{
+	return ((pps->flags & V4L2_H264_PPS_FLAG_WEIGHTED_PRED) &&
+		code == VXD_H264_CODE_P) ||
+	       (pps->weighted_bipred_idc == 1 && code == VXD_H264_CODE_B);
+}
+
+/* The weight tables go out for explicit and implicit modes (L40086). */
+static bool vxd_h264_weight_tables(const struct v4l2_ctrl_h264_pps *pps,
+				   int code)
+{
+	return ((pps->flags & V4L2_H264_PPS_FLAG_WEIGHTED_PRED) &&
+		code == VXD_H264_CODE_P) ||
+	       (pps->weighted_bipred_idc && code == VXD_H264_CODE_B);
+}
+
+static void vxd_h264_scaling_words(const struct apple_vxd_h264_frame *f,
+				   u32 *w)
+{
+	const struct v4l2_ctrl_h264_scaling_matrix *m = f->scaling;
+	u8 bytes[4 * VXD_H264_SCALING_WORDS];
+	unsigned int i;
+
+	memset(bytes, VXD_H264_SCALING_FLAT, sizeof(bytes));
+	if (vxd_h264_has_scaling(f->pps) && m) {
+		/* 8x8 lists only with the 8x8 transform (0x62be538 L33469). */
+		if (f->pps->flags & V4L2_H264_PPS_FLAG_TRANSFORM_8X8_MODE) {
+			memcpy(&bytes[0], m->scaling_list_8x8[1], 64);
+			memcpy(&bytes[64], m->scaling_list_8x8[0], 64);
+		}
+		for (i = 0; i < 6; i++)
+			memcpy(&bytes[128 + 16 * i],
+			       m->scaling_list_4x4[vxd_h264_scaling_4x4_order[i]],
+			       16);
+	}
+	for (i = 0; i < VXD_H264_SCALING_WORDS; i++)
+		w[i] = bytes[4 * i] | bytes[4 * i + 1] << 8 |
+		       bytes[4 * i + 2] << 16 | (u32)bytes[4 * i + 3] << 24;
+}
+
+/* @n bytes of a reference list, four per word, low byte first. */
+static unsigned int vxd_h264_pack_list(const u8 *list, unsigned int n, u32 *w)
+{
+	unsigned int i, words = DIV_ROUND_UP(n, 4);
+
+	for (i = 0; i < words; i++)
+		w[i] = 0;
+	for (i = 0; i < 4 * words; i++)
+		w[i / 4] |= (u32)list[i] << (8 * (i % 4));
+	return words;
+}
+
+static bool vxd_h264_dpb_active(const struct v4l2_h264_dpb_entry *e)
+{
+	return (e->flags & V4L2_H264_DPB_ENTRY_FLAG_VALID) &&
+	       (e->flags & V4L2_H264_DPB_ENTRY_FLAG_ACTIVE);
+}
+
+/*
+ * B slices: the picture order counts (BE_FOC0/1, then TOP/BOT_FOC per
+ * hardware DPB slot) and the co-located picture block (BE_COL_PIC0,
+ * BE_BASE_ADDR_COL_PIC, BE_LIST0_INVERSE x 8, BE_LIST1), 0x62c66b0
+ * L39776-39887.  The co-located picture is RefPicList1[0].
+ */
+static void vxd_h264_emit_b(struct apple_vxd_cmdbuf *cb,
+			    const struct apple_vxd_h264_frame *f,
+			    const u8 *l0, const u8 *l1, u8 l1_minus1,
+			    unsigned int highwater, u32 *w)
+{
+	const struct v4l2_ctrl_h264_decode_params *dp = f->dp;
+	u8 inverse[V4L2_H264_REF_LIST_LEN];
+	unsigned int i, n;
+	u8 col = l1[0];
+
+	w[0] = vxd_h264_poc(dp->top_field_order_cnt);
+	w[1] = vxd_h264_poc(dp->bottom_field_order_cnt);
+	for (i = 0; i < highwater; i++) {
+		const struct v4l2_h264_dpb_entry *e = &dp->dpb[i];
+		bool active = vxd_h264_dpb_active(e);
+
+		w[2 + 2 * i] = active ? vxd_h264_poc(e->top_field_order_cnt) : 0;
+		w[3 + 2 * i] = active ? vxd_h264_poc(e->bottom_field_order_cnt) : 0;
+	}
+	apple_vxd_cmd_block(cb, VXD_H264_BE_FOC0, 0, w, 2 + 2 * highwater);
+
+	if (col < V4L2_H264_NUM_DPB_ENTRIES && f->dpb_colocated[col]) {
+		const struct v4l2_h264_dpb_entry *e = &dp->dpb[col];
+		s32 cur = min(dp->top_field_order_cnt, dp->bottom_field_order_cnt);
+		s64 dtop = abs((s64)cur - e->top_field_order_cnt);
+		s64 dbot = abs((s64)cur - e->bottom_field_order_cnt);
+
+		/*
+		 * Frame co-located picture: COL_NOTFRAME and COL_MBAFF clear,
+		 * bottom field flag by POC distance, as psb_video and the kext.
+		 */
+		w[0] = dbot <= dtop;
+		w[1] = f->dpb_colocated[col];
+	} else {
+		w[0] = APPLE_VXD_H264_UNUSED_VA;
+		w[1] = APPLE_VXD_H264_UNUSED_VA;
+	}
+
+	/* Inverse L0: first position of each slot (bottom fields at +16). */
+	memset(inverse, APPLE_VXD_H264_NO_REF, sizeof(inverse));
+	for (i = V4L2_H264_REF_LIST_LEN; i--; )
+		if (l0[i] != APPLE_VXD_H264_NO_REF)
+			inverse[(l0[i] >> 3 & 0x10) | (l0[i] & 0x1f)] = i;
+	vxd_h264_pack_list(inverse, V4L2_H264_REF_LIST_LEN, &w[2]);
+	n = vxd_h264_pack_list(l1, l1_minus1 + 1, &w[10]);
+	apple_vxd_cmd_block(cb, VXD_H264_BE_COL_PIC0, 0, w, 10 + n);
+}
+
+/*
+ * H264_WEIGHTED_FACTORS/OFFSET A (list 0) and B (list 1), 32 entries each
+ * (0x62c66b0 L40086-40134, field layout as psb_video's msvdx_cmds_io2.h).
+ * Implicit bi-prediction leaves the kext's tables unrefreshed (zero in a
+ * fresh context); the core derives those weights from the POCs.
+ */
+static void vxd_h264_emit_weights(struct apple_vxd_cmdbuf *cb,
+				  const struct apple_vxd_h264_frame *f,
+				  const struct apple_vxd_h264_slice *sl,
+				  const u8 *ref_slots, unsigned int list,
+				  u8 n_minus1, int code, u32 *w)
+{
+	bool expl = vxd_h264_explicit_weights(f->pps, code);
+	unsigned int i;
+
+	memset(w, 0, VXD_H264_WEIGHT_WORDS * sizeof(*w));
+	for (i = 0; expl && i <= n_minus1; i++) {
+		const struct apple_vxd_h264_weight *wt = &sl->weights[list][i];
+
+		if (ref_slots[i] == APPLE_VXD_H264_NO_REF)
+			continue;
+		w[i] = ((u32)wt->weight[2] & 0x1ff) << 18 |
+		       ((u32)wt->weight[1] & 0x1ff) << 9 |
+		       ((u32)wt->weight[0] & 0x1ff);
+		w[32 + i] = (u32)(u8)wt->offset[2] << 16 |
+			    (u32)(u8)wt->offset[1] << 8 | (u8)wt->offset[0];
+	}
+	apple_vxd_cmd_block(cb, VXD_H264_CMDS_WEIGHTS(list), 0, w,
+			    VXD_H264_WEIGHT_WORDS);
+}
+
+static void vxd_h264_emit_slice(struct apple_vxd_cmdbuf *cb,
+				const struct apple_vxd_h264_frame *f,
+				unsigned int idx, int code)
+{
+	const struct v4l2_ctrl_h264_sps *sps = f->sps;
+	const struct v4l2_ctrl_h264_pps *pps = f->pps;
+	const struct apple_vxd_h264_slice *sl = &f->slices[idx];
+	const u8 *l0 = f->ref_slots[idx][0];
+	const u8 *l1 = f->ref_slots[idx][1];
+	u32 w = sps->pic_width_in_mbs_minus1 + 1;
+	u32 h = sps->pic_height_in_map_units_minus1 + 1;
+	u32 mb_x = sl->first_mb_in_slice % w, mb_y = sl->first_mb_in_slice / w;
+	u32 chroma = V4L2_H264_SPS_HAS_CHROMA_FORMAT(sps) ? sps->chroma_format_idc : 1;
+	u32 wmode = !!(pps->flags & V4L2_H264_PPS_FLAG_WEIGHTED_PRED) |
+		    pps->weighted_bipred_idc << 1;
+	u32 hdr[VXD_CMD_SLICE_BLOCK_WORDS - 1] = { };
+	u32 sps0, pps0, pic0, slice0, slice1, skip, bits, longterm = 0;
+	unsigned int i, n, highwater = 0;
+	bool min_bipred8, used[V4L2_H264_NUM_DPB_ENTRIES] = { };
+	/*
+	 * I slices zero both counts; P slices keep the parsed L1 count (the
+	 * PPS default, 0x62a0058) as the kext does (0x62c5fb8 L39477-39483).
+	 */
+	u8 l0_minus1 = code ? sl->num_ref_idx_l0_active_minus1 : 0;
+	u8 l1_minus1 = code ? sl->num_ref_idx_l1_active_minus1 : 0;
+	/* Scratch for one block at a time: the largest is the weight table. */
+	u32 buf[VXD_H264_WEIGHT_WORDS];
+
+	min_bipred8 = w > 80 && sps->level_idc > 30;
+	sps0 = ((chroma >> 1) & 1) << 28 | sps->bit_depth_chroma_minus8 << 25 |
+	       sps->bit_depth_luma_minus8 << 22 | 1 << 14 | 3 << 12 |
+	       min_bipred8 << 11 |
+	       !!(sps->flags & V4L2_H264_SPS_FLAG_DIRECT_8X8_INFERENCE) << 10 |
+	       (chroma & 1) << 9 |
+	       !!(sps->flags & V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY) << 8 | (w - 1);
+	pps0 = ((u8)pps->second_chroma_qp_index_offset & 31) << 24 |
+	       ((u8)pps->chroma_qp_index_offset & 31) << 16 |
+	       pps->weighted_bipred_idc << 8 |
+	       pps->num_slice_groups_minus1 << 4 |
+	       !!(pps->flags & V4L2_H264_PPS_FLAG_ENTROPY_CODING_MODE) << 2 |
+	       !!(pps->flags & V4L2_H264_PPS_FLAG_CONSTRAINED_INTRA_PRED) << 1 |
+	       !!(pps->flags & V4L2_H264_PPS_FLAG_TRANSFORM_8X8_MODE);
+	pic0 = (w * h - 1) << 16 | (h - 1) << 8 | !!f->dp->nal_ref_idc << 3;
+	slice0 = sl->direct_spatial_mv_pred << 31 |
+		 sl->disable_deblocking_filter_idc << 28 |
+		 ((u8)sl->slice_alpha_c0_offset_div2 & 15) << 24 |
+		 ((u8)sl->slice_beta_offset_div2 & 15) << 20 |
+		 VXD_H264_FIELD_FRAME << 18 | code << 16 |
+		 sl->cabac_init_idc << 14 | (idx & 0x3fff);
+	slice1 = mb_y << 24 | mb_x << 16 |
+		 ((26 + pps->pic_init_qp_minus26 + sl->slice_qp_delta) & 63) << 10 |
+		 (l1_minus1 & 31) << 5 | (l0_minus1 & 31);
+
+	/* CTRL_ALLOC_HEADER; MODE_CONFIG = weighted_pred | bipred_idc << 1. */
+	hdr[0] = !!(pps->flags & V4L2_H264_PPS_FLAG_CONSTRAINED_INTRA_PRED) << 23 |
+		 wmode << 17 |
+		 sl->disable_deblocking_filter_idc << 12 |
+		 ((u8)sl->slice_alpha_c0_offset_div2 & 15) << 8 |
+		 ((u8)sl->slice_beta_offset_div2 & 15) << 4 |
+		 VXD_H264_FIELD_FRAME << 2 | code;
+	hdr[2] = f->dst_stride | f->dst_stride << 16;
+	hdr[3] = mb_x | mb_y << 16;
+	hdr[4] = (w - 1) | (h - 1) << 16;
+	hdr[8] = sps->bit_depth_chroma_minus8 << 12 |
+		 sps->bit_depth_luma_minus8 << 8 | chroma;
+	apple_vxd_cmd_ctrl_alloc(cb, hdr);
+
+	/* CAVLC table + its address registers, every slice. */
+	apple_vxd_cmd_dma(cb, VXD_CMD_DMA_TYPE_VLC, APPLE_VXD_H264_VLC_BYTES,
+			  f->bufs.cavlc);
+	apple_vxd_cmd_group_open(cb, 0);
+	for (i = 0; i < ARRAY_SIZE(vxd_h264_vlc_addr); i++)
+		apple_vxd_cmd_reg(cb, VXD_H264_VLC_ADDR0 + 4 * i,
+				  vxd_h264_vlc_addr[i]);
+	for (i = 0; i < ARRAY_SIZE(vxd_h264_vlc_addr_hi); i++)
+		apple_vxd_cmd_reg(cb, VXD_H264_VLC_ADDR_HI + 4 * i,
+				  vxd_h264_vlc_addr_hi[i]);
+	apple_vxd_cmd_group_close(cb);
+
+	/*
+	 * The slice NAL from its header byte: whole 32-bit words of header go
+	 * by DMA offset, the rest by the SR bit offset (0x62c5b18 [E]).
+	 */
+	bits = vxd_h264_header_bits(pps, sl);
+	skip = (bits & 0xffe0) >> 3;
+	apple_vxd_cmd_slice_desc(cb, bits & 31, sl->nal_size - skip);
+	apple_vxd_cmd_load(cb, f->src_va + sl->nal_offset + skip,
+			   sl->nal_size - skip);
+
+	/* Entropy front end. */
+	apple_vxd_cmd_group_open(cb, 0);
+	apple_vxd_cmd_reg(cb, VXD_H264_FE_CONTROL, VXD_H264_ENTDEC_CONTROL);
+	apple_vxd_cmd_reg(cb, VXD_H264_FE_SPS0, sps0);
+	apple_vxd_cmd_reg(cb, VXD_H264_FE_SPS0 + 4, pps0);
+	apple_vxd_cmd_reg(cb, VXD_H264_FE_SPS0 + 8, pic0);
+	apple_vxd_cmd_reg(cb, VXD_H264_FE_SPS0 + 12, slice0);
+	apple_vxd_cmd_reg(cb, VXD_H264_FE_SPS0 + 16, slice1);
+	apple_vxd_cmd_reg(cb, VXD_H264_FE_SLICE2, sl->first_mb_in_slice << 16);
+	apple_vxd_cmd_group_close(cb);
+
+	/* Entropy back end. */
+	buf[0] = VXD_H264_ENTDEC_CONTROL;
+	apple_vxd_cmd_block(cb, VXD_H264_BE_CONTROL, 0, buf, 1);
+
+	for (i = 0; i < V4L2_H264_NUM_DPB_ENTRIES; i++) {
+		const struct v4l2_h264_dpb_entry *e = &f->dp->dpb[i];
+
+		if (!vxd_h264_dpb_active(e))
+			continue;
+		highwater = i + 1;
+		if (e->flags & V4L2_H264_DPB_ENTRY_FLAG_LONG_TERM)
+			longterm |= BIT(i);
+	}
+	buf[0] = sps0;
+	buf[1] = pps0;
+	buf[2] = pic0;
+	buf[3] = slice0;
+	buf[4] = slice1;
+	buf[5] = f->colocated;
+	buf[6] = longterm;
+	apple_vxd_cmd_block(cb, VXD_H264_BE_SPS0, 0, buf, 7);
+
+	vxd_h264_scaling_words(f, buf);
+	apple_vxd_cmd_block(cb, VXD_H264_SCALING, 0, buf,
+			    VXD_H264_SCALING_WORDS);
+
+	if (code == VXD_H264_CODE_B)
+		vxd_h264_emit_b(cb, f, l0, l1, l1_minus1, highwater, buf);
+
+	if (code) {
+		n = vxd_h264_pack_list(l0, l0_minus1 + 1, buf);
+		apple_vxd_cmd_block(cb, VXD_H264_BE_L0, 0, buf, n);
+	}
+
+	/* Surfaces only for the references this slice's lists use. */
+	for (i = 0; code && i <= l0_minus1; i++)
+		if (l0[i] < V4L2_H264_NUM_DPB_ENTRIES)
+			used[l0[i]] = true;
+	for (i = 0; code == VXD_H264_CODE_B && i <= l1_minus1; i++)
+		if (l1[i] < V4L2_H264_NUM_DPB_ENTRIES)
+			used[l1[i]] = true;
+	if (highwater) {
+		for (i = 0; i < highwater; i++) {
+			bool real = used[i] && f->dpb_luma[i];
+
+			buf[2 * i] = real ? f->dpb_luma[i] : APPLE_VXD_H264_UNUSED_VA;
+			buf[2 * i + 1] = real ? f->dpb_chroma[i] :
+						APPLE_VXD_H264_UNUSED_VA;
+		}
+		apple_vxd_cmd_block(cb, VXD_H264_CMDS_REFS, VXD_CMD_BLOCK_FLAG_REFS,
+				    buf, 2 * highwater);
+	}
+
+	if (vxd_h264_weight_tables(pps, code)) {
+		vxd_h264_emit_weights(cb, f, sl, l0, 0, l0_minus1, code, buf);
+		if (code == VXD_H264_CODE_B)
+			vxd_h264_emit_weights(cb, f, sl, l1, 1, l1_minus1, code,
+					      buf);
+	}
+
+	/* Picture geometry, operating mode, output. */
+	buf[0] = (16 * h - 1) << 12 | (16 * w - 1);
+	buf[1] = buf[0];
+	buf[2] = APPLE_VXD_H264_OPMODE_BASE | 2 << 20 | (chroma != 0) << 12;
+	buf[3] = f->dst_luma;
+	buf[4] = f->dst_chroma;
+	apple_vxd_cmd_block(cb, VXD_H264_CMDS_SIZE, 0, buf, 5);
+	buf[0] = f->bufs.intra;
+	apple_vxd_cmd_block(cb, VXD_H264_CMDS_INTRA, 0, buf, 1);
+	/* Denominators: the slice's when explicit, 5 / 5 otherwise. */
+	buf[0] = vxd_h264_explicit_weights(pps, code) ?
+		 sl->chroma_log2_weight_denom << 4 | sl->luma_log2_weight_denom :
+		 VXD_H264_WEIGHTS_DEFAULT;
+	apple_vxd_cmd_block(cb, VXD_H264_CMDS_WEIGHT_DENOM, 0, buf, 1);
+	buf[0] = VXD_H264_CACHE_POLICY;
+	apple_vxd_cmd_block(cb, VXD_H264_CMDS_CACHE, 0, buf, 1);
+	buf[0] = f->dst_stride & ~63U;
+	apple_vxd_cmd_block(cb, VXD_H264_CMDS_STRIDE, 0, buf, 1);
+	buf[0] = chroma;
+	apple_vxd_cmd_block(cb, VXD_H264_CMDS_CHROMA, 0, buf, 1);
+
+	apple_vxd_cmd_end_slice(cb);
+}
+
+/*
+ * One picture: per slice, the chunk and its kind-1 packet (payload as
+ * 0x62c4c98 fills it, L39392-39429 of the dump).  Returns 0, or -EINVAL /
+ * -ENOSPC with @why set; the buffer is then unusable for this picture.
+ */
+int apple_vxd_h264_build(struct apple_vxd_cmdbuf *cb,
+			 const struct apple_vxd_h264_frame *f,
+			 const char **why)
+{
+	u32 opmode = APPLE_VXD_H264_OPMODE_BASE | 2 << 20 | 1 << 12;
+	unsigned int i;
+	int ret;
+
+	*why = NULL;
+	ret = apple_vxd_h264_validate(f->sps, f->pps, f->scaling, why);
+	if (ret)
+		return ret;
+	if (!f->nslices) {
+		*why = "no slices";
+		return -EINVAL;
+	}
+
+	for (i = 0; i < f->nslices; i++) {
+		const struct apple_vxd_h264_slice *sl = &f->slices[i];
+		int code = vxd_h264_slice_code(sl->slice_type);
+		u32 off, bytes, *p;
+
+		if (code < 0) {
+			*why = "SP/SI slices are not supported";
+			return -EINVAL;
+		}
+		if (vxd_h264_header_bits(f->pps, sl) >= 0x10000 ||
+		    (vxd_h264_header_bits(f->pps, sl) & 0xffe0) >> 3 >= sl->nal_size) {
+			*why = "slice header longer than the NAL";
+			return -EINVAL;
+		}
+
+		vxd_h264_emit_slice(cb, f, i, code);
+		ret = apple_vxd_cmdbuf_chunk_end_exact(cb, &off, &bytes);
+		if (ret) {
+			*why = "command buffer full or misused";
+			return ret;
+		}
+
+		p = apple_vxd_cmdbuf_add_packet(cb, VXD_PKT_MAGIC0,
+						VXD_PKT_H264_PAYLOAD);
+		if (!p) {
+			*why = "packet list full";
+			return -ENOSPC;
+		}
+		p[VXD_PKT_FLAGS / 4] = (i ? 0 : 1) |
+				       (!i && f->first_picture ? 0x10 : 0);
+		p[VXD_PKT_W4 / 4] = opmode;
+		p[VXD_PKT_CMD_BYTES / 4] = bytes;
+		p[VXD_PKT_W2 / 4] = cb->va + off;
+		p[VXD_PKT_W5 / 4] = f->bufs.stream_state;
+		p[VXD_PKT_KIND / 4] = VXD_PKT_KIND_PICTURE;
+		p[VXD_PKT_NOT_REF / 4] = !f->dp->nal_ref_idc;
+	}
+	return 0;
+}
diff --git a/drivers/media/platform/apple/vxd/apple-vxd-h264-cmd.h b/drivers/media/platform/apple/vxd/apple-vxd-h264-cmd.h
new file mode 100644
index 000000000..192678d47
--- /dev/null
+++ b/drivers/media/platform/apple/vxd/apple-vxd-h264-cmd.h
@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Apple VXD - H.264 (AVC) command-stream builder
+ *
+ * Pure function of its inputs: no allocation, no MMIO, no V4L2 core, so
+ * it builds unchanged in the host harness (scripts/vdec/host/) and is
+ * diffed word for word against tools/ds-video/cmdstream.py --gen.
+ */
+#ifndef __APPLE_VXD_H264_CMD_H__
+#define __APPLE_VXD_H264_CMD_H__
+
+#include <linux/types.h>
+#include <linux/v4l2-controls.h>
+
+#include "apple-vxd-cmd.h"
+#include "apple-vxd-h264-parse.h"
+
+/* Hardware DPB slot of a reference list entry; slot == V4L2 dpb[] index. */
+#define APPLE_VXD_H264_NO_REF		0xff
+#define APPLE_VXD_H264_UNUSED_VA	0xdeadbeef
+
+/* The CAVLC table travels by CMD_DMA, 0x440 bytes, every slice. */
+#define APPLE_VXD_H264_VLC_BYTES	0x440
+
+/* Operating mode for 8-bit 4:2:0 frames (CMDS 0x7008, payload +0x08). */
+#define APPLE_VXD_H264_OPMODE_BASE	0x10010000
+
+/* Device VAs of the decode context's own buffers (DecodeCreateH264VLD). */
+struct apple_vxd_h264_bufs {
+	u32 cavlc;			/* 0x1000, the 0x440-byte VLC table */
+	u32 intra;			/* IntraBuffer */
+	u32 stream_state;		/* StreamStateBuffer -> message w5 */
+};
+
+struct apple_vxd_h264_frame {
+	const struct v4l2_ctrl_h264_sps *sps;
+	const struct v4l2_ctrl_h264_pps *pps;
+	const struct v4l2_ctrl_h264_decode_params *dp;
+	/*
+	 * Used when the PPS has V4L2_H264_PPS_FLAG_SCALING_MATRIX_PRESENT;
+	 * flat (16) lists otherwise.
+	 */
+	const struct v4l2_ctrl_h264_scaling_matrix *scaling;
+	const struct apple_vxd_h264_slice *slices;
+	unsigned int nslices;
+	/* Per slice: final RefPicList0/1 as DPB slots, NO_REF past the end. */
+	const u8 (*ref_slots)[2][V4L2_H264_REF_LIST_LEN];
+
+	u32 src_va;			/* OUTPUT buffer, byte 0 */
+	u32 dst_luma, dst_chroma;	/* CAPTURE planes */
+	u32 dst_stride;			/* bytes, luma and chroma (NV12) */
+	u32 colocated;			/* CAPTURE's stored-MB parameter buffer */
+	u32 dpb_luma[V4L2_H264_NUM_DPB_ENTRIES];	/* 0: not resolvable */
+	u32 dpb_chroma[V4L2_H264_NUM_DPB_ENTRIES];
+	/* Each reference's stored-MB buffer: the B co-located picture's. */
+	u32 dpb_colocated[V4L2_H264_NUM_DPB_ENTRIES];
+	struct apple_vxd_h264_bufs bufs;
+	bool first_picture;		/* first picture of the context */
+};
+
+int apple_vxd_h264_validate(const struct v4l2_ctrl_h264_sps *sps,
+			    const struct v4l2_ctrl_h264_pps *pps,
+			    const struct v4l2_ctrl_h264_scaling_matrix *scaling,
+			    const char **why);
+int apple_vxd_h264_build(struct apple_vxd_cmdbuf *cb,
+			 const struct apple_vxd_h264_frame *f,
+			 const char **why);
+u32 apple_vxd_h264_colocated_size(unsigned int width_mbs,
+				  unsigned int height_mbs);
+
+#endif /* __APPLE_VXD_H264_CMD_H__ */
diff --git a/drivers/media/platform/apple/vxd/apple-vxd-h264-parse.c b/drivers/media/platform/apple/vxd/apple-vxd-h264-parse.c
new file mode 100644
index 000000000..55739366d
--- /dev/null
+++ b/drivers/media/platform/apple/vxd/apple-vxd-h264-parse.c
@@ -0,0 +1,544 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Apple VXD - H.264 slice finder and slice-header parser
+ *
+ * Frame-based decode with Annex-B start codes: the OUTPUT buffer carries
+ * the whole access unit and V4L2_CID_STATELESS_H264_SLICE_PARAMS is not
+ * used (uapi: "When this mode is selected, ... SLICE_PARAMS is not
+ * used").  The MSVDX command stream still needs per-slice values: where
+ * the slice bytes are (the 0xa load), how many header bits precede the
+ * slice data (the 0xb descriptor), the slice type, first MB, QP and
+ * deblocking parameters, and the reference-list modifications.  Apple's
+ * kext gets them from its own NAL walk; so does this file.
+ *
+ * Scope: progressive frames (frame_mbs_only), one slice group (no FMO),
+ * no separate colour planes, no data partitioning.  Everything else of
+ * clause 7.3.3 is parsed so the header length is exact.
+ */
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+
+#include "apple-vxd-h264-parse.h"
+
+struct vxd_bits {
+	const u8 *buf;			/* escaped bytes after the NAL header */
+	size_t len;
+	size_t byte;			/* raw index of the current byte */
+	unsigned int bit;		/* bits of buf[byte] already read */
+	unsigned int zeros;		/* zero bytes right before buf[byte] */
+	u32 rbsp_bits;			/* bits read, emulation bytes excluded */
+	bool overrun;
+};
+
+static unsigned int vxd_bit(struct vxd_bits *b)
+{
+	unsigned int v;
+
+	if (!b->bit && b->zeros >= 2 && b->byte < b->len &&
+	    b->buf[b->byte] == 0x03) {
+		/* emulation_prevention_three_byte */
+		b->byte++;
+		b->zeros = 0;
+	}
+	if (b->byte >= b->len) {
+		b->overrun = true;
+		return 0;
+	}
+
+	v = (b->buf[b->byte] >> (7 - b->bit)) & 1;
+	b->rbsp_bits++;
+	if (++b->bit == 8) {
+		b->zeros = b->buf[b->byte] ? 0 : b->zeros + 1;
+		b->byte++;
+		b->bit = 0;
+	}
+	return v;
+}
+
+static u32 vxd_bits_u(struct vxd_bits *b, unsigned int n)
+{
+	u32 v = 0;
+
+	while (n--)
+		v = (v << 1) | vxd_bit(b);
+	return v;
+}
+
+static u32 vxd_bits_ue(struct vxd_bits *b)
+{
+	unsigned int zeros = 0;
+
+	while (!vxd_bit(b)) {
+		if (b->overrun || ++zeros > 31) {
+			b->overrun = true;
+			return 0;
+		}
+	}
+	if (!zeros)
+		return 0;
+	return (u32)((1ULL << zeros) - 1) + vxd_bits_u(b, zeros);
+}
+
+static s32 vxd_bits_se(struct vxd_bits *b)
+{
+	u32 k = vxd_bits_ue(b);
+
+	return (k & 1) ? (s32)((k + 1) / 2) : -(s32)(k / 2);
+}
+
+static bool vxd_slice_is(u8 slice_type, u8 want)
+{
+	return slice_type == want;
+}
+
+/* ChromaArrayType; profiles without chroma_format_idc in the SPS imply 4:2:0. */
+static unsigned int vxd_chroma_array_type(const struct v4l2_ctrl_h264_sps *sps)
+{
+	if (sps->flags & V4L2_H264_SPS_FLAG_SEPARATE_COLOUR_PLANE)
+		return 0;
+	if (!V4L2_H264_SPS_HAS_CHROMA_FORMAT(sps))
+		return 1;
+	return sps->chroma_format_idc;
+}
+
+static int vxd_parse_mods(struct vxd_bits *b, struct apple_vxd_h264_slice *sl,
+			  unsigned int list)
+{
+	unsigned int n = 0;
+	u32 idc;
+
+	if (!vxd_bit(b))		/* ref_pic_list_modification_flag_lX */
+		return 0;
+
+	do {
+		idc = vxd_bits_ue(b);
+		if (idc > 3 || n >= ARRAY_SIZE(sl->mods[list]) || b->overrun)
+			return -EINVAL;
+		sl->mods[list][n].idc = idc;
+		sl->mods[list][n].val = idc < 3 ? vxd_bits_ue(b) : 0;
+		if (idc == 3)
+			break;
+		n++;
+	} while (1);
+	sl->num_mods[list] = n;
+	return 0;
+}
+
+/* luma/chroma_weight and _offset: se(v) in -128..127 (7.4.3.2, 8 bits). */
+static bool vxd_weight_ok(s32 v)
+{
+	return v >= -128 && v <= 127;
+}
+
+/*
+ * Clause 7.3.3.2, with the inferred weights and offsets filled in.  The
+ * command stream carries the table for every active reference.
+ */
+static int vxd_parse_pred_weight_table(struct vxd_bits *b,
+				       const struct v4l2_ctrl_h264_sps *sps,
+				       struct apple_vxd_h264_slice *sl)
+{
+	unsigned int chroma = vxd_chroma_array_type(sps);
+	unsigned int list, i, c, n;
+	u32 v;
+
+	v = vxd_bits_ue(b);
+	if (v > 7)
+		return -EINVAL;
+	sl->luma_log2_weight_denom = v;
+	if (chroma) {
+		v = vxd_bits_ue(b);
+		if (v > 7)
+			return -EINVAL;
+		sl->chroma_log2_weight_denom = v;
+	}
+
+	for (list = 0; list < 2; list++) {
+		if (list && !vxd_slice_is(sl->slice_type, V4L2_H264_SLICE_TYPE_B))
+			break;
+		n = list ? sl->num_ref_idx_l1_active_minus1 :
+			   sl->num_ref_idx_l0_active_minus1;
+		for (i = 0; i <= n && !b->overrun; i++) {
+			struct apple_vxd_h264_weight *w = &sl->weights[list][i];
+			s32 wt, off;
+
+			w->weight[0] = 1 << sl->luma_log2_weight_denom;
+			if (vxd_bit(b)) {	/* luma_weight_lX_flag */
+				wt = vxd_bits_se(b);
+				off = vxd_bits_se(b);
+				if (!vxd_weight_ok(wt) || !vxd_weight_ok(off))
+					return -EINVAL;
+				w->weight[0] = wt;
+				w->offset[0] = off;
+			}
+			if (!chroma)
+				continue;
+			for (c = 1; c < 3; c++)
+				w->weight[c] = 1 << sl->chroma_log2_weight_denom;
+			if (!vxd_bit(b))	/* chroma_weight_lX_flag */
+				continue;
+			for (c = 1; c < 3; c++) {
+				wt = vxd_bits_se(b);
+				off = vxd_bits_se(b);
+				if (!vxd_weight_ok(wt) || !vxd_weight_ok(off))
+					return -EINVAL;
+				w->weight[c] = wt;
+				w->offset[c] = off;
+			}
+		}
+	}
+	return 0;
+}
+
+static int vxd_skip_dec_ref_pic_marking(struct vxd_bits *b,
+					struct apple_vxd_h264_slice *sl)
+{
+	unsigned int n = 0;
+	u32 mmco;
+
+	if (sl->nal_unit_type == APPLE_VXD_H264_NAL_IDR) {
+		sl->no_output_of_prior_pics = vxd_bit(b);
+		sl->long_term_reference = vxd_bit(b);
+		return 0;
+	}
+
+	sl->adaptive_ref_pic_marking = vxd_bit(b);
+	if (!sl->adaptive_ref_pic_marking)
+		return 0;
+
+	do {
+		mmco = vxd_bits_ue(b);
+		if (mmco > 6 || ++n > 66 || b->overrun)
+			return -EINVAL;
+		if (mmco == 1 || mmco == 3)
+			vxd_bits_ue(b);	/* difference_of_pic_nums_minus1 */
+		if (mmco == 2)
+			vxd_bits_ue(b);	/* long_term_pic_num */
+		if (mmco == 3 || mmco == 6)
+			vxd_bits_ue(b);	/* long_term_frame_idx */
+		if (mmco == 4)
+			vxd_bits_ue(b);	/* max_long_term_frame_idx_plus1 */
+	} while (mmco);
+	return 0;
+}
+
+/* Clause 7.3.3, for one NAL whose header byte is @nal[0]. */
+static int vxd_parse_slice_header(const u8 *nal, size_t len,
+				  const struct v4l2_ctrl_h264_sps *sps,
+				  const struct v4l2_ctrl_h264_pps *pps,
+				  struct apple_vxd_h264_slice *sl,
+				  const char **why)
+{
+	bool p, b_slice, sp, si, i_slice;
+	struct vxd_bits b = {
+		.buf = nal + 1,
+		.len = len - 1,
+	};
+	u32 v;
+
+	sl->nal_ref_idc = (nal[0] >> 5) & 3;
+	sl->nal_unit_type = nal[0] & 0x1f;
+
+	sl->first_mb_in_slice = vxd_bits_ue(&b);
+	v = vxd_bits_ue(&b);
+	if (v > 9) {
+		*why = "slice_type out of range";
+		return -EINVAL;
+	}
+	sl->slice_type = v % 5;
+	v = vxd_bits_ue(&b);
+	if (v != pps->pic_parameter_set_id) {
+		*why = "slice references another PPS";
+		return -EINVAL;
+	}
+	sl->pps_id = v;
+
+	p = vxd_slice_is(sl->slice_type, V4L2_H264_SLICE_TYPE_P);
+	b_slice = vxd_slice_is(sl->slice_type, V4L2_H264_SLICE_TYPE_B);
+	sp = vxd_slice_is(sl->slice_type, V4L2_H264_SLICE_TYPE_SP);
+	si = vxd_slice_is(sl->slice_type, V4L2_H264_SLICE_TYPE_SI);
+	i_slice = vxd_slice_is(sl->slice_type, V4L2_H264_SLICE_TYPE_I);
+
+	sl->frame_num = vxd_bits_u(&b, sps->log2_max_frame_num_minus4 + 4);
+	/* frame_mbs_only_flag is enforced by try_ctrl: no field_pic_flag. */
+	if (sl->nal_unit_type == APPLE_VXD_H264_NAL_IDR)
+		sl->idr_pic_id = vxd_bits_ue(&b);
+	if (sps->pic_order_cnt_type == 0) {
+		sl->pic_order_cnt_lsb =
+			vxd_bits_u(&b, sps->log2_max_pic_order_cnt_lsb_minus4 + 4);
+		if (pps->flags & V4L2_H264_PPS_FLAG_BOTTOM_FIELD_PIC_ORDER_IN_FRAME_PRESENT)
+			sl->delta_pic_order_cnt_bottom = vxd_bits_se(&b);
+	} else if (sps->pic_order_cnt_type == 1 &&
+		   !(sps->flags & V4L2_H264_SPS_FLAG_DELTA_PIC_ORDER_ALWAYS_ZERO)) {
+		sl->delta_pic_order_cnt[0] = vxd_bits_se(&b);
+		if (pps->flags & V4L2_H264_PPS_FLAG_BOTTOM_FIELD_PIC_ORDER_IN_FRAME_PRESENT)
+			sl->delta_pic_order_cnt[1] = vxd_bits_se(&b);
+	}
+	if (pps->flags & V4L2_H264_PPS_FLAG_REDUNDANT_PIC_CNT_PRESENT)
+		sl->redundant_pic_cnt = vxd_bits_ue(&b);
+	if (b_slice)
+		sl->direct_spatial_mv_pred = vxd_bit(&b);
+
+	sl->num_ref_idx_l0_active_minus1 = pps->num_ref_idx_l0_default_active_minus1;
+	sl->num_ref_idx_l1_active_minus1 = pps->num_ref_idx_l1_default_active_minus1;
+	if (p || sp || b_slice) {
+		sl->num_ref_idx_override = vxd_bit(&b);
+		if (sl->num_ref_idx_override) {
+			v = vxd_bits_ue(&b);
+			if (v > 31) {
+				*why = "num_ref_idx_l0_active_minus1 > 31";
+				return -EINVAL;
+			}
+			sl->num_ref_idx_l0_active_minus1 = v;
+			if (b_slice) {
+				v = vxd_bits_ue(&b);
+				if (v > 31) {
+					*why = "num_ref_idx_l1_active_minus1 > 31";
+					return -EINVAL;
+				}
+				sl->num_ref_idx_l1_active_minus1 = v;
+			}
+		}
+	}
+
+	if (!i_slice && !si) {
+		if (vxd_parse_mods(&b, sl, 0)) {
+			*why = "bad ref_pic_list_modification (l0)";
+			return -EINVAL;
+		}
+		if (b_slice && vxd_parse_mods(&b, sl, 1)) {
+			*why = "bad ref_pic_list_modification (l1)";
+			return -EINVAL;
+		}
+	}
+
+	if (((pps->flags & V4L2_H264_PPS_FLAG_WEIGHTED_PRED) && (p || sp)) ||
+	    (pps->weighted_bipred_idc == 1 && b_slice)) {
+		sl->has_pred_weight_table = true;
+		if (vxd_parse_pred_weight_table(&b, sps, sl)) {
+			*why = "bad pred_weight_table";
+			return -EINVAL;
+		}
+	}
+
+	if (sl->nal_ref_idc && vxd_skip_dec_ref_pic_marking(&b, sl)) {
+		*why = "bad dec_ref_pic_marking";
+		return -EINVAL;
+	}
+
+	if ((pps->flags & V4L2_H264_PPS_FLAG_ENTROPY_CODING_MODE) && !i_slice && !si)
+		sl->cabac_init_idc = vxd_bits_ue(&b);
+	sl->slice_qp_delta = vxd_bits_se(&b);
+	if (sp || si) {
+		if (sp)
+			sl->sp_for_switch = vxd_bit(&b);
+		sl->slice_qs_delta = vxd_bits_se(&b);
+	}
+	if (pps->flags & V4L2_H264_PPS_FLAG_DEBLOCKING_FILTER_CONTROL_PRESENT) {
+		sl->disable_deblocking_filter_idc = vxd_bits_ue(&b);
+		if (sl->disable_deblocking_filter_idc != 1) {
+			sl->slice_alpha_c0_offset_div2 = vxd_bits_se(&b);
+			sl->slice_beta_offset_div2 = vxd_bits_se(&b);
+		}
+	}
+	/* num_slice_groups_minus1 == 0 (try_ctrl): no slice_group_change_cycle. */
+
+	if (b.overrun) {
+		*why = "slice header runs past the NAL unit";
+		return -EINVAL;
+	}
+	sl->header_bits = b.rbsp_bits;
+	sl->header_bits_raw = b.byte * 8 + b.bit;
+	return 0;
+}
+
+/* Next 0x000001 at or after @from, or @len. */
+static size_t vxd_next_start_code(const u8 *buf, size_t len, size_t from)
+{
+	size_t i;
+
+	for (i = from; i + 3 <= len; i++)
+		if (!buf[i] && !buf[i + 1] && buf[i + 2] == 1)
+			return i;
+	return len;
+}
+
+/*
+ * Walk the Annex-B access unit and parse every slice NAL (types 1 and 5).
+ * Parameter sets, SEI, AUD and the like may be present and are skipped;
+ * redundant slices (redundant_pic_cnt > 0) are dropped as decoders may.
+ * The slices of one picture must agree on the picture-level syntax and
+ * come in increasing first_mb_in_slice order.
+ */
+int apple_vxd_h264_find_slices(const u8 *buf, size_t len,
+			       const struct v4l2_ctrl_h264_sps *sps,
+			       const struct v4l2_ctrl_h264_pps *pps,
+			       struct apple_vxd_h264_slice *slices,
+			       unsigned int max, unsigned int *count,
+			       const char **why)
+{
+	size_t sc = vxd_next_start_code(buf, len, 0);
+	unsigned int n = 0;
+	int ret;
+
+	*count = 0;
+	*why = NULL;
+	while (sc < len) {
+		size_t nal = sc + 3, next, end;
+		struct apple_vxd_h264_slice *sl;
+		u8 type;
+
+		next = vxd_next_start_code(buf, len, nal);
+		end = next;
+		while (end > nal && !buf[end - 1])	/* trailing_zero_8bits */
+			end--;
+		if (sc && !buf[sc - 1])			/* 4-byte start code */
+			sc--;
+		if (end <= nal)
+			goto next_nal;
+
+		if (buf[nal] & 0x80) {
+			*why = "forbidden_zero_bit set";
+			return -EINVAL;
+		}
+		type = buf[nal] & 0x1f;
+		if (type >= 2 && type <= 4) {
+			*why = "data partitioning is not supported";
+			return -EINVAL;
+		}
+		if (type != APPLE_VXD_H264_NAL_SLICE &&
+		    type != APPLE_VXD_H264_NAL_IDR)
+			goto next_nal;
+
+		if (n == max) {
+			*why = "too many slices in one picture";
+			return -E2BIG;
+		}
+		sl = &slices[n];
+		memset(sl, 0, sizeof(*sl));
+		sl->sc_offset = sc;
+		sl->nal_offset = nal;
+		sl->nal_size = end - nal;
+		ret = vxd_parse_slice_header(buf + nal, end - nal, sps, pps, sl, why);
+		if (ret)
+			return ret;
+		if (sl->redundant_pic_cnt)
+			goto next_nal;
+
+		if (!n && sl->first_mb_in_slice) {
+			*why = "the first slice does not start at macroblock 0";
+			return -EINVAL;
+		}
+		if (n && (sl->first_mb_in_slice <= slices[n - 1].first_mb_in_slice ||
+			  sl->frame_num != slices[0].frame_num ||
+			  sl->nal_unit_type != slices[0].nal_unit_type ||
+			  sl->idr_pic_id != slices[0].idr_pic_id ||
+			  sl->pic_order_cnt_lsb != slices[0].pic_order_cnt_lsb)) {
+			*why = "slices disagree on the picture or are out of order (ASO)";
+			return -EINVAL;
+		}
+		n++;
+next_nal:
+		sc = next;
+	}
+
+	if (!n) {
+		*why = "no slice NAL unit in the buffer";
+		return -ENOENT;
+	}
+	*count = n;
+	return 0;
+}
+
+/* FrameNumWrap of a short-term DPB entry (clause 8.2.4.1, frames). */
+static s32 vxd_pic_num(const struct v4l2_h264_dpb_entry *e, u32 cur_frame_num,
+		       u32 max_frame_num)
+{
+	return e->frame_num > cur_frame_num ? (s32)e->frame_num - (s32)max_frame_num :
+					      (s32)e->frame_num;
+}
+
+static bool vxd_dpb_is_ref(const struct v4l2_h264_dpb_entry *e)
+{
+	return (e->flags & V4L2_H264_DPB_ENTRY_FLAG_ACTIVE) &&
+	       (e->flags & V4L2_H264_DPB_ENTRY_FLAG_VALID);
+}
+
+/*
+ * Clause 8.2.4.3, frames only: apply the slice's modifications to the
+ * initial list (indices into dp->dpb, as built by the v4l2-h264 helper).
+ * @len is num_ref_idx_lX_active_minus1 + 1; @reflist holds at least
+ * V4L2_H264_REF_LIST_LEN entries.
+ */
+int apple_vxd_h264_modify_ref_list(const struct apple_vxd_h264_slice *sl,
+				   unsigned int list,
+				   const struct v4l2_ctrl_h264_sps *sps,
+				   const struct v4l2_ctrl_h264_decode_params *dp,
+				   struct v4l2_h264_reference *reflist,
+				   unsigned int len)
+{
+	struct v4l2_h264_reference tmp[V4L2_H264_REF_LIST_LEN + 1];
+	u32 max_frame_num = 1U << (sps->log2_max_frame_num_minus4 + 4);
+	s32 cur = sl->frame_num, pred = cur;
+	unsigned int m, ref_idx = 0;
+
+	if (!sl->num_mods[list])
+		return 0;
+	if (!len || len > V4L2_H264_REF_LIST_LEN)
+		return -EINVAL;
+
+	memcpy(tmp, reflist, len * sizeof(*tmp));
+	for (m = 0; m < sl->num_mods[list]; m++) {
+		const struct apple_vxd_h264_ref_mod *mod = &sl->mods[list][m];
+		unsigned int i, c, nidx;
+		bool long_term = mod->idc == 2;
+		s32 pic_num = 0;
+		int found = -1;
+
+		if (!long_term) {
+			s32 no_wrap, diff = mod->val + 1;
+
+			if (diff > (s32)max_frame_num)
+				return -EINVAL;
+			if (mod->idc == 0) {
+				no_wrap = pred - diff;
+				if (no_wrap < 0)
+					no_wrap += max_frame_num;
+			} else {
+				no_wrap = pred + diff;
+				if (no_wrap >= (s32)max_frame_num)
+					no_wrap -= max_frame_num;
+			}
+			pred = no_wrap;
+			pic_num = no_wrap > cur ? no_wrap - (s32)max_frame_num : no_wrap;
+		}
+
+		for (i = 0; i < V4L2_H264_NUM_DPB_ENTRIES; i++) {
+			const struct v4l2_h264_dpb_entry *e = &dp->dpb[i];
+			bool lt = e->flags & V4L2_H264_DPB_ENTRY_FLAG_LONG_TERM;
+
+			if (!vxd_dpb_is_ref(e) || lt != long_term)
+				continue;
+			if (long_term ? e->pic_num == mod->val :
+					vxd_pic_num(e, cur, max_frame_num) == pic_num) {
+				found = i;
+				break;
+			}
+		}
+		if (found < 0)
+			return -ENOENT;
+
+		for (c = len; c > ref_idx; c--)
+			tmp[c] = tmp[c - 1];
+		tmp[ref_idx].index = found;
+		tmp[ref_idx].fields = V4L2_H264_FRAME_REF;
+		ref_idx++;
+		nidx = ref_idx;
+		for (c = ref_idx; c <= len; c++)
+			if (tmp[c].index != found)
+				tmp[nidx++] = tmp[c];
+	}
+	memcpy(reflist, tmp, len * sizeof(*tmp));
+	return 0;
+}
diff --git a/drivers/media/platform/apple/vxd/apple-vxd-h264-parse.h b/drivers/media/platform/apple/vxd/apple-vxd-h264-parse.h
new file mode 100644
index 000000000..94aa3aa9c
--- /dev/null
+++ b/drivers/media/platform/apple/vxd/apple-vxd-h264-parse.h
@@ -0,0 +1,100 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Apple VXD - H.264 slice finder and slice-header parser
+ *
+ * The device runs in V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED with
+ * Annex-B start codes: the OUTPUT buffer holds a whole picture and the
+ * driver itself locates the slices, as AppleD5500's host NAL walk does
+ * (HOST_H264DecodeFrame, 0xfffffff0062965f4).  Every value the command
+ * stream needs per slice comes from here; the picture-invariant values
+ * come from the SPS/PPS/DECODE_PARAMS controls.
+ *
+ * Host-buildable: no allocation, no locking, no MMIO.
+ */
+#ifndef __APPLE_VXD_H264_PARSE_H__
+#define __APPLE_VXD_H264_PARSE_H__
+
+#include <linux/types.h>
+#include <linux/v4l2-controls.h>
+
+#define APPLE_VXD_H264_MAX_SLICES	128
+
+#define APPLE_VXD_H264_NAL_SLICE	1
+#define APPLE_VXD_H264_NAL_IDR		5
+
+struct apple_vxd_h264_ref_mod {
+	u8 idc;				/* modification_of_pic_nums_idc */
+	u32 val;			/* abs_diff_pic_num_minus1 or long_term_pic_num */
+};
+
+/*
+ * One pred_weight_table() entry with the values clause 7.4.3.2 infers for
+ * absent flags (weight 1 << denominator, offset 0), the way AppleD5500's
+ * copy (0xfffffff0062b0e9c) fills its per-reference arrays.
+ */
+struct apple_vxd_h264_weight {
+	s16 weight[3];			/* Y, Cb, Cr */
+	s8 offset[3];
+};
+
+struct apple_vxd_h264_slice {
+	/* Location in the OUTPUT buffer. */
+	u32 sc_offset;			/* first byte of the start code */
+	u32 nal_offset;			/* the NAL header byte */
+	u32 nal_size;			/* NAL header .. last non-zero byte */
+	/*
+	 * slice_header() length, counted from the first bit after the NAL
+	 * header byte: in RBSP bits, and in bits of the escaped byte stream
+	 * (emulation prevention bytes inside the header included).
+	 */
+	u32 header_bits;
+	u32 header_bits_raw;
+
+	u8 nal_ref_idc;
+	u8 nal_unit_type;
+	u32 first_mb_in_slice;
+	u8 slice_type;			/* 0..4 (V4L2_H264_SLICE_TYPE_*) */
+	u8 pps_id;
+	u16 frame_num;
+	u16 idr_pic_id;
+	u16 pic_order_cnt_lsb;
+	s32 delta_pic_order_cnt_bottom;
+	s32 delta_pic_order_cnt[2];
+	u8 redundant_pic_cnt;
+	bool direct_spatial_mv_pred;
+	bool num_ref_idx_override;
+	u8 num_ref_idx_l0_active_minus1;
+	u8 num_ref_idx_l1_active_minus1;
+	u8 num_mods[2];
+	struct apple_vxd_h264_ref_mod mods[2][V4L2_H264_REF_LIST_LEN + 1];
+	bool has_pred_weight_table;
+	u8 luma_log2_weight_denom;
+	u8 chroma_log2_weight_denom;
+	struct apple_vxd_h264_weight weights[2][V4L2_H264_REF_LIST_LEN];
+	bool no_output_of_prior_pics;
+	bool long_term_reference;
+	bool adaptive_ref_pic_marking;
+	u8 cabac_init_idc;
+	s8 slice_qp_delta;
+	bool sp_for_switch;
+	s8 slice_qs_delta;
+	u8 disable_deblocking_filter_idc;
+	s8 slice_alpha_c0_offset_div2;
+	s8 slice_beta_offset_div2;
+};
+
+int apple_vxd_h264_find_slices(const u8 *buf, size_t len,
+			       const struct v4l2_ctrl_h264_sps *sps,
+			       const struct v4l2_ctrl_h264_pps *pps,
+			       struct apple_vxd_h264_slice *slices,
+			       unsigned int max, unsigned int *count,
+			       const char **why);
+
+int apple_vxd_h264_modify_ref_list(const struct apple_vxd_h264_slice *sl,
+				   unsigned int list,
+				   const struct v4l2_ctrl_h264_sps *sps,
+				   const struct v4l2_ctrl_h264_decode_params *dp,
+				   struct v4l2_h264_reference *reflist,
+				   unsigned int len);
+
+#endif /* __APPLE_VXD_H264_PARSE_H__ */
diff --git a/drivers/media/platform/apple/vxd/apple-vxd-h264.c b/drivers/media/platform/apple/vxd/apple-vxd-h264.c
new file mode 100644
index 000000000..726df7525
--- /dev/null
+++ b/drivers/media/platform/apple/vxd/apple-vxd-h264.c
@@ -0,0 +1,570 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Apple VXD - H.264 backend (V4L2 stateless, frame based)
+ *
+ * Userspace parses the parameter sets and the DPB (V4L2 stateless
+ * contract); the OUTPUT buffer carries a whole Annex-B access unit.  Per
+ * picture this file
+ *
+ *   1. validates SPS/PPS against what the AVC recipe covers,
+ *   2. finds and parses the slices itself (frame-based mode has no
+ *      SLICE_PARAMS, apple-vxd-h264-parse.c),
+ *   3. builds RefPicList0/1 (v4l2-h264 helper + the slice's
+ *      modifications) and resolves the DPB to CAPTURE device addresses
+ *      (and, for B slices, stored-MB buffers) by timestamp,
+ *   4. builds the command stream (apple-vxd-h264-cmd.c) into a pooled
+ *      command buffer and submits one 0x81 message per slice.
+ *
+ * The job completes from the last packet's 0xc0 (apple_vxd_job_done()).
+ *
+ * The context owns the buffers DecodeCreateH264VLD allocates for the
+ * AVC path (ds-vxd-cmdstream.md section 16.5): the packed CAVLC table
+ * (0x1000, the 0x440-byte constant), the IntraBuffer and the
+ * StreamStateBuffer, each sized for the larger of Apple's two platform
+ * multipliers.  Each CAPTURE buffer carries its stored-macroblock
+ * parameter buffer (apple_vxd_buffer.aux).
+ */
+#include <linux/crc32.h>
+#include <linux/slab.h>
+#include <linux/sizes.h>
+
+#include <media/v4l2-h264.h>
+
+#include "apple-vxd.h"
+#include "apple-vxd-h264-cmd.h"
+#include "apple-vxd-h264-parse.h"
+#include "apple-vxd-h264-tables.h"
+
+/* DecodeCreateH264VLD sizes with Apple's multiplier M = 2. */
+#define APPLE_VXD_H264_CAVLC_BUF	SZ_4K
+#define APPLE_VXD_H264_INTRA_BUF	(2 << 16)
+#define APPLE_VXD_H264_STREAM_STATE_BUF	(2 << 12)
+
+struct apple_vxd_h264_ctx {
+	struct apple_vxd_dev_buf cavlc;
+	struct apple_vxd_dev_buf intra;
+	struct apple_vxd_dev_buf stream_state;
+	bool first_picture;
+	struct apple_vxd_h264_slice slices[APPLE_VXD_H264_MAX_SLICES];
+	u8 ref_slots[APPLE_VXD_H264_MAX_SLICES][2][V4L2_H264_REF_LIST_LEN];
+};
+
+static_assert(sizeof(apple_vxd_h264_vlc_table) == APPLE_VXD_H264_VLC_BYTES);
+
+static int apple_vxd_h264_validate_sps(struct apple_vxd_ctx *ctx,
+				       const struct v4l2_ctrl_h264_sps *sps)
+{
+	const struct apple_vxd_dev *vxd = ctx->vxd;
+
+	/*
+	 * Reject the profiles whose tools the 8-bit 4:2:0 decoder lacks;
+	 * High 10/4:2:2/4:4:4 are caught by the chroma/bit-depth checks below.
+	 * No allow-list: the control's default (profile_idc 0, before
+	 * userspace sets an SPS) must pass, or TRY_EXT_CTRLS on the current
+	 * values fails (v4l2-compliance).  What the AVC
+	 * command recipe does not cover (interlace, FMO) is refused per
+	 * picture.
+	 */
+	switch (sps->profile_idc) {
+	case 88: /* extended: data partitioning */
+	case 83: /* scalable baseline */
+	case 86: /* scalable high */
+	case 118: /* multiview high */
+	case 128: /* stereo high */
+	case 134: /* MFC high */
+	case 135: /* MFC depth high */
+	case 138: /* multiview depth high */
+	case 139: /* enhanced multiview depth high */
+		dev_dbg(vxd->dev, "sps: unsupported profile %u\n",
+			sps->profile_idc);
+		return -EINVAL;
+	default:
+		break;
+	}
+
+	if (sps->chroma_format_idc > 1) {
+		dev_dbg(vxd->dev, "sps: chroma format 4:2:2/4:4:4 not supported\n");
+		return -EINVAL;
+	}
+
+	if (sps->bit_depth_luma_minus8 > 0 || sps->bit_depth_chroma_minus8 > 0) {
+		dev_dbg(vxd->dev, "sps: 10-bit not supported\n");
+		return -EINVAL;
+	}
+
+	/*
+	 * DT advertises h264-playback-level = 42: 1920x1088 [E].  Tile
+	 * decode could lift this, but is not explored yet.
+	 */
+	if (sps->pic_width_in_mbs_minus1 > (APPLE_VXD_MAX_PIC_W / 16 - 1) ||
+	    sps->pic_height_in_map_units_minus1 > (APPLE_VXD_MAX_PIC_H / 16 - 1)) {
+		dev_dbg(vxd->dev, "sps: %ux%u exceeds level 4.2\n",
+			(sps->pic_width_in_mbs_minus1 + 1) * 16,
+			(sps->pic_height_in_map_units_minus1 + 1) * 16);
+		return -EINVAL;
+	}
+
+	if (sps->max_num_ref_frames > V4L2_H264_NUM_DPB_ENTRIES) {
+		dev_dbg(vxd->dev, "sps: max_num_ref_frames %u too many\n",
+			sps->max_num_ref_frames);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int apple_vxd_h264_try_ctrl(struct apple_vxd_ctx *ctx,
+				   struct v4l2_ctrl *ctrl)
+{
+	if (ctrl->id == V4L2_CID_STATELESS_H264_SPS)
+		return apple_vxd_h264_validate_sps(ctx, ctrl->p_new.p_h264_sps);
+
+	return 0;
+}
+
+static int apple_vxd_h264_start(struct apple_vxd_ctx *ctx)
+{
+	struct apple_vxd_dev *vxd = ctx->vxd;
+	struct apple_vxd_h264_ctx *h;
+	int ret;
+
+	h = kvzalloc_obj(*h);
+	if (!h)
+		return -ENOMEM;
+
+	ret = apple_vxd_dev_buf_alloc(vxd, APPLE_VXD_H264_CAVLC_BUF, &h->cavlc);
+	if (ret)
+		goto err_free;
+	ret = apple_vxd_dev_buf_alloc(vxd, APPLE_VXD_H264_INTRA_BUF, &h->intra);
+	if (ret)
+		goto err_cavlc;
+	ret = apple_vxd_dev_buf_alloc(vxd, APPLE_VXD_H264_STREAM_STATE_BUF,
+				      &h->stream_state);
+	if (ret)
+		goto err_intra;
+
+	memcpy(h->cavlc.mem.vaddr, apple_vxd_h264_vlc_table,
+	       sizeof(apple_vxd_h264_vlc_table));
+	if ((crc32_le(~0U, h->cavlc.mem.vaddr, APPLE_VXD_H264_VLC_BYTES) ^ ~0U) !=
+	    APPLE_VXD_H264_VLC_CRC32) {
+		dev_err(vxd->dev, "h264: CAVLC table CRC mismatch\n");
+		ret = -EIO;
+		goto err_state;
+	}
+	h->first_picture = true;
+	ctx->priv = h;
+
+	dev_dbg(vxd->dev,
+		"h264: context buffers: cavlc %#x, intra %#x (%u bytes), stream state %#x (%u bytes)\n",
+		h->cavlc.va, h->intra.va, APPLE_VXD_H264_INTRA_BUF,
+		h->stream_state.va, APPLE_VXD_H264_STREAM_STATE_BUF);
+	return 0;
+
+err_state:
+	apple_vxd_dev_buf_free(vxd, &h->stream_state);
+err_intra:
+	apple_vxd_dev_buf_free(vxd, &h->intra);
+err_cavlc:
+	apple_vxd_dev_buf_free(vxd, &h->cavlc);
+err_free:
+	kvfree(h);
+	return ret;
+}
+
+static void apple_vxd_h264_stop(struct apple_vxd_ctx *ctx)
+{
+	struct apple_vxd_h264_ctx *h = ctx->priv;
+
+	if (!h)
+		return;
+	apple_vxd_dev_buf_free(ctx->vxd, &h->stream_state);
+	apple_vxd_dev_buf_free(ctx->vxd, &h->intra);
+	apple_vxd_dev_buf_free(ctx->vxd, &h->cavlc);
+	kvfree(h);
+	ctx->priv = NULL;
+}
+
+static enum apple_vxd_image_fmt
+apple_vxd_h264_get_image_fmt(struct apple_vxd_ctx *ctx, struct v4l2_ctrl *ctrl)
+{
+	if (ctrl->id != V4L2_CID_STATELESS_H264_SPS)
+		return APPLE_VXD_IMG_FMT_ANY;
+
+	return APPLE_VXD_IMG_FMT_420_8BIT;
+}
+
+static size_t apple_vxd_h264_capture_aux_size(struct apple_vxd_ctx *ctx)
+{
+	const struct v4l2_pix_format_mplane *pix = &ctx->decoded_fmt.fmt.pix_mp;
+
+	return apple_vxd_h264_colocated_size(DIV_ROUND_UP(pix->width, 16),
+					     DIV_ROUND_UP(pix->height, 16));
+}
+
+static const void *apple_vxd_h264_ctrl(struct apple_vxd_ctx *ctx, u32 id)
+{
+	struct v4l2_ctrl *ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl, id);
+
+	return ctrl ? ctrl->p_cur.p : NULL;
+}
+
+/*
+ * RefPicList0/1 per slice as DPB slots: the initial lists (8.2.4.2.1 for
+ * P, 8.2.4.2.3 for B, built once per picture by the v4l2-h264 helper),
+ * truncated to num_ref_idx_lX_active, then the slice's modifications
+ * (8.2.4.3).  Entries past the available references are NO_REF.
+ */
+enum { VXD_LIST_P, VXD_LIST_B0, VXD_LIST_B1, VXD_LISTS };
+
+static int apple_vxd_h264_ref_lists(struct apple_vxd_h264_ctx *h,
+				    unsigned int nslices,
+				    const struct v4l2_ctrl_h264_sps *sps,
+				    const struct v4l2_ctrl_h264_decode_params *dp)
+{
+	struct v4l2_h264_reference init[VXD_LISTS][V4L2_H264_REF_LIST_LEN];
+	struct v4l2_h264_reference list[V4L2_H264_REF_LIST_LEN];
+	struct v4l2_h264_reflist_builder b;
+	bool have_p = false, have_b = false;
+	unsigned int i, k, lst;
+	int ret;
+
+	v4l2_h264_init_reflist_builder(&b, dp, sps, dp->dpb);
+	for (i = 0; i < nslices; i++) {
+		const struct apple_vxd_h264_slice *sl = &h->slices[i];
+		bool bslice = sl->slice_type == V4L2_H264_SLICE_TYPE_B;
+
+		memset(h->ref_slots[i], APPLE_VXD_H264_NO_REF,
+		       sizeof(h->ref_slots[i]));
+		if (sl->slice_type != V4L2_H264_SLICE_TYPE_P && !bslice)
+			continue;
+
+		if (!bslice && !have_p) {
+			v4l2_h264_build_p_ref_list(&b, init[VXD_LIST_P]);
+			have_p = true;
+		}
+		if (bslice && !have_b) {
+			v4l2_h264_build_b_ref_lists(&b, init[VXD_LIST_B0],
+						    init[VXD_LIST_B1]);
+			have_b = true;
+		}
+		for (lst = 0; lst < (bslice ? 2 : 1); lst++) {
+			const struct v4l2_h264_reference *src =
+				init[bslice ? VXD_LIST_B0 + lst : VXD_LIST_P];
+			unsigned int len = 1 + (lst ? sl->num_ref_idx_l1_active_minus1 :
+						      sl->num_ref_idx_l0_active_minus1);
+
+			for (k = 0; k < V4L2_H264_REF_LIST_LEN; k++) {
+				list[k] = src[k];
+				if (k >= b.num_valid)
+					list[k].index = APPLE_VXD_H264_NO_REF;
+			}
+			ret = apple_vxd_h264_modify_ref_list(sl, lst, sps, dp,
+							     list, len);
+			if (ret)
+				return ret;
+			for (k = 0; k < len; k++)
+				h->ref_slots[i][lst][k] = list[k].index;
+		}
+	}
+	return 0;
+}
+
+/* Every reference a slice names must resolve to a CAPTURE buffer. */
+static const char *apple_vxd_h264_check_refs(const struct apple_vxd_h264_ctx *h,
+					     unsigned int nslices,
+					     const struct apple_vxd_h264_frame *f)
+{
+	unsigned int i, k, lst;
+
+	for (i = 0; i < nslices; i++) {
+		const struct apple_vxd_h264_slice *sl = &h->slices[i];
+		bool bslice = sl->slice_type == V4L2_H264_SLICE_TYPE_B;
+
+		if (sl->slice_type != V4L2_H264_SLICE_TYPE_P && !bslice)
+			continue;
+		for (lst = 0; lst < (bslice ? 2 : 1); lst++) {
+			unsigned int len = 1 + (lst ? sl->num_ref_idx_l1_active_minus1 :
+						      sl->num_ref_idx_l0_active_minus1);
+
+			for (k = 0; k < len; k++) {
+				u8 slot = h->ref_slots[i][lst][k];
+
+				if (slot < V4L2_H264_NUM_DPB_ENTRIES &&
+				    !f->dpb_luma[slot])
+					return "a reference picture has no CAPTURE buffer";
+			}
+		}
+		if (bslice) {
+			u8 col = h->ref_slots[i][1][0];
+
+			if (col >= V4L2_H264_NUM_DPB_ENTRIES ||
+			    !f->dpb_colocated[col])
+				return "co-located picture (RefPicList1[0]) unresolved";
+		}
+	}
+	return NULL;
+}
+
+static int apple_vxd_h264_run(struct apple_vxd_ctx *ctx)
+{
+	const struct v4l2_pix_format_mplane *pix = &ctx->decoded_fmt.fmt.pix_mp;
+	const struct v4l2_ctrl_h264_scaling_matrix *scaling;
+	const struct v4l2_ctrl_h264_decode_params *dp;
+	const struct v4l2_ctrl_h264_sps *sps;
+	const struct v4l2_ctrl_h264_pps *pps;
+	struct apple_vxd_h264_ctx *h = ctx->priv;
+	struct apple_vxd_dev *vxd = ctx->vxd;
+	struct apple_vxd_h264_frame f = { };
+	struct apple_vxd_cmdbuf *cb = NULL;
+	struct apple_vxd_run run;
+	const char *why = NULL;
+	struct vb2_queue *cap_q;
+	unsigned int i, nslices;
+	const u8 *src;
+	size_t src_len;
+	u32 stride;
+	int ret;
+
+	apple_vxd_run_preamble(ctx, &run);
+
+	if (!vxd->hw_ready || vxd->fw_panicked) {
+		dev_dbg(vxd->dev,
+			"decode job with no usable firmware (not booted, init message not taken, or panicked)\n");
+		ret = -EAGAIN;
+		goto out;
+	}
+	if (!h) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	sps = apple_vxd_h264_ctrl(ctx, V4L2_CID_STATELESS_H264_SPS);
+	pps = apple_vxd_h264_ctrl(ctx, V4L2_CID_STATELESS_H264_PPS);
+	dp = apple_vxd_h264_ctrl(ctx, V4L2_CID_STATELESS_H264_DECODE_PARAMS);
+	scaling = apple_vxd_h264_ctrl(ctx, V4L2_CID_STATELESS_H264_SCALING_MATRIX);
+	if (!sps || !pps || !dp) {
+		ret = -EINVAL;
+		goto out;
+	}
+	ret = apple_vxd_h264_validate(sps, pps, scaling, &why);
+	if (ret)
+		goto out_why;
+	if (dp->flags & V4L2_H264_DECODE_PARAM_FLAG_FIELD_PIC) {
+		why = "field pictures";
+		ret = -EINVAL;
+		goto out_why;
+	}
+	if ((sps->pic_width_in_mbs_minus1 + 1) * 16 > pix->width ||
+	    (sps->pic_height_in_map_units_minus1 + 1) * 16 > pix->height) {
+		why = "picture larger than the CAPTURE format";
+		ret = -EINVAL;
+		goto out_why;
+	}
+
+	src_len = vb2_get_plane_payload(&run.src->vb2_buf, 0);
+	src = vb2_plane_vaddr(&run.src->vb2_buf, 0);
+	if (!src) {
+		why = "OUTPUT buffer has no kernel mapping";
+		ret = -EINVAL;
+		goto out_why;
+	}
+	ret = apple_vxd_h264_find_slices(src, src_len, sps, pps, h->slices,
+					 APPLE_VXD_H264_MAX_SLICES, &nslices,
+					 &why);
+	if (ret)
+		goto out_why;
+	if (nslices > APPLE_VXD_JOB_MAX_PACKETS) {
+		why = "more slices in one picture than packets in a job";
+		ret = -EINVAL;
+		goto out_why;
+	}
+	ret = apple_vxd_h264_ref_lists(h, nslices, sps, dp);
+	if (ret) {
+		why = "a reference-list modification names a picture not in the DPB";
+		goto out_why;
+	}
+
+	stride = pix->plane_fmt[0].bytesperline;
+	f.sps = sps;
+	f.pps = pps;
+	f.dp = dp;
+	f.scaling = scaling;
+	f.slices = h->slices;
+	f.nslices = nslices;
+	f.ref_slots = (const u8 (*)[2][V4L2_H264_REF_LIST_LEN])h->ref_slots;
+	f.src_va = apple_vxd_buf_va(run.src);
+	f.dst_luma = apple_vxd_buf_va(run.dst);
+	f.dst_chroma = f.dst_luma + stride * pix->height;
+	f.dst_stride = stride;
+	f.colocated = apple_vxd_buf_aux_va(run.dst);
+	f.bufs.cavlc = h->cavlc.va;
+	f.bufs.intra = h->intra.va;
+	f.bufs.stream_state = h->stream_state.va;
+	f.first_picture = h->first_picture;
+
+	cap_q = v4l2_m2m_get_vq(ctx->fh.m2m_ctx, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+	for (i = 0; i < V4L2_H264_NUM_DPB_ENTRIES; i++) {
+		const struct v4l2_h264_dpb_entry *e = &dp->dpb[i];
+		struct vb2_buffer *ref;
+
+		if (!(e->flags & V4L2_H264_DPB_ENTRY_FLAG_VALID))
+			continue;
+		ref = vb2_find_buffer(cap_q, e->reference_ts);
+		if (!ref) {
+			dev_dbg(vxd->dev, "h264: dpb[%u] ts %llu has no CAPTURE buffer\n",
+				i, e->reference_ts);
+			continue;
+		}
+		f.dpb_luma[i] = apple_vxd_buf_va(to_vb2_v4l2_buffer(ref));
+		f.dpb_chroma[i] = f.dpb_luma[i] + stride * pix->height;
+		f.dpb_colocated[i] = apple_vxd_buf_aux_va(to_vb2_v4l2_buffer(ref));
+	}
+	why = apple_vxd_h264_check_refs(h, nslices, &f);
+	if (why) {
+		ret = -EINVAL;
+		goto out_why;
+	}
+
+	cb = apple_vxd_cmdbuf_get(vxd);
+	if (!cb) {
+		why = "no free command buffer";
+		ret = -EBUSY;
+		goto out_why;
+	}
+	ret = apple_vxd_h264_build(cb, &f, &why);
+	if (ret)
+		goto out_why;
+
+	dev_dbg(vxd->dev,
+		"decode: src %u va %#x (%zu bytes, %u slices, first %c NAL %#x+%u, header %u bits), dst %u Y %#x UV %#x stride %u, %zu command bytes in buf %u (va %#x), %u packets\n",
+		run.src->vb2_buf.index, f.src_va, src_len, nslices,
+		"PBIps"[h->slices[0].slice_type % 5],
+		h->slices[0].nal_offset, h->slices[0].nal_size,
+		8 + h->slices[0].header_bits_raw, run.dst->vb2_buf.index,
+		f.dst_luma, f.dst_chroma, stride, cb->used, cb->index,
+		cb->va, cb->npackets);
+
+	/*
+	 * The controls were only read while building: complete them before
+	 * the submit, after which the job may finish (and the request with
+	 * it) at any moment.
+	 */
+	apple_vxd_run_postamble(ctx, &run);
+	ret = apple_vxd_submit(ctx, cb);
+	if (ret) {
+		dev_warn_ratelimited(vxd->dev, "decode: submit failed: %d\n", ret);
+		if (cb->state == APPLE_VXD_CMDBUF_HOST)
+			apple_vxd_cmdbuf_put(vxd, cb);
+		return ret;
+	}
+	h->first_picture = false;
+	return 0;
+
+out_why:
+	dev_warn_ratelimited(vxd->dev, "decode: picture refused (%d): %s\n",
+			     ret, why ? why : "?");
+out:
+	if (cb)
+		apple_vxd_cmdbuf_put(vxd, cb);
+	apple_vxd_run_postamble(ctx, &run);
+	return ret;
+}
+
+static const struct apple_vxd_ctrl_desc apple_vxd_h264_ctrl_descs[] = {
+	{
+		.cfg.id = V4L2_CID_STATELESS_H264_DECODE_PARAMS,
+	},
+	{
+		.cfg.id = V4L2_CID_STATELESS_H264_SPS,
+		.cfg.ops = &apple_vxd_ctrl_ops,
+	},
+	{
+		.cfg.id = V4L2_CID_STATELESS_H264_PPS,
+	},
+	{
+		.cfg.id = V4L2_CID_STATELESS_H264_SCALING_MATRIX,
+	},
+	{
+		.cfg.id = V4L2_CID_STATELESS_H264_PRED_WEIGHTS,
+	},
+	{
+		.cfg.id = V4L2_CID_STATELESS_H264_SLICE_PARAMS,
+		.cfg.flags = V4L2_CTRL_FLAG_DYNAMIC_ARRAY,
+	},
+	{
+		.cfg.id = V4L2_CID_STATELESS_H264_DECODE_MODE,
+		.cfg.min = V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED,
+		.cfg.max = V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED,
+		.cfg.def = V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED,
+	},
+	{
+		.cfg.id = V4L2_CID_STATELESS_H264_START_CODE,
+		.cfg.min = V4L2_STATELESS_H264_START_CODE_ANNEX_B,
+		.cfg.def = V4L2_STATELESS_H264_START_CODE_ANNEX_B,
+		.cfg.max = V4L2_STATELESS_H264_START_CODE_ANNEX_B,
+	},
+	{
+		.cfg.id = V4L2_CID_MPEG_VIDEO_H264_PROFILE,
+		.cfg.min = V4L2_MPEG_VIDEO_H264_PROFILE_CONSTRAINED_BASELINE,
+		.cfg.max = V4L2_MPEG_VIDEO_H264_PROFILE_HIGH_422_INTRA,
+		.cfg.menu_skip_mask =
+			BIT(V4L2_MPEG_VIDEO_H264_PROFILE_EXTENDED) |
+			BIT(V4L2_MPEG_VIDEO_H264_PROFILE_HIGH_444_PREDICTIVE),
+		.cfg.def = V4L2_MPEG_VIDEO_H264_PROFILE_MAIN,
+	},
+	{
+		.cfg.id = V4L2_CID_MPEG_VIDEO_H264_LEVEL,
+		.cfg.min = V4L2_MPEG_VIDEO_H264_LEVEL_1_0,
+		.cfg.max = V4L2_MPEG_VIDEO_H264_LEVEL_4_2,
+		.cfg.def = V4L2_MPEG_VIDEO_H264_LEVEL_4_2,
+	},
+};
+
+static const struct apple_vxd_ctrls apple_vxd_h264_ctrls = {
+	.ctrls = apple_vxd_h264_ctrl_descs,
+	.num_ctrls = ARRAY_SIZE(apple_vxd_h264_ctrl_descs),
+};
+
+static const struct apple_vxd_decoded_fmt_desc
+apple_vxd_h264_decoded_fmts[] = {
+	{
+		.fourcc = V4L2_PIX_FMT_NV12,
+		.image_fmt = APPLE_VXD_IMG_FMT_420_8BIT,
+	},
+};
+
+static const struct apple_vxd_coded_fmt_desc apple_vxd_h264_fmt = {
+	.fourcc = V4L2_PIX_FMT_H264_SLICE,
+	.frmsize = {
+		.min_width = APPLE_VXD_MIN_PIC_W,
+		.max_width = APPLE_VXD_MAX_PIC_W,
+		.step_width = 16,
+		.min_height = APPLE_VXD_MIN_PIC_H,
+		.max_height = APPLE_VXD_MAX_PIC_H,
+		.step_height = 16,
+	},
+	.ctrls = &apple_vxd_h264_ctrls,
+	.ops = &(const struct apple_vxd_coded_fmt_ops){
+		.adjust_fmt = NULL,
+		.start = apple_vxd_h264_start,
+		.stop = apple_vxd_h264_stop,
+		.run = apple_vxd_h264_run,
+		.try_ctrl = apple_vxd_h264_try_ctrl,
+		.get_image_fmt = apple_vxd_h264_get_image_fmt,
+		.capture_aux_size = apple_vxd_h264_capture_aux_size,
+	},
+	.num_decoded_fmts = ARRAY_SIZE(apple_vxd_h264_decoded_fmts),
+	.decoded_fmts = apple_vxd_h264_decoded_fmts,
+};
+
+static const struct apple_vxd_coded_fmt_desc apple_vxd_coded_fmts[] = {
+	apple_vxd_h264_fmt,
+};
+
+/* Fills the device's coded-format table, before any V4L2 node exists. */
+int apple_vxd_h264_register(struct apple_vxd_dev *vxd)
+{
+	vxd->coded_fmts = apple_vxd_coded_fmts;
+	vxd->num_coded_fmts = ARRAY_SIZE(apple_vxd_coded_fmts);
+	return 0;
+}
diff --git a/drivers/media/platform/apple/vxd/apple-vxd-mbox.c b/drivers/media/platform/apple/vxd/apple-vxd-mbox.c
new file mode 100644
index 000000000..dc3c8835f
--- /dev/null
+++ b/drivers/media/platform/apple/vxd/apple-vxd-mbox.c
@@ -0,0 +1,777 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Apple VXD - host<->MTX mailbox
+ *
+ * docs/periph/ds-vxd-decode-protocol.md sections 2, 3 and 6.  The rings
+ * are word windows in the register file, not DMA queues: after the ready
+ * magic the DEVA firmware publishes each ring as (base << 16) | capacity
+ * in 0x2024 (TO_MTX) and 0x2018 (TO_HOST), and word i of a ring is the
+ * register at 0x2000 + base + 4 * i.
+ *
+ *   push (0xfffffff0062990bc):  words, 0x2030 = wr, flush reads of
+ *                               0x2028/0x2030/0x201c/0x2020, 0x88 = 1,
+ *                               flush read of 0x2000
+ *   ISR  (0xfffffff00629a0ac):  read 0x410, 0x414 = 0x100000, then drain
+ *                               TO_HOST (0x201c host rd, 0x2020 fw wr)
+ *   init (0xfffffff006298d40):  one 0x80 message after the ready magic
+ *
+ * The firmware answers decode packets with a 0xc0 completion carrying the
+ * fence; it answers nothing else.  0x80 and the benign 0x83..0x85 are
+ * acknowledged only by TO_MTX_RD (0x2028) moving past them: the DEVA
+ * reader publishes the new read index before it dispatches (fw 0x1000a9c).
+ * That is what the boot waits for.
+ *
+ * Every ring access is bounded: indices are checked against the published
+ * capacity, the geometry against the MMIO window, message lengths against
+ * both sides' limits, and every wait has a timeout.
+ */
+#include <linux/bitfield.h>
+#include <linux/interrupt.h>
+#include <linux/iopoll.h>
+#include <linux/ktime.h>
+
+#include "apple-vxd.h"
+
+#define VXD_MSG_CONSUME_TIMEOUT_US	100000	/* init message */
+#define VXD_MSG_PUSH_TIMEOUT_US		100000	/* free-slot wait */
+#define VXD_DRAIN_MAX_MSGS		0x70	/* the kext's bound */
+#define VXD_RING_MAX_CAP		0x4000	/* sanity bound, words */
+/*
+ * The firmware raises bit 20 only after posting a message, so an interrupt
+ * normally drains at least one.  This many in a row with nothing to drain
+ * means 0x414 does not clear the level line: stop taking it rather than
+ * livelock the CPU.
+ */
+#define VXD_IRQ_STORM_LIMIT		1000
+
+/* --- ring arithmetic ---------------------------------------------------- */
+
+static u32 vxd_ring_next(u32 idx, u32 cap)
+{
+	return idx + 1 < cap ? idx + 1 : 0;
+}
+
+/* Words from @from forward to @to. */
+static u32 vxd_ring_dist(u32 from, u32 to, u32 cap)
+{
+	return to >= from ? to - from : to + cap - from;
+}
+
+/*
+ * Free TO_MTX words, AppleD5500's helper (0xfffffff0062996b4 [E]):
+ * rd + ~wr, plus the capacity unless wr < rd.  One word always stays free,
+ * so rd == wr means empty.
+ */
+static u32 vxd_ring_free(u32 rd, u32 wr, u32 cap)
+{
+	if (wr < rd)
+		return rd - wr - 1;
+	return rd - wr - 1 + cap;
+}
+
+/*
+ * The reader has taken the @t message once it moved at least nwords past
+ * its start without overtaking the writer.  A read index still behind the
+ * start (earlier messages pending) is "not yet".
+ */
+static bool vxd_ring_consumed(const struct apple_vxd_msg_ticket *t, u32 rd,
+			      u32 wr, u32 cap)
+{
+	u32 done = vxd_ring_dist(t->start, rd, cap);
+
+	return done >= t->nwords && done <= vxd_ring_dist(t->start, wr, cap);
+}
+
+/* Apple's fence: (submission << 4) | (packet * 2 & 0xe) | core, core 0. */
+static u16 vxd_fence_id(u16 seq, unsigned int packet)
+{
+	return (seq << 4) | ((packet * 2) & 0xe);
+}
+
+/*
+ * InitMessageBuffers [E]: w1 = firmware device address (the 0x6a00 value),
+ * w2 = (u8)seq << 16 | image size in 4 KiB pages (the blob, not the
+ * page-aligned allocation: 0x17e98 bytes -> 0x17), w3 = 0xffff0000.
+ */
+static void apple_vxd_build_init_msg(u32 msg[VXD_INIT_MSG_WORDS], u32 fw_va,
+				     size_t fw_bytes, u16 seq)
+{
+	msg[0] = apple_vxd_msg_hdr(0, VXD_MSG_INIT, VXD_INIT_MSG_WORDS);
+	msg[1] = fw_va;
+	msg[2] = FIELD_PREP(VXD_INIT_SEQ, seq & 0xff) |
+		 FIELD_PREP(VXD_INIT_PAGES, fw_bytes >> 12);
+	msg[3] = VXD_INIT_SENTINEL;
+	msg[4] = 0;
+}
+
+/* --- geometry ---------------------------------------------------------- */
+
+static int vxd_ring_parse(struct apple_vxd_dev *vxd, const char *name,
+			  u32 raw, struct apple_vxd_ring *ring)
+{
+	ring->base = FIELD_GET(VXD_RING_BASE, raw);
+	ring->cap = FIELD_GET(VXD_RING_CAP, raw);
+
+	if (ring->cap <= VXD_MSG_TO_MTX_MAX_WORDS ||
+	    ring->cap > VXD_RING_MAX_CAP || ring->base & 3 ||
+	    VXD_RING_WINDOW + ring->base + 4 * ring->cap > vxd->regs_size) {
+		dev_err(vxd->dev,
+			"%s ring geometry %#010x (base %#x, %u words) is not usable: needs %u < words <= %u, a 4-byte aligned base and the ring inside the %#llx-byte register window\n",
+			name, raw, ring->base, ring->cap,
+			VXD_MSG_TO_MTX_MAX_WORDS, VXD_RING_MAX_CAP,
+			(unsigned long long)vxd->regs_size);
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static u32 vxd_ring_reg(const struct apple_vxd_ring *ring, u32 idx)
+{
+	return VXD_RING_WINDOW + ring->base + 4 * idx;
+}
+
+/*
+ * Read the geometry the firmware published with the ready magic, once per
+ * boot.  Called by the boot under power_lock.
+ */
+int apple_vxd_mbox_open(struct apple_vxd_dev *vxd)
+{
+	struct apple_vxd_ring to_mtx, to_host;
+	u32 raw_mtx, raw_host;
+	unsigned long flags;
+	unsigned int i;
+	int ret;
+
+	raw_mtx = vxd_read(vxd, VXD_REG_TO_MTX_RING);
+	raw_host = vxd_read(vxd, VXD_REG_TO_HOST_RING);
+
+	ret = vxd_ring_parse(vxd, "TO_MTX", raw_mtx, &to_mtx);
+	if (!ret)
+		ret = vxd_ring_parse(vxd, "TO_HOST", raw_host, &to_host);
+	if (ret)
+		return ret;
+
+	if (to_mtx.base < to_host.base + 4 * to_host.cap &&
+	    to_host.base < to_mtx.base + 4 * to_mtx.cap) {
+		dev_err(vxd->dev, "TO_MTX and TO_HOST rings overlap\n");
+		return -EINVAL;
+	}
+
+	spin_lock_irqsave(&vxd->mbox_lock, flags);
+	vxd->to_mtx = to_mtx;
+	vxd->to_host = to_host;
+	for (i = 0; i < APPLE_VXD_NUM_FENCES; i++)
+		vxd->fences[i].state = APPLE_VXD_FENCE_FREE;
+	vxd->fw_panicked = false;
+	vxd->irq_storm = false;
+	vxd->irq_empty = 0;
+	vxd->mbox_ready = true;
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+
+	dev_dbg(vxd->dev,
+		"mailbox: TO_MTX regs %#x..%#x (%u words), TO_HOST regs %#x..%#x (%u words)\n",
+		vxd_ring_reg(&to_mtx, 0), vxd_ring_reg(&to_mtx, to_mtx.cap) - 1,
+		to_mtx.cap, vxd_ring_reg(&to_host, 0),
+		vxd_ring_reg(&to_host, to_host.cap) - 1, to_host.cap);
+	return 0;
+}
+
+/* --- push -------------------------------------------------------------- */
+
+/*
+ * Push one message to TO_MTX in AppleD5500's exact order, waiting (bounded)
+ * for room.  Process context only.  @ticket records where it went so the
+ * caller can wait for the firmware to take it.
+ */
+int apple_vxd_msg_push(struct apple_vxd_dev *vxd, const u32 *msg,
+		       struct apple_vxd_msg_ticket *ticket)
+{
+	u32 nwords = FIELD_GET(VXD_MSG_NWORDS, msg[0]);
+	u32 rd, wr, cap, i;
+	unsigned long flags;
+	ktime_t deadline;
+
+	might_sleep();
+	if (!nwords || nwords > VXD_MSG_TO_MTX_MAX_WORDS || msg[0] & BIT(7))
+		return -EINVAL;
+
+	deadline = ktime_add_us(ktime_get(), VXD_MSG_PUSH_TIMEOUT_US);
+	for (;;) {
+		spin_lock_irqsave(&vxd->mbox_lock, flags);
+		if (!vxd->mbox_ready) {
+			spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+			return -ENODEV;
+		}
+
+		cap = vxd->to_mtx.cap;
+		rd = vxd_read(vxd, VXD_REG_TO_MTX_RD_INDEX);
+		wr = vxd_read(vxd, VXD_REG_TO_MTX_WR_INDEX);
+		if (rd >= cap || wr >= cap) {
+			spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+			dev_err(vxd->dev,
+				"TO_MTX indices out of range: rd %u wr %u (capacity %u)\n",
+				rd, wr, cap);
+			return -EIO;
+		}
+		if (vxd_ring_free(rd, wr, cap) >= nwords)
+			break;
+		spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+
+		if (ktime_after(ktime_get(), deadline)) {
+			dev_err(vxd->dev,
+				"TO_MTX full for 100 ms: rd %u wr %u, %u words free, %u needed\n",
+				rd, wr, vxd_ring_free(rd, wr, cap), nwords);
+			return -EBUSY;
+		}
+		usleep_range(100, 200);
+	}
+
+	ticket->start = wr;
+	ticket->nwords = nwords;
+	for (i = 0; i < nwords; i++) {
+		vxd_write(vxd, vxd_ring_reg(&vxd->to_mtx, wr), msg[i]);
+		wr = vxd_ring_next(wr, cap);
+	}
+	ticket->end = wr;
+	vxd_write(vxd, VXD_REG_TO_MTX_WR_INDEX, wr);
+
+	/* APB flush reads, doorbell, final flush: the kext's sequence. */
+	vxd_read(vxd, VXD_REG_TO_MTX_RD_INDEX);
+	vxd_read(vxd, VXD_REG_TO_MTX_WR_INDEX);
+	vxd_read(vxd, VXD_REG_TO_HOST_RD_INDEX);
+	vxd_read(vxd, VXD_REG_TO_HOST_WR_INDEX);
+	vxd_write(vxd, VXD_REG_MTX_DOORBELL, 1);
+	vxd_read(vxd, VXD_REG_COMMS_STATE);
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+
+	return 0;
+}
+
+static bool vxd_msg_is_consumed(struct apple_vxd_dev *vxd,
+				const struct apple_vxd_msg_ticket *ticket)
+{
+	u32 rd = vxd_read(vxd, VXD_REG_TO_MTX_RD_INDEX);
+	u32 wr = vxd_read(vxd, VXD_REG_TO_MTX_WR_INDEX);
+
+	if (rd >= vxd->to_mtx.cap || wr >= vxd->to_mtx.cap)
+		return false;
+	return vxd_ring_consumed(ticket, rd, wr, vxd->to_mtx.cap);
+}
+
+/* Poll 0x2028 until the firmware has taken the message (bounded). */
+int apple_vxd_msg_wait_consumed(struct apple_vxd_dev *vxd,
+				const struct apple_vxd_msg_ticket *ticket,
+				unsigned int timeout_us, unsigned int *waited_us)
+{
+	ktime_t start = ktime_get();
+	bool done;
+	int ret;
+
+	ret = read_poll_timeout(vxd_msg_is_consumed, done, done, 50,
+				timeout_us, false, vxd, ticket);
+	if (waited_us)
+		*waited_us = ktime_us_delta(ktime_get(), start);
+	return ret;
+}
+
+/* --- fences ------------------------------------------------------------ */
+
+/* 12-bit submission counter, never 0: fence 0 is the init message's.  mbox_lock held. */
+static u16 vxd_fence_next_seq_locked(struct apple_vxd_dev *vxd)
+{
+	vxd->fence_seq = (vxd->fence_seq + 1) & 0xfff;
+	if (!vxd->fence_seq)
+		vxd->fence_seq = 1;
+	return vxd->fence_seq;
+}
+
+/* mbox_lock held. */
+static struct apple_vxd_fence *vxd_fence_arm_locked(struct apple_vxd_dev *vxd,
+						    u16 id, u8 type)
+{
+	unsigned int i;
+
+	for (i = 0; i < APPLE_VXD_NUM_FENCES; i++) {
+		struct apple_vxd_fence *fence = &vxd->fences[i];
+
+		if (fence->state != APPLE_VXD_FENCE_FREE)
+			continue;
+		fence->id = id;
+		fence->type = type;
+		fence->status = 0;
+		fence->error = false;
+		fence->job = false;
+		fence->cmdbuf = NULL;
+		fence->state = APPLE_VXD_FENCE_ARMED;
+		reinit_completion(&fence->done);
+		return fence;
+	}
+	return NULL;
+}
+
+struct apple_vxd_fence *apple_vxd_fence_arm(struct apple_vxd_dev *vxd,
+					    unsigned int packet, u8 type)
+{
+	struct apple_vxd_fence *fence;
+	unsigned long flags;
+
+	spin_lock_irqsave(&vxd->mbox_lock, flags);
+	fence = vxd_fence_arm_locked(vxd,
+				     vxd_fence_id(vxd_fence_next_seq_locked(vxd),
+						  packet), type);
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+
+	return fence;
+}
+
+void apple_vxd_fence_release(struct apple_vxd_dev *vxd,
+			     struct apple_vxd_fence *fence)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&vxd->mbox_lock, flags);
+	/* Never completed: its command buffer stays with the device. */
+	if (fence->cmdbuf) {
+		fence->cmdbuf->fence = NULL;
+		fence->cmdbuf = NULL;
+	}
+	fence->job = false;
+	fence->state = APPLE_VXD_FENCE_FREE;
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+}
+
+/*
+ * Called with mbox_lock held.  A real 0xc0 (@device_done) means the core
+ * is finished with the bound command buffer, whatever the status; a panic
+ * or a teardown wakes the waiter but leaves the buffer quarantined until
+ * apple_vxd_cmdbufs_reclaim().
+ */
+static void vxd_fence_complete(struct apple_vxd_dev *vxd,
+			       struct apple_vxd_fence *fence, u32 status,
+			       bool error, bool device_done)
+{
+	struct apple_vxd_cmdbuf *cb = fence->cmdbuf;
+
+	if (cb) {
+		if (device_done)
+			apple_vxd_cmdbuf_retire_locked(cb);
+		else
+			cb->fence = NULL;
+		fence->cmdbuf = NULL;
+	}
+	fence->status = status;
+	fence->error = error;
+	fence->state = APPLE_VXD_FENCE_SIGNALLED;
+	complete_all(&fence->done);
+	/* The job is finished in process context (v4l2-m2m, runtime PM). */
+	if (fence->job)
+		queue_work(system_highpri_wq, &vxd->job_done_work);
+}
+
+/* Called with mbox_lock held: wake every waiter with an error. */
+static void vxd_fences_fail_all(struct apple_vxd_dev *vxd)
+{
+	unsigned int i;
+
+	for (i = 0; i < APPLE_VXD_NUM_FENCES; i++)
+		if (vxd->fences[i].state == APPLE_VXD_FENCE_ARMED)
+			vxd_fence_complete(vxd, &vxd->fences[i], 0, true, false);
+}
+
+/* --- drain ------------------------------------------------------------- */
+
+/*
+ * Pop one TO_HOST message (the kext's 0xfffffff0062997b0, consuming mode).
+ * mbox_lock held.  Returns the word count, 0 if the ring is empty, or
+ * -EIO if it is corrupt.
+ */
+static int vxd_msg_pop(struct apple_vxd_dev *vxd, u32 *msg)
+{
+	u32 cap = vxd->to_host.cap;
+	u32 rd = vxd_read(vxd, VXD_REG_TO_HOST_RD_INDEX);
+	u32 wr = vxd_read(vxd, VXD_REG_TO_HOST_WR_INDEX);
+	u32 n, i;
+
+	if (rd >= cap || wr >= cap) {
+		dev_err_ratelimited(vxd->dev,
+				    "TO_HOST indices out of range: rd %u wr %u (capacity %u)\n",
+				    rd, wr, cap);
+		return -EIO;
+	}
+	if (rd == wr)
+		return 0;
+
+	msg[0] = vxd_read(vxd, vxd_ring_reg(&vxd->to_host, rd));
+	n = FIELD_GET(VXD_MSG_NWORDS, msg[0]);
+	if (n > VXD_MSG_TO_HOST_MAX_WORDS || n > vxd_ring_dist(rd, wr, cap)) {
+		/*
+		 * The kext logs "received oversize fw->host msg" and stops;
+		 * resync to the writer so one bad header cannot pin the ring.
+		 */
+		dev_err_ratelimited(vxd->dev,
+				    "TO_HOST message %#010x at %u claims %u words (%u queued); dropping the queue\n",
+				    msg[0], rd, n, vxd_ring_dist(rd, wr, cap));
+		vxd_write(vxd, VXD_REG_TO_HOST_RD_INDEX, wr);
+		return -EIO;
+	}
+	if (!n) {
+		/* The kext consumes a zero-length header as one word. */
+		n = 1;
+	}
+
+	rd = vxd_ring_next(rd, cap);
+	for (i = 1; i < n; i++) {
+		msg[i] = vxd_read(vxd, vxd_ring_reg(&vxd->to_host, rd));
+		rd = vxd_ring_next(rd, cap);
+	}
+	vxd_write(vxd, VXD_REG_TO_HOST_RD_INDEX, rd);
+	return n;
+}
+
+static void vxd_msg_completion(struct apple_vxd_dev *vxd, const u32 *msg,
+			       u32 n)
+{
+	u16 id = FIELD_GET(VXD_MSG_FENCE, msg[0]);
+	u32 status = n > 2 ? msg[2] : 0;
+	u32 w3 = n > 3 ? msg[3] : 0;
+	bool fault = status & VXD_COMPLETION_FAULT;
+	unsigned int i;
+
+	if (fault) {
+		if ((status & VXD_COMPLETION_AFTER_RESET) && !w3)
+			dev_warn_ratelimited(vxd->dev,
+					     "completion fence %#x after core reset (status %#x)\n",
+					     id, status);
+		else
+			dev_err_ratelimited(vxd->dev,
+					    "completion fence %#x with fault: status %#x, word1 %#x, word3 %#x\n",
+					    id, status, n > 1 ? msg[1] : 0, w3);
+	}
+	if (status & VXD_COMPLETION_REATTEMPT)
+		dev_warn_ratelimited(vxd->dev,
+				     "completion fence %#x asks for REATTEMPT_SINGLEPIPE (0x200c %#x)\n",
+				     id, vxd_read(vxd, VXD_REG_FW_PC));
+
+	for (i = 0; i < APPLE_VXD_NUM_FENCES; i++) {
+		struct apple_vxd_fence *fence = &vxd->fences[i];
+
+		if (fence->state == APPLE_VXD_FENCE_ARMED && fence->id == id) {
+			vxd_fence_complete(vxd, fence, status, fault, true);
+			return;
+		}
+	}
+
+	dev_warn_ratelimited(vxd->dev,
+			     "completion for unknown fence %#x (status %#x)\n",
+			     id, status);
+}
+
+/* ProcessFWMessages' type switch (0xfffffff006299bb4 [E]).  mbox_lock held. */
+static void vxd_msg_dispatch(struct apple_vxd_dev *vxd, const u32 *msg, u32 n)
+{
+	u8 type = FIELD_GET(VXD_MSG_TYPE, msg[0]);
+
+	switch (type) {
+	case VXD_MSG_COMPLETION:
+		vxd_msg_completion(vxd, msg, n);
+		break;
+	case VXD_MSG_CONTIGUITY:
+		dev_warn_ratelimited(vxd->dev,
+				     "firmware contiguity warning (%#x %#x)\n",
+				     n > 1 ? msg[1] : 0, n > 2 ? msg[2] : 0);
+		break;
+	case VXD_MSG_PANIC:
+		vxd->fw_panicked = true;
+		dev_err_ratelimited(vxd->dev,
+				    "FW_DEVA_PANIC: fence %#x, error int %#x; decode is off until the firmware is rebooted\n",
+				    (u32)FIELD_GET(VXD_MSG_FENCE, msg[0]),
+				    n > 1 ? msg[1] : 0);
+		vxd_fences_fail_all(vxd);
+		break;
+	default:
+		/* The kext drops 0xd1..0xd4 and 0xe1..0xe4 without a word. */
+		if ((type >= 0xd1 && type <= 0xd4) ||
+		    (type >= 0xe1 && type <= 0xe4)) {
+			dev_dbg(vxd->dev, "firmware message %#x ignored\n", type);
+			break;
+		}
+		dev_warn_ratelimited(vxd->dev,
+				     "unknown message %#010x from the DEVA firmware (%u words)\n",
+				     msg[0], n);
+		break;
+	}
+}
+
+/* mbox_lock held. */
+static unsigned int vxd_mbox_drain_locked(struct apple_vxd_dev *vxd)
+{
+	u32 msg[VXD_MSG_TO_HOST_MAX_WORDS];
+	unsigned int count;
+	int n;
+
+	for (count = 0; count < VXD_DRAIN_MAX_MSGS; count++) {
+		n = vxd_msg_pop(vxd, msg);
+		if (n <= 0)
+			return count;
+		vxd_msg_dispatch(vxd, msg, n);
+	}
+
+	dev_warn_ratelimited(vxd->dev, "too many messages in the fw2host queue\n");
+	return count;
+}
+
+/*
+ * Level interrupt.  Armed only while the firmware runs (the boot holds a
+ * runtime PM reference for that whole time, so the block is powered).
+ * Apple's order: status, clear, then drain.
+ */
+irqreturn_t apple_vxd_irq(int irq, void *data)
+{
+	struct apple_vxd_dev *vxd = data;
+	u32 status;
+
+	spin_lock(&vxd->mbox_lock);
+	if (!vxd->mbox_ready) {
+		spin_unlock(&vxd->mbox_lock);
+		return IRQ_NONE;
+	}
+
+	status = vxd_read(vxd, VXD_REG_IRQ_STATUS);
+	if (!(status & VXD_IRQ_FW_MSG)) {
+		spin_unlock(&vxd->mbox_lock);
+		return IRQ_NONE;
+	}
+
+	vxd_write(vxd, VXD_REG_IRQ_CLEAR, VXD_IRQ_FW_MSG);
+	if (vxd_mbox_drain_locked(vxd)) {
+		vxd->irq_empty = 0;
+	} else if (++vxd->irq_empty == VXD_IRQ_STORM_LIMIT) {
+		disable_irq_nosync(irq);
+		vxd->irq_storm = true;
+		dev_err(vxd->dev,
+			"IRQ %d: %u interrupts in a row with nothing to drain (0x410 %#x); IRQ disabled\n",
+			irq, VXD_IRQ_STORM_LIMIT, status);
+	}
+	spin_unlock(&vxd->mbox_lock);
+
+	return IRQ_HANDLED;
+}
+
+/* --- start / stop ------------------------------------------------------- */
+
+static void vxd_mbox_log_state(struct apple_vxd_dev *vxd, const char *what)
+{
+	dev_err(vxd->dev,
+		"%s: TO_MTX rd %u wr %u, TO_HOST rd %u wr %u, 0x200c %#x, 0x0 %#x, comms state %#x, irq status %#x\n",
+		what, vxd_read(vxd, VXD_REG_TO_MTX_RD_INDEX),
+		vxd_read(vxd, VXD_REG_TO_MTX_WR_INDEX),
+		vxd_read(vxd, VXD_REG_TO_HOST_RD_INDEX),
+		vxd_read(vxd, VXD_REG_TO_HOST_WR_INDEX),
+		vxd_read(vxd, VXD_REG_FW_PC),
+		vxd_read(vxd, VXD_REG_MTX_MSG_CONSUMED),
+		vxd_read(vxd, VXD_REG_COMMS_STATE),
+		vxd_read(vxd, VXD_REG_IRQ_STATUS));
+}
+
+/*
+ * The mandatory 0x80 init message, then the IRQ.  Without the init
+ * message the firmware has no picture of its own image and never
+ * schedules work (ds-vxd-decode-protocol.md section 3.1).  Boot path,
+ * power_lock held, mailbox open.
+ */
+int apple_vxd_mbox_start(struct apple_vxd_dev *vxd)
+{
+	struct apple_vxd_msg_ticket ticket;
+	u32 msg[VXD_INIT_MSG_WORDS];
+	unsigned int waited;
+	int ret;
+
+	apple_vxd_build_init_msg(msg, vxd->fw_dev_va, vxd->fw_blob_size,
+				 vxd->init_seq);
+	ret = apple_vxd_msg_push(vxd, msg, &ticket);
+	if (ret) {
+		dev_err(vxd->dev, "init message push failed: %d\n", ret);
+		return ret;
+	}
+	vxd->init_seq++;
+
+	ret = apple_vxd_msg_wait_consumed(vxd, &ticket,
+					  VXD_MSG_CONSUME_TIMEOUT_US, &waited);
+	if (ret) {
+		vxd_mbox_log_state(vxd, "init message not consumed");
+		return ret;
+	}
+	dev_dbg(vxd->dev, "init message consumed after %u us\n", waited);
+
+	enable_irq(vxd->irq);
+	vxd->irq_armed = true;
+	return 0;
+}
+
+/* Teardown, power_lock held: no IRQ, no pushes, every waiter woken. */
+void apple_vxd_mbox_stop(struct apple_vxd_dev *vxd)
+{
+	unsigned long flags;
+
+	if (vxd->irq_armed) {
+		/* The storm guard already disabled it from the handler. */
+		if (READ_ONCE(vxd->irq_storm))
+			synchronize_irq(vxd->irq);
+		else
+			disable_irq(vxd->irq);
+		vxd->irq_armed = false;
+	}
+
+	spin_lock_irqsave(&vxd->mbox_lock, flags);
+	if (vxd->mbox_ready) {
+		/* Quiesce the line the way known state does. */
+		vxd_write(vxd, VXD_REG_IRQ_ENABLE, 0);
+		vxd_write(vxd, VXD_REG_IRQ_CLEAR, 0xffffffff);
+	}
+	vxd->mbox_ready = false;
+	vxd_fences_fail_all(vxd);
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+}
+
+/*
+ * Decode submission: one picture's command buffer, one mailbox message per
+ * packet, in packet-list order (SubmitCommandBufferInternal
+ * 0xfffffff00628a8d4 [E]).  The last message carries 0x4004 and its fence
+ * completes the job (apple_vxd_job_done(), process context); the buffer
+ * is bound to that fence and freed by its 0xc0.  Returns 0 once every
+ * message is in TO_MTX; on an error nothing is left armed, and a buffer
+ * the firmware may already have been told about stays quarantined.
+ *
+ * Messages are built twice (checked before anything is armed, rebuilt for
+ * the push) so a 128-slice picture needs no per-packet array on the stack.
+ */
+int apple_vxd_submit(struct apple_vxd_ctx *ctx, struct apple_vxd_cmdbuf *cb)
+{
+	struct apple_vxd_fence *fences[APPLE_VXD_JOB_MAX_FENCES] = { };
+	struct apple_vxd_dev *vxd = ctx->vxd;
+	struct apple_vxd_msg_ticket ticket;
+	u32 msg[VXD_DECODE_MSG_WORDS];
+	unsigned int i, narmed, first_armed, pushed = 0;
+	struct apple_vxd_fence *last = NULL;
+	unsigned long flags;
+	bool gart_dirty;
+	int n, ret;
+	size_t off;
+	u16 seq;
+
+	n = apple_vxd_cmdbuf_validate(cb);
+	if (n <= 0 || n > APPLE_VXD_JOB_MAX_PACKETS) {
+		dev_err(vxd->dev, "decode: %d packets in the command buffer (1..%u)\n",
+			n, APPLE_VXD_JOB_MAX_PACKETS);
+		return -EINVAL;
+	}
+	narmed = n <= APPLE_VXD_JOB_MAX_FENCES ? n : 1;
+	first_armed = n - narmed;
+
+	/* Every packet must make a message before anything is armed. */
+	for (i = 0, off = 0; i < n; i++) {
+		u32 *pkt = (u32 *)(cb->pkt + off);
+
+		ret = apple_vxd_packet_msg(vxd, pkt, 0, 0, i == n - 1, msg);
+		if (ret < 0)
+			return ret;
+		off += VXD_PKT_HDR_BYTES + pkt[1];
+	}
+
+	mutex_lock(&vxd->power_lock);
+	if (!vxd->mbox_ready || !vxd->hw_ready || vxd->fw_panicked) {
+		ret = -ENODEV;
+		goto out_unlock;
+	}
+
+	/* Fences first: the firmware may answer before the last push. */
+	spin_lock_irqsave(&vxd->mbox_lock, flags);
+	seq = vxd_fence_next_seq_locked(vxd);
+	for (i = 0; i < narmed; i++) {
+		fences[i] = vxd_fence_arm_locked(vxd,
+						 vxd_fence_id(seq, first_armed + i),
+						 VXD_MSG_DECODE);
+		if (!fences[i])
+			break;
+	}
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+	if (i < narmed) {
+		ret = -EBUSY;
+		goto out_fences;
+	}
+
+	last = fences[narmed - 1];
+	last->job = true;
+	ret = apple_vxd_cmdbuf_bind(vxd, cb, last);
+	if (ret)
+		goto out_fences;
+
+	spin_lock_irqsave(&vxd->job_lock, flags);
+	if (vxd->job_active) {
+		spin_unlock_irqrestore(&vxd->job_lock, flags);
+		ret = -EBUSY;
+		goto out_unbind;
+	}
+	vxd->job.ctx = ctx;
+	vxd->job.nfences = narmed;
+	vxd->job.npackets = n;
+	vxd->job.seq = seq;
+	vxd->job.submitted = ktime_get();
+	memcpy(vxd->job.fences, fences, sizeof(fences));
+	vxd->job_active = true;
+	spin_unlock_irqrestore(&vxd->job_lock, flags);
+
+	/* The kext rewrites 0x1008 before a submit that follows a GART change. */
+	mutex_lock(&vxd->gart.lock);
+	gart_dirty = vxd->gart.dirty;
+	vxd->gart.dirty = false;
+	mutex_unlock(&vxd->gart.lock);
+	if (gart_dirty)
+		vxd_write(vxd, VXD_REG_MMU_CONTROL1, VXD_MMU_INVALDC_ALL);
+
+	for (i = 0, off = 0; i < n; i++) {
+		u32 *pkt = (u32 *)(cb->pkt + off);
+		int type;
+
+		off += VXD_PKT_HDR_BYTES + pkt[1];
+		type = apple_vxd_packet_msg(vxd, pkt, vxd_fence_id(seq, i), 0,
+					    i == n - 1, msg);
+		if (i >= first_armed)
+			fences[i - first_armed]->type = type;
+		ret = apple_vxd_msg_push(vxd, msg, &ticket);
+		if (ret)
+			break;
+		pushed++;
+	}
+	if (ret) {
+		dev_err(vxd->dev, "decode: push %u of %d failed: %d%s\n", pushed + 1,
+			n, ret, pushed ? "; the command buffer stays quarantined" : "");
+		spin_lock_irqsave(&vxd->job_lock, flags);
+		vxd->job_active = false;
+		spin_unlock_irqrestore(&vxd->job_lock, flags);
+		if (pushed)
+			goto out_fences;	/* release leaves the buffer DEVICE */
+		goto out_unbind;
+	}
+
+	schedule_delayed_work(&vxd->watchdog_work,
+			      msecs_to_jiffies(APPLE_VXD_JOB_TIMEOUT_MS));
+	mutex_unlock(&vxd->power_lock);
+	return 0;
+
+out_unbind:
+	spin_lock_irqsave(&vxd->mbox_lock, flags);
+	if (cb->state == APPLE_VXD_CMDBUF_DEVICE && cb->fence == last) {
+		cb->state = APPLE_VXD_CMDBUF_HOST;
+		cb->fence = NULL;
+		last->cmdbuf = NULL;
+	}
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+out_fences:
+	for (i = 0; i < narmed; i++)
+		if (fences[i])
+			apple_vxd_fence_release(vxd, fences[i]);
+out_unlock:
+	mutex_unlock(&vxd->power_lock);
+	return ret;
+}
diff --git a/drivers/media/platform/apple/vxd/apple-vxd-regs.h b/drivers/media/platform/apple/vxd/apple-vxd-regs.h
new file mode 100644
index 000000000..37a13ab32
--- /dev/null
+++ b/drivers/media/platform/apple/vxd/apple-vxd-regs.h
@@ -0,0 +1,279 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Apple VXD (Imagination MSVDX, "PowerVR video decoder") register map
+ *
+ * Offsets recovered by mining the iOS 16.7.10 com.apple.driver.AppleD5500
+ * kext (iPad6,11 kernelcache, unslid virtual addresses); every offset below
+ * is reached through CPVDECCore::ReadReg/WriteReg in that kext. See
+ * docs/periph/ds-video-decoder.md. Names follow the public MSVDX layout used
+ * by Imagination-derived drivers; offset are facts, names are inferred.
+ */
+#ifndef __APPLE_VXD_REGS_H__
+#define __APPLE_VXD_REGS_H__
+
+#include <linux/bits.h>
+
+/* Core identification (CPVDECCore::GetCoreRev [E]) */
+#define VXD_REG_CORE_ID			0x0630
+#define  VXD_CORE_ID_MAJOR_SH		16
+#define  VXD_CORE_ID_ENT_PIPES		GENMASK(3, 0)
+#define  VXD_CORE_ID_PIX_PIPES		GENMASK(7, 4)
+#define VXD_REG_CORE_REV		0x0640
+
+/*
+ * Clock enables (CPVDECCore_Clocks.cpp SetClocks [E]).  Written with the
+ * default value first, read back for a sanity check, then written with the
+ * requested value.  A read-back mismatch means the core is not powered or
+ * not clocked ("Core register write differs from read").
+ */
+#define VXD_REG_CR_PVDEC_MAN_CLK_ENABLE	0x0440
+#define  VXD_CLK_ENABLE_DEFAULT		0x00000011
+#define  VXD_CLK_ENABLE_ALL		0xffffffff
+#define  VXD_CLK_ENABLE_FW		0x01010113
+
+/*
+ * MTX (META) block.  MTX_CTRL is read-modify-written with bits 0 and 16
+ * taken from core flags; MTX_MAN_CLK_ENABLE is written with bit 28 set and
+ * polled for equality during the boot sequence.
+ */
+#define VXD_REG_MTX_CTRL		0x1000
+#define  VXD_MTX_CTRL_KEEP_MASK		0xfffefffe
+#define VXD_REG_MTX_MAN_CLK_ENABLE	0x1008
+/*
+ * The same 0x1008 seen from the submit path: the kext writes 0xf00 there
+ * before a decode submit that follows a GART change (+0x27a0 rule,
+ * 0xfffffff00628af2c [E]).  In Imagination's BUS4 MMU layout (PVDEC,
+ * img-vxe-vxd) 0x1000 + 8 is MMU_CONTROL1 and bits 11:8 are MMU_INVALDC,
+ * one directory-cache invalidate per context [I].
+ */
+#define VXD_REG_MMU_CONTROL1		0x1008
+#define  VXD_MMU_INVALDC_ALL		0x00000f00
+#define  VXD_MTX_CLK_SEL		0x10000000
+#define VXD_REG_MTX_MMU_0		0x1010
+#define VXD_REG_MTX_MMU_DIR_ADR		0x1020
+#define VXD_REG_MTX_MMU_MODE		0x1070
+#define  VXD_MTX_MMU_MODE_40BIT		0x10
+#define VXD_REG_MTX_MMU_CFG0		0x1080
+#define  VXD_MTX_MMU_CFG0_40BIT		0x80	/* (cfg0 & 0xf0) == 0x80 */
+#define VXD_REG_MTX_MMU_CFG1		0x1084
+#define  VXD_MTX_MMU_CFG1_TILING_CTX	BIT(29)
+
+/*
+ * MTX boot block, programmed by LoadFirmwareAndStartCore [E].  BOOT_5 (7)
+ * enables the MTX clocks and must be written before the rest of the block;
+ * BOOT_1 is written twice (stage 0 then stage 1) to release the MTX from
+ * reset; BOOT_FW_ADR holds the low 32 bits of the firmware buffer address.
+ */
+#define VXD_REG_MTX_BOOT_FW_ADR		0x6a00
+#define VXD_REG_MTX_BOOT_1		0x6a04
+#define  VXD_MTX_BOOT_1_STAGE0		0x22000000
+#define  VXD_MTX_BOOT_1_STAGE1		0x22010000
+#define VXD_REG_MTX_BOOT_2		0x6a08
+#define  VXD_MTX_BOOT_2_VALUE		0x01000000
+#define VXD_REG_MTX_BOOT_3		0x6a0c
+#define VXD_REG_MTX_BOOT_4		0x6a14
+#define  VXD_MTX_BOOT_4_VALUE		0x00000350
+#define VXD_REG_MTX_BOOT_5		0x6a18
+#define  VXD_MTX_BOOT_5_ENABLE		0x7
+
+/* VEC block and entropy decoder pipes */
+#define VXD_REG_VECT_CFG		0x0200
+#define VXD_REG_VECT_CFG2		0x0208
+#define  VXD_VECT_CFG2_MSGS_MINUS1	0x000000c7	/* core[0xb4] - 1 */
+#define VXD_REG_ENTDEC_0_SIZE		0x0340
+#define VXD_REG_ENTDEC_0_CFG		0x0344
+
+/*
+ * MTX -> host "message consumed" word: the firmware stores the word count
+ * of the message it last took from TO_MTX here (fw 0x1000a90 [E]).
+ */
+#define VXD_REG_MTX_MSG_CONSUMED	0x0000
+
+/* Host -> MTX doorbell, written 1 after every message push [E]. */
+#define VXD_REG_MTX_DOORBELL		0x0088
+
+/*
+ * CMD block control.  The reset value 0xffff0000 is written before and
+ * after firmware load (known state v1/v2 [E]).
+ */
+#define VXD_REG_CMD_CTRL		0x0400
+#define  VXD_CMD_CTRL_RESET		0xffff0000
+
+/*
+ * Host interrupt: status / write-1-to-clear / enable.  The firmware raises
+ * bit 20 by writing it to 0x410 when it posts a TO_HOST message with the
+ * interrupt flag (fw 0x1000fe4 [E]); the kext ISR reads 0x410, clears with
+ * 0x414 = 0x100000 before draining (0xfffffff00629a0ac [E]).  Known state
+ * writes 0 to the enable and all-ones to the clear; boot enables bit 20.
+ */
+#define VXD_REG_IRQ_STATUS		0x0410
+#define VXD_REG_IRQ_CLEAR		0x0414
+#define VXD_REG_IRQ_ENABLE		0x0418
+#define  VXD_IRQ_FW_MSG			BIT(20)
+
+/* DMAC */
+#define VXD_REG_MTX_MEM_CFG		0x0500
+#define  VXD_MTX_MEM_BANK_COUNT		GENMASK(11, 8)
+#define  VXD_MTX_MEM_BANK_SIZE		GENMASK(19, 16)
+#define  VXD_MTX_MEM_LAST_BANK		GENMASK(27, 24)
+#define VXD_REG_DMAC_STATUS		0x0504
+#define  VXD_DMAC_STATUS_FLUSH		0x80000000
+
+/*
+ * Pipe select + per-pipe registers.  The block multiplexes several register
+ * banks behind CMD_KICK: writing the pipe index (1-based) there selects
+ * which pipe the 0x30xx/0x40xx banks talk to.
+ */
+#define VXD_REG_CMD_KICK		0x0460
+#define VXD_REG_PIPE_SET_0		0x3020
+#define VXD_REG_PIPE_SET_1		0x3030
+#define VXD_REG_PIPE_SET_2		0x3038
+#define VXD_REG_PIPE_4004		0x4004
+#define VXD_REG_PIPE_CTRL		0x4020
+#define VXD_REG_PIPE_CR0		0x4060
+#define VXD_REG_PIPE_CR1		0x4068
+#define VXD_REG_PIPE_CR2		0x4070
+#define VXD_REG_PIPE_CR3		0x4078
+#define VXD_REG_PIPE_STATUS		0x40c0
+#define VXD_REG_PIPE_STATUS_2		0x40c4
+
+/*
+ * Host<->MTX message rings (comms), docs/periph/ds-vxd-decode-protocol.md
+ * section 2.  The four indices are confirmed by the kext recovery path:
+ *   0x201c TO_HOST_RD_INDEX (host)   0x2020 TO_HOST_WR_INDEX (fw)
+ *   0x2028 TO_MTX_RD_INDEX  (fw)     0x2030 TO_MTX_WR_INDEX  (host)
+ * FW_READY_MAGIC is polled (0 = the kext clears it, 0xa5a5a5a5 = firmware
+ * alive).  After the magic the firmware has published each ring's geometry
+ * as (base_bytes << 16) | capacity_words: word i of a ring is the register
+ * at VXD_RING_WINDOW + base + 4 * i.
+ */
+#define VXD_REG_COMMS_STATE		0x2000
+#define VXD_REG_COMMS_2008		0x2008	/* cleared at ring setup [E] */
+#define VXD_REG_FW_PC			0x200c	/* fw stores its PC; host clears */
+#define VXD_REG_COMMS_MSG_COUNT		0x2010	/* fw->host messages posted */
+#define VXD_REG_FW_READY_MAGIC		0x2014
+#define  VXD_FW_READY_MAGIC		0xa5a5a5a5
+#define VXD_REG_TO_HOST_RING		0x2018
+#define VXD_REG_TO_HOST_RD_INDEX	0x201c
+#define VXD_REG_TO_HOST_WR_INDEX	0x2020
+#define VXD_REG_TO_MTX_RING		0x2024
+#define VXD_REG_TO_MTX_RD_INDEX		0x2028
+#define VXD_REG_COMMS_FLAGS		0x202c
+#define VXD_REG_TO_MTX_WR_INDEX		0x2030
+
+#define VXD_RING_WINDOW			0x2000
+#define  VXD_RING_BASE			GENMASK(31, 16)
+#define  VXD_RING_CAP			GENMASK(15, 0)
+
+/*
+ * Message header, both directions: (fence << 16) | (type << 8) | nwords,
+ * nwords counting the header.  The firmware drops TO_MTX messages longer
+ * than 0x14 words (fw 0x1000b80) and a zero-length header wedges its
+ * reader (fw 0x1000a4c: it re-publishes the same read index forever).
+ * The kext refuses TO_HOST messages of 0xf0 / 4 = 60 words or more.
+ */
+#define VXD_MSG_NWORDS			GENMASK(6, 0)
+#define VXD_MSG_TYPE			GENMASK(15, 8)
+#define VXD_MSG_FENCE			GENMASK(31, 16)
+#define VXD_MSG_TO_MTX_MAX_WORDS	0x14
+#define VXD_MSG_TO_HOST_MAX_WORDS	(0xf0 / 4 - 1)
+
+/*
+ * Host -> firmware types: the DEVA dispatcher (fw 0x1000ad4) handles
+ * 0x80..0x8b.  0x83..0x85 jump straight back to the reader loop: they are
+ * consumed and dropped, which makes them the benign ping.
+ */
+#define VXD_MSG_INIT			0x80
+#define VXD_MSG_DECODE			0x81
+#define VXD_MSG_NOP_FIRST		0x83
+#define VXD_MSG_NOP_LAST		0x85
+#define VXD_MSG_DEBLOCK			0x87
+#define VXD_MSG_RENDER_TARGET		0x88
+
+/* Firmware -> host types (ProcessFWMessages 0xfffffff006299bb4 [E]). */
+#define VXD_MSG_COMPLETION		0xc0
+#define VXD_MSG_CONTIGUITY		0xc6
+#define VXD_MSG_PANIC			0xc7
+
+/* 0xc0 word 2: fault class, "after core reset", REATTEMPT_SINGLEPIPE. */
+#define VXD_COMPLETION_FAULT		GENMASK(28, 27)
+#define VXD_COMPLETION_AFTER_RESET	BIT(28)
+#define VXD_COMPLETION_REATTEMPT	BIT(31)
+
+/* 0x80 init message (InitMessageBuffers 0xfffffff006298d40 [E]). */
+#define VXD_INIT_MSG_WORDS		5
+#define VXD_INIT_PAGES			GENMASK(15, 0)
+#define VXD_INIT_SEQ			GENMASK(23, 16)
+#define VXD_INIT_SENTINEL		0xffff0000
+
+/*
+ * Decode-family message w1 low-half flags (SubmitCommandBufferInternal
+ * 0xfffffff00628a8d4 [E]): last packet of a submission | interrupt the
+ * host on completion; more packets follow.
+ */
+#define VXD_MSG_FLAG_LAST		0x4004
+#define VXD_MSG_FLAG_MORE		0x2000
+
+/*
+ * MSVDX command stream (docs/periph/ds-vxd-cmdstream.md section 2, the
+ * emitters at 0xfffffff00629a34c..0xfffffff00629b15c [E]).  These words
+ * live in the GART-mapped command buffer and are read by the core's
+ * command processor, not by the DEVA firmware.
+ */
+#define VXD_CMD_REG_RUN			0x10000000	/* | count << 16 | reg */
+#define  VXD_CMD_REG_RUN_ONE		0x00010000	/* count += 1 */
+#define  VXD_CMD_REG_RUN_COUNT		GENMASK(27, 16)
+#define VXD_CMD_REG1			0x000f0000	/* | (flags & 0xf0) << 16 | reg */
+#define  VXD_CMD_REG1_FLAGS		GENMASK(7, 4)
+#define VXD_CMD_REG_ADDR		GENMASK(15, 0)
+#define VXD_CMD_SLICE_BLOCK		0x90000000	/* + 9 zero words */
+#define  VXD_CMD_SLICE_BLOCK_WORDS	10
+#define VXD_CMD_SLICE_DESC		0xb0000001	/* + 2 words */
+#define VXD_CMD_LOAD			0xa0000000	/* | bytes, + device address */
+#define  VXD_CMD_LOAD_MAX		GENMASK(27, 0)
+#define VXD_CMD_TABLE_XFER		0xf0000000	/* | bytes, + address, + dest */
+#define VXD_CMD_END_SLICE		0x60000000
+/*
+ * AVC additions (ds-vxd-cmdstream.md section 16.3-16.6; Imagination's
+ * DXVA control-allocation names from psb_video's dxva_fw_ctrl.h):
+ *   0x5 CMD_RENDEC_BLOCK  0x50000000 | flags | count << 16 | reg, values
+ *   0xe CMD_DMA           0xe0000000 | type | bytes, device address
+ *   0xb CMD_SR_SETUP flag 1 = ENABLE_RBDU_EXTRACTION (the core strips the
+ *                         emulation-prevention bytes itself)
+ */
+#define VXD_CMD_BLOCK			0x50000000
+#define  VXD_CMD_BLOCK_COUNT		GENMASK(26, 16)
+#define  VXD_CMD_BLOCK_FLAG_REFS	0x08000000	/* on the 0x7100 block */
+#define VXD_CMD_DMA			0xe0000000
+#define  VXD_CMD_DMA_BYTES		GENMASK(15, 0)
+#define  VXD_CMD_DMA_TYPE_VLC		0x00000000
+#define VXD_CMD_CHUNK_ALIGN		64		/* zero pad between slices */
+
+/*
+ * Host-side packet list (CmdBuf::addCommand 0xfffffff0062982f8 [E]):
+ * {magic0, payload bytes, magic1} + payload, back to back.  The submit
+ * path walks it from its base, checks both magics (0xfffffff00628ac78) and
+ * turns every packet into one mailbox message; the list itself never
+ * reaches the device.
+ */
+#define VXD_PKT_MAGIC0			0x80000007
+#define VXD_PKT_MAGIC1			0xabcdefab
+#define VXD_PKT_HDR_BYTES		12
+#define VXD_PKT_H264_PAYLOAD		0x78
+/* Payload offsets (header-relative offset - 0xc). */
+#define VXD_PKT_FLAGS			0x04	/* -> w1[15:0] */
+#define VXD_PKT_W4			0x08	/* -> w4 */
+#define VXD_PKT_CMD_BYTES		0x0c	/* -> w1[31:16] (>> 2, kind 4: >> 3) */
+#define VXD_PKT_W2			0x10	/* -> w2 */
+#define VXD_PKT_W5			0x24	/* -> w5 */
+#define VXD_PKT_W6			0x28	/* -> w6, 7-word messages only */
+#define VXD_PKT_KIND			0x4c
+#define  VXD_PKT_KIND_PICTURE		1	/* -> 0x81 */
+#define  VXD_PKT_KIND_DEBLOCK		3	/* -> 0x87 */
+#define  VXD_PKT_KIND_RENDER_TARGET	4	/* -> 0x88 */
+#define VXD_PKT_NOT_REF			0x50	/* AVC: host-side bookkeeping */
+#define VXD_DECODE_MSG_WORDS		6
+
+#define VXD_MMIO_SIZE			0x100000
+
+#endif /* __APPLE_VXD_REGS_H__ */
diff --git a/drivers/media/platform/apple/vxd/apple-vxd-v4l2.c b/drivers/media/platform/apple/vxd/apple-vxd-v4l2.c
new file mode 100644
index 000000000..23c051f1d
--- /dev/null
+++ b/drivers/media/platform/apple/vxd/apple-vxd-v4l2.c
@@ -0,0 +1,1018 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Apple VXD - V4L2 stateless m2m device
+ *
+ * Structure follows the rkvdec stateless template: one video node, a media
+ * controller entity, mplane m2m queues with the request API mandatory on
+ * the output queue, and the stateless H.264 control set.
+ */
+#include <linux/pm_runtime.h>
+
+#include <media/v4l2-event.h>
+#include <media/v4l2-ioctl.h>
+#include <media/videobuf2-dma-contig.h>
+
+#include "apple-vxd.h"
+
+/* Smallest bitstream buffer handed to userspace. */
+#define APPLE_VXD_MIN_BITSTREAM_SIZE	SZ_1M
+
+static struct apple_vxd_ctx *file_to_vxd_ctx(struct file *file)
+{
+	return container_of(file_to_v4l2_fh(file), struct apple_vxd_ctx, fh);
+}
+
+static void apple_vxd_reset_fmt(struct apple_vxd_ctx *ctx,
+				struct v4l2_format *f, u32 fourcc)
+{
+	memset(f, 0, sizeof(*f));
+	f->fmt.pix_mp.pixelformat = fourcc;
+	f->fmt.pix_mp.field = V4L2_FIELD_NONE;
+	f->fmt.pix_mp.colorspace = V4L2_COLORSPACE_REC709;
+	f->fmt.pix_mp.ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	f->fmt.pix_mp.quantization = V4L2_QUANTIZATION_DEFAULT;
+	f->fmt.pix_mp.xfer_func = V4L2_XFER_FUNC_DEFAULT;
+}
+
+/*
+ * Every MSVDX surface base register (luma and chroma reconstruction,
+ * references) drops the low 12 bits, and the extended row stride counts
+ * 64-byte units.  With single-plane NV12 the chroma plane starts at
+ * bytesperline * height, so the luma stride is rounded up to 256 bytes:
+ * with the height a multiple of 16 that keeps the chroma plane 4 KiB
+ * aligned behind a page-aligned buffer.
+ */
+#define APPLE_VXD_NV12_STRIDE_ALIGN	256
+
+static void apple_vxd_fill_decoded_pixfmt(struct apple_vxd_ctx *ctx,
+					  struct v4l2_pix_format_mplane *pix_mp)
+{
+	struct v4l2_plane_pix_format *plane = &pix_mp->plane_fmt[0];
+
+	v4l2_fill_pixfmt_mp(pix_mp, pix_mp->pixelformat,
+			    pix_mp->width, pix_mp->height);
+	if (pix_mp->pixelformat == V4L2_PIX_FMT_NV12) {
+		plane->bytesperline = ALIGN(pix_mp->width,
+					    APPLE_VXD_NV12_STRIDE_ALIGN);
+		plane->sizeimage = plane->bytesperline * pix_mp->height * 3 / 2;
+	}
+}
+
+static const struct apple_vxd_decoded_fmt_desc *
+apple_vxd_find_decoded_fmt(const struct apple_vxd_coded_fmt_desc *desc,
+			   enum apple_vxd_image_fmt image_fmt)
+{
+	unsigned int i;
+
+	for (i = 0; i < desc->num_decoded_fmts; i++)
+		if (desc->decoded_fmts[i].image_fmt == image_fmt)
+			return &desc->decoded_fmts[i];
+
+	return NULL;
+}
+
+static u32 apple_vxd_enum_decoded_fmt(struct apple_vxd_ctx *ctx, int index,
+				      enum apple_vxd_image_fmt image_fmt)
+{
+	const struct apple_vxd_decoded_fmt_desc *dfmt;
+
+	if (image_fmt == APPLE_VXD_IMG_FMT_ANY)
+		image_fmt = APPLE_VXD_IMG_FMT_420_8BIT;
+	dfmt = apple_vxd_find_decoded_fmt(ctx->coded_fmt_desc, image_fmt);
+	if (dfmt && !index)
+		return dfmt->fourcc;
+	return 0;
+}
+
+static bool apple_vxd_is_valid_fmt(struct apple_vxd_ctx *ctx, u32 fourcc,
+				   enum apple_vxd_image_fmt image_fmt)
+{
+	return apple_vxd_enum_decoded_fmt(ctx, 0, image_fmt) == fourcc;
+}
+
+static const struct apple_vxd_coded_fmt_desc *
+apple_vxd_find_coded_fmt_desc(struct apple_vxd_ctx *ctx, u32 fourcc)
+{
+	struct apple_vxd_dev *vxd = ctx->vxd;
+	unsigned int i;
+
+	for (i = 0; i < vxd->num_coded_fmts; i++)
+		if (vxd->coded_fmts[i].fourcc == fourcc)
+			return &vxd->coded_fmts[i];
+	return NULL;
+}
+
+static void apple_vxd_reset_coded_fmt(struct apple_vxd_ctx *ctx)
+{
+	struct v4l2_format *f = &ctx->coded_fmt;
+
+	/* apple_vxd_ctx_init() checked vxd->coded_fmts before calling us. */
+	ctx->coded_fmt_desc = &ctx->vxd->coded_fmts[0];
+	apple_vxd_reset_fmt(ctx, f, ctx->coded_fmt_desc->fourcc);
+	f->type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+	f->fmt.pix_mp.width = ctx->coded_fmt_desc->frmsize.min_width;
+	f->fmt.pix_mp.height = ctx->coded_fmt_desc->frmsize.min_height;
+	/* Same normalization as TRY_FMT: one plane, a usable bitstream size. */
+	f->fmt.pix_mp.num_planes = 1;
+	f->fmt.pix_mp.plane_fmt[0].sizeimage = APPLE_VXD_MIN_BITSTREAM_SIZE;
+
+	if (ctx->coded_fmt_desc->ops->adjust_fmt)
+		ctx->coded_fmt_desc->ops->adjust_fmt(ctx, f);
+}
+
+static void apple_vxd_reset_decoded_fmt(struct apple_vxd_ctx *ctx)
+{
+	struct v4l2_format *f = &ctx->decoded_fmt;
+	u32 fourcc = apple_vxd_enum_decoded_fmt(ctx, 0, ctx->image_fmt);
+
+	apple_vxd_reset_fmt(ctx, f, fourcc);
+	f->type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+	f->fmt.pix_mp.width = ctx->coded_fmt.fmt.pix_mp.width;
+	f->fmt.pix_mp.height = ctx->coded_fmt.fmt.pix_mp.height;
+	apple_vxd_fill_decoded_pixfmt(ctx, &f->fmt.pix_mp);
+}
+
+static int apple_vxd_image_fmt_changed(struct apple_vxd_ctx *ctx,
+				       enum apple_vxd_image_fmt image_fmt)
+{
+	if (image_fmt == APPLE_VXD_IMG_FMT_ANY)
+		return ctx->image_fmt != image_fmt;
+
+	return apple_vxd_find_decoded_fmt(ctx->coded_fmt_desc, image_fmt) !=
+	       apple_vxd_find_decoded_fmt(ctx->coded_fmt_desc, ctx->image_fmt);
+}
+
+static int apple_vxd_try_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct apple_vxd_ctx *ctx =
+		container_of(ctrl->handler, struct apple_vxd_ctx, ctrl_hdl);
+	const struct apple_vxd_coded_fmt_desc *desc = ctx->coded_fmt_desc;
+
+	if (desc->ops->try_ctrl)
+		return desc->ops->try_ctrl(ctx, ctrl);
+	return 0;
+}
+
+/*
+ * Also runs from v4l2_ctrl_handler_setup() inside apple_vxd_ctx_init(), so
+ * the m2m context (and its queues) must exist before the controls do.
+ */
+static int apple_vxd_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct apple_vxd_ctx *ctx =
+		container_of(ctrl->handler, struct apple_vxd_ctx, ctrl_hdl);
+	const struct apple_vxd_coded_fmt_desc *desc = ctx->coded_fmt_desc;
+	enum apple_vxd_image_fmt image_fmt;
+	struct vb2_queue *vq;
+
+	if (!desc->ops->get_image_fmt)
+		return 0;
+
+	image_fmt = desc->ops->get_image_fmt(ctx, ctrl);
+	if (apple_vxd_image_fmt_changed(ctx, image_fmt)) {
+		vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx,
+				     V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+		if (vb2_is_busy(vq))
+			return -EBUSY;
+
+		ctx->image_fmt = image_fmt;
+		apple_vxd_reset_decoded_fmt(ctx);
+	}
+
+	return 0;
+}
+
+const struct v4l2_ctrl_ops apple_vxd_ctrl_ops = {
+	.try_ctrl = apple_vxd_try_ctrl,
+	.s_ctrl = apple_vxd_s_ctrl,
+};
+
+static int apple_vxd_add_ctrls(struct apple_vxd_ctx *ctx,
+			       const struct apple_vxd_ctrls *ctrls)
+{
+	unsigned int i;
+
+	for (i = 0; i < ctrls->num_ctrls; i++) {
+		v4l2_ctrl_new_custom(&ctx->ctrl_hdl, &ctrls->ctrls[i].cfg, ctx);
+		if (ctx->ctrl_hdl.error)
+			return ctx->ctrl_hdl.error;
+	}
+
+	return 0;
+}
+
+static int apple_vxd_init_ctrls(struct apple_vxd_ctx *ctx)
+{
+	struct apple_vxd_dev *vxd = ctx->vxd;
+	unsigned int i, nctrls = 0;
+	int ret;
+
+	for (i = 0; i < vxd->num_coded_fmts; i++)
+		nctrls += vxd->coded_fmts[i].ctrls->num_ctrls;
+
+	v4l2_ctrl_handler_init(&ctx->ctrl_hdl, nctrls);
+
+	for (i = 0; i < vxd->num_coded_fmts; i++) {
+		ret = apple_vxd_add_ctrls(ctx, vxd->coded_fmts[i].ctrls);
+		if (ret)
+			goto err_free_handler;
+	}
+
+	ret = v4l2_ctrl_handler_setup(&ctx->ctrl_hdl);
+	if (ret)
+		goto err_free_handler;
+
+	ctx->fh.ctrl_handler = &ctx->ctrl_hdl;
+	return 0;
+
+err_free_handler:
+	v4l2_ctrl_handler_free(&ctx->ctrl_hdl);
+	return ret;
+}
+
+/* --- handler bodies (context based) ------------------------------------ */
+
+static int apple_vxd_do_enum_framesizes(struct apple_vxd_ctx *ctx,
+					struct v4l2_frmsizeenum *fsize)
+{
+	const struct apple_vxd_coded_fmt_desc *desc;
+
+	if (fsize->index != 0)
+		return -EINVAL;
+
+	desc = apple_vxd_find_coded_fmt_desc(ctx, fsize->pixel_format);
+	if (!desc)
+		return -EINVAL;
+
+	fsize->type = V4L2_FRMSIZE_TYPE_CONTINUOUS;
+	fsize->stepwise.min_width = 1;
+	fsize->stepwise.max_width = desc->frmsize.max_width;
+	fsize->stepwise.step_width = 1;
+	fsize->stepwise.min_height = 1;
+	fsize->stepwise.max_height = desc->frmsize.max_height;
+	fsize->stepwise.step_height = 1;
+
+	return 0;
+}
+
+/*
+ * The V4L2 core fills device_caps, capabilities and bus_info (from the
+ * node's parent device, "platform:207f00000.vxd", matching the media
+ * device's default) before calling the driver.
+ */
+static void apple_vxd_fill_querycap(struct apple_vxd_dev *vxd,
+				    struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, APPLE_VXD_DRV_NAME, sizeof(cap->driver));
+	strscpy(cap->card, APPLE_VXD_DRV_NAME, sizeof(cap->card));
+}
+
+static int apple_vxd_do_try_capture_fmt(struct apple_vxd_ctx *ctx,
+					struct v4l2_format *f)
+{
+	struct v4l2_pix_format_mplane *pix_mp = &f->fmt.pix_mp;
+	const struct apple_vxd_coded_fmt_desc *coded_desc = ctx->coded_fmt_desc;
+
+	if (!apple_vxd_is_valid_fmt(ctx, pix_mp->pixelformat, ctx->image_fmt))
+		pix_mp->pixelformat =
+			apple_vxd_enum_decoded_fmt(ctx, 0, ctx->image_fmt);
+
+	/* Always apply the frmsize constraint of the coded end. */
+	pix_mp->width = max(pix_mp->width, ctx->coded_fmt.fmt.pix_mp.width);
+	pix_mp->height = max(pix_mp->height, ctx->coded_fmt.fmt.pix_mp.height);
+	v4l2_apply_frmsize_constraints(&pix_mp->width, &pix_mp->height,
+				       &coded_desc->frmsize);
+
+	apple_vxd_fill_decoded_pixfmt(ctx, pix_mp);
+	pix_mp->field = V4L2_FIELD_NONE;
+
+	return 0;
+}
+
+static int apple_vxd_do_try_output_fmt(struct apple_vxd_ctx *ctx,
+				       struct v4l2_format *f)
+{
+	struct v4l2_pix_format_mplane *pix_mp = &f->fmt.pix_mp;
+	const struct apple_vxd_coded_fmt_desc *desc;
+
+	desc = apple_vxd_find_coded_fmt_desc(ctx, pix_mp->pixelformat);
+	if (!desc) {
+		desc = &ctx->vxd->coded_fmts[0];
+		pix_mp->pixelformat = desc->fourcc;
+	}
+
+	v4l2_apply_frmsize_constraints(&pix_mp->width, &pix_mp->height,
+				       &desc->frmsize);
+
+	pix_mp->field = V4L2_FIELD_NONE;
+	/* All coded formats are considered single planar for now. */
+	pix_mp->num_planes = 1;
+
+	if (desc->ops->adjust_fmt) {
+		int ret;
+
+		ret = desc->ops->adjust_fmt(ctx, f);
+		if (ret)
+			return ret;
+	}
+
+	/*
+	 * One access unit per buffer (frame-based decode): one byte per
+	 * pixel covers a level 4.2 1080p intra picture (about 2 MiB),
+	 * userspace such as GStreamer leaves sizeimage to the driver.
+	 */
+	pix_mp->plane_fmt[0].sizeimage =
+		max3(pix_mp->plane_fmt[0].sizeimage,
+		     (u32)APPLE_VXD_MIN_BITSTREAM_SIZE,
+		     (u32)PAGE_ALIGN(pix_mp->width * pix_mp->height));
+	return 0;
+}
+
+static int apple_vxd_do_s_capture_fmt(struct apple_vxd_ctx *ctx,
+				      struct v4l2_format *f)
+{
+	struct vb2_queue *vq;
+	int ret;
+
+	/* Change not allowed if queue is busy */
+	vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx,
+			     V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+	if (vb2_is_busy(vq))
+		return -EBUSY;
+
+	ret = apple_vxd_do_try_capture_fmt(ctx, f);
+	if (ret)
+		return ret;
+
+	ctx->decoded_fmt = *f;
+	return 0;
+}
+
+static int apple_vxd_do_s_output_fmt(struct apple_vxd_ctx *ctx,
+				     struct v4l2_format *f)
+{
+	struct v4l2_m2m_ctx *m2m_ctx = ctx->fh.m2m_ctx;
+	const struct apple_vxd_coded_fmt_desc *desc;
+	struct v4l2_format *cap_fmt;
+	struct vb2_queue *peer_vq, *vq;
+	int ret;
+
+	/*
+	 * The iOS parser is one-stream-configuration-per-instance ("SPS
+	 * changes not supported!"); resolution changes only within the
+	 * same pixelformat.  Never while streaming.
+	 */
+	vq = v4l2_m2m_get_vq(m2m_ctx, V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
+	if (vb2_is_streaming(vq) ||
+	    (vb2_is_busy(vq) &&
+	     f->fmt.pix_mp.pixelformat != ctx->coded_fmt.fmt.pix_mp.pixelformat))
+		return -EBUSY;
+
+	peer_vq = v4l2_m2m_get_vq(m2m_ctx, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+	if (vb2_is_busy(peer_vq))
+		return -EBUSY;
+
+	ret = apple_vxd_do_try_output_fmt(ctx, f);
+	if (ret)
+		return ret;
+
+	desc = apple_vxd_find_coded_fmt_desc(ctx, f->fmt.pix_mp.pixelformat);
+	if (!desc)
+		return -EINVAL;
+	ctx->coded_fmt_desc = desc;
+	ctx->coded_fmt = *f;
+
+	/*
+	 * Reset the decoded format; the user is mandated to set it again
+	 * after we return.
+	 */
+	ctx->image_fmt = APPLE_VXD_IMG_FMT_ANY;
+	apple_vxd_reset_decoded_fmt(ctx);
+
+	/* Propagate colorspace information to capture. */
+	cap_fmt = &ctx->decoded_fmt;
+	cap_fmt->fmt.pix_mp.colorspace = f->fmt.pix_mp.colorspace;
+	cap_fmt->fmt.pix_mp.xfer_func = f->fmt.pix_mp.xfer_func;
+	cap_fmt->fmt.pix_mp.ycbcr_enc = f->fmt.pix_mp.ycbcr_enc;
+	cap_fmt->fmt.pix_mp.quantization = f->fmt.pix_mp.quantization;
+
+	return 0;
+}
+
+static int apple_vxd_do_enum_output_fmt(struct apple_vxd_ctx *ctx,
+					struct v4l2_fmtdesc *f)
+{
+	if (f->index >= ctx->vxd->num_coded_fmts)
+		return -EINVAL;
+	f->pixelformat = ctx->vxd->coded_fmts[f->index].fourcc;
+	return 0;
+}
+
+static int apple_vxd_do_enum_capture_fmt(struct apple_vxd_ctx *ctx,
+					 struct v4l2_fmtdesc *f)
+{
+	u32 fourcc;
+
+	fourcc = apple_vxd_enum_decoded_fmt(ctx, f->index, ctx->image_fmt);
+	if (!fourcc)
+		return -EINVAL;
+	f->pixelformat = fourcc;
+	return 0;
+}
+
