+# SPDX-License-Identifier: GPL-2.0
+config VIDEO_APPLE_VXD
+	tristate "Apple VXD (PowerVR MSVDX) video decoder driver"
+	depends on VIDEO_DEV
+	depends on ARCH_APPLE || COMPILE_TEST
+	select MEDIA_CONTROLLER
+	select VIDEOBUF2_DMA_CONTIG
+	select V4L2_MEM2MEM_DEV
+	select V4L2_H264
+	select CRC32
+	help
+	  Support for the Apple "VXD" video decoder of the S8000/S8003 (A9)
+	  SoCs: an Imagination PowerVR MSVDX core driven by the DEVA (MTX)
+	  firmware. It is exposed as a V4L2 stateless H.264 decoder.
+
+	  The driver needs the DEVA firmware as apple/vxd-deva.bin.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called apple-vxd.
