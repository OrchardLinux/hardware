 	if (apple_z2_is_iphone7_plus(z2)) {
 		if (payload_len < APPLE_Z2_FINGERS_OFFSET)
@@ -561,7 +747,8 @@ static void apple_z2_dispatch_frame(struct apple_z2 *z2, const u8 *payload,
