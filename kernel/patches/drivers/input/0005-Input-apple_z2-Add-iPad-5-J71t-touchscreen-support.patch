+	for (i = 0; i < n1->get_attempts && error == -EBADMSG; i++) {
+		if (i)
+			usleep_range(1000, 2000);
+		usleep_range(n1->get_delay_us, n1->get_delay_us + 1000);
+		error = apple_z2_n1_get_report_once(z2, report, min_len, len);
+	}
