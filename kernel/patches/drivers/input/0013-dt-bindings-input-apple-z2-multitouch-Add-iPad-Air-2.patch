From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Fri, 30 Oct 2026 20:24:00 +0800
Subject: [PATCH] dt-bindings: input: apple,z2-multitouch: Add iPad Air 2

The iPad Air 2 (J81, J82) has the iPad 5's N1 touchscreen controller
with the same supplies and clock. Its display sync stays an input, so
the display-sync pin states are required only on the iPad 5.

Signed-off-by: Henrik Klee <henrik@goat-code.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../input/touchscreen/apple,z2-multitouch.yaml  | 17 +++++++++++++----
 1 file changed, 13 insertions(+), 4 deletions(-)

diff --git a/Documentation/devicetree/bindings/input/touchscreen/apple,z2-multitouch.yaml b/Documentation/devicetree/bindings/input/touchscreen/apple,z2-multitouch.yaml
index f92fdb9..0d50813 100644
--- a/Documentation/devicetree/bindings/input/touchscreen/apple,z2-multitouch.yaml
+++ b/Documentation/devicetree/bindings/input/touchscreen/apple,z2-multitouch.yaml
@@ -19,6 +19,7 @@ properties:
       - apple,j493-touchbar
       - apple,j71b-touchscreen
       - apple,j71t-touchscreen
+      - apple,j81-touchscreen
       - apple,j172-touchscreen
       - apple,d11-touchscreen
       - apple,d111-touchscreen
@@ -179,7 +180,9 @@ allOf:
   - if:
       properties:
         compatible:
-          const: apple,j71t-touchscreen
+          enum:
+            - apple,j71t-touchscreen
+            - apple,j81-touchscreen
     then:
       properties:
         pinctrl-names:
@@ -199,13 +202,19 @@ allOf:
         - clocks
         - ana-supply
         - power-ldo-gpios
-        - pinctrl-0
-        - pinctrl-1
-        - pinctrl-names
     else:
       properties:
         ana-supply: false
         attn-gpios: false
+  - if:
+      properties:
+        compatible:
+          const: apple,j71t-touchscreen
+    then:
+      required:
+        - pinctrl-0
+        - pinctrl-1
+        - pinctrl-names
   - if:
       properties:
         compatible:
