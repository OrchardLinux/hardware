From 7aaf4b5f2b16e026a8bd01f4e8877b2840cafadd Mon Sep 17 00:00:00 2001
From: Dalton Alexandre <alley.nightly_0b@icloud.com>
Date: Fri, 30 Oct 2026 08:48:06 -0700
Subject: [PATCH] dt-bindings: soc: apple: Describe the T8010 AOP

Describe the single-word IOP mailbox, local SRAM and auto-boot word
used by the J71b orientation service.

Signed-off-by: Dalton Alexandre <alley.nightly_0b@icloud.com>
---
 .../bindings/soc/apple/apple,t8010-aop.yaml   | 53 +++++++++++++++++++
 MAINTAINERS                                   |  5 ++
 2 files changed, 58 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/apple/apple,t8010-aop.yaml

diff --git a/Documentation/devicetree/bindings/soc/apple/apple,t8010-aop.yaml b/Documentation/devicetree/bindings/soc/apple/apple,t8010-aop.yaml
new file mode 100644
index 0000000..4092f81
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/apple/apple,t8010-aop.yaml
@@ -0,0 +1,53 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/apple/apple,t8010-aop.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple T8010 always-on processor
+
+maintainers:
+  - Dalton Alexandre <alley.nightly_0b@icloud.com>
+
+description: |
+  ARMv7 always-on processor with a single-word RTBuddy mailbox, local SRAM
+  and an always-on boot control word. The mailbox range includes padding
+  to a 16 KiB boundary. No generic RTKit mailbox controller may own these
+  resources at the same time as the exclusive userspace DMA owner.
+
+properties:
+  compatible:
+    const: apple,t8010-aop
+
+  reg:
+    items:
+      - description: IOP control and mailbox registers, padded to 16 KiB
+      - description: Local SRAM
+      - description: Always-on boot control word
+
+  reg-names:
+    items:
+      - const: iop
+      - const: sram
+      - const: autoboot
+
+required:
+  - compatible
+  - reg
+  - reg-names
+
+additionalProperties: false
+
+examples:
+  - |
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+        coprocessor@210800000 {
+            compatible = "apple,t8010-aop";
+            reg = <0x2 0x10800000 0x0 0x20000>,
+                  <0x2 0x10e00000 0x0 0xa0000>,
+                  <0x2 0x10000500 0x0 0x4>;
+            reg-names = "iop", "sram", "autoboot";
+        };
+    };
diff --git a/MAINTAINERS b/MAINTAINERS
index b02280b..ffdcf4a 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -2064,6 +2064,11 @@ L:	linux-hwmon@vger.kernel.org
 S:	Odd fixes
 F:	drivers/hwmon/applesmc.c
 
+APPLE T8010 AOP ORIENTATION
+M:	Dalton Alexandre <alley.nightly_0b@icloud.com>
+S:	Maintained
+F:	Documentation/devicetree/bindings/soc/apple/apple,t8010-aop.yaml
+
 APPLETALK NETWORK LAYER
 L:	netdev@vger.kernel.org
 S:	Obsolete
