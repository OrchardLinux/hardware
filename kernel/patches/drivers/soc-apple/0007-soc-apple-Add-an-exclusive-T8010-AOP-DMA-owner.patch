 drivers/soc/apple/Kconfig          |  10 +
 drivers/soc/apple/Makefile         |   2 +
 drivers/soc/apple/apple-aop-dma.c  | 310 +++++++++++++++++++++++++++++
 include/uapi/linux/apple-aop-dma.h |  19 ++
 5 files changed, 343 insertions(+)
 create mode 100644 drivers/soc/apple/apple-aop-dma.c
 create mode 100644 include/uapi/linux/apple-aop-dma.h

