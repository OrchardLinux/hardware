diff --git a/drivers/soc/apple/Kconfig b/drivers/soc/apple/Kconfig
index 4e8dfff..bd5c37c 100644
--- a/drivers/soc/apple/Kconfig
+++ b/drivers/soc/apple/Kconfig
@@ -4,6 +4,16 @@ if ARCH_APPLE || COMPILE_TEST
 
 menu "Apple SoC drivers"
 
+config APPLE_AOP_DMA
+	tristate "Apple T8010 AOP userspace DMA owner"
+	depends on ARM64_16K_PAGES
+	depends on OF
+	help
+	  Provide exclusive root-only MMIO and bounded coherent DMA buffers for
+	  the T8010 AOP orientation service. The core is stopped before buffers
+	  are released. After starting it, a reboot is required to start again.
+	  This does not provide generic access to physical memory.
+
 config APPLE_MAILBOX
