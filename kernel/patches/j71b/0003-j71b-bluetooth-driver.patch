+/* The power001 Bluetooth core predates the upstream btbcm_reset export.
+ * Keep the equivalent HCI reset local to this out-of-tree UART module.
+ */
+static int bcm_reset_before_patch(struct hci_dev *hdev)
+{
+	struct sk_buff *skb;
+
+	skb = __hci_cmd_sync(hdev, HCI_OP_RESET, 0, NULL, HCI_INIT_TIMEOUT);
+	if (IS_ERR(skb))
+		return PTR_ERR(skb);
+	kfree_skb(skb);
+	msleep(100);
+	return 0;
+}
