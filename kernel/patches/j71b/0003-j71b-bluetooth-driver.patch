+		hci_set_quirk(hu->hdev,
+			      HCI_QUIRK_BROKEN_READ_TRANSMIT_POWER);
+
+	/* The upstream LE advertising-event fixup needs an HCI-core change.
+	 * It is not available in this power001 kernel; do not claim LE pairing.
+	 */
+	baudrate_set_before_patch = bcm->dev &&
+				   bcm->dev->set_baudrate_before_patch &&
+				   bcm->dev->oper_speed;
+	if (baudrate_set_before_patch) {
+		err = bcm_reset_before_patch(hu->hdev);
+		if (err)
+			return err;
+
+		speed = bcm->dev->oper_speed;
+		err = bcm_set_baudrate(hu, speed);
