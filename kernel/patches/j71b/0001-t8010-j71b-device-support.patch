+	numerator = coordinate - 10LL * minimum;
+	denominator = 10LL * (maximum - minimum);
+	if (numerator <= 0) {
+		*position = 0;
+	} else if (numerator >= denominator) {
+		*position = pixels;
+	} else {
+		*position = DIV_ROUND_CLOSEST_ULL((u64)numerator * pixels,
+						  denominator);
+	}
+
+	return true;
+}
