diff --git a/arch/arm64/boot/dts/apple/t8010-j71b-readiness.dts b/arch/arm64/boot/dts/apple/t8010-j71b-readiness.dts
new file mode 100644
index 000000000..6403442f3
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t8010-j71b-readiness.dts
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * Bounded J71b readiness experiment, NOT a full touchscreen implementation.
+ * Base board: Hoolock J71b. SPI wiring: this device's Apple DT and Pauli1Go
+ * T8010 SPI infrastructure. Display/timestamp sync pins are left untouched.
+ */
+#include "t8010-j71b.dts"
+
+/ {
+	spi3_readiness_nclk: clock-spi3-readiness {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		/* Candidate from ADT clock ID 0x135 / frequency table index 53.
+		 * Not measured. A <=500 kHz request gives ample speed margin even
+		 * if this differs from the physical source. Do not use for upload.
+		 */
+		clock-frequency = <61538461>;
+	};
+};
+
+&pmgr {
+	touch_readiness_clk: clock-controller@78000 {
+		compatible = "apple,t8010-touch-clock";
+		reg = <0x78000 0x8>;
+		#clock-cells = <0>;
+		clocks = <&clkref>;
+		clock-output-names = "touch-readiness";
+		clock-frequency = <24000000>;
+	};
+};
+
+&pinctrl_ap {
+	spi3_readiness_pins: spi3-readiness-pins {
+		pinmux = <APPLE_PINMUX(82, 1)>,
+			 <APPLE_PINMUX(83, 1)>,
+			 <APPLE_PINMUX(84, 1)>;
+	};
+};
+
+&{/soc} {
+	spi3_readiness: spi@20a08c000 {
+		compatible = "apple,t8010-spi", "apple,spi";
+		reg = <0x2 0x0a08c000 0x0 0x4000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 217 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&spi3_readiness_nclk>;
+		pinctrl-0 = <&spi3_readiness_pins>;
+		pinctrl-names = "default";
+		power-domains = <&ps_spi3>;
+		cs-gpios = <&pinctrl_ap 85 GPIO_ACTIVE_LOW>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		status = "okay";
+		/* Intentionally no dmas/dma-names and no enabled SmartIO node. */
+
+		touchscreen@0 {
+			compatible = "apple,j71b-touchscreen-readiness";
+			reg = <0>;
+			apple,readiness-only;
+			spi-max-frequency = <500000>;
+			spi-cpol;
+			spi-cpha;
+			/* Conservative 10 us CS hypothesis from reference HBPP14 path. */
+			spi-cs-setup-delay-ns = <10000>;
+			spi-cs-hold-delay-ns = <10000>;
+			spi-cs-inactive-delay-ns = <10000>;
+			interrupts-extended = <&pinctrl_ap 21 IRQ_TYPE_EDGE_FALLING>;
+			reset-gpios = <&pinctrl_ap 31 GPIO_ACTIVE_LOW>;
+			power-ana-gpios = <&pinctrl_ap 145 GPIO_ACTIVE_HIGH>;
+			power-ldo-gpios = <&pinctrl_ap 29 GPIO_ACTIVE_HIGH>;
+			clocks = <&touch_readiness_clk>;
+			/* No GPIO165/176/177, calibration or firmware-name property. */
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t8010-j71b-sio-dev.dts b/arch/arm64/boot/dts/apple/t8010-j71b-sio-dev.dts
new file mode 100644
index 000000000..7395b81de
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t8010-j71b-sio-dev.dts
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/* Development kernel: SmartIO is a manually loaded module, not boot-started.
+ * Preserve the successful readiness wiring and leave SPI3 PIO-only.
+ */
+#include "t8010-j71b-readiness.dts"
+
+&{/soc} {
+	sio_dev: dma-controller@20ae00000 {
+		compatible = "apple,t8010-sio";
+		reg = <0x2 0x0ae00000 0x0 0x10000>;
+		reg-names = "a7iop";
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 211 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 210 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 213 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 212 IRQ_TYPE_LEVEL_HIGH>;
+		power-domains = <&ps_sio>;
+		firmware-name = "apple/t8010-smartio.bin";
+		apple,diagnostics-only;
+		apple,firmware-size = <557152>;
+		apple,firmware-sha256 = [85 c3 24 30 f1 40 a1 2d 18 a7 4f 20 dc e5 20 bb
+					72 66 ae 64 ba 20 b2 0c 67 22 3c 6f 50 04 7f 6e];
+		dma-channels = <64>;
+		#dma-cells = <1>;
+		status = "okay";
+	};
+
+	sio-channel-check {
+		compatible = "apple,j71b-sio-channel-check";
+		apple,diagnostics-only;
+		dmas = <&sio_dev 26>;
+		dma-names = "tx";
+	};
+};
