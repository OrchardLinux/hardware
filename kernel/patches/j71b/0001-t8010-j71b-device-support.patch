+static bool apple_z2_scale_j172_coord(const u8 *raw, s16 maximum,
+				      s16 minimum, unsigned int pixels,
+				      unsigned int *position)
+{
+	s64 coordinate;
+	s64 numerator;
+	s64 denominator;
