diff --git a/arch/arm64/boot/dts/apple/t8010-j71b-devbase.dts b/arch/arm64/boot/dts/apple/t8010-j71b-devbase.dts
new file mode 100644
index 000000000..0be5f8c81
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t8010-j71b-devbase.dts
@@ -0,0 +1,12 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/* Stable ABI modular base. PCIe host/consumers are explicitly loaded modules.
+ * Wi-Fi root3/board wiring can be added with native OF overlays while host is
+ * quiesced/unloaded; no speculative board calibration is activated at boot.
+ */
+#include "t8010-j71b-storage-ro.dts"
+/ {
+	apple,devbase-version = "001";
+};
+&pcie0 {
+	linux,pci-domain = <0>;
+};
diff --git a/arch/arm64/boot/dts/apple/t8010-j71b-pcie-dev.dts b/arch/arm64/boot/dts/apple/t8010-j71b-pcie-dev.dts
new file mode 100644
index 000000000..9af89ee25
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t8010-j71b-pcie-dev.dts
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/* J71b PCIe discovery only: NO NVMe driver, commands, or NVMMU DMA setup.
+ * Touch/SIO wiring comes from the included t8010-j71b-sio-dev.dts.
+ * PCIe addresses, IRQs and port0 PERST12/CLKREQ16 checked against this J71b ADT.
+ */
+#include "t8010-j71b-sio-dev.dts"
+
+&ps_pcie { apple,manual-pm; };
+&ps_pcie_ref {
+	/delete-property/ #power-domain-cells;
+	/delete-property/ #reset-cells;
+	#clock-cells = <0>;
+	apple,clock-gate-only;
+	apple,manual-pm;
+};
+&ps_pcie_aux {
+	/delete-property/ #power-domain-cells;
+	/delete-property/ #reset-cells;
+	#clock-cells = <0>;
+	apple,clock-gate-only;
+	apple,manual-pm;
+};
+
+&{/soc} {
+	pcie0_dart0: iommu@601008000 {
+		compatible = "apple,t8010-dart", "apple,s5l8960x-dart";
+		reg = <0x6 0x01008000 0 0x4000>;
+		#iommu-cells = <1>;
+		interrupts = <AIC_IRQ 271 IRQ_TYPE_LEVEL_HIGH>;
+		power-domains = <&ps_pcie>;
+		apple,dma-range = <0 0x80000000 0 0x3c000000>;
+		status = "okay";
+	};
+
+	pcie0: pcie@610000000 {
+		compatible = "apple,t8010-pcie";
+		device_type = "pci";
+		apple,diagnostics-only;
+		apple,enumeration-only;
+		reg = <0x6 0x10000000 0 0x1000000>,
+		      <0x6 0x00000000 0 0x8000>,
+		      <0x6 0x00008000 0 0x4000>,
+		      <0x6 0x0a000000 0 0x40000>,
+		      <0x6 0x01000000 0 0x4000>,
+		      <0x6 0x02000000 0 0x4000>,
+		      <0x6 0x03000000 0 0x4000>,
+		      <0x6 0x04000000 0 0x4000>,
+		      <0x6 0x01004000 0 0x4000>;
+		reg-names = "config", "rc", "phy", "phy-ip", "port0", "port1",
+			    "port2", "port3", "nvmmu";
+		interrupts = <AIC_IRQ 270 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 273 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 276 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 279 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 272 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "port0", "port1", "port2", "port3", "nvmmu";
+		msi-controller;
+		msi-parent = <&pcie0>;
+		msi-ranges = <&aic AIC_IRQ 288 IRQ_TYPE_EDGE_RISING 32>;
+		apple,msi-doorbell = <0xbffff000>;
+		/* No nvme-hmb/nvmmu-iova: this DT does not allocate loader DMA buffers. */
+		iommu-map = <0x100 &pcie0_dart0 0 1>;
+		iommu-map-mask = <0xff00>;
+		#address-cells = <3>;
+		#size-cells = <2>;
+		#interrupt-cells = <1>;
+		interrupt-controller;
+		bus-range = <0 0x0f>;
+		ranges = <0x03000000 0 0xc0000000 0x7 0xc0000000 0 0x40000000>;
+		power-domains = <&ps_pcie>;
+		clocks = <&ps_pcie_aux>, <&ps_pcie_ref>;
+		clock-names = "aux", "ref";
+		status = "okay";
+
+		pci@0,0 {
+			device_type = "pci";
+			reg = <0 0 0 0 0>;
+			reset-gpios = <&pinctrl_ap 12 GPIO_ACTIVE_LOW>;
+			clkreq-gpios = <&pinctrl_ap 16 GPIO_ACTIVE_LOW>;
+			#address-cells = <3>;
+			#size-cells = <2>;
+			ranges;
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t8010-j71b-storage-ro.dts b/arch/arm64/boot/dts/apple/t8010-j71b-storage-ro.dts
