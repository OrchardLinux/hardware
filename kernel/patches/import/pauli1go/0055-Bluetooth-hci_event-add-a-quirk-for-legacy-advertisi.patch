From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Paul Praschl <praschlpaul@g-p.at>
Date: Mon, 27 Jul 2026 10:22:52 +0200
Subject: [PATCH 055/117] Bluetooth: hci_event: add a quirk for legacy
 advertising event types

Some controllers place vendor flags in the reserved upper nibble of the
one-byte Event_Type field in legacy LE Advertising Report events while
keeping a valid standard type in the lower nibble.

Add an opt-in HCI quirk that masks those reserved bits before the report
is processed. The fix is limited to legacy advertising reports from
drivers that explicitly set the quirk. All other controllers and event
paths remain unchanged.

Signed-off-by: Paul Praschl <praschlpaul@g-p.at>

Orchard-replay-of: 90272cb9847103e59c0569f46d4699990b2c2106
---
 include/net/bluetooth/hci.h | 11 +++++++++++
 net/bluetooth/hci_event.c   |  8 +++++++-
 2 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/include/net/bluetooth/hci.h b/include/net/bluetooth/hci.h
index 1641d879d..a5d3c759a 100644
--- a/include/net/bluetooth/hci.h
+++ b/include/net/bluetooth/hci.h
@@ -359,6 +359,16 @@ enum {
 	 */
 	HCI_QUIRK_FIXUP_LE_EXT_ADV_REPORT_PHY,
 
+	/*
+	 * When this quirk is set, reserved upper bits in the Event_Type field
+	 * of LE Advertising Report events are discarded. This is required for
+	 * some Apple/Broadcom controllers which use those bits for vendor flags.
+	 *
+	 * This quirk can be set before hci_register_dev is called or during the
+	 * hdev->setup vendor callback.
+	 */
+	HCI_QUIRK_FIXUP_LE_ADV_REPORT_EVT_TYPE,
+
 	/* When this quirk is set, the HCI_OP_READ_VOICE_SETTING command is
 	 * skipped. This is required for a subset of the CSR controller clones
 	 * which erroneously claim to support it.
@@ -2937,6 +2947,7 @@ struct hci_ev_le_conn_complete {
 #define LE_ADV_NONCONN_IND	0x03
 #define LE_ADV_SCAN_RSP		0x04
 #define LE_ADV_INVALID		0x05
+#define LE_ADV_EVT_TYPE_MASK	0x0f
 
 /* Legacy event types in extended adv report */
 #define LE_LEGACY_ADV_IND		0x0013
diff --git a/net/bluetooth/hci_event.c b/net/bluetooth/hci_event.c
index 2f5e21ff9..ad374f76e 100644
--- a/net/bluetooth/hci_event.c
+++ b/net/bluetooth/hci_event.c
@@ -6453,6 +6453,7 @@ static void hci_le_adv_report_evt(struct hci_dev *hdev, void *data,
 
 	while (ev->num--) {
 		struct hci_ev_le_advertising_info *info;
+		u8 evt_type;
 		s8 rssi;
 
 		info = hci_le_ev_skb_pull(hdev, skb,
@@ -6467,9 +6468,14 @@ static void hci_le_adv_report_evt(struct hci_dev *hdev, void *data,
 
 		hci_store_wake_reason(hdev, &info->bdaddr, info->bdaddr_type);
 
+		evt_type = info->type;
+		if (hci_test_quirk(hdev,
+				   HCI_QUIRK_FIXUP_LE_ADV_REPORT_EVT_TYPE))
+			evt_type &= LE_ADV_EVT_TYPE_MASK;
+
 		if (info->length <= max_adv_len(hdev)) {
 			rssi = info->data[info->length];
-			process_adv_report(hdev, info->type, &info->bdaddr,
+			process_adv_report(hdev, evt_type, &info->bdaddr,
 					   info->bdaddr_type, NULL, 0,
 					   HCI_ADV_PHY_1M, 0, rssi,
 					   info->data, info->length, false,
