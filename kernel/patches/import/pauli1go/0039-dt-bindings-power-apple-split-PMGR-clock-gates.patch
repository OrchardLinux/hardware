From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Paul Praschl <praschlpaul@g-p.at>
Date: Sun, 26 Jul 2026 17:17:56 +0200
Subject: [PATCH 039/117] dt-bindings: power: apple: split PMGR clock gates

Some T8010 PMGR state registers provide only a clock gate while the PCIe
core retains a separate generic power domain. Describe clock-only
providers, explicit manual-PM ownership and the mutually exclusive clock
versus power-domain interfaces.

This gives each state register a single owner and prevents a consumer
clock from also acquiring reset or generic power-domain control for the
same hardware gate.

Signed-off-by: Paul Praschl <praschlpaul@g-p.at>

Orchard-replay-of: 19c1b05dc70b106ed81f3a1954e15c721567fa50
---
 .../bindings/arm/apple/apple,pmgr.yaml        |  4 +-
 .../bindings/power/apple,pmgr-pwrstate.yaml   | 65 ++++++++++++++++---
 2 files changed, 57 insertions(+), 12 deletions(-)

diff --git a/Documentation/devicetree/bindings/arm/apple/apple,pmgr.yaml b/Documentation/devicetree/bindings/arm/apple/apple,pmgr.yaml
index f098225ee..8e1d168c2 100644
--- a/Documentation/devicetree/bindings/arm/apple/apple,pmgr.yaml
+++ b/Documentation/devicetree/bindings/arm/apple/apple,pmgr.yaml
@@ -58,9 +58,9 @@ properties:
     $ref: /schemas/clock/apple,t8010-touch-clock.yaml#
 
 patternProperties:
-  "power-controller@[0-9a-f]+$":
+  "^(power-controller|clock-controller)@(?!78000$)[0-9a-f]+$":
     description:
-      The individual power management domains within this controller
+      The individual power management domains and clock gates
     type: object
     $ref: /schemas/power/apple,pmgr-pwrstate.yaml#
 
diff --git a/Documentation/devicetree/bindings/power/apple,pmgr-pwrstate.yaml b/Documentation/devicetree/bindings/power/apple,pmgr-pwrstate.yaml
index e269f4335..41553d381 100644
--- a/Documentation/devicetree/bindings/power/apple,pmgr-pwrstate.yaml
+++ b/Documentation/devicetree/bindings/power/apple,pmgr-pwrstate.yaml
@@ -9,20 +9,19 @@ title: Apple SoC PMGR Power States
 maintainers:
   - Hector Martin <marcan@marcan.st>
 
-allOf:
-  - $ref: power-domain.yaml#
-
 description: |
   Apple SoCs include PMGR blocks responsible for power management,
   which can control various clocks, resets, power states, and
   performance features. This binding describes the device power
   state registers, which control power states and resets.
 
-  Each instance of a power controller within the PMGR syscon node
-  represents a generic power domain provider, as documented in
-  Documentation/devicetree/bindings/power/power-domain.yaml.
-  The provider controls a single SoC block. The power hierarchy is
-  represented via power-domains relationships between these nodes.
+  Most instances within the PMGR syscon node represent a generic power
+  domain provider, as documented in
+  Documentation/devicetree/bindings/power/power-domain.yaml. A state
+  register may instead be exposed exclusively as a clock gate when the
+  hardware consumer has no power-domain or reset interface. Each provider
+  controls a single SoC block. The power hierarchy is represented via
+  power-domains relationships between generic power-domain nodes.
 
   See Documentation/devicetree/bindings/arm/apple/apple,pmgr.yaml
   for the top-level PMGR node documentation.
@@ -56,6 +55,15 @@ properties:
   "#power-domain-cells":
     const: 0
 
+  "#clock-cells":
+    const: 0
+    description:
+      Exposes this PMGR state register as a clock gate. Enabling the clock
+      preserves an already active firmware state or requests the active state;
+      disabling it retains power while requesting the clock-gated state. A
+      state register exposed as a generic power domain cannot also be exposed
+      as a clock provider.
+
   "#reset-cells":
     const: 0
 
@@ -76,6 +84,19 @@ properties:
       Forces this power domain to always be powered up.
     type: boolean
 
+  apple,clock-gate-only:
+    description:
+      Registers this PMGR state exclusively as a clock gate. This is used
+      when the hardware provider exposes no generic power-domain or reset
+      interface for the state register.
+    type: boolean
+
+  apple,manual-pm:
+    description:
+      Keeps firmware-enabled hardware under explicit clock and power control
+      instead of enabling PMGR auto-PM while the provider is registered.
+    type: boolean
+
   apple,min-state:
     description:
       Specifies the minimum power state for auto-PM.
@@ -87,8 +108,32 @@ properties:
 required:
   - compatible
   - reg
-  - "#power-domain-cells"
-  - "#reset-cells"
   - label
 
+allOf:
+  - if:
+      required:
+        - apple,clock-gate-only
+    then:
+      required:
+        - "#clock-cells"
+      not:
+        anyOf:
+          - required:
+              - "#power-domain-cells"
+          - required:
+              - "#reset-cells"
+          - required:
+              - power-domains
+          - required:
+              - apple,always-on
+          - required:
+              - apple,min-state
+    else:
+      allOf:
+        - $ref: power-domain.yaml#
+      required:
+        - "#power-domain-cells"
+        - "#reset-cells"
+
 additionalProperties: false
