 .../bindings/mux/apple,sn2400-hdq-mux.yaml    | 31 +++++++++
 .../power/supply/apple,sn2400-charger.yaml    | 48 +++++++++++++
 MAINTAINERS                                   | 11 +++
 4 files changed, 157 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/mfd/apple,sn2400.yaml
 create mode 100644 Documentation/devicetree/bindings/mux/apple,sn2400-hdq-mux.yaml
 create mode 100644 Documentation/devicetree/bindings/power/supply/apple,sn2400-charger.yaml

diff --git a/Documentation/devicetree/bindings/mfd/apple,sn2400.yaml b/Documentation/devicetree/bindings/mfd/apple,sn2400.yaml
new file mode 100644
index 000000000..0719ceaf9
--- /dev/null
+++ b/Documentation/devicetree/bindings/mfd/apple,sn2400.yaml
@@ -0,0 +1,67 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mfd/apple,sn2400.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple SN2400 battery charger
+
+maintainers:
+  - Paul Praschl <praschlpaul@g-p.at>
+
+description:
+  The SN2400, also known as Tigris, is an I2C battery charger used in Apple
+  mobile devices. It also arbitrates access to the battery gauge HDQ line.
+
+properties:
+  compatible:
+    const: apple,sn2400
+
+  reg:
+    maxItems: 1
+
+  hdq-mux:
+    type: object
+    $ref: /schemas/mux/apple,sn2400-hdq-mux.yaml#
+    unevaluatedProperties: false
+
+  charger:
+    type: object
+    $ref: /schemas/power/supply/apple,sn2400-charger.yaml#
+    unevaluatedProperties: false
+
+required:
+  - compatible
+  - reg
+  - hdq-mux
+
+additionalProperties: false
+
+examples:
+  - |
+    battery_info: battery {
+        compatible = "simple-battery";
+    };
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        charger@75 {
+            compatible = "apple,sn2400";
+            reg = <0x75>;
+
+            hdq_mux: hdq-mux {
+                compatible = "apple,sn2400-hdq-mux";
+                #mux-state-cells = <1>;
+            };
+
+            charger {
+                compatible = "apple,sn2400-charger";
+                monitored-battery = <&battery_info>;
+                input-current-limit-microamp = <2000000>;
+                mux-states = <&hdq_mux 0>;
+                mux-state-names = "hdq";
+            };
+        };
+    };
diff --git a/Documentation/devicetree/bindings/mux/apple,sn2400-hdq-mux.yaml b/Documentation/devicetree/bindings/mux/apple,sn2400-hdq-mux.yaml
new file mode 100644
index 000000000..41087d399
--- /dev/null
+++ b/Documentation/devicetree/bindings/mux/apple,sn2400-hdq-mux.yaml
@@ -0,0 +1,31 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mux/apple,sn2400-hdq-mux.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple SN2400 HDQ multiplexer
+
+maintainers:
+  - Paul Praschl <praschlpaul@g-p.at>
+
+description: |
+  The SN2400 arbitrates access to the battery gauge HDQ line between its
+  internal charging logic and the application processor. State 0 routes HDQ
+  to the charger and state 1 routes it to the application processor.
+
+allOf:
+  - $ref: mux-controller.yaml#
+
+properties:
+  compatible:
+    const: apple,sn2400-hdq-mux
+
+  '#mux-state-cells':
+    const: 1
+
+required:
+  - compatible
+  - '#mux-state-cells'
+
+additionalProperties: false
diff --git a/Documentation/devicetree/bindings/power/supply/apple,sn2400-charger.yaml b/Documentation/devicetree/bindings/power/supply/apple,sn2400-charger.yaml
new file mode 100644
index 000000000..6ec7a7147
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/apple,sn2400-charger.yaml
@@ -0,0 +1,48 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/apple,sn2400-charger.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple SN2400 USB charger
+
+maintainers:
+  - Paul Praschl <praschlpaul@g-p.at>
+
+description:
+  The SN2400, also known as Tigris, is a single-cell battery charger used in
+  Apple mobile devices. The charger measures VBUS and input current and uses
+  those measurements to select a safe USB input-current limit.
+
+allOf:
+  - $ref: power-supply.yaml#
+  - $ref: /schemas/mux/mux-consumer.yaml#
+
+properties:
+  compatible:
+    const: apple,sn2400-charger
+
+  monitored-battery: true
+
+  input-current-limit-microamp:
+    minimum: 300000
+    maximum: 2000000
+    multipleOf: 10000
+    description:
+      Maximum USB input current that the foldback policy may request.
+
+  mux-states:
+    maxItems: 1
+
+  mux-state-names:
+    items:
+      - const: hdq
+
+required:
+  - compatible
+  - monitored-battery
+  - input-current-limit-microamp
+  - mux-states
+  - mux-state-names
+
+unevaluatedProperties: false
