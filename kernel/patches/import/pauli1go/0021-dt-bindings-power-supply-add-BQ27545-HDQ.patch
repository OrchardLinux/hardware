+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/ti,bq27545-hdq.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Texas Instruments BQ27545 fuel gauge on an HDQ bus
+
+maintainers:
+  - Paul Praschl <praschlpaul@g-p.at>
+
+description: |
+  The BQ27545 is a single-cell fuel gauge which can communicate using the
+  Texas Instruments single-wire HDQ protocol. An HDQ device has no 1-Wire
+  ROM address, so it is represented as the single child of an HDQ bus.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: ti,bq27545-hdq
+
+  power-supplies:
+    maxItems: 1
+
+  monitored-battery: true
+
+required:
+  - compatible
+
+additionalProperties: false
+
+examples:
+  - |
+    battery_info: battery {
+        compatible = "simple-battery";
+    };
+
+    serial {
+        onewire {
+            compatible = "ti,hdq-uart";
+
+            fuel-gauge {
+                compatible = "ti,bq27545-hdq";
+                monitored-battery = <&battery_info>;
+            };
+        };
+    };
