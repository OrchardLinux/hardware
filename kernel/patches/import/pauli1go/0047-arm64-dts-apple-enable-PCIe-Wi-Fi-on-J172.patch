From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Paul Praschl <praschlpaul@g-p.at>
Date: Sun, 26 Jul 2026 17:26:46 +0200
Subject: [PATCH 047/117] arm64: dts: apple: enable PCIe Wi-Fi on J172

Describe the retained availability DART, split PCIe auxiliary and
reference PMGR clocks from the core power domain, and wire the J172
D2365 regulator, WLAN UART supplier, H9P port and BCM4355 endpoint.

Select the board-specific apple,j172-pcie compatible for the temporary
bridge replay, constrain the endpoint-facing root port to its validated
Gen1 contract, and reference loader-populated NVMEM cells through the
endpoint once they are present.

Signed-off-by: Paul Praschl <praschlpaul@g-p.at>

Orchard-replay-of: b9b7e97e3449496601f5ec09a9d269731a451629
---
 arch/arm64/boot/dts/apple/t8010-ipad7.dtsi | 79 ++++++++++++++++++++++
 arch/arm64/boot/dts/apple/t8010-pmgr.dtsi  | 15 ++--
 arch/arm64/boot/dts/apple/t8010.dtsi       | 19 ++++--
 3 files changed, 102 insertions(+), 11 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi b/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi
index 4f2f9dddb..258c43cf4 100644
--- a/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi
@@ -25,6 +25,76 @@
 		clock-frequency = <55384615>;
 		clock-output-names = "spi3-nclk";
 	};
+
+	wlan_vdd: regulator-wlan-vdd {
+		compatible = "regulator-fixed";
+		regulator-name = "wlan-vdd";
+		gpio = <&pmu_gpio 14 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		off-on-delay-us = <100000>;
+	};
+};
+
+&d2365_pmic {
+	pmu_gpio: gpio {
+		compatible = "apple,d2365-pmic-gpio";
+		gpio-controller;
+		#gpio-cells = <2>;
+		gpio-reserved-ranges = <0 14>, <15 9>;
+	};
+};
+
+&{/soc} {
+	wlan_uart2: wlan-platform-control@20a0c8000 {
+		compatible = "apple,t8010-wlan-uart-provider";
+		reg = <0x2 0x0a0c8000 0x0 0x4000>;
+		pinctrl-0 = <&wlan_uart2_pins>;
+		pinctrl-names = "default";
+		power-domains = <&ps_uart2>;
+		status = "okay";
+	};
+};
+
+&pcie0 {
+	compatible = "apple,j172-pcie", "apple,t8010-pcie";
+	iommu-map = <0x100 &pcie0_dart0 0 1>,
+		    <0x200 &pcie0_dart3 0 1>;
+	apple,preinit-phy-port-mask = <0x4>;
+	pinctrl-0 = <&wifi_clkreq>;
+	pinctrl-names = "default";
+
+	pci@3,0 {
+		device_type = "pci";
+		reg = <0x1800 0x0 0x0 0x0 0x0>;
+		bus-range = <2 2>;
+		max-link-speed = <1>;
+		apple,manual-availability-iommu = <&pcie0_dart3 0>;
+		apple,link-retry-after-power-cycle;
+		apple,hardware-trained-phy-lane;
+		apple,endpoint-power-after-link-setup;
+		apple,inherited-perst-before-link-setup;
+		reset-gpios = <&pinctrl_ap 15 GPIO_ACTIVE_LOW>;
+
+		#address-cells = <3>;
+		#size-cells = <2>;
+		ranges;
+
+		wifi@0,0 {
+			compatible = "pci14e4,43dc";
+			reg = <0x20000 0x0 0x0 0x0 0x0>;
+			interrupts-extended = <&pinctrl_ap 147 IRQ_TYPE_EDGE_FALLING>;
+			interrupt-names = "host-wake";
+			apple,wlan-uart = <&wlan_uart2>;
+			device-wake-gpios = <&pinctrl_ap 23 GPIO_ACTIVE_HIGH>;
+			vdd-supply = <&wlan_vdd>;
+			apple,antenna-sku = "XX";
+			brcm,board-type = "apple,rudderb";
+		};
+	};
+};
+
+&pcie0_dart3 {
+	status = "okay";
 };
 
 &pinctrl_ap {
@@ -37,6 +107,15 @@
 			 <APPLE_PINMUX(39, 0)>;
 	};
 
+	wifi_clkreq: wifi-clkreq-pins {
+		pinmux = <APPLE_PINMUX(19, 1)>;
+	};
+
+	wlan_uart2_pins: wlan-uart2-pins {
+		pinmux = <APPLE_PINMUX(148, 1)>,
+			 <APPLE_PINMUX(150, 1)>;
+	};
+
 	touch_display_sync_active: touch-display-sync-active-pins {
 		pinmux = <APPLE_PINMUX(176, 1)>,
 			 <APPLE_PINMUX(177, 1)>;
diff --git a/arch/arm64/boot/dts/apple/t8010-pmgr.dtsi b/arch/arm64/boot/dts/apple/t8010-pmgr.dtsi
index 01d6eedcd..3db5b8e9b 100644
--- a/arch/arm64/boot/dts/apple/t8010-pmgr.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010-pmgr.dtsi
@@ -102,12 +102,13 @@
 		apple,always-on; /* Core device */
 	};
 
-	ps_pcie_ref: power-controller@80148 {
+	ps_pcie_ref: clock-controller@80148 {
 		compatible = "apple,t8010-pmgr-pwrstate", "apple,pmgr-pwrstate";
 		reg = <0x80148 4>;
-		#power-domain-cells = <0>;
-		#reset-cells = <0>;
+		#clock-cells = <0>;
 		label = "pcie_ref";
+		apple,clock-gate-only;
+		apple,manual-pm;
 	};
 
 	ps_socuvd: power-controller@80150 {
@@ -603,14 +604,16 @@
 		#power-domain-cells = <0>;
 		#reset-cells = <0>;
 		label = "pcie";
+		apple,manual-pm;
 	};
 
-	ps_pcie_aux: power-controller@80320 {
+	ps_pcie_aux: clock-controller@80320 {
 		compatible = "apple,t8010-pmgr-pwrstate", "apple,pmgr-pwrstate";
 		reg = <0x80320 4>;
-		#power-domain-cells = <0>;
-		#reset-cells = <0>;
+		#clock-cells = <0>;
 		label = "pcie_aux";
+		apple,clock-gate-only;
+		apple,manual-pm;
 	};
 
 	ps_vdec0: power-controller@80300 {
diff --git a/arch/arm64/boot/dts/apple/t8010.dtsi b/arch/arm64/boot/dts/apple/t8010.dtsi
index ed7cf43a4..0d025f3a1 100644
--- a/arch/arm64/boot/dts/apple/t8010.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010.dtsi
@@ -330,6 +330,16 @@
 			status = "disabled";
 		};
 
+		pcie0_dart3: iommu@604008000 {
+			compatible = "apple,t8010-dart", "apple,s5l8960x-dart";
+			reg = <0x6 0x04008000 0x0 0x4000>;
+			#iommu-cells = <1>;
+			interrupts = <AIC_IRQ 280 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_pcie>;
+			apple,dma-range = <0x0 0x80000000 0x0 0x3ffff000>;
+			status = "disabled";
+		};
+
 		pcie0: pcie@610000000 {
 			compatible = "apple,t8010-pcie";
 			device_type = "pci";
@@ -373,11 +383,10 @@
 			ranges = <0x03000000 0x0 0xc0000000
 				  0x7 0xc0000000 0x0 0x40000000>;
 
-			clocks = <&clkref>, <&clkref>, <&clkref>;
-			clock-names = "core", "aux", "ref";
-			power-domains = <&ps_pcie>, <&ps_pcie_aux>,
-					<&ps_pcie_ref>;
-			power-domain-names = "core", "aux", "ref";
+			power-domains = <&ps_pcie>;
+			clocks = <&ps_pcie_aux>,
+				 <&ps_pcie_ref>;
+			clock-names = "aux", "ref";
 			status = "disabled";
 
 			pci@0,0 {
