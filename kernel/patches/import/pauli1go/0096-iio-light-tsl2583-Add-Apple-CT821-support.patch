-			 / gainadj[chip->als_settings.als_gain].ch1;
+			  (chip->info->gainadj[chip->als_settings.als_gain].ch1 >> 1))
+			 / chip->info->gainadj[chip->als_settings.als_gain].ch1;
 
 		/* note: lux is 31 bit max at this point */
 		if (ch1lux > ch0lux) {
@@ -300,6 +496,81 @@ done:
