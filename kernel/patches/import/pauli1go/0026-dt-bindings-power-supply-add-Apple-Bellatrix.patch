From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Paul Praschl <praschlpaul@g-p.at>
Date: Wed, 22 Jul 2026 12:47:33 +0200
Subject: [PATCH 026/117] dt-bindings: power: supply: add Apple Bellatrix

Bellatrix supplies J172 USB input presence, but there was no DT
description for exposing that read-only source state.

Document the I2C power-supply node and its interrupt. The binding
deliberately covers status reporting only, not charging, ADC or
power-role control.

Signed-off-by: Paul Praschl <praschlpaul@g-p.at>

Orchard-replay-of: edad62e7596a3c317b042cef5cbb76e2b0907043
---
 .../power/supply/apple,bellatrix.yaml         | 49 +++++++++++++++++++
 1 file changed, 49 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/apple,bellatrix.yaml

diff --git a/Documentation/devicetree/bindings/power/supply/apple,bellatrix.yaml b/Documentation/devicetree/bindings/power/supply/apple,bellatrix.yaml
new file mode 100644
index 000000000..72e158f91
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/apple,bellatrix.yaml
@@ -0,0 +1,49 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/apple,bellatrix.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple Bellatrix USB power controller
+
+maintainers:
+  - Paul Praschl <praschlpaul@g-p.at>
+
+description: |
+  Bellatrix is an I2C power and accessory controller used in some Apple
+  T8010 devices. The Linux driver reports cached USB input presence without
+  changing charging, ADC, power-role, or interrupt configuration.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: apple,bellatrix
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        usb-power@13 {
+            compatible = "apple,bellatrix";
+            reg = <0x13>;
+            interrupts = <13 IRQ_TYPE_LEVEL_LOW>;
+        };
+    };
