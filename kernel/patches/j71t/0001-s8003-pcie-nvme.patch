+				       range, 2))
+		return 0;
+
+	if (!range[1] || !IS_ALIGNED(range[0], dart->pgsize) ||
+	    !IS_ALIGNED(range[1], dart->pgsize) ||
+	    check_add_overflow(range[0], range[1] - 1, &end) ||
+	    end > DMA_BIT_MASK(dart->ias)) {
