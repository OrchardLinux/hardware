+	.complete = apple_h9p_pcie_complete,
+	.suspend_noirq = apple_h9p_pcie_suspend_noirq,
+	.resume_noirq = apple_h9p_pcie_resume_noirq,
+};
+
+static const struct apple_h9p_hw apple_h9p_hw_t8010 = {
