index 0000000000000000000000000000000000000000..ed6bd936f52d2c7b0c64af1502dd51ad78c6106e
--- /dev/null
+++ b/Documentation/devicetree/bindings/pci/apple,t8010-pcie.yaml
@@ -0,0 +1,343 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pci/apple,t8010-pcie.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple S8003 and T8010 PCIe host controller
+
+maintainers:
+  - Paul Praschl <praschlpaul@g-p.at>
+
+description: |
+  Apple A9/S8003 (TSMC) and A10/T8010 devices use the H8P/H9P PCIe root
+  complex for internal storage and Wi-Fi. It exposes one ECAM window shared by up to four root
+  ports, controller-specific PHY and port register windows, and a local MSI
+  block.
+
+  The storage port also contains an NVMMU which translates the proprietary
+  Apple ANS FlatDMA format. Unlike a general-purpose IOMMU, this block uses a
+  loader-provided, physically contiguous host-memory buffer and a fixed IOVA
+  window. The PCIe driver owns that NVMMU state and exposes it only to the ANS
+  NVMe glue.
+
+  Each enabled root port is represented by a child node. This allows port
+  devices to carry their own reset, clock-request, firmware and other
+  device-specific properties.
+
+allOf:
+  - $ref: /schemas/pci/pci-host-bridge.yaml#
+  - $ref: /schemas/interrupt-controller/msi-controller.yaml#
+
+properties:
+  compatible:
+    enum:
+      - apple,s8003-pcie
+      - apple,t8010-pcie
+
+  reg:
+    maxItems: 9
+
+  reg-names:
+    items:
+      - const: config
+      - const: rc
+      - const: phy
+      - const: phy-ip
+      - const: port0
+      - const: port1
+      - const: port2
+      - const: port3
+      - const: nvmmu
+
+  interrupts:
+    description:
+      One state interrupt for each root port followed by the storage-port
+      NVMMU fault interrupt.
+    maxItems: 5
+
+  interrupt-names:
+    items:
+      - const: port0
+      - const: port1
+      - const: port2
+      - const: port3
+      - const: nvmmu
+
+  clocks:
+    maxItems: 3
+
+  clock-names:
+    items:
+      - const: core
+      - const: aux
+      - const: ref
+
+  power-domains:
+    minItems: 3
+    maxItems: 7
+
+  power-domain-names:
+    minItems: 3
+    items:
+      - const: core
+      - const: aux
+      - const: ref
+      - const: link0
+      - const: link1
+      - const: link2
+      - const: link3
+
+  apple,tunable-phy:
+    $ref: /schemas/types.yaml#/definitions/uint32-matrix
+    items:
+      items:
+        - description: register offset in the "phy" block
+        - description: mask
+        - description: value
+    description:
+      PHY tunables (Apple device tree apcie-phy-tunables), applied as
+      (reg & ~mask) | (value & mask) after the common init.
+
+  apple,tunable-common:
+    $ref: /schemas/types.yaml#/definitions/uint32-matrix
+    items:
+      items:
+        - description: register offset in the "rc" block
+        - description: mask
+        - description: value
+    description:
+      Root complex tunables (apcie-common-tunables), applied after the PHY
+      tunables.
+
+  apple,nvmmu-invalidate-fifo:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    enum: [0, 1, 2]
+    default: 0
+    description:
+      NVMMU invalidate workaround (nvme-mmu0 invalidate-fifo-workaround):
+      1 waits for the invalidate FIFO in the port 0 block to drain before
+      each invalidate, 2 spaces invalidates by a fixed delay.
+
+  apple,lane-cfg:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 15
+    default: 0
+    description:
+      Lane configuration of the root complex, the "lane-cfg" property of the
+      Apple device tree apcie node. Programmed into the common control
+      register together with the PHY init request.
+
+  devpwr-gpios:
+    description:
+      Optional device power GPIOs shared by the root ports.
+    maxItems: 4
+
+  msi-parent: true
+
+  msi-ranges:
+    maxItems: 1
+
+  apple,msi-doorbell:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      MSI doorbell address programmed into downstream endpoints.
+
+  apple,nvmmu-iova:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Base device-visible address of the storage-port NVMMU window.
+
+  apple,nvme-hmb:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      Phandle of the loader-populated reserved-memory node used as the Apple
+      ANS NVMe host-memory buffer.
+
+  interrupt-controller: true
+
+  '#interrupt-cells':
+    const: 1
+
+patternProperties:
+  '^pci@[0-3],0$':
+    type: object
+    properties:
+      reg:
+        maxItems: 1
+
+      reset-gpios:
+        maxItems: 1
+
+      clkreq-gpios:
+        maxItems: 1
+
+      pwren-gpios:
+        maxItems: 1
+        description:
+          Power enable of the endpoint (e.g. the Wi-Fi chip's REG_ON). A
+          port with this is brought up after probe, once the GPIO exists:
+          endpoint powered with PERST# asserted, then the link is trained
+          and the bus rescanned.
+
+      device-wake-gpios:
+        maxItems: 1
+        description:
+          Host-to-endpoint wake (ADT "function-device_wake"), kept
+          deasserted.
+
+      max-link-speed:
+        description:
+          Target link speed of the root port. Defaults to 3 (8 GT/s) for
+          port 0 on T8010, 2 (5 GT/s) for port 0 on S8003 and 1 otherwise.
+
+      apple,tunable-config:
+        $ref: /schemas/types.yaml#/definitions/uint32-matrix
+        description:
+          Port block tunables (apcie-config-tunables), <offset mask value>.
+
+      apple,tunable-rc:
+        $ref: /schemas/types.yaml#/definitions/uint32-matrix
+        description:
+          Root port config space tunables (pcie-rc-tunables),
+          <offset mask value>.
+
+      apple,nvme-mode:
+        type: boolean
+        description:
+          The port carries the ANS NVMe endpoint (ADT "nvme-mode"); S8003
+          then switches the root complex into NVMe mode before powering the
+          port.
+
+    required:
+      - reg
+      - reset-gpios
+
+    additionalProperties: true
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - interrupt-names
+  - clocks
+  - clock-names
+  - power-domains
+  - power-domain-names
+  - bus-range
+  - ranges
+  - msi-controller
+  - msi-parent
+  - msi-ranges
+  - apple,nvmmu-iova
+  - apple,nvme-hmb
+  - '#interrupt-cells'
+
+if:
+  properties:
+    compatible:
+      const: apple,t8010-pcie
+then:
+  patternProperties:
+    '^pci@[0-3],0$':
+      required:
+        - clkreq-gpios
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/apple-aic.h>
+
+    / {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        aliases {
+            nvme-hmb = &nvme_hmb;
+        };
+
+        aic: interrupt-controller {
+            interrupt-controller;
+            #interrupt-cells = <3>;
+        };
+
+        reserved-memory {
+            #address-cells = <2>;
+            #size-cells = <2>;
+            ranges;
+
+            nvme_hmb: nvme-hmb@0 {
+                reg = <0x0 0x0 0x0 0x0>; /* To be filled by loader */
+                no-map;
+            };
+        };
+
+        soc {
+            #address-cells = <2>;
+            #size-cells = <2>;
+
+            pcie0: pcie@610000000 {
+                compatible = "apple,t8010-pcie";
+                device_type = "pci";
+
+                reg = <0x6 0x10000000 0x0 0x1000000>,
+                      <0x6 0x00000000 0x0 0x8000>,
+                      <0x6 0x00008000 0x0 0x4000>,
+                      <0x6 0x0a000000 0x0 0x40000>,
+                      <0x6 0x01000000 0x0 0x4000>,
+                      <0x6 0x02000000 0x0 0x4000>,
+                      <0x6 0x03000000 0x0 0x4000>,
+                      <0x6 0x04000000 0x0 0x4000>,
+                      <0x6 0x01004000 0x0 0x4000>;
+                reg-names = "config", "rc", "phy", "phy-ip",
+                            "port0", "port1", "port2", "port3",
+                            "nvmmu";
+
+                interrupt-parent = <&aic>;
+                interrupts = <AIC_IRQ 270 IRQ_TYPE_LEVEL_HIGH>,
+                             <AIC_IRQ 273 IRQ_TYPE_LEVEL_HIGH>,
+                             <AIC_IRQ 276 IRQ_TYPE_LEVEL_HIGH>,
+                             <AIC_IRQ 279 IRQ_TYPE_LEVEL_HIGH>,
+                             <AIC_IRQ 272 IRQ_TYPE_EDGE_RISING>;
+                interrupt-names = "port0", "port1", "port2", "port3",
+                                  "nvmmu";
+
+                msi-controller;
+                msi-parent = <&pcie0>;
+                msi-ranges = <&aic AIC_IRQ 288 IRQ_TYPE_EDGE_RISING 32>;
+                apple,msi-doorbell = <0xbffff000>;
+                apple,nvmmu-iova = <0xbc000000>;
+                apple,nvme-hmb = <&nvme_hmb>;
+
+                #address-cells = <3>;
+                #size-cells = <2>;
+                #interrupt-cells = <1>;
+                interrupt-controller;
+                bus-range = <0x00 0x0f>;
+                ranges = <0x03000000 0x0 0xc0000000
+                          0x7 0xc0000000 0x0 0x40000000>;
+
+                clocks = <&clkref>, <&clkref>, <&clkref>;
+                clock-names = "core", "aux", "ref";
+                power-domains = <&ps_pcie>, <&ps_pcie_aux>,
+                                <&ps_pcie_ref>;
+                power-domain-names = "core", "aux", "ref";
+
+                pci@0,0 {
+                    device_type = "pci";
+                    reg = <0x0 0x0 0x0 0x0 0x0>;
+                    reset-gpios = <&pinctrl_ap 12 GPIO_ACTIVE_LOW>;
+                    clkreq-gpios = <&pinctrl_ap 16 GPIO_ACTIVE_LOW>;
+
+                    #address-cells = <3>;
+                    #size-cells = <2>;
+                    ranges;
+                };
+            };
+        };
+    };
+
+...
