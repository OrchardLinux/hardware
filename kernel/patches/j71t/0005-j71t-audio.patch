+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/cirrus,cs42l81.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Cirrus Logic CS42L81 audio codec (Apple)
+
+maintainers:
+  - linux-a9 <linux-a9@localhost>
+
+description:
+  Apple-specific Cirrus Logic codec with integrated speaker drivers, a
+  headphone driver and digital microphone inputs, used on the A9 iPad 5.
+  Controlled over SPI with a 5-byte paged register protocol. The codec DAI
+  has outputs SPKOUT and HPOUT and DMIC inputs DMIC1A and DMIC1B for
+  machine routing.
+
+allOf:
+  - $ref: dai-common.yaml#
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: cirrus,cs42l81
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: mclk
+
+  mute-gpios:
+    maxItems: 1
+    description: Speaker mute line, asserted while the speakers are muted.
+
+  hs-switch-gpios:
+    maxItems: 2
+    description:
+      The two control lines of the external headset switch (Apple
+      function-ext_sw1, function-ext_sw2). Their direction is not known;
+      the driver only reads them.
+
+  apple,max-speaker-gain-db-q8:
+    $ref: /schemas/types.yaml#/definitions/int32
+    description: Maximum speaker gain in 1/256 dB (ADT spkr-gain-db).
+
+  apple,speaker-mode:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    enum: [1, 2]
+    description: Number of speaker outputs in use.
+
+  '#sound-dai-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - '#sound-dai-cells'
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    spi {
+      #address-cells = <1>;
+      #size-cells = <0>;
+
+      audio-codec@0 {
+        compatible = "cirrus,cs42l81";
+        reg = <0>;
+        spi-max-frequency = <1000000>;
+        clocks = <&mca0>;
+        clock-names = "mclk";
+        mute-gpios = <&pinctrl_ap 64 GPIO_ACTIVE_LOW>;
+        hs-switch-gpios = <&pinctrl_ap 68 GPIO_ACTIVE_HIGH>,
+                          <&pinctrl_ap 66 GPIO_ACTIVE_HIGH>;
+        #sound-dai-cells = <0>;
+      };
+    };
