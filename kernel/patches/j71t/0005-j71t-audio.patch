+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/apple,s8000-mca.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple S8000 (A9) MCA I2S controller
+
+maintainers:
+  - linux-a9 <linux-a9@localhost>
+
+description:
+  The A9 "mca-version 4" serializer. Besides its register window it owns a
+  32-bit MCLK control word (exported as a clock) and programs a route in the
+  shared i2s-switch.
+
+allOf:
+  - $ref: dai-common.yaml#
+
+properties:
+  compatible:
+    const: apple,s8000-mca
+
+  reg:
+    items:
+      - description: MCA registers
+      - description: MCLK control word
+
+  reg-names:
+    items:
+      - const: mca
+      - const: mclk
+
+  interrupts:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+  dmas:
+    minItems: 1
+    items:
+      - description: SmartIO transmit (playback) endpoint
+      - description: SmartIO receive (capture) endpoint
+
+  dma-names:
+    minItems: 1
+    items:
+      - const: tx
+      - const: rx
+
+  '#sound-dai-cells':
+    const: 0
+
+  '#clock-cells':
+    const: 0
+
+  clock-output-names:
+    maxItems: 1
+
+  apple,mclk-control:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Value written to the MCLK word to enable MCLK output.
+
+  apple,mclk-frequency:
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  apple,i2s-switch:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The i2s-switch syscon.
+
+  apple,i2s-switch-route:
+    $ref: /schemas/types.yaml#/definitions/uint32-matrix
+    items:
+      items:
+        - description: register byte offset
+        - description: value
+    description: i2s-switch registers to set while the port runs.
+
+  apple,sio-dma-config:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    items:
+      - description: SmartIO transfer control for 16-bit samples
+      - description: SmartIO transfer control for 32-bit samples
+      - description: shim timeout
+      - description: shim FIFO size, bytes
+      - description: shim trigger level, bytes
+    description:
+      The SmartIO shim words of this MCA's DMA endpoints (Apple ADT
+      dma-channels; the transmit and receive entries carry the same words).
+
+  apple,pio-fifo-offset:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Experimental CPU-writable TX FIFO register (no DMA).
+
+  apple,pio-burst:
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - '#sound-dai-cells'
+
+unevaluatedProperties: false
