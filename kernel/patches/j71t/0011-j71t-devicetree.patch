diff --git a/arch/arm64/boot/dts/apple/s8003-j71t-audio.dtsi b/arch/arm64/boot/dts/apple/s8003-j71t-audio.dtsi
new file mode 100644
index 0000000000000000000000000000000000000000..1a101a4211ae9341eab446aa4e8a8437332e39b3
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/s8003-j71t-audio.dtsi
@@ -0,0 +1,161 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * J71t audio: CS42L81 on SPI1 (control) + MCA0 (data). Built-in speakers,
+ * 3.5 mm headphones and the two built-in DMICs (capture over MCA0 RX).
+ * Values: Apple's J71t ADT and iOS 16.7.10's AppleCS42L81Audio/AppleAE2MCA
+ * (omarchy-ipad5 docs/audio/playback-path.md, ds-capture-and-jack.md). Items
+ * marked "inferred" are unverified on hardware.
+ */
+
+/ {
+	/* Live iOS arm-io clock-frequencies[0x12e - 0x100] (spi1 clock-ids) */
+	spi1_nclk: clock-spi1 {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <61538461>;
+	};
+
+	sound: sound {
+		compatible = "simple-audio-card";
+		/* name kept from the speaker-only card: ALSA card id iPad5Speakers */
+		simple-audio-card,name = "iPad5 Speakers";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,bitclock-master = <&j71t_codec_dai>;
+		simple-audio-card,frame-master = <&j71t_codec_dai>;
+		simple-audio-card,widgets = "Speaker", "Speakers",
+					    "Headphone", "Headphones",
+					    "Microphone", "Internal Mic";
+		/* ADT dmic1a-intmic "cimi", dmic1b-intmic "cims" */
+		simple-audio-card,routing = "Speakers", "SPKOUT",
+					    "Headphones", "HPOUT",
+					    "DMIC1A", "Internal Mic",
+					    "DMIC1B", "Internal Mic";
+		/*
+		 * The codec's "Headphone Jack" switches HPOUT/SPKOUT; these add
+		 * user switches on top (ALSA "Speakers/Headphones Switch").
+		 */
+		simple-audio-card,pin-switches = "Speakers", "Headphones";
+
+		simple-audio-card,cpu {
+			sound-dai = <&mca0>;
+		};
+
+		j71t_codec_dai: simple-audio-card,codec {
+			sound-dai = <&cs42l81>;
+		};
+	};
+};
+
+/*
+ * SmartIO coprocessor domain: PMGR device "SIO" is index 12 in the ADT, next
+ * to SIO_BUSIF (10, 0x80150) and SIO_P (11, 0x80158) -> 0x80160 (inferred).
+ */
+&pmgr {
+	ps_sio: power-controller@80160 {
+		compatible = "apple,s8000-pmgr-pwrstate", "apple,pmgr-pwrstate";
+		reg = <0x80160 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "sio";
+		power-domains = <&ps_sio_p>;
+	};
+};
+
+&{/soc} {
+	/* ADT /arm-io/sio: iop,s8000, iop-version 1 (AppleA7IOPV1) */
+	sio: dma-controller@20ae00000 {
+		compatible = "apple,s8000-sio";
+		reg = <0x2 0x0ae00000 0x0 0x10000>,
+		      <0x2 0x0a000000 0x0 0x2000>;
+		reg-names = "a7iop", "shim";
+		interrupt-parent = <&aic>;
+		/* ADT order; the driver takes index 2 (187) as the RX mailbox */
+		interrupts = <AIC_IRQ 185 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 184 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 187 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 186 IRQ_TYPE_LEVEL_HIGH>;
+		power-domains = <&ps_sio>;
+		resets = <&ps_sio>;
+		firmware-name = "apple/s8000-smartio.bin";
+		dma-channels = <64>;
+		#dma-cells = <1>;
+	};
+
+	i2s_switch: syscon@20a003000 {
+		compatible = "apple,s8000-i2s-switch", "syscon";
+		reg = <0x2 0x0a003000 0x0 0x1000>;
+	};
+
+	mca0: mca@20a0a0000 {
+		compatible = "apple,s8000-mca";
+		reg = <0x2 0x0a0a0000 0x0 0x4000>,
+		      <0x2 0x0a002000 0x0 0x4>;
+		reg-names = "mca", "mclk";
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 201 IRQ_TYPE_LEVEL_HIGH>;
+		power-domains = <&ps_mca0>;
+		#sound-dai-cells = <0>;
+		#clock-cells = <0>;
+		clock-output-names = "mca0-mclk";
+		/* nclk (24 MHz fixed, inferred) / 2 = 12 MHz, output enabled */
+		apple,mclk-control = <0x58>;
+		apple,mclk-frequency = <12000000>;
+		apple,i2s-switch = <&i2s_switch>;
+		/*
+		 * Byte offset, value. Codec is clock master on pin0 (inferred):
+		 * pin0 data from aud0, aud0 clocks+data from pin0, pin0 drives
+		 * data only.
+		 */
+		apple,i2s-switch-route = <0x00 0x00000018>,
+					 <0x14 0x00080808>,
+					 <0x3c 0x00000010>;
+		/*
+		 * SmartIO MCA0 TX/RX, ADT dma-channels: 0x28 and 0x29, both
+		 * {0x21|0x22, 0, 0x300, 0x180}.
+		 */
+		dmas = <&sio 0x28>, <&sio 0x29>;
+		dma-names = "tx", "rx";
+		apple,sio-dma-config = <0x21 0x22 0 0x300 0x180>;
+	};
+
+	j71t_spi1: spi@20a084000 {
+		/* driver: spi-apple-s8000 (touch workstream) */
+		compatible = "apple,s8000-spi";
+		reg = <0x2 0x0a084000 0x0 0x4000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 189 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&spi1_nclk>;
+		power-domains = <&ps_spi1>;
+		/* ADT function-spi_cs0 = GPIO(0x10, 0x10001) */
+		cs-gpios = <&pinctrl_ap 16 GPIO_ACTIVE_LOW>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cs42l81: audio-codec@0 {
+			compatible = "cirrus,cs42l81";
+			reg = <0>;
+			/* ADT gives no speed; iOS framing is mode 0 (inferred) */
+			spi-max-frequency = <1000000>;
+			clocks = <&mca0>;
+			clock-names = "mclk";
+			/* function-spkr_mute = GPIO(0x40, 0x10001): active low (inferred) */
+			mute-gpios = <&pinctrl_ap 64 GPIO_ACTIVE_LOW>;
+			/* spkr-gain-db = -3.0 dB */
+			apple,max-speaker-gain-db-q8 = <(-768)>;
+			apple,speaker-mode = <2>;
+			/*
+			 * ADT function-ext_sw1 = GPIO(0x44, 0x101), ext_sw2 =
+			 * GPIO(0x42, 0x101): headset switch, direction unknown.
+			 * The driver only reads them (GPIOD_ASIS).
+			 */
+			hs-switch-gpios = <&pinctrl_ap 68 GPIO_ACTIVE_HIGH>,
+					  <&pinctrl_ap 66 GPIO_ACTIVE_HIGH>;
+			/*
+			 * No interrupts yet: ADT has <0x36 0x1> (AP GPIO 54),
+			 * but iOS detects the jack with a timer; the driver
+			 * polls (jack_poll_ms).
+			 */
+			#sound-dai-cells = <0>;
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/s8003-j71t-display.dtsi b/arch/arm64/boot/dts/apple/s8003-j71t-display.dtsi
new file mode 100644
index 0000000000000000000000000000000000000000..690ac1368f9664e73ae9d055b3d6eafc34410c7e
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/s8003-j71t-display.dtsi
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+
+/* Observer only: no clock, power-domain, reset or IOMMU consumers. */
+&{/soc} {
+	disp0: display-subsystem@206200000 {
+		compatible = "adbe0,s8000";
+		reg = <0x2 0x06200000 0 0x100000>,
+		      <0x2 0x06400000 0 0x8000>,
+		      <0x2 0x06440000 0 0x8000>,
+		      <0x2 0x06480000 0 0x8000>,
+		      <0x2 0x064c0000 0 0x8000>,
+		      <0x2 0x06500000 0 0x1c>;
+		interrupts = <AIC_IRQ 140 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 143 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 144 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 145 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 146 IRQ_TYPE_LEVEL_HIGH>;
+		memory-region = <&adbe_boot_vram>;
+	};
+};
+
+/*
+ * Live j71t ADT /vram: CPU 0x87c95c000, length 0x2400000 (36 MiB).
+ * Reserve it against allocation; this does not assert any DART mapping.
+ * D2 separately requires the operator to verify the current mapping span.
+ */
+/ {
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		adbe_boot_vram: framebuffer@87c95c000 {
+			reg = <0x8 0x7c95c000 0 0x2400000>;
+			no-map;
+		};
+	};
+};
+
+/* Also keep standalone a9/display builds safe, before the pcie merge. */
+&ps_disp0 {
+	apple,always-on;
+};
+
+&ps_dp {
+	apple,always-on;
+};
diff --git a/arch/arm64/boot/dts/apple/s8003-j71t-periph.dtsi b/arch/arm64/boot/dts/apple/s8003-j71t-periph.dtsi
new file mode 100644
index 0000000000000000000000000000000000000000..e3266d36431105070f4091d9b9724bdc90a10640
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/s8003-j71t-periph.dtsi
@@ -0,0 +1,180 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/* Round 1 J71t peripherals. Hardware values: Apple's J71t ADT. */
+
+#include <dt-bindings/input/input.h>
+
+/*
+ * Smart Cover hall sensors: PMIC GPIO lines 0 ("halleffect") and 10
+ * ("halleffect1") in the ADT's /buttons node. Which level means "cover
+ * closed" is not measured yet (docs/periph/ds-als-hall.md H1); the guess is a
+ * magnet pulling the line low. After measuring with evtest, change the
+ * define (GPIO_ACTIVE_HIGH if SW_LID reads 1 with the cover open) and rebuild
+ * the dtb, or flip the flag of a built dtb with scripts/sensors/cover-polarity.sh.
+ */
+#define J71T_COVER0_ACTIVE	GPIO_ACTIVE_LOW
+#define J71T_COVER1_ACTIVE	GPIO_ACTIVE_LOW
+
+/ {
+	aliases {
+		serial3 = &serial3;
+		serial5 = &serial5;
+		bluetooth0 = &bluetooth;
+	};
+
+	/*
+	 * Not named "Lid Switch": systemd-logind and Omarchy's Hyprland
+	 * bindings pick the lid up by that name and would suspend on a cover
+	 * close, which does not resume yet. The ipad-lid user daemon of the
+	 * tablet layer reads these instead.
+	 *
+	 * Polled: gpio-apple-d2365 has no irq_chip, so there is no wakeup
+	 * either (docs/periph/ds-als-hall.md 4.2). Each line is its own device so
+	 * that one the PMIC keeps for itself (the driver refuses those) cannot
+	 * take the other down.
+	 */
+	smart-cover {
+		compatible = "gpio-keys-polled";
+		poll-interval = <50>;
+		label = "iPad Smart Cover";
+
+		lid-switch {
+			label = "Smart Cover (PMIC GPIO 0)";
+			gpios = <&periph_pmu_gpio 0 J71T_COVER0_ACTIVE>;
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_LID>;
+			debounce-interval = <50>;
+		};
+	};
+
+	/*
+	 * The second hall, which this does not tell apart from the first one
+	 * (H4): a code of its own, so evtest shows each line separately.
+	 */
+	smart-cover-aux {
+		compatible = "gpio-keys-polled";
+		poll-interval = <50>;
+		label = "iPad Smart Cover 2";
+
+		cover-switch {
+			label = "Smart Cover (PMIC GPIO 10)";
+			gpios = <&periph_pmu_gpio 10 J71T_COVER1_ACTIVE>;
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_MACHINE_COVER>;
+			debounce-interval = <50>;
+		};
+	};
+};
+
+&{/soc} {
+	serial3: serial@20a0cc000 {
+		compatible = "apple,s8000-uart", "apple,s5l-uart";
+		reg = <0x2 0x0a0cc000 0 0x4000>;
+		reg-io-width = <4>;
+		interrupts = <AIC_IRQ 195 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&clkref>, <&clkref>;
+		clock-names = "uart", "clk_uart_baud0";
+		power-domains = <&ps_uart3>;
+		pinctrl-0 = <&bluetooth_uart3_pins>;
+		pinctrl-names = "default";
+		uart-has-rtscts;
+		status = "okay";
+
+		bluetooth: bluetooth {
+			compatible = "apple,j71t-bcm4355-bt";
+			/* 115200 ROM rate inferred from A10; runtime rate is in ADT. */
+			current-speed = <115200>;
+			max-speed = <3000000>;
+			shutdown-gpios = <&periph_pmu_gpio 13 GPIO_ACTIVE_HIGH>;
+			device-wakeup-gpios = <&pinctrl_ap 142 GPIO_ACTIVE_HIGH>;
+		};
+	};
+
+	serial5: serial@20a0d4000 {
+		compatible = "apple,s5l-uart";
+		reg = <0x2 0x0a0d4000 0 0x4000>;
+		reg-io-width = <4>;
+		interrupts = <AIC_IRQ 197 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&clkref>, <&clkref>;
+		clock-names = "uart", "clk_uart_baud0";
+		power-domains = <&ps_uart5>;
+		pinctrl-0 = <&battery_swi_pins>;
+		pinctrl-names = "default";
+		status = "okay";
+
+		onewire {
+			compatible = "ti,hdq-uart";
+
+			battery: fuel-gauge {
+				/* ADT bq27540; uses the experimental J172 map, not an ID claim. */
+				compatible = "apple,j71t-bq27540";
+			};
+		};
+	};
+};
+
+&pinctrl_ap {
+	bluetooth_uart3_pins: bluetooth-uart3-pins {
+		pinmux = <APPLE_PINMUX(88, 1)>, <APPLE_PINMUX(89, 1)>,
+			 <APPLE_PINMUX(90, 1)>, <APPLE_PINMUX(91, 1)>;
+	};
+
+	battery_swi_pins: battery-swi-pins {
+		pinmux = <APPLE_PINMUX(2, 1)>;
+	};
+};
+
+&{/soc/i2c@20a110000/pmic@3c} {
+	/* Internal register offsets are not CPU MMIO resources. */
+	#size-cells = <0>;
+
+	rtc@500 {
+		reg = <0x500>;
+	};
+
+	nvmem@5000 {
+		reg = <0x5000>;
+		size = <0x28>;
+		read-only;
+	};
+
+	periph_pmu_gpio: gpio {
+		compatible = "apple,d2365-pmic-gpio";
+		gpio-controller;
+		#gpio-cells = <2>;
+		/* Line 13 is Bluetooth enable, 0 and 10 the Smart Cover halls. */
+		gpio-reserved-ranges = <1 9>, <11 2>, <14 10>;
+	};
+
+	charger@180 {
+		/* Automatic policy uses source authorization and private CBAT. */
+		compatible = "apple,j71t-d2365-charger";
+		reg = <0x180>, <0xa00>;
+		reg-names = "status", "control";
+		power-supplies = <&periph_tristar>;
+	};
+};
+
+&i2c2 {
+	status = "okay";
+
+	light-sensor@39 {
+		compatible = "apple,ct819", "amstaos,tsl2581";
+		reg = <0x39>;
+		interrupts-extended = <&pinctrl_ap 71 IRQ_TYPE_LEVEL_LOW>;
+		firmware-name = "apple/j71t-LSCI.bin";
+	};
+};
+
+&i2c0 {
+	periph_tristar: power-controller@1a {
+		apple,usb-role-switch = <&usb_role>;
+		compatible = "apple,j71t-cbtl1610-power";
+		usb-controller = <&usbdev>;
+		apple,pmic = <&{/soc/i2c@20a110000/pmic@3c}>;
+		reg = <0x1a>;
+	};
+};
+
+&usbdev {
+	apple,host-current-budget;
+};
diff --git a/arch/arm64/boot/dts/apple/s8003-j71t-touch.dtsi b/arch/arm64/boot/dts/apple/s8003-j71t-touch.dtsi
new file mode 100644
index 0000000000000000000000000000000000000000..efdc12e5ec53347b23a8d8a4bfa35cdd55e72ae4
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/s8003-j71t-touch.dtsi
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/* J71t N1 touch wiring; portrait framebuffer, home button at the bottom. */
+/ {
+	/* Live iOS arm-io clock-frequencies[0x130 - 0x100]. */
+	spi3_nclk: clock-spi3 {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <61538461>;
+	};
+};
+
+&pmgr {
+	touch_clk: clock-controller@78000 {
+		compatible = "apple,s8000-touch-clock";
+		reg = <0x78000 4>;
+		#clock-cells = <0>;
+		clocks = <&clkref>;
+	};
+};
+
+&i2c0 {
+	pmic@3c {
+		touch_analog: regulator@31c {
+			compatible = "apple,d2365-touch-analog";
+			reg = <0x31c 1>;
+			regulator-name = "touch-analog";
+		};
+	};
+};
+
+&pinctrl_ap {
+	compatible = "apple,s8000-pinctrl", "apple,pinctrl";
+
+	touch_sync_on: touch-sync-on-pins {
+		pinmux = <APPLE_PINMUX(74, 2)>;
+	};
+
+	touch_sync_off: touch-sync-off-pins {
+		pinmux = <APPLE_PINMUX(74, 0)>;
+	};
+};
+
+/* Isolated board hunk: does not enable this N1 personality on J71s/J72t. */
+&{/soc} {
+	spi3: spi@20a08c000 {
+		compatible = "apple,s8000-spi";
+		reg = <0x2 0x0a08c000 0 0x4000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		interrupts = <AIC_IRQ 191 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&spi3_nclk>;
+		power-domains = <&ps_spi3>;
+		cs-gpios = <&pinctrl_ap 102 GPIO_ACTIVE_LOW>;
+		status = "okay";
+
+		touchscreen@0 {
+			compatible = "apple,j71t-n1";
+			reg = <0>;
+			/* Hardware-confirmed corner taps: X agrees, raw Y grows upward. */
+			touchscreen-inverted-y;
+			/* N1 selects 83 ns; controller rounds up to divider 6. */
+			spi-max-frequency = <12048192>;
+			/* This pinned SPI core applies GPIO CS setup twice. */
+			spi-cs-setup-delay-ns = <5000>;
+			spi-cs-hold-delay-ns = <10000>;
+			interrupt-parent = <&pinctrl_ap>;
+			interrupts = <65 IRQ_TYPE_EDGE_FALLING>;
+			attn-gpios = <&pinctrl_ap 65 GPIO_ACTIVE_LOW>;
+			reset-gpios = <&pinctrl_ap 75 GPIO_ACTIVE_LOW>;
+			ldo-gpios = <&pinctrl_ap 73 GPIO_ACTIVE_HIGH>;
+			vdd-supply = <&touch_analog>;
+			clocks = <&touch_clk>;
+			pinctrl-names = "sync-on", "sync-off";
+			pinctrl-0 = <&touch_sync_on>;
+			pinctrl-1 = <&touch_sync_off>;
+			firmware-name = "apple/j71t-n1.bin";
+			apple,calibration-firmware = "apple/j71t-n1-calibration.bin";
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/s8003-j71t-usbhost.dtsi b/arch/arm64/boot/dts/apple/s8003-j71t-usbhost.dtsi
new file mode 100644
index 0000000000000000000000000000000000000000..cb3664fce8706b8d2fc706d63a1d6b724fca7016
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/s8003-j71t-usbhost.dtsi
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * J71t Lightning port USB host mode: the EHCI + OHCI pair behind a role
+ * switch that shares the AUSB PHY with the device-only DWC2. Hardware
+ * values: Apple's J71t ADT (otgphyctrl, usb-complex, dock).
+ *
+ * Included right after /dts-v1/ (before the SoC dtsi, like the AOP
+ * observer): full paths only, and it includes the binding headers it uses.
+ */
+
+#include <dt-bindings/interrupt-controller/apple-aic.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/phy/phy.h>
+
+/ {
+	soc {
+		/* usb-complex */
+		bus@20c000000 {
+			usb_role: usb-role-switch@20e0d8000 {
+				compatible = "apple,s8000-usb-role-switch";
+				/* The DMA remap words belong to the usb-complex. */
+				reg = <0x2 0x0e0d8000 0x0 0x1000>,
+				      <0x2 0x0c000000 0x0 0x30>;
+				reg-names = "usb-ctl", "glue";
+				#address-cells = <2>;
+				#size-cells = <2>;
+				ranges;
+				/* The usb-complex dma-ranges apply to the host pair. */
+				dma-ranges;
+				nonposted-mmio;
+				phys = <&ausbphy0 PHY_TYPE_USB2>;
+				phy-names = "usb2-phy";
+				apple,usb-device = <&usbdev>;
+				/* dock function-acc_pwr / acc_sw_en: D2365 LDO5 */
+				apple,pmic = <&{/soc/i2c@20a110000/pmic@3c}>;
+				/* CBTL1610 VBUS sink bit */
+				apple,tristar = <&i2c0 0x1a>;
+
+				/* Created by the switch in host mode only. */
+				usb@20c200000 {
+					compatible = "apple,s8000-ehci", "generic-ehci";
+					reg = <0x2 0x0c200000 0x0 0x10000>;
+					interrupts = <AIC_IRQ 215 IRQ_TYPE_LEVEL_HIGH>;
+					power-domains = <&ps_usb2host0>;
+				};
+
+				usb@20c300000 {
+					compatible = "apple,s8000-ohci", "generic-ohci";
+					reg = <0x2 0x0c300000 0x0 0x10000>;
+					interrupts = <AIC_IRQ 216 IRQ_TYPE_LEVEL_HIGH>;
+					power-domains = <&ps_usb2host0_ohci>;
+				};
+			};
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/s8003-j71t.dts b/arch/arm64/boot/dts/apple/s8003-j71t.dts
index 0d906ae80b075622709c7a231aa28cc87b36e9e8..3c48bec20902ed38a6afc592219a1f2da84d6b1e 100644
--- a/arch/arm64/boot/dts/apple/s8003-j71t.dts
+++ b/arch/arm64/boot/dts/apple/s8003-j71t.dts
@@ -4,12 +4,154 @@
  * Copyright (c) 2022, Konrad Dybcio <konradybcio@kernel.org>
  */
 
+#define APPLE_J71T_BOOT_DISPLAY
+
 /dts-v1/;
 
+/memreserve/ 0x210e00000 0x9b000;
+/memreserve/ 0x858000000 0x400000;
+
 #include "s8003.dtsi"
 #include "s800x-ipad5.dtsi"
+#include "s8003-j71t-periph.dtsi"
 
+#include "s8003-j71t-audio.dtsi"
 / {
 	compatible = "apple,j71t", "apple,s8003", "apple,arm-platform";
 	model = "Apple iPad 5 (Wi-Fi) (TSMC)";
+
+	aliases {
+		nvme-hmb = &nvme_hmb; /* Used by loader */
+		serial2 = &wlan_uart;
+		wifi0 = &wifi0; /* m1n1: local-mac-address, brcm,cal-blob */
+	};
+
+	reserved-memory {
+		nvme_hmb: nvme-hmb@0 {
+			reg = <0 0 0 0>; /* To be filled by loader */
+			no-map;
+		};
+
+		/*
+		 * sepOS root shared-memory page, handed over by pongoOS with
+		 * op 6 on endpoint 0xfe (2026-10-26 boot: data=87adb0). sepOS
+		 * may use it for the rest of its life. The address belongs to
+		 * that pongoOS session: after a new sepOS boot, take it from
+		 * the "root shmem ... data=" line of the pongoOS log.
+		 */
+		sep-shmem@87adb0000 {
+			reg = <0x8 0x7adb0000 0x0 0x4000>;
+			no-map;
+		};
+	};
+};
+
+/*
+ * Keep the SEP PMGR word pongoOS hands over (0x4f0000ff) bit for bit. The
+ * cold-boot AUTO_ENABLE update (0x5f0000ff) was in place when sepOS stopped
+ * consuming the AP->SEP mailbox (2026-10-26 15:42).
+ */
+&ps_sep {
+	apple,no-auto-pm;
+};
+
+&pcie0_dart0 {
+	status = "okay";
+};
+
+&pcie0 {
+	apple,lane-cfg = <1>;
+	apple,nvme-hmb = <&nvme_hmb>;
+	/* live ADT nvme-mmu0 invalidate-fifo-workaround (added by iBoot) */
+	apple,nvmmu-invalidate-fifo = <1>;
+	status = "okay";
 };
+
+/*
+ * Wi-Fi: BCM4355 C0 (USI module "FearA"), 14e4:43dc, on port 1. From the
+ * j71t live ADT:
+ * - REG_ON: uart2/wlan function-reg_on = D2365 PMU GPIO 14
+ * - DEVICE_WAKE: pci-bridge1 function-device_wake = AP GPIO 67
+ * - PERST#: pci-bridge1 function-perst = AP GPIO 161 (s8003.dtsi)
+ * - board type: uart2/wlan module-instance "feara"
+ * The PCIe driver powers the chip and trains the link after probe (the
+ * port has pwren-gpios), then rescans; NVMe on port 0 doesn't wait for it.
+ */
+&{/soc/i2c@20a110000/pmic@3c} {
+	wlan_pmu_gpio: gpio {
+		compatible = "apple,d2365-pmic-gpio";
+		gpio-controller;
+		#gpio-cells = <2>;
+		/* 13: Bluetooth power enable, 14: WLAN REG_ON */
+		gpio-reserved-ranges = <0 13>, <15 9>;
+	};
+};
+
+&{/soc} {
+	/*
+	 * uart2 hosts the ADT's "wlan" (wlan-pcie-uart,bcm4355) node. Keep it
+	 * powered and in its UART pin function while Wi-Fi runs, as Pauli1Go's
+	 * A10 wlan-uart provider does (ADT function-tx = GPIO 192,
+	 * function-rts = GPIO 194). The serial driver does exactly that.
+	 */
+	wlan_uart: serial@20a0c8000 {
+		compatible = "apple,s5l-uart";
+		reg = <0x2 0x0a0c8000 0x0 0x4000>;
+		reg-io-width = <4>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 194 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&clkref>, <&clkref>;
+		clock-names = "uart", "clk_uart_baud0";
+		power-domains = <&ps_uart2>;
+		pinctrl-0 = <&wlan_uart2_pins>;
+		pinctrl-names = "default";
+	};
+};
+
+&pinctrl_ap {
+	wlan_uart2_pins: wlan-uart2-pins {
+		pinmux = <APPLE_PINMUX(192, 1)>, <APPLE_PINMUX(194, 1)>;
+	};
+
+	/*
+	 * Port 1 CLKREQ# (pci-bridge1 function-clkreq, AP GPIO 165) in its
+	 * peripheral function: iBoot doesn't set it up for Wi-Fi on a tethered
+	 * boot. Function 1 by analogy with A10 J172 (pin 19) and the UART pins.
+	 */
+	wifi_clkreq_pins: wifi-clkreq-pins {
+		pinmux = <APPLE_PINMUX(165, 1)>;
+	};
+};
+
+&pcie0 {
+	pinctrl-0 = <&wifi_clkreq_pins>;
+	pinctrl-names = "default";
+};
+
+&pcie0_dart1 {
+	status = "okay";
+};
+
+&pcie0_port1 {
+	/* Linux numbers it after port 0's bus 1 */
+	bus-range = <2 2>;
+	pwren-gpios = <&wlan_pmu_gpio 14 GPIO_ACTIVE_HIGH>;
+	device-wake-gpios = <&pinctrl_ap 67 GPIO_ACTIVE_HIGH>;
+
+	wifi0: wifi@0,0 {
+		compatible = "pci14e4,43dc";
+		/* port 1's secondary bus is 2 (iommu-map 0x200 -> pcie0_dart1) */
+		reg = <0x20000 0x0 0x0 0x0 0x0>;
+		brcm,board-type = "apple,feara";
+		/* the staged firmware's antenna SKU (A10 J172 uses the same) */
+		apple,antenna-sku = "XX";
+		/* filled by m1n1 from the ADT (/chosen mac-address-wifi0) */
+		local-mac-address = [00 00 00 00 00 00];
+		/* cfg80211's country goes to the firmware as <ISO code>/0 */
+		brcm,ccode-map-trivial;
+	};
+};
+
+#include "s8003-j71t-touch.dtsi"
+
+#include "s8003-j71t-usbhost.dtsi"
