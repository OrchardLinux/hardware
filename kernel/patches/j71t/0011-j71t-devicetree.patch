+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 245 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_pcie_link0>;
+			apple,dma-range = <0x0 0x80000000 0x0 0x3c000000>;
+			apple,error-reflector = /bits/ 64 <0x20fffc000>;
+			apple,fetch-config = <0x000e0303>;
+			apple,diag-config = <0x00000100>;
+			status = "disabled";
+		};
+
