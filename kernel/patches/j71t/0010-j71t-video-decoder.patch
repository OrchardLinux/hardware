index 0000000000000000000000000000000000000000..04f3e5ce7f8968afae719cf9d386492d7ba0e5c1
--- /dev/null
+++ b/drivers/media/platform/apple/vxd/apple-vxd-h264.c
@@ -0,0 +1,582 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Apple VXD - H.264 backend (V4L2 stateless, frame based)
+ *
+ * Userspace parses the parameter sets and the DPB (V4L2 stateless
+ * contract); the OUTPUT buffer carries a whole Annex-B access unit.  Per
+ * picture this file
+ *
+ *   1. validates SPS/PPS against what the AVC recipe covers,
+ *   2. finds and parses the slices itself (frame-based mode has no
+ *      SLICE_PARAMS, apple-vxd-h264-parse.c),
+ *   3. builds RefPicList0/1 (v4l2-h264 helper + the slice's
+ *      modifications) and resolves the DPB to CAPTURE device addresses
+ *      (and, for B slices, stored-MB buffers) by timestamp,
+ *   4. builds the command stream (apple-vxd-h264-cmd.c) into a pooled
+ *      command buffer and submits one 0x81 message per slice.
+ *
+ * The job completes from the last packet's 0xc0 (apple_vxd_job_done()).
+ *
+ * The context owns the buffers DecodeCreateH264VLD allocates for the
+ * AVC path (ds-vxd-cmdstream.md section 16.5): the packed CAVLC table
+ * (0x1000, the 0x440-byte constant), the IntraBuffer and the
+ * StreamStateBuffer, each sized for the larger of Apple's two platform
+ * multipliers.  Each CAPTURE buffer carries its stored-macroblock
+ * parameter buffer (apple_vxd_buffer.aux).
+ */
+#include <linux/crc32.h>
+#include <linux/moduleparam.h>
+#include <linux/slab.h>
+#include <linux/sizes.h>
+
+#include <media/v4l2-h264.h>
+
+#include "apple-vxd.h"
+#include "apple-vxd-h264-cmd.h"
+#include "apple-vxd-h264-parse.h"
+#include "apple-vxd-h264-tables.h"
+
+static unsigned int apple_vxd_scaling_order;
+module_param_named(scaling_order, apple_vxd_scaling_order, uint, 0644);
+MODULE_PARM_DESC(scaling_order,
+		 "debug: scaling-list element order, 0 raster (AppleD5500, default), 1 zig-zag, 2 transposed");
+
+/* DecodeCreateH264VLD sizes with Apple's multiplier M = 2. */
+#define APPLE_VXD_H264_CAVLC_BUF	SZ_4K
+#define APPLE_VXD_H264_INTRA_BUF	(2 << 16)
+#define APPLE_VXD_H264_STREAM_STATE_BUF	(2 << 12)
+
+struct apple_vxd_h264_ctx {
+	struct apple_vxd_dev_buf cavlc;
+	struct apple_vxd_dev_buf intra;
+	struct apple_vxd_dev_buf stream_state;
+	bool first_picture;
+	struct apple_vxd_h264_slice slices[APPLE_VXD_H264_MAX_SLICES];
+	u8 ref_slots[APPLE_VXD_H264_MAX_SLICES][2][V4L2_H264_REF_LIST_LEN];
+};
+
+static_assert(sizeof(apple_vxd_h264_vlc_table) == APPLE_VXD_H264_VLC_BYTES);
+
+static int apple_vxd_h264_validate_sps(struct apple_vxd_ctx *ctx,
+				       const struct v4l2_ctrl_h264_sps *sps)
+{
+	const struct apple_vxd_dev *vxd = ctx->vxd;
+
+	/*
+	 * Reject the profiles whose tools the 8-bit 4:2:0 decoder lacks;
+	 * High 10/4:2:2/4:4:4 are caught by the chroma/bit-depth checks below.
+	 * No allow-list: the control's default (profile_idc 0, before
+	 * userspace sets an SPS) must pass, or TRY_EXT_CTRLS on the current
+	 * values fails (v4l2-compliance, round 3 QEMU smoke).  What the AVC
+	 * command recipe does not cover (interlace, FMO) is refused per
+	 * picture.
+	 */
+	switch (sps->profile_idc) {
+	case 88: /* extended: data partitioning */
+	case 83: /* scalable baseline */
+	case 86: /* scalable high */
+	case 118: /* multiview high */
+	case 128: /* stereo high */
+	case 134: /* MFC high */
+	case 135: /* MFC depth high */
+	case 138: /* multiview depth high */
+	case 139: /* enhanced multiview depth high */
+		dev_dbg(vxd->dev, "sps: unsupported profile %u\n",
+			sps->profile_idc);
+		return -EINVAL;
+	default:
+		break;
+	}
+
+	if (sps->chroma_format_idc > 1) {
+		dev_dbg(vxd->dev, "sps: chroma format 4:2:2/4:4:4 not supported\n");
+		return -EINVAL;
+	}
+
+	if (sps->bit_depth_luma_minus8 > 0 || sps->bit_depth_chroma_minus8 > 0) {
+		dev_dbg(vxd->dev, "sps: 10-bit not supported\n");
+		return -EINVAL;
+	}
+
+	/*
+	 * DT advertises h264-playback-level = 42: 1920x1088 [E].  Tile
+	 * decode could lift this, but is not explored yet.
+	 */
+	if (sps->pic_width_in_mbs_minus1 > (APPLE_VXD_MAX_PIC_W / 16 - 1) ||
+	    sps->pic_height_in_map_units_minus1 > (APPLE_VXD_MAX_PIC_H / 16 - 1)) {
+		dev_dbg(vxd->dev, "sps: %ux%u exceeds level 4.2\n",
+			(sps->pic_width_in_mbs_minus1 + 1) * 16,
+			(sps->pic_height_in_map_units_minus1 + 1) * 16);
+		return -EINVAL;
+	}
+
+	if (sps->max_num_ref_frames > V4L2_H264_NUM_DPB_ENTRIES) {
+		dev_dbg(vxd->dev, "sps: max_num_ref_frames %u too many\n",
+			sps->max_num_ref_frames);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int apple_vxd_h264_try_ctrl(struct apple_vxd_ctx *ctx,
+				   struct v4l2_ctrl *ctrl)
+{
+	if (ctrl->id == V4L2_CID_STATELESS_H264_SPS)
+		return apple_vxd_h264_validate_sps(ctx, ctrl->p_new.p_h264_sps);
+
+	return 0;
+}
+
+static int apple_vxd_h264_start(struct apple_vxd_ctx *ctx)
+{
+	struct apple_vxd_dev *vxd = ctx->vxd;
+	struct apple_vxd_h264_ctx *h;
+	int ret;
+
+	h = kvzalloc_obj(*h);
+	if (!h)
+		return -ENOMEM;
+
+	ret = apple_vxd_dev_buf_alloc(vxd, APPLE_VXD_H264_CAVLC_BUF, &h->cavlc);
+	if (ret)
+		goto err_free;
+	ret = apple_vxd_dev_buf_alloc(vxd, APPLE_VXD_H264_INTRA_BUF, &h->intra);
+	if (ret)
+		goto err_cavlc;
+	ret = apple_vxd_dev_buf_alloc(vxd, APPLE_VXD_H264_STREAM_STATE_BUF,
+				      &h->stream_state);
+	if (ret)
+		goto err_intra;
+
+	memcpy(h->cavlc.mem.vaddr, apple_vxd_h264_vlc_table,
+	       sizeof(apple_vxd_h264_vlc_table));
+	if ((crc32_le(~0U, h->cavlc.mem.vaddr, APPLE_VXD_H264_VLC_BYTES) ^ ~0U) !=
+	    APPLE_VXD_H264_VLC_CRC32) {
+		dev_err(vxd->dev, "h264: CAVLC table CRC mismatch\n");
+		ret = -EIO;
+		goto err_state;
+	}
+	h->first_picture = true;
+	ctx->priv = h;
+
+	vxd_step_io(vxd->dev,
+		    "h264: context buffers: cavlc %#x, intra %#x (%u bytes), stream state %#x (%u bytes)",
+		    h->cavlc.va, h->intra.va, APPLE_VXD_H264_INTRA_BUF,
+		    h->stream_state.va, APPLE_VXD_H264_STREAM_STATE_BUF);
+	return 0;
+
+err_state:
+	apple_vxd_dev_buf_free(vxd, &h->stream_state);
+err_intra:
+	apple_vxd_dev_buf_free(vxd, &h->intra);
+err_cavlc:
+	apple_vxd_dev_buf_free(vxd, &h->cavlc);
+err_free:
+	kvfree(h);
+	return ret;
+}
+
+static void apple_vxd_h264_stop(struct apple_vxd_ctx *ctx)
+{
+	struct apple_vxd_h264_ctx *h = ctx->priv;
+
+	if (!h)
+		return;
+	apple_vxd_dev_buf_free(ctx->vxd, &h->stream_state);
+	apple_vxd_dev_buf_free(ctx->vxd, &h->intra);
+	apple_vxd_dev_buf_free(ctx->vxd, &h->cavlc);
+	kvfree(h);
+	ctx->priv = NULL;
+}
+
+static enum apple_vxd_image_fmt
+apple_vxd_h264_get_image_fmt(struct apple_vxd_ctx *ctx, struct v4l2_ctrl *ctrl)
+{
+	if (ctrl->id != V4L2_CID_STATELESS_H264_SPS)
+		return APPLE_VXD_IMG_FMT_ANY;
+
+	return APPLE_VXD_IMG_FMT_420_8BIT;
+}
+
+static size_t apple_vxd_h264_capture_aux_size(struct apple_vxd_ctx *ctx)
+{
+	const struct v4l2_pix_format_mplane *pix = &ctx->decoded_fmt.fmt.pix_mp;
+
+	return apple_vxd_h264_colocated_size(DIV_ROUND_UP(pix->width, 16),
+					     DIV_ROUND_UP(pix->height, 16));
+}
+
+static const void *apple_vxd_h264_ctrl(struct apple_vxd_ctx *ctx, u32 id)
+{
+	struct v4l2_ctrl *ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl, id);
+
+	return ctrl ? ctrl->p_cur.p : NULL;
+}
+
+/*
+ * RefPicList0/1 per slice as DPB slots: the initial lists (8.2.4.2.1 for
+ * P, 8.2.4.2.3 for B, built once per picture by the v4l2-h264 helper),
+ * truncated to num_ref_idx_lX_active, then the slice's modifications
+ * (8.2.4.3).  Entries past the available references are NO_REF.
+ */
+enum { VXD_LIST_P, VXD_LIST_B0, VXD_LIST_B1, VXD_LISTS };
+
+static int apple_vxd_h264_ref_lists(struct apple_vxd_h264_ctx *h,
+				    unsigned int nslices,
+				    const struct v4l2_ctrl_h264_sps *sps,
+				    const struct v4l2_ctrl_h264_decode_params *dp)
+{
+	struct v4l2_h264_reference init[VXD_LISTS][V4L2_H264_REF_LIST_LEN];
+	struct v4l2_h264_reference list[V4L2_H264_REF_LIST_LEN];
+	struct v4l2_h264_reflist_builder b;
+	bool have_p = false, have_b = false;
+	unsigned int i, k, lst;
+	int ret;
+
+	v4l2_h264_init_reflist_builder(&b, dp, sps, dp->dpb);
+	for (i = 0; i < nslices; i++) {
+		const struct apple_vxd_h264_slice *sl = &h->slices[i];
+		bool bslice = sl->slice_type == V4L2_H264_SLICE_TYPE_B;
+
+		memset(h->ref_slots[i], APPLE_VXD_H264_NO_REF,
+		       sizeof(h->ref_slots[i]));
+		if (sl->slice_type != V4L2_H264_SLICE_TYPE_P && !bslice)
+			continue;
+
+		if (!bslice && !have_p) {
+			v4l2_h264_build_p_ref_list(&b, init[VXD_LIST_P]);
+			have_p = true;
+		}
+		if (bslice && !have_b) {
+			v4l2_h264_build_b_ref_lists(&b, init[VXD_LIST_B0],
+						    init[VXD_LIST_B1]);
+			have_b = true;
+		}
+		for (lst = 0; lst < (bslice ? 2 : 1); lst++) {
+			const struct v4l2_h264_reference *src =
+				init[bslice ? VXD_LIST_B0 + lst : VXD_LIST_P];
+			unsigned int len = 1 + (lst ? sl->num_ref_idx_l1_active_minus1 :
+						      sl->num_ref_idx_l0_active_minus1);
+
+			for (k = 0; k < V4L2_H264_REF_LIST_LEN; k++) {
+				list[k] = src[k];
+				if (k >= b.num_valid)
+					list[k].index = APPLE_VXD_H264_NO_REF;
+			}
+			ret = apple_vxd_h264_modify_ref_list(sl, lst, sps, dp,
+							     list, len);
+			if (ret)
+				return ret;
+			for (k = 0; k < len; k++)
+				h->ref_slots[i][lst][k] = list[k].index;
+		}
+	}
+	return 0;
+}
+
+/* Every reference a slice names must resolve to a CAPTURE buffer. */
+static const char *apple_vxd_h264_check_refs(const struct apple_vxd_h264_ctx *h,
+					     unsigned int nslices,
+					     const struct apple_vxd_h264_frame *f)
+{
+	unsigned int i, k, lst;
+
+	for (i = 0; i < nslices; i++) {
+		const struct apple_vxd_h264_slice *sl = &h->slices[i];
+		bool bslice = sl->slice_type == V4L2_H264_SLICE_TYPE_B;
+
+		if (sl->slice_type != V4L2_H264_SLICE_TYPE_P && !bslice)
+			continue;
+		for (lst = 0; lst < (bslice ? 2 : 1); lst++) {
+			unsigned int len = 1 + (lst ? sl->num_ref_idx_l1_active_minus1 :
+						      sl->num_ref_idx_l0_active_minus1);
+
+			for (k = 0; k < len; k++) {
+				u8 slot = h->ref_slots[i][lst][k];
+
+				if (slot < V4L2_H264_NUM_DPB_ENTRIES &&
+				    !f->dpb_luma[slot])
+					return "a reference picture has no CAPTURE buffer";
+			}
+		}
+		if (bslice) {
+			u8 col = h->ref_slots[i][1][0];
+
+			if (col >= V4L2_H264_NUM_DPB_ENTRIES ||
+			    !f->dpb_colocated[col])
+				return "co-located picture (RefPicList1[0]) unresolved";
+		}
+	}
+	return NULL;
+}
+
+static int apple_vxd_h264_run(struct apple_vxd_ctx *ctx)
+{
+	const struct v4l2_pix_format_mplane *pix = &ctx->decoded_fmt.fmt.pix_mp;
+	const struct v4l2_ctrl_h264_scaling_matrix *scaling;
+	const struct v4l2_ctrl_h264_decode_params *dp;
+	const struct v4l2_ctrl_h264_sps *sps;
+	const struct v4l2_ctrl_h264_pps *pps;
+	struct apple_vxd_h264_ctx *h = ctx->priv;
+	struct apple_vxd_dev *vxd = ctx->vxd;
+	struct apple_vxd_h264_frame f = { };
+	struct apple_vxd_cmdbuf *cb = NULL;
+	struct apple_vxd_run run;
+	const char *why = NULL;
+	struct vb2_queue *cap_q;
+	unsigned int i, nslices;
+	const u8 *src;
+	size_t src_len;
+	u32 stride;
+	int ret;
+
+	apple_vxd_run_preamble(ctx, &run);
+
+	if (!vxd->hw_ready || vxd->fw_panicked) {
+		dev_dbg(vxd->dev,
+			"decode job with no usable firmware (not booted, init message not taken, or panicked)\n");
+		ret = -EAGAIN;
+		goto out;
+	}
+	if (!h) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	sps = apple_vxd_h264_ctrl(ctx, V4L2_CID_STATELESS_H264_SPS);
+	pps = apple_vxd_h264_ctrl(ctx, V4L2_CID_STATELESS_H264_PPS);
+	dp = apple_vxd_h264_ctrl(ctx, V4L2_CID_STATELESS_H264_DECODE_PARAMS);
+	scaling = apple_vxd_h264_ctrl(ctx, V4L2_CID_STATELESS_H264_SCALING_MATRIX);
+	if (!sps || !pps || !dp) {
+		ret = -EINVAL;
+		goto out;
+	}
+	ret = apple_vxd_h264_validate(sps, pps, scaling, &why);
+	if (ret)
+		goto out_why;
+	if (dp->flags & V4L2_H264_DECODE_PARAM_FLAG_FIELD_PIC) {
+		why = "field pictures";
+		ret = -EINVAL;
+		goto out_why;
+	}
+	if ((sps->pic_width_in_mbs_minus1 + 1) * 16 > pix->width ||
+	    (sps->pic_height_in_map_units_minus1 + 1) * 16 > pix->height) {
+		why = "picture larger than the CAPTURE format";
+		ret = -EINVAL;
+		goto out_why;
+	}
+
+	src_len = vb2_get_plane_payload(&run.src->vb2_buf, 0);
+	src = vb2_plane_vaddr(&run.src->vb2_buf, 0);
+	if (!src) {
+		why = "OUTPUT buffer has no kernel mapping";
+		ret = -EINVAL;
+		goto out_why;
+	}
+	ret = apple_vxd_h264_find_slices(src, src_len, sps, pps, h->slices,
+					 APPLE_VXD_H264_MAX_SLICES, &nslices,
+					 &why);
+	if (ret)
+		goto out_why;
+	if (nslices > APPLE_VXD_JOB_MAX_PACKETS) {
+		why = "more slices in one picture than packets in a job";
+		ret = -EINVAL;
+		goto out_why;
+	}
+	ret = apple_vxd_h264_ref_lists(h, nslices, sps, dp);
+	if (ret) {
+		why = "a reference-list modification names a picture not in the DPB";
+		goto out_why;
+	}
+
+	stride = pix->plane_fmt[0].bytesperline;
+	f.sps = sps;
+	f.pps = pps;
+	f.dp = dp;
+	f.scaling = scaling;
+	f.slices = h->slices;
+	f.nslices = nslices;
+	f.ref_slots = (const u8 (*)[2][V4L2_H264_REF_LIST_LEN])h->ref_slots;
+	f.src_va = apple_vxd_buf_va(run.src);
+	f.dst_luma = apple_vxd_buf_va(run.dst);
+	f.dst_chroma = f.dst_luma + stride * pix->height;
+	f.dst_stride = stride;
+	f.colocated = apple_vxd_buf_aux_va(run.dst);
+	f.bufs.cavlc = h->cavlc.va;
+	f.bufs.intra = h->intra.va;
+	f.bufs.stream_state = h->stream_state.va;
+	f.first_picture = h->first_picture;
+	f.scaling_order = min_t(unsigned int, apple_vxd_scaling_order,
+				APPLE_VXD_H264_SCALING_TRANSPOSED);
+
+	cap_q = v4l2_m2m_get_vq(ctx->fh.m2m_ctx, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+	for (i = 0; i < V4L2_H264_NUM_DPB_ENTRIES; i++) {
+		const struct v4l2_h264_dpb_entry *e = &dp->dpb[i];
+		struct vb2_buffer *ref;
+
+		if (!(e->flags & V4L2_H264_DPB_ENTRY_FLAG_VALID))
+			continue;
+		ref = vb2_find_buffer(cap_q, e->reference_ts);
+		if (!ref) {
+			dev_dbg(vxd->dev, "h264: dpb[%u] ts %llu has no CAPTURE buffer\n",
+				i, e->reference_ts);
+			continue;
+		}
+		f.dpb_luma[i] = apple_vxd_buf_va(to_vb2_v4l2_buffer(ref));
+		f.dpb_chroma[i] = f.dpb_luma[i] + stride * pix->height;
+		f.dpb_colocated[i] = apple_vxd_buf_aux_va(to_vb2_v4l2_buffer(ref));
+	}
+	why = apple_vxd_h264_check_refs(h, nslices, &f);
+	if (why) {
+		ret = -EINVAL;
+		goto out_why;
+	}
+
+	cb = apple_vxd_cmdbuf_get(vxd);
+	if (!cb) {
+		why = "no free command buffer";
+		ret = -EBUSY;
+		goto out_why;
+	}
+	ret = apple_vxd_h264_build(cb, &f, &why);
+	if (ret)
+		goto out_why;
+
+	vxd_step_io(vxd->dev,
+		    "decode: src %u va %#x (%zu bytes, %u slices, first %c NAL %#x+%u, header %u bits), dst %u Y %#x UV %#x stride %u, %zu command bytes in buf %u (va %#x), %u packets",
+		    run.src->vb2_buf.index, f.src_va, src_len, nslices,
+		    "PBIps"[h->slices[0].slice_type % 5],
+		    h->slices[0].nal_offset, h->slices[0].nal_size,
+		    8 + h->slices[0].header_bits_raw, run.dst->vb2_buf.index,
+		    f.dst_luma, f.dst_chroma, stride, cb->used, cb->index,
+		    cb->va, cb->npackets);
+
+	/*
+	 * The controls were only read while building: complete them before
+	 * the submit, after which the job may finish (and the request with
+	 * it) at any moment.
+	 */
+	apple_vxd_run_postamble(ctx, &run);
+	ret = apple_vxd_submit(ctx, cb);
+	if (ret) {
+		dev_warn_ratelimited(vxd->dev, "decode: submit failed: %d\n", ret);
+		if (cb->state == APPLE_VXD_CMDBUF_HOST)
+			apple_vxd_cmdbuf_put(vxd, cb);
+		return ret;
+	}
+	h->first_picture = false;
+	return 0;
+
+out_why:
+	dev_warn_ratelimited(vxd->dev, "decode: picture refused (%d): %s\n",
+			     ret, why ? why : "?");
+out:
+	if (cb)
+		apple_vxd_cmdbuf_put(vxd, cb);
+	apple_vxd_run_postamble(ctx, &run);
+	return ret;
+}
+
+static const struct apple_vxd_ctrl_desc apple_vxd_h264_ctrl_descs[] = {
+	{
+		.cfg.id = V4L2_CID_STATELESS_H264_DECODE_PARAMS,
+	},
+	{
+		.cfg.id = V4L2_CID_STATELESS_H264_SPS,
+		.cfg.ops = &apple_vxd_ctrl_ops,
+	},
+	{
+		.cfg.id = V4L2_CID_STATELESS_H264_PPS,
+	},
+	{
+		.cfg.id = V4L2_CID_STATELESS_H264_SCALING_MATRIX,
+	},
+	{
+		.cfg.id = V4L2_CID_STATELESS_H264_PRED_WEIGHTS,
+	},
+	{
+		.cfg.id = V4L2_CID_STATELESS_H264_SLICE_PARAMS,
+		.cfg.flags = V4L2_CTRL_FLAG_DYNAMIC_ARRAY,
+	},
+	{
+		.cfg.id = V4L2_CID_STATELESS_H264_DECODE_MODE,
+		.cfg.min = V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED,
+		.cfg.max = V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED,
+		.cfg.def = V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED,
+	},
+	{
+		.cfg.id = V4L2_CID_STATELESS_H264_START_CODE,
+		.cfg.min = V4L2_STATELESS_H264_START_CODE_ANNEX_B,
+		.cfg.def = V4L2_STATELESS_H264_START_CODE_ANNEX_B,
+		.cfg.max = V4L2_STATELESS_H264_START_CODE_ANNEX_B,
+	},
+	{
+		.cfg.id = V4L2_CID_MPEG_VIDEO_H264_PROFILE,
+		.cfg.min = V4L2_MPEG_VIDEO_H264_PROFILE_CONSTRAINED_BASELINE,
+		.cfg.max = V4L2_MPEG_VIDEO_H264_PROFILE_HIGH_422_INTRA,
+		.cfg.menu_skip_mask =
+			BIT(V4L2_MPEG_VIDEO_H264_PROFILE_EXTENDED) |
+			BIT(V4L2_MPEG_VIDEO_H264_PROFILE_HIGH_444_PREDICTIVE),
+		.cfg.def = V4L2_MPEG_VIDEO_H264_PROFILE_MAIN,
+	},
+	{
+		.cfg.id = V4L2_CID_MPEG_VIDEO_H264_LEVEL,
+		.cfg.min = V4L2_MPEG_VIDEO_H264_LEVEL_1_0,
+		.cfg.max = V4L2_MPEG_VIDEO_H264_LEVEL_4_2,
+		.cfg.def = V4L2_MPEG_VIDEO_H264_LEVEL_4_2,
+	},
+};
+
+static const struct apple_vxd_ctrls apple_vxd_h264_ctrls = {
+	.ctrls = apple_vxd_h264_ctrl_descs,
+	.num_ctrls = ARRAY_SIZE(apple_vxd_h264_ctrl_descs),
+};
+
+static const struct apple_vxd_decoded_fmt_desc
+apple_vxd_h264_decoded_fmts[] = {
+	{
+		.fourcc = V4L2_PIX_FMT_NV12,
+		.image_fmt = APPLE_VXD_IMG_FMT_420_8BIT,
+	},
+};
+
+static const struct apple_vxd_coded_fmt_desc apple_vxd_h264_fmt = {
+	.fourcc = V4L2_PIX_FMT_H264_SLICE,
+	.frmsize = {
+		.min_width = APPLE_VXD_MIN_PIC_W,
+		.max_width = APPLE_VXD_MAX_PIC_W,
+		.step_width = 16,
+		.min_height = APPLE_VXD_MIN_PIC_H,
+		.max_height = APPLE_VXD_MAX_PIC_H,
+		.step_height = 16,
+	},
+	.ctrls = &apple_vxd_h264_ctrls,
+	.ops = &(const struct apple_vxd_coded_fmt_ops){
+		.adjust_fmt = NULL,
+		.start = apple_vxd_h264_start,
+		.stop = apple_vxd_h264_stop,
+		.run = apple_vxd_h264_run,
+		.try_ctrl = apple_vxd_h264_try_ctrl,
+		.get_image_fmt = apple_vxd_h264_get_image_fmt,
+		.capture_aux_size = apple_vxd_h264_capture_aux_size,
+	},
+	.num_decoded_fmts = ARRAY_SIZE(apple_vxd_h264_decoded_fmts),
+	.decoded_fmts = apple_vxd_h264_decoded_fmts,
+};
+
+static const struct apple_vxd_coded_fmt_desc apple_vxd_coded_fmts[] = {
+	apple_vxd_h264_fmt,
+};
+
+/*
+ * Fills the device's coded-format table.  Called during probe, before any
+ * V4L2 node exists: apple_vxd_v4l2_init() and open() both refuse to run
+ * without it (round 2 had no such fill and oopsed in the first open()).
+ */
+int apple_vxd_h264_register(struct apple_vxd_dev *vxd)
+{
+	vxd->coded_fmts = apple_vxd_coded_fmts;
+	vxd->num_coded_fmts = ARRAY_SIZE(apple_vxd_coded_fmts);
+	return 0;
+}
diff --git a/drivers/media/platform/apple/vxd/apple-vxd-mbox.c b/drivers/media/platform/apple/vxd/apple-vxd-mbox.c
new file mode 100644
index 0000000000000000000000000000000000000000..b030d70d48886b2d01aaa7f232b8eb9d577e41ca
--- /dev/null
+++ b/drivers/media/platform/apple/vxd/apple-vxd-mbox.c
@@ -0,0 +1,1406 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Apple VXD - host<->MTX mailbox (R3a)
+ *
+ * docs/periph/ds-vxd-decode-protocol.md sections 2, 3 and 6.  The rings
+ * are word windows in the register file, not DMA queues: after the ready
+ * magic the DEVA firmware publishes each ring as (base << 16) | capacity
+ * in 0x2024 (TO_MTX) and 0x2018 (TO_HOST), and word i of a ring is the
+ * register at 0x2000 + base + 4 * i.
+ *
+ *   push (0xfffffff0062990bc):  words, 0x2030 = wr, flush reads of
+ *                               0x2028/0x2030/0x201c/0x2020, 0x88 = 1,
+ *                               flush read of 0x2000
+ *   ISR  (0xfffffff00629a0ac):  read 0x410, 0x414 = 0x100000, then drain
+ *                               TO_HOST (0x201c host rd, 0x2020 fw wr)
+ *   init (0xfffffff006298d40):  one 0x80 message after the ready magic
+ *
+ * The firmware answers decode packets with a 0xc0 completion carrying the
+ * fence; it answers nothing else.  0x80 and the benign 0x83..0x85 are
+ * acknowledged only by TO_MTX_RD (0x2028) moving past them: the DEVA
+ * reader publishes the new read index before it dispatches (fw 0x1000a9c).
+ * That is what the boot and the debugfs ping wait for.
+ *
+ * Every ring access is bounded: indices are checked against the published
+ * capacity, the geometry against the MMIO window, message lengths against
+ * both sides' limits, and every wait has a timeout.
+ */
+#include <linux/bitfield.h>
+#include <linux/debugfs.h>
+#include <linux/fs.h>
+#include <linux/interrupt.h>
+#include <linux/iopoll.h>
+#include <linux/kstrtox.h>
+#include <linux/ktime.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/seq_file.h>
+
+#include "apple-vxd.h"
+
+#define VXD_MSG_CONSUME_TIMEOUT_US	100000	/* init + ping */
+#define VXD_MSG_PUSH_TIMEOUT_US		100000	/* free-slot wait */
+#define VXD_PING_COMPLETION_MS		20
+#define VXD_DRAIN_MAX_MSGS		0x70	/* the kext's bound */
+#define VXD_RING_MAX_CAP		0x4000	/* sanity bound, words */
+#define VXD_RING_DUMP_MAX_WORDS		64
+#define VXD_PING_COOKIE			0x50494e47	/* "PING" */
+/*
+ * The firmware raises bit 20 only after posting a message, so an interrupt
+ * normally drains at least one.  This many in a row with nothing to drain
+ * means 0x414 does not clear the level line: stop taking it rather than
+ * livelock the CPU, and leave the hand drain (ping) working.
+ */
+#define VXD_IRQ_STORM_LIMIT		1000
+
+/* --- ring arithmetic: pure, shared with the self-test ------------------ */
+
+static u32 vxd_ring_next(u32 idx, u32 cap)
+{
+	return idx + 1 < cap ? idx + 1 : 0;
+}
+
+/* Words from @from forward to @to. */
+static u32 vxd_ring_dist(u32 from, u32 to, u32 cap)
+{
+	return to >= from ? to - from : to + cap - from;
+}
+
+/*
+ * Free TO_MTX words, AppleD5500's helper (0xfffffff0062996b4 [E]):
+ * rd + ~wr, plus the capacity unless wr < rd.  One word always stays free,
+ * so rd == wr means empty.
+ */
+static u32 vxd_ring_free(u32 rd, u32 wr, u32 cap)
+{
+	if (wr < rd)
+		return rd - wr - 1;
+	return rd - wr - 1 + cap;
+}
+
+/*
+ * The reader has taken the @t message once it moved at least nwords past
+ * its start without overtaking the writer.  A read index still behind the
+ * start (earlier messages pending) is "not yet".
+ */
+static bool vxd_ring_consumed(const struct apple_vxd_msg_ticket *t, u32 rd,
+			      u32 wr, u32 cap)
+{
+	u32 done = vxd_ring_dist(t->start, rd, cap);
+
+	return done >= t->nwords && done <= vxd_ring_dist(t->start, wr, cap);
+}
+
+/* Apple's fence: (submission << 4) | (packet * 2 & 0xe) | core, core 0. */
+static u16 vxd_fence_id(u16 seq, unsigned int packet)
+{
+	return (seq << 4) | ((packet * 2) & 0xe);
+}
+
+/*
+ * InitMessageBuffers [E]: w1 = firmware device address (the 0x6a00 value),
+ * w2 = (u8)seq << 16 | image size in 4 KiB pages (the blob, not the
+ * page-aligned allocation: 0x17e98 bytes -> 0x17), w3 = 0xffff0000.
+ */
+void apple_vxd_build_init_msg(u32 msg[VXD_INIT_MSG_WORDS], u32 fw_va,
+			      size_t fw_bytes, u16 seq)
+{
+	msg[0] = apple_vxd_msg_hdr(0, VXD_MSG_INIT, VXD_INIT_MSG_WORDS);
+	msg[1] = fw_va;
+	msg[2] = FIELD_PREP(VXD_INIT_SEQ, seq & 0xff) |
+		 FIELD_PREP(VXD_INIT_PAGES, fw_bytes >> 12);
+	msg[3] = VXD_INIT_SENTINEL;
+	msg[4] = 0;
+}
+
+/* --- geometry ---------------------------------------------------------- */
+
+static int vxd_ring_parse(struct apple_vxd_dev *vxd, const char *name,
+			  u32 raw, struct apple_vxd_ring *ring)
+{
+	ring->base = FIELD_GET(VXD_RING_BASE, raw);
+	ring->cap = FIELD_GET(VXD_RING_CAP, raw);
+
+	if (ring->cap <= VXD_MSG_TO_MTX_MAX_WORDS ||
+	    ring->cap > VXD_RING_MAX_CAP || ring->base & 3 ||
+	    VXD_RING_WINDOW + ring->base + 4 * ring->cap > vxd->regs_size) {
+		dev_err(vxd->dev,
+			"%s ring geometry %#010x (base %#x, %u words) is not usable: needs %u < words <= %u, a 4-byte aligned base and the ring inside the %#llx-byte register window\n",
+			name, raw, ring->base, ring->cap,
+			VXD_MSG_TO_MTX_MAX_WORDS, VXD_RING_MAX_CAP,
+			(unsigned long long)vxd->regs_size);
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static u32 vxd_ring_reg(const struct apple_vxd_ring *ring, u32 idx)
+{
+	return VXD_RING_WINDOW + ring->base + 4 * idx;
+}
+
+/*
+ * Read the geometry the firmware published with the ready magic, once per
+ * boot.  Called by the boot under power_lock.
+ */
+int apple_vxd_mbox_open(struct apple_vxd_dev *vxd)
+{
+	struct apple_vxd_ring to_mtx, to_host;
+	u32 raw_mtx, raw_host;
+	unsigned long flags;
+	unsigned int i;
+	int ret;
+
+	raw_mtx = vxd_read(vxd, VXD_REG_TO_MTX_RING);
+	raw_host = vxd_read(vxd, VXD_REG_TO_HOST_RING);
+	dev_info(vxd->dev,
+		 "ring geometry: TO_MTX (0x2024) %#010x, TO_HOST (0x2018) %#010x\n",
+		 raw_mtx, raw_host);
+
+	ret = vxd_ring_parse(vxd, "TO_MTX", raw_mtx, &to_mtx);
+	if (!ret)
+		ret = vxd_ring_parse(vxd, "TO_HOST", raw_host, &to_host);
+	if (ret)
+		return ret;
+
+	if (to_mtx.base < to_host.base + 4 * to_host.cap &&
+	    to_host.base < to_mtx.base + 4 * to_mtx.cap) {
+		dev_err(vxd->dev, "TO_MTX and TO_HOST rings overlap\n");
+		return -EINVAL;
+	}
+
+	spin_lock_irqsave(&vxd->mbox_lock, flags);
+	vxd->to_mtx = to_mtx;
+	vxd->to_host = to_host;
+	memset(&vxd->stats, 0, sizeof(vxd->stats));
+	for (i = 0; i < APPLE_VXD_NUM_FENCES; i++)
+		vxd->fences[i].state = APPLE_VXD_FENCE_FREE;
+	vxd->fw_panicked = false;
+	vxd->irq_storm = false;
+	vxd->irq_empty = 0;
+	vxd->mbox_ready = true;
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+
+	dev_info(vxd->dev,
+		 "mailbox: TO_MTX regs %#x..%#x (%u words), TO_HOST regs %#x..%#x (%u words)\n",
+		 vxd_ring_reg(&to_mtx, 0), vxd_ring_reg(&to_mtx, to_mtx.cap) - 1,
+		 to_mtx.cap, vxd_ring_reg(&to_host, 0),
+		 vxd_ring_reg(&to_host, to_host.cap) - 1, to_host.cap);
+	return 0;
+}
+
+/* --- push -------------------------------------------------------------- */
+
+/*
+ * Push one message to TO_MTX in AppleD5500's exact order, waiting (bounded)
+ * for room.  Process context only.  @ticket records where it went so the
+ * caller can wait for the firmware to take it.
+ */
+int apple_vxd_msg_push(struct apple_vxd_dev *vxd, const u32 *msg,
+		       struct apple_vxd_msg_ticket *ticket)
+{
+	u32 nwords = FIELD_GET(VXD_MSG_NWORDS, msg[0]);
+	u32 rd, wr, cap, i;
+	unsigned long flags;
+	ktime_t deadline;
+
+	might_sleep();
+	if (!nwords || nwords > VXD_MSG_TO_MTX_MAX_WORDS || msg[0] & BIT(7))
+		return -EINVAL;
+
+	deadline = ktime_add_us(ktime_get(), VXD_MSG_PUSH_TIMEOUT_US);
+	for (;;) {
+		spin_lock_irqsave(&vxd->mbox_lock, flags);
+		if (!vxd->mbox_ready) {
+			spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+			return -ENODEV;
+		}
+
+		cap = vxd->to_mtx.cap;
+		rd = vxd_read(vxd, VXD_REG_TO_MTX_RD_INDEX);
+		wr = vxd_read(vxd, VXD_REG_TO_MTX_WR_INDEX);
+		if (rd >= cap || wr >= cap) {
+			vxd->stats.malformed++;
+			spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+			dev_err(vxd->dev,
+				"TO_MTX indices out of range: rd %u wr %u (capacity %u)\n",
+				rd, wr, cap);
+			return -EIO;
+		}
+		if (vxd_ring_free(rd, wr, cap) >= nwords)
+			break;
+		spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+
+		if (ktime_after(ktime_get(), deadline)) {
+			dev_err(vxd->dev,
+				"TO_MTX full for 100 ms: rd %u wr %u, %u words free, %u needed\n",
+				rd, wr, vxd_ring_free(rd, wr, cap), nwords);
+			return -EBUSY;
+		}
+		usleep_range(100, 200);
+	}
+
+	ticket->start = wr;
+	ticket->nwords = nwords;
+	for (i = 0; i < nwords; i++) {
+		vxd_write(vxd, vxd_ring_reg(&vxd->to_mtx, wr), msg[i]);
+		wr = vxd_ring_next(wr, cap);
+	}
+	ticket->end = wr;
+	vxd_write(vxd, VXD_REG_TO_MTX_WR_INDEX, wr);
+
+	/* APB flush reads, doorbell, final flush: the kext's sequence. */
+	vxd_read(vxd, VXD_REG_TO_MTX_RD_INDEX);
+	vxd_read(vxd, VXD_REG_TO_MTX_WR_INDEX);
+	vxd_read(vxd, VXD_REG_TO_HOST_RD_INDEX);
+	vxd_read(vxd, VXD_REG_TO_HOST_WR_INDEX);
+	vxd_write(vxd, VXD_REG_MTX_DOORBELL, 1);
+	vxd_read(vxd, VXD_REG_COMMS_STATE);
+	vxd->stats.sent++;
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+
+	return 0;
+}
+
+static bool vxd_msg_is_consumed(struct apple_vxd_dev *vxd,
+				const struct apple_vxd_msg_ticket *ticket)
+{
+	u32 rd = vxd_read(vxd, VXD_REG_TO_MTX_RD_INDEX);
+	u32 wr = vxd_read(vxd, VXD_REG_TO_MTX_WR_INDEX);
+
+	if (rd >= vxd->to_mtx.cap || wr >= vxd->to_mtx.cap)
+		return false;
+	return vxd_ring_consumed(ticket, rd, wr, vxd->to_mtx.cap);
+}
+
+/* Poll 0x2028 until the firmware has taken the message (bounded). */
+int apple_vxd_msg_wait_consumed(struct apple_vxd_dev *vxd,
+				const struct apple_vxd_msg_ticket *ticket,
+				unsigned int timeout_us, unsigned int *waited_us)
+{
+	ktime_t start = ktime_get();
+	bool done;
+	int ret;
+
+	ret = read_poll_timeout(vxd_msg_is_consumed, done, done, 50,
+				timeout_us, false, vxd, ticket);
+	if (waited_us)
+		*waited_us = ktime_us_delta(ktime_get(), start);
+	return ret;
+}
+
+/* --- fences ------------------------------------------------------------ */
+
+/* 12-bit submission counter, never 0: fence 0 is the init message's.  mbox_lock held. */
+static u16 vxd_fence_next_seq_locked(struct apple_vxd_dev *vxd)
+{
+	vxd->fence_seq = (vxd->fence_seq + 1) & 0xfff;
+	if (!vxd->fence_seq)
+		vxd->fence_seq = 1;
+	return vxd->fence_seq;
+}
+
+/* mbox_lock held. */
+static struct apple_vxd_fence *vxd_fence_arm_locked(struct apple_vxd_dev *vxd,
+						    u16 id, u8 type)
+{
+	unsigned int i;
+
+	for (i = 0; i < APPLE_VXD_NUM_FENCES; i++) {
+		struct apple_vxd_fence *fence = &vxd->fences[i];
+
+		if (fence->state != APPLE_VXD_FENCE_FREE)
+			continue;
+		fence->id = id;
+		fence->type = type;
+		fence->status = 0;
+		fence->error = false;
+		fence->job = false;
+		fence->cmdbuf = NULL;
+		fence->state = APPLE_VXD_FENCE_ARMED;
+		reinit_completion(&fence->done);
+		return fence;
+	}
+	return NULL;
+}
+
+struct apple_vxd_fence *apple_vxd_fence_arm(struct apple_vxd_dev *vxd,
+					    unsigned int packet, u8 type)
+{
+	struct apple_vxd_fence *fence;
+	unsigned long flags;
+
+	spin_lock_irqsave(&vxd->mbox_lock, flags);
+	fence = vxd_fence_arm_locked(vxd,
+				     vxd_fence_id(vxd_fence_next_seq_locked(vxd),
+						  packet), type);
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+
+	return fence;
+}
+
+void apple_vxd_fence_release(struct apple_vxd_dev *vxd,
+			     struct apple_vxd_fence *fence)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&vxd->mbox_lock, flags);
+	/* Never completed: its command buffer stays with the device. */
+	if (fence->cmdbuf) {
+		fence->cmdbuf->fence = NULL;
+		fence->cmdbuf = NULL;
+	}
+	fence->job = false;
+	fence->state = APPLE_VXD_FENCE_FREE;
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+}
+
+/*
+ * Called with mbox_lock held.  A real 0xc0 (@device_done) means the core
+ * is finished with the bound command buffer, whatever the status; a panic
+ * or a teardown wakes the waiter but leaves the buffer quarantined until
+ * apple_vxd_cmdbufs_reclaim().
+ */
+static void vxd_fence_complete(struct apple_vxd_dev *vxd,
+			       struct apple_vxd_fence *fence, u32 status,
+			       bool error, bool device_done)
+{
+	struct apple_vxd_cmdbuf *cb = fence->cmdbuf;
+
+	if (cb) {
+		if (device_done)
+			apple_vxd_cmdbuf_retire_locked(cb);
+		else
+			cb->fence = NULL;
+		fence->cmdbuf = NULL;
+	}
+	fence->status = status;
+	fence->error = error;
+	fence->state = APPLE_VXD_FENCE_SIGNALLED;
+	complete_all(&fence->done);
+	/* The job is finished in process context (v4l2-m2m, runtime PM). */
+	if (fence->job)
+		queue_work(system_highpri_wq, &vxd->job_done_work);
+}
+
+/* Called with mbox_lock held: wake every waiter with an error. */
+static void vxd_fences_fail_all(struct apple_vxd_dev *vxd)
+{
+	unsigned int i;
+
+	for (i = 0; i < APPLE_VXD_NUM_FENCES; i++)
+		if (vxd->fences[i].state == APPLE_VXD_FENCE_ARMED)
+			vxd_fence_complete(vxd, &vxd->fences[i], 0, true, false);
+}
+
+/* --- drain ------------------------------------------------------------- */
+
+/*
+ * Pop one TO_HOST message (the kext's 0xfffffff0062997b0, consuming mode).
+ * mbox_lock held.  Returns the word count, 0 if the ring is empty, or
+ * -EIO if it is corrupt.
+ */
+static int vxd_msg_pop(struct apple_vxd_dev *vxd, u32 *msg)
+{
+	u32 cap = vxd->to_host.cap;
+	u32 rd = vxd_read(vxd, VXD_REG_TO_HOST_RD_INDEX);
+	u32 wr = vxd_read(vxd, VXD_REG_TO_HOST_WR_INDEX);
+	u32 n, i;
+
+	if (rd >= cap || wr >= cap) {
+		vxd->stats.malformed++;
+		dev_err_ratelimited(vxd->dev,
+				    "TO_HOST indices out of range: rd %u wr %u (capacity %u)\n",
+				    rd, wr, cap);
+		return -EIO;
+	}
+	if (rd == wr)
+		return 0;
+
+	msg[0] = vxd_read(vxd, vxd_ring_reg(&vxd->to_host, rd));
+	n = FIELD_GET(VXD_MSG_NWORDS, msg[0]);
+	if (n > VXD_MSG_TO_HOST_MAX_WORDS || n > vxd_ring_dist(rd, wr, cap)) {
+		/*
+		 * The kext logs "received oversize fw->host msg" and stops;
+		 * resync to the writer so one bad header cannot pin the ring.
+		 */
+		vxd->stats.malformed++;
+		dev_err_ratelimited(vxd->dev,
+				    "TO_HOST message %#010x at %u claims %u words (%u queued); dropping the queue\n",
+				    msg[0], rd, n, vxd_ring_dist(rd, wr, cap));
+		vxd_write(vxd, VXD_REG_TO_HOST_RD_INDEX, wr);
+		return -EIO;
+	}
+	if (!n) {
+		/* The kext consumes a zero-length header as one word. */
+		vxd->stats.malformed++;
+		n = 1;
+	}
+
+	rd = vxd_ring_next(rd, cap);
+	for (i = 1; i < n; i++) {
+		msg[i] = vxd_read(vxd, vxd_ring_reg(&vxd->to_host, rd));
+		rd = vxd_ring_next(rd, cap);
+	}
+	vxd_write(vxd, VXD_REG_TO_HOST_RD_INDEX, rd);
+	vxd->stats.received++;
+	return n;
+}
+
+static void vxd_msg_completion(struct apple_vxd_dev *vxd, const u32 *msg,
+			       u32 n)
+{
+	u16 id = FIELD_GET(VXD_MSG_FENCE, msg[0]);
+	u32 status = n > 2 ? msg[2] : 0;
+	u32 w3 = n > 3 ? msg[3] : 0;
+	bool fault = status & VXD_COMPLETION_FAULT;
+	unsigned int i;
+
+	vxd->stats.completions++;
+	if (fault) {
+		vxd->stats.faults++;
+		if ((status & VXD_COMPLETION_AFTER_RESET) && !w3)
+			dev_warn_ratelimited(vxd->dev,
+					     "completion fence %#x after core reset (status %#x)\n",
+					     id, status);
+		else
+			dev_err_ratelimited(vxd->dev,
+					    "completion fence %#x with fault: status %#x, word1 %#x, word3 %#x\n",
+					    id, status, n > 1 ? msg[1] : 0, w3);
+	}
+	if (status & VXD_COMPLETION_REATTEMPT)
+		dev_warn_ratelimited(vxd->dev,
+				     "completion fence %#x asks for REATTEMPT_SINGLEPIPE (0x200c %#x)\n",
+				     id, vxd_read(vxd, VXD_REG_FW_PC));
+
+	for (i = 0; i < APPLE_VXD_NUM_FENCES; i++) {
+		struct apple_vxd_fence *fence = &vxd->fences[i];
+
+		if (fence->state == APPLE_VXD_FENCE_ARMED && fence->id == id) {
+			vxd_fence_complete(vxd, fence, status, fault, true);
+			return;
+		}
+	}
+
+	vxd->stats.unknown_fences++;
+	dev_warn_ratelimited(vxd->dev,
+			     "completion for unknown fence %#x (status %#x)\n",
+			     id, status);
+}
+
+/* ProcessFWMessages' type switch (0xfffffff006299bb4 [E]).  mbox_lock held. */
+static void vxd_msg_dispatch(struct apple_vxd_dev *vxd, const u32 *msg, u32 n)
+{
+	u8 type = FIELD_GET(VXD_MSG_TYPE, msg[0]);
+
+	switch (type) {
+	case VXD_MSG_COMPLETION:
+		vxd_msg_completion(vxd, msg, n);
+		break;
+	case VXD_MSG_CONTIGUITY:
+		vxd->stats.contiguity++;
+		dev_warn_ratelimited(vxd->dev,
+				     "firmware contiguity warning (%#x %#x)\n",
+				     n > 1 ? msg[1] : 0, n > 2 ? msg[2] : 0);
+		break;
+	case VXD_MSG_PANIC:
+		vxd->stats.panics++;
+		vxd->fw_panicked = true;
+		dev_err_ratelimited(vxd->dev,
+				    "FW_DEVA_PANIC: fence %#x, error int %#x; decode is off until the firmware is rebooted\n",
+				    (u32)FIELD_GET(VXD_MSG_FENCE, msg[0]),
+				    n > 1 ? msg[1] : 0);
+		vxd_fences_fail_all(vxd);
+		break;
+	default:
+		/* The kext drops 0xd1..0xd4 and 0xe1..0xe4 without a word. */
+		if ((type >= 0xd1 && type <= 0xd4) ||
+		    (type >= 0xe1 && type <= 0xe4)) {
+			dev_dbg(vxd->dev, "firmware message %#x ignored\n", type);
+			break;
+		}
+		vxd->stats.unknown++;
+		dev_warn_ratelimited(vxd->dev,
+				     "unknown message %#010x from the DEVA firmware (%u words)\n",
+				     msg[0], n);
+		break;
+	}
+}
+
+/* mbox_lock held. */
+static unsigned int vxd_mbox_drain_locked(struct apple_vxd_dev *vxd)
+{
+	u32 msg[VXD_MSG_TO_HOST_MAX_WORDS];
+	unsigned int count;
+	int n;
+
+	for (count = 0; count < VXD_DRAIN_MAX_MSGS; count++) {
+		n = vxd_msg_pop(vxd, msg);
+		if (n <= 0)
+			return count;
+		vxd_msg_dispatch(vxd, msg, n);
+	}
+
+	dev_warn_ratelimited(vxd->dev, "too many messages in the fw2host queue\n");
+	return count;
+}
+
+/*
+ * Drain by hand: Apple's timeout path runs ProcessInterrupt manually, and
+ * the ping uses this to collect what an unarmed IRQ would have.
+ */
+unsigned int apple_vxd_mbox_drain(struct apple_vxd_dev *vxd)
+{
+	unsigned int count = 0;
+	unsigned long flags;
+
+	spin_lock_irqsave(&vxd->mbox_lock, flags);
+	if (vxd->mbox_ready)
+		count = vxd_mbox_drain_locked(vxd);
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+
+	return count;
+}
+
+/*
+ * IRQ 157, level.  Armed only while the firmware runs (the boot holds a
+ * runtime PM reference for that whole time, so the block is powered).
+ * Apple's order: status, clear, then drain.
+ */
+irqreturn_t apple_vxd_irq(int irq, void *data)
+{
+	struct apple_vxd_dev *vxd = data;
+	u32 status;
+
+	spin_lock(&vxd->mbox_lock);
+	if (!vxd->mbox_ready) {
+		spin_unlock(&vxd->mbox_lock);
+		return IRQ_NONE;
+	}
+
+	status = vxd_read(vxd, VXD_REG_IRQ_STATUS);
+	vxd->stats.last_irq_status = status;
+	if (!(status & VXD_IRQ_FW_MSG)) {
+		vxd->stats.spurious++;
+		spin_unlock(&vxd->mbox_lock);
+		return IRQ_NONE;
+	}
+
+	vxd_write(vxd, VXD_REG_IRQ_CLEAR, VXD_IRQ_FW_MSG);
+	vxd->stats.irqs++;
+	if (vxd_mbox_drain_locked(vxd)) {
+		vxd->irq_empty = 0;
+	} else if (++vxd->irq_empty == VXD_IRQ_STORM_LIMIT) {
+		disable_irq_nosync(irq);
+		vxd->irq_storm = true;
+		dev_err(vxd->dev,
+			"IRQ %d: %u interrupts in a row with nothing to drain (0x410 %#x): 0x414 does not clear the line; IRQ disabled, the debugfs ping still drains by hand\n",
+			irq, VXD_IRQ_STORM_LIMIT, status);
+	}
+	spin_unlock(&vxd->mbox_lock);
+
+	return IRQ_HANDLED;
+}
+
+/* --- start / stop ------------------------------------------------------- */
+
+static void vxd_mbox_log_state(struct apple_vxd_dev *vxd, const char *what)
+{
+	dev_info(vxd->dev,
+		 "%s: TO_MTX rd %u wr %u, TO_HOST rd %u wr %u, 0x200c %#x, 0x0 %#x, comms state %#x, irq status %#x\n",
+		 what, vxd_read(vxd, VXD_REG_TO_MTX_RD_INDEX),
+		 vxd_read(vxd, VXD_REG_TO_MTX_WR_INDEX),
+		 vxd_read(vxd, VXD_REG_TO_HOST_RD_INDEX),
+		 vxd_read(vxd, VXD_REG_TO_HOST_WR_INDEX),
+		 vxd_read(vxd, VXD_REG_FW_PC),
+		 vxd_read(vxd, VXD_REG_MTX_MSG_CONSUMED),
+		 vxd_read(vxd, VXD_REG_COMMS_STATE),
+		 vxd_read(vxd, VXD_REG_IRQ_STATUS));
+}
+
+/*
+ * The mandatory 0x80 init message, then the IRQ.  Without the init
+ * message the firmware has no picture of its own image and never
+ * schedules work (ds-vxd-decode-protocol.md section 3.1).  Boot path,
+ * power_lock held, mailbox open.
+ */
+int apple_vxd_mbox_start(struct apple_vxd_dev *vxd)
+{
+	struct apple_vxd_msg_ticket ticket;
+	u32 msg[VXD_INIT_MSG_WORDS];
+	unsigned int waited;
+	int ret;
+
+	apple_vxd_build_init_msg(msg, vxd->fw_dev_va, vxd->fw_blob_size,
+				 vxd->init_seq);
+	vxd_step(vxd->dev,
+		 "mbox: push the 0x80 init message {%#x %#x %#x %#x %#x}",
+		 msg[0], msg[1], msg[2], msg[3], msg[4]);
+	ret = apple_vxd_msg_push(vxd, msg, &ticket);
+	if (ret) {
+		dev_err(vxd->dev, "init message push failed: %d\n", ret);
+		return ret;
+	}
+	vxd->init_seq++;
+
+	vxd_step(vxd->dev,
+		 "mbox: wait for TO_MTX rd to reach %u (init message taken, 100 ms)",
+		 ticket.end);
+	ret = apple_vxd_msg_wait_consumed(vxd, &ticket,
+					  VXD_MSG_CONSUME_TIMEOUT_US, &waited);
+	if (ret) {
+		vxd_mbox_log_state(vxd, "init message NOT consumed after 100 ms");
+		return ret;
+	}
+	dev_info(vxd->dev, "init message consumed after %u us\n", waited);
+	vxd_mbox_log_state(vxd, "after init");
+
+	vxd_step(vxd->dev, "mbox: arm IRQ %d (0x418 = %#x)", vxd->irq,
+		 vxd_read(vxd, VXD_REG_IRQ_ENABLE));
+	enable_irq(vxd->irq);
+	vxd->irq_armed = true;
+	return 0;
+}
+
+/* Teardown, power_lock held: no IRQ, no pushes, every waiter woken. */
+void apple_vxd_mbox_stop(struct apple_vxd_dev *vxd)
+{
+	unsigned long flags;
+
+	if (vxd->irq_armed) {
+		/* The storm guard already disabled it from the handler. */
+		if (READ_ONCE(vxd->irq_storm))
+			synchronize_irq(vxd->irq);
+		else
+			disable_irq(vxd->irq);
+		vxd->irq_armed = false;
+	}
+
+	spin_lock_irqsave(&vxd->mbox_lock, flags);
+	if (vxd->mbox_ready) {
+		/* Quiesce the line the way known state does. */
+		vxd_write(vxd, VXD_REG_IRQ_ENABLE, 0);
+		vxd_write(vxd, VXD_REG_IRQ_CLEAR, 0xffffffff);
+	}
+	vxd->mbox_ready = false;
+	vxd_fences_fail_all(vxd);
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+}
+
+/*
+ * Decode submission: one picture's command buffer, one mailbox message per
+ * packet, in packet-list order (SubmitCommandBufferInternal
+ * 0xfffffff00628a8d4 [E]).  The last message carries 0x4004 and its fence
+ * completes the job (apple_vxd_job_done(), process context); the buffer
+ * is bound to that fence and freed by its 0xc0.  Returns 0 once every
+ * message is in TO_MTX; on an error nothing is left armed, and a buffer
+ * the firmware may already have been told about stays quarantined.
+ *
+ * Messages are built twice (checked before anything is armed, rebuilt for
+ * the push) so a 128-slice picture needs no per-packet array on the stack.
+ */
+int apple_vxd_submit(struct apple_vxd_ctx *ctx, struct apple_vxd_cmdbuf *cb)
+{
+	struct apple_vxd_fence *fences[APPLE_VXD_JOB_MAX_FENCES] = { };
+	struct apple_vxd_dev *vxd = ctx->vxd;
+	struct apple_vxd_msg_ticket ticket;
+	u32 msg[VXD_DECODE_MSG_WORDS];
+	unsigned int i, narmed, first_armed, pushed = 0;
+	struct apple_vxd_fence *last = NULL;
+	unsigned long flags;
+	bool gart_dirty;
+	int n, ret;
+	size_t off;
+	u16 seq;
+
+	n = apple_vxd_cmdbuf_validate(cb);
+	if (n <= 0 || n > APPLE_VXD_JOB_MAX_PACKETS) {
+		dev_err(vxd->dev, "decode: %d packets in the command buffer (1..%u)\n",
+			n, APPLE_VXD_JOB_MAX_PACKETS);
+		return -EINVAL;
+	}
+	narmed = n <= APPLE_VXD_JOB_MAX_FENCES ? n : 1;
+	first_armed = n - narmed;
+
+	/* Every packet must make a message before anything is armed. */
+	for (i = 0, off = 0; i < n; i++) {
+		u32 *pkt = (u32 *)(cb->pkt + off);
+
+		ret = apple_vxd_packet_msg(vxd, pkt, 0, 0, i == n - 1, msg);
+		if (ret < 0)
+			return ret;
+		off += VXD_PKT_HDR_BYTES + pkt[1];
+	}
+
+	mutex_lock(&vxd->power_lock);
+	if (!vxd->mbox_ready || !vxd->hw_ready || vxd->fw_panicked) {
+		ret = -ENODEV;
+		goto out_unlock;
+	}
+
+	/* Fences first: the firmware may answer before the last push. */
+	spin_lock_irqsave(&vxd->mbox_lock, flags);
+	seq = vxd_fence_next_seq_locked(vxd);
+	for (i = 0; i < narmed; i++) {
+		fences[i] = vxd_fence_arm_locked(vxd,
+						 vxd_fence_id(seq, first_armed + i),
+						 VXD_MSG_DECODE);
+		if (!fences[i])
+			break;
+	}
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+	if (i < narmed) {
+		ret = -EBUSY;
+		goto out_fences;
+	}
+
+	last = fences[narmed - 1];
+	last->job = true;
+	ret = apple_vxd_cmdbuf_bind(vxd, cb, last);
+	if (ret)
+		goto out_fences;
+
+	spin_lock_irqsave(&vxd->job_lock, flags);
+	if (vxd->job_active) {
+		spin_unlock_irqrestore(&vxd->job_lock, flags);
+		ret = -EBUSY;
+		goto out_unbind;
+	}
+	vxd->job.ctx = ctx;
+	vxd->job.nfences = narmed;
+	vxd->job.npackets = n;
+	vxd->job.seq = seq;
+	vxd->job.submitted = ktime_get();
+	memcpy(vxd->job.fences, fences, sizeof(fences));
+	vxd->job_active = true;
+	spin_unlock_irqrestore(&vxd->job_lock, flags);
+
+	/* The kext rewrites 0x1008 before a submit that follows a GART change. */
+	mutex_lock(&vxd->gart.lock);
+	gart_dirty = vxd->gart.dirty;
+	vxd->gart.dirty = false;
+	mutex_unlock(&vxd->gart.lock);
+	if (gart_dirty)
+		vxd_write(vxd, VXD_REG_MMU_CONTROL1, VXD_MMU_INVALDC_ALL);
+
+	for (i = 0, off = 0; i < n; i++) {
+		u32 *pkt = (u32 *)(cb->pkt + off);
+		int type;
+
+		off += VXD_PKT_HDR_BYTES + pkt[1];
+		type = apple_vxd_packet_msg(vxd, pkt, vxd_fence_id(seq, i), 0,
+					    i == n - 1, msg);
+		if (i >= first_armed)
+			fences[i - first_armed]->type = type;
+		vxd_step_io(vxd->dev,
+			    "decode: push %#x fence %#x%s {%#x %#x %#x %#x %#x %#x}",
+			    type, vxd_fence_id(seq, i),
+			    i >= first_armed ? "" : " (not armed)", msg[0],
+			    msg[1], msg[2], msg[3], msg[4], msg[5]);
+		ret = apple_vxd_msg_push(vxd, msg, &ticket);
+		if (ret)
+			break;
+		pushed++;
+	}
+	if (ret) {
+		dev_err(vxd->dev, "decode: push %u of %d failed: %d%s\n", pushed + 1,
+			n, ret, pushed ? "; the command buffer stays quarantined" : "");
+		spin_lock_irqsave(&vxd->job_lock, flags);
+		vxd->job_active = false;
+		spin_unlock_irqrestore(&vxd->job_lock, flags);
+		if (pushed)
+			goto out_fences;	/* release leaves the buffer DEVICE */
+		goto out_unbind;
+	}
+
+	schedule_delayed_work(&vxd->watchdog_work,
+			      msecs_to_jiffies(APPLE_VXD_JOB_TIMEOUT_MS));
+	mutex_unlock(&vxd->power_lock);
+	return 0;
+
+out_unbind:
+	spin_lock_irqsave(&vxd->mbox_lock, flags);
+	if (cb->state == APPLE_VXD_CMDBUF_DEVICE && cb->fence == last) {
+		cb->state = APPLE_VXD_CMDBUF_HOST;
+		cb->fence = NULL;
+		last->cmdbuf = NULL;
+	}
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+out_fences:
+	for (i = 0; i < narmed; i++)
+		if (fences[i])
+			apple_vxd_fence_release(vxd, fences[i]);
+out_unlock:
+	mutex_unlock(&vxd->power_lock);
+	return ret;
+}
+
+/* --- debugfs ------------------------------------------------------------- */
+
+/*
+ * Debugfs boot trigger: write anything to trigger apple_vxd_boot_firmware
+ * (the R1 recipe) without an unbind/bind cycle.  Returns 0 (bytes written)
+ * on success or the negative error, so the failure is visible at the
+ * shell: `echo 1 > /sys/kernel/debug/apple-vxd/boot`.
+ */
+static ssize_t apple_vxd_boot_trigger_write(struct file *file,
+					    const char __user *ubuf,
+					    size_t count, loff_t *ppos)
+{
+	struct apple_vxd_dev *vxd = file->private_data;
+	int ret;
+
+	ret = apple_vxd_boot_firmware(vxd);
+	if (ret)
+		return ret;
+
+	return count;
+}
+
+static const struct file_operations apple_vxd_boot_trigger_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = apple_vxd_boot_trigger_write,
+	.llseek = default_llseek,
+};
+
+/*
+ * One benign message through the whole mailbox: push, doorbell, wait for
+ * TO_MTX rd to pass it (bounded), drain TO_HOST by hand, then give a fence
+ * completion a short window.  0x83..0x85 are dropped by the DEVA
+ * dispatcher, so "consumed, no completion" is the expected answer; 0x80
+ * re-sends the init message (Apple's recovery path 0xfffffff00629964c
+ * does the same).
+ */
+static int apple_vxd_ping(struct apple_vxd_dev *vxd, u8 type)
+{
+	struct apple_vxd_fence *fence = NULL;
+	struct apple_vxd_msg_ticket ticket;
+	u32 msg[VXD_INIT_MSG_WORDS];
+	unsigned int waited, drained;
+	int ret;
+
+	if (type != VXD_MSG_INIT &&
+	    (type < VXD_MSG_NOP_FIRST || type > VXD_MSG_NOP_LAST))
+		return -EINVAL;
+
+	mutex_lock(&vxd->power_lock);
+	if (!vxd->mbox_ready) {
+		dev_err(vxd->dev, "ping: the firmware mailbox is not up (boot first)\n");
+		ret = -ENODEV;
+		goto out_unlock;
+	}
+
+	ret = pm_runtime_resume_and_get(vxd->dev);
+	if (ret)
+		goto out_unlock;
+
+	if (type == VXD_MSG_INIT) {
+		apple_vxd_build_init_msg(msg, vxd->fw_dev_va, vxd->fw_blob_size,
+					 vxd->init_seq);
+	} else {
+		fence = apple_vxd_fence_arm(vxd, 0, type);
+		if (!fence) {
+			ret = -EBUSY;
+			goto out_put;
+		}
+		msg[0] = apple_vxd_msg_hdr(fence->id, type, 2);
+		msg[1] = VXD_PING_COOKIE ^ fence->id;
+	}
+
+	vxd_step(vxd->dev, "ping: push type %#x, fence %#x, %u words",
+		 type, (u32)FIELD_GET(VXD_MSG_FENCE, msg[0]),
+		 (u32)FIELD_GET(VXD_MSG_NWORDS, msg[0]));
+	ret = apple_vxd_msg_push(vxd, msg, &ticket);
+	if (ret) {
+		dev_err(vxd->dev, "ping: push failed: %d\n", ret);
+		goto out_fence;
+	}
+	if (type == VXD_MSG_INIT)
+		vxd->init_seq++;
+
+	vxd_step(vxd->dev,
+		 "ping: pushed at TO_MTX [%u..%u), doorbell rung; wait for rd to reach %u (100 ms)",
+		 ticket.start, ticket.end, ticket.end);
+	ret = apple_vxd_msg_wait_consumed(vxd, &ticket,
+					  VXD_MSG_CONSUME_TIMEOUT_US, &waited);
+	if (ret)
+		vxd_mbox_log_state(vxd, "ping: NOT consumed after 100 ms");
+	else
+		dev_info(vxd->dev, "ping: type %#x consumed after %u us\n",
+			 type, waited);
+
+	drained = apple_vxd_mbox_drain(vxd);
+	if (fence && !ret) {
+		if (wait_for_completion_timeout(&fence->done,
+						msecs_to_jiffies(VXD_PING_COMPLETION_MS)))
+			dev_info(vxd->dev,
+				 "ping: completion for fence %#x, status %#x%s\n",
+				 fence->id, fence->status,
+				 fence->error ? " (error)" : "");
+		else
+			dev_info(vxd->dev,
+				 "ping: no completion for fence %#x within %u ms (expected: the DEVA dispatcher drops 0x83-0x85 without a reply)\n",
+				 fence->id, VXD_PING_COMPLETION_MS);
+	}
+	vxd_step(vxd->dev, "ping: done, rc %d, %u TO_HOST messages drained by hand",
+		 ret, drained);
+
+out_fence:
+	if (fence)
+		apple_vxd_fence_release(vxd, fence);
+out_put:
+	pm_runtime_put_autosuspend(vxd->dev);
+out_unlock:
+	mutex_unlock(&vxd->power_lock);
+	return ret;
+}
+
+/* `echo [0x83|0x84|0x85|0x80] > ping`; an empty write sends 0x83. */
+static ssize_t apple_vxd_ping_write(struct file *file, const char __user *ubuf,
+				    size_t count, loff_t *ppos)
+{
+	struct apple_vxd_dev *vxd = file->private_data;
+	u8 type = VXD_MSG_NOP_FIRST;
+	int ret;
+
+	if (count > 1) {
+		ret = kstrtou8_from_user(ubuf, count, 0, &type);
+		if (ret)
+			return ret;
+	}
+
+	ret = apple_vxd_ping(vxd, type);
+	return ret ? ret : count;
+}
+
+static const struct file_operations apple_vxd_ping_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = apple_vxd_ping_write,
+	.llseek = default_llseek,
+};
+
+struct vxd_comms_snap {
+	u32 rd, wr, r0, r200c, r2010;
+};
+
+static void vxd_comms_snap(struct apple_vxd_dev *vxd, struct vxd_comms_snap *s,
+			   const char *when)
+{
+	s->rd = vxd_read(vxd, VXD_REG_TO_MTX_RD_INDEX);
+	s->wr = vxd_read(vxd, VXD_REG_TO_MTX_WR_INDEX);
+	s->r0 = vxd_read(vxd, VXD_REG_MTX_MSG_CONSUMED);
+	s->r200c = vxd_read(vxd, VXD_REG_FW_PC);
+	s->r2010 = vxd_read(vxd, VXD_REG_COMMS_MSG_COUNT);
+	dev_info(vxd->dev,
+		 "consume_check: %s: TO_MTX rd %u wr %u, 0x0 %#x, 0x200c %#x, 0x2010 %#x\n",
+		 when, s->rd, s->wr, s->r0, s->r200c, s->r2010);
+}
+
+static u32 vxd_to_mtx_rd(struct apple_vxd_dev *vxd)
+{
+	return vxd_read(vxd, VXD_REG_TO_MTX_RD_INDEX);
+}
+
+/*
+ * Is TO_MTX_RD (0x2028) really written by the firmware?  Every message so
+ * far was "consumed after 0 us", which a reader that moves rd before the
+ * host even looks would also produce.  One benign 0x83 in three stages:
+ *
+ *   1. ring words written, write index NOT published: rd must not move
+ *      (20 ms), and the ring window must read back what was written;
+ *   2. write index published, no doorbell: does the reader poll 0x2030
+ *      (rd moves) or wait for the doorbell (rd stays)?  Either is a finding;
+ *   3. doorbell: rd must reach the new write index (100 ms).
+ *
+ * Returns 0 when stage 1 held and stage 3 was reached, -EIO when rd moved
+ * with nothing published, -ETIMEDOUT when the message was never taken.
+ * Same serialization as the ping (power_lock); refuses while a decode job
+ * is in flight.
+ */
+static int apple_vxd_consume_check(struct apple_vxd_dev *vxd)
+{
+	struct apple_vxd_fence *fence = NULL;
+	struct vxd_comms_snap s0, s1;
+	u32 msg[2], back[2], cap, wr, wr1, rd;
+	unsigned long flags;
+	bool moved_early = false, moved_nodb = false;
+	unsigned int i, drained;
+	ktime_t t0;
+	int ret, err;
+
+	mutex_lock(&vxd->power_lock);
+	if (!vxd->mbox_ready) {
+		dev_err(vxd->dev, "consume_check: the firmware mailbox is not up (boot first)\n");
+		ret = -ENODEV;
+		goto out_unlock;
+	}
+	if (READ_ONCE(vxd->job_active)) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+	ret = pm_runtime_resume_and_get(vxd->dev);
+	if (ret)
+		goto out_unlock;
+
+	fence = apple_vxd_fence_arm(vxd, 0, VXD_MSG_NOP_FIRST);
+	if (!fence) {
+		ret = -EBUSY;
+		goto out_put;
+	}
+	msg[0] = apple_vxd_msg_hdr(fence->id, VXD_MSG_NOP_FIRST, 2);
+	msg[1] = VXD_PING_COOKIE ^ fence->id;
+
+	vxd_comms_snap(vxd, &s0, "before");
+	cap = vxd->to_mtx.cap;
+	if (s0.rd >= cap || s0.wr >= cap || s0.rd != s0.wr) {
+		dev_err(vxd->dev, "consume_check: TO_MTX not idle (rd %u wr %u, capacity %u)\n",
+			s0.rd, s0.wr, cap);
+		ret = -EBUSY;
+		goto out_fence;
+	}
+
+	/* Stage 1: words only. */
+	spin_lock_irqsave(&vxd->mbox_lock, flags);
+	wr = s0.wr;
+	for (i = 0; i < ARRAY_SIZE(msg); i++) {
+		vxd_write(vxd, vxd_ring_reg(&vxd->to_mtx, wr), msg[i]);
+		wr = vxd_ring_next(wr, cap);
+	}
+	wr1 = wr;
+	wr = s0.wr;
+	for (i = 0; i < ARRAY_SIZE(msg); i++) {
+		back[i] = vxd_read(vxd, vxd_ring_reg(&vxd->to_mtx, wr));
+		wr = vxd_ring_next(wr, cap);
+	}
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+	vxd_step(vxd->dev,
+		 "consume_check: stage 1: %#010x %#010x written at TO_MTX [%u..%u), read back %#010x %#010x, write index NOT published; wait 20 ms",
+		 msg[0], msg[1], s0.wr, wr1, back[0], back[1]);
+	msleep(20);
+	rd = vxd_to_mtx_rd(vxd);
+	moved_early = rd != s0.rd;
+	dev_info(vxd->dev, "consume_check: stage 1: rd %u after 20 ms (%s), wr register %u, ring readback %s\n",
+		 rd, moved_early ? "MOVED with nothing published: FAIL" : "unchanged: ok",
+		 vxd_read(vxd, VXD_REG_TO_MTX_WR_INDEX),
+		 back[0] == msg[0] && back[1] == msg[1] ? "matches" : "DIFFERS");
+
+	/* Stage 2: publish the write index, no doorbell. */
+	spin_lock_irqsave(&vxd->mbox_lock, flags);
+	vxd_write(vxd, VXD_REG_TO_MTX_WR_INDEX, wr1);
+	vxd_read(vxd, VXD_REG_TO_MTX_RD_INDEX);
+	vxd_read(vxd, VXD_REG_TO_MTX_WR_INDEX);
+	vxd_read(vxd, VXD_REG_TO_HOST_RD_INDEX);
+	vxd_read(vxd, VXD_REG_TO_HOST_WR_INDEX);
+	vxd->stats.sent++;
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+	t0 = ktime_get();
+	err = read_poll_timeout(vxd_to_mtx_rd, rd, rd == wr1, 20, 50000, false, vxd);
+	moved_nodb = !err;
+	dev_info(vxd->dev, "consume_check: stage 2: write index %u published, no doorbell: rd %u, %s after %lld us\n",
+		 wr1, rd, moved_nodb ? "taken (the reader polls 0x2030)" :
+		 "not taken (the reader waits for the doorbell)",
+		 ktime_us_delta(ktime_get(), t0));
+
+	/* Stage 3: doorbell. */
+	spin_lock_irqsave(&vxd->mbox_lock, flags);
+	vxd_write(vxd, VXD_REG_MTX_DOORBELL, 1);
+	vxd_read(vxd, VXD_REG_COMMS_STATE);
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+	t0 = ktime_get();
+	err = read_poll_timeout(vxd_to_mtx_rd, rd, rd == wr1, 20, 100000, false, vxd);
+	dev_info(vxd->dev, "consume_check: stage 3: doorbell rung: rd %u, %s after %lld us\n",
+		 rd, err ? "NOT taken" : "taken", ktime_us_delta(ktime_get(), t0));
+
+	drained = apple_vxd_mbox_drain(vxd);
+	vxd_comms_snap(vxd, &s1, "after");
+	if (moved_early)
+		ret = -EIO;
+	else if (err)
+		ret = -ETIMEDOUT;
+	dev_info(vxd->dev,
+		 "consume_check: %s: rd firmware-driven %s, reader %s, %u TO_HOST messages drained, 0x0 %s, 0x200c %s, 0x2010 %s\n",
+		 ret ? "FAIL" : "PASS", moved_early ? "NO" : "yes",
+		 moved_nodb ? "polls the write index" : "is doorbell-driven", drained,
+		 s1.r0 == s0.r0 ? "unchanged" : "changed",
+		 s1.r200c == s0.r200c ? "unchanged" : "changed",
+		 s1.r2010 == s0.r2010 ? "unchanged" : "changed");
+
+out_fence:
+	apple_vxd_fence_release(vxd, fence);
+out_put:
+	pm_runtime_put_autosuspend(vxd->dev);
+out_unlock:
+	mutex_unlock(&vxd->power_lock);
+	return ret;
+}
+
+static ssize_t apple_vxd_consume_check_write(struct file *file,
+					     const char __user *ubuf,
+					     size_t count, loff_t *ppos)
+{
+	int ret = apple_vxd_consume_check(file->private_data);
+
+	return ret ? ret : count;
+}
+
+static const struct file_operations apple_vxd_consume_check_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = apple_vxd_consume_check_write,
+	.llseek = default_llseek,
+};
+
+static void vxd_dump_ring(struct seq_file *m, struct apple_vxd_dev *vxd,
+			  const char *name, const struct apple_vxd_ring *ring)
+{
+	u32 i, n = min_t(u32, ring->cap, VXD_RING_DUMP_MAX_WORDS);
+
+	seq_printf(m, "%s words (%u of %u):", name, n, ring->cap);
+	for (i = 0; i < n; i++)
+		seq_printf(m, "%s%08x", i % 8 ? " " : "\n  ",
+			   vxd_read(vxd, vxd_ring_reg(ring, i)));
+	seq_puts(m, "\n");
+}
+
+static const char *const vxd_fence_state_names[] = {
+	[APPLE_VXD_FENCE_FREE] = "free",
+	[APPLE_VXD_FENCE_ARMED] = "armed",
+	[APPLE_VXD_FENCE_SIGNALLED] = "signalled",
+};
+
+/*
+ * The dumps read MMIO, and the block autosuspends 100 ms after probe (the
+ * ps_vdec genpd then cuts it): take a runtime PM reference around every
+ * dump so a `cat` never reads an unpowered block.
+ */
+static int apple_vxd_mbox_dump_show(struct seq_file *m, void *v)
+{
+	struct apple_vxd_dev *vxd = m->private;
+	struct apple_vxd_mbox_stats st;
+	struct apple_vxd_ring to_mtx, to_host;
+	/*
+	 * Only what the dump prints: a whole struct apple_vxd_fence carries a
+	 * struct completion, which lockdep makes large (a 16-entry copy
+	 * overflowed the 2 KiB frame limit in the QEMU smoke's KASAN build).
+	 */
+	struct {
+		enum apple_vxd_fence_state state;
+		u16 id;
+		u8 type;
+		bool error;
+		u32 status;
+	} fences[APPLE_VXD_NUM_FENCES];
+	u32 raw_mtx, raw_host, rd, wr;
+	unsigned long flags;
+	bool ready;
+	unsigned int i;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(vxd->dev);
+	if (ret)
+		return ret;
+
+	spin_lock_irqsave(&vxd->mbox_lock, flags);
+	ready = vxd->mbox_ready;
+	to_mtx = vxd->to_mtx;
+	to_host = vxd->to_host;
+	st = vxd->stats;
+	for (i = 0; i < APPLE_VXD_NUM_FENCES; i++) {
+		fences[i].state = vxd->fences[i].state;
+		fences[i].id = vxd->fences[i].id;
+		fences[i].type = vxd->fences[i].type;
+		fences[i].error = vxd->fences[i].error;
+		fences[i].status = vxd->fences[i].status;
+	}
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
+
+	raw_mtx = vxd_read(vxd, VXD_REG_TO_MTX_RING);
+	raw_host = vxd_read(vxd, VXD_REG_TO_HOST_RING);
+
+	seq_printf(m, "comms state      %#x\n", vxd_read(vxd, VXD_REG_COMMS_STATE));
+	seq_printf(m, "reg 0x0          %#x\n", vxd_read(vxd, VXD_REG_MTX_MSG_CONSUMED));
+	seq_printf(m, "comms 0x2008     %#x\n", vxd_read(vxd, VXD_REG_COMMS_2008));
+	seq_printf(m, "reg 0x200c       %#x\n", vxd_read(vxd, VXD_REG_FW_PC));
+	seq_printf(m, "msg count (2010) %#x\n", vxd_read(vxd, VXD_REG_COMMS_MSG_COUNT));
+	seq_printf(m, "fw ready (2014)  %#x%s\n", vxd_read(vxd, VXD_REG_FW_READY_MAGIC),
+		   vxd->fw_loaded ? " (firmware alive)" : "");
+	seq_printf(m, "TO_MTX  (2024)   %#010x: base %#lx, %lu words\n", raw_mtx,
+		   FIELD_GET(VXD_RING_BASE, raw_mtx), FIELD_GET(VXD_RING_CAP, raw_mtx));
+	seq_printf(m, "TO_HOST (2018)   %#010x: base %#lx, %lu words\n", raw_host,
+		   FIELD_GET(VXD_RING_BASE, raw_host), FIELD_GET(VXD_RING_CAP, raw_host));
+	seq_printf(m, "to_host rd/wr    %#x/%#x\n",
+		   vxd_read(vxd, VXD_REG_TO_HOST_RD_INDEX),
+		   vxd_read(vxd, VXD_REG_TO_HOST_WR_INDEX));
+	rd = vxd_read(vxd, VXD_REG_TO_MTX_RD_INDEX);
+	wr = vxd_read(vxd, VXD_REG_TO_MTX_WR_INDEX);
+	seq_printf(m, "to_mtx  rd/wr    %#x/%#x", rd, wr);
+	if (ready && rd < to_mtx.cap && wr < to_mtx.cap)
+		seq_printf(m, " (free %u, %s)", vxd_ring_free(rd, wr, to_mtx.cap),
+			   rd == wr ? "all consumed" : "pending");
+	seq_puts(m, "\n");
+	seq_printf(m, "comms flags      %#x\n", vxd_read(vxd, VXD_REG_COMMS_FLAGS));
+	seq_printf(m, "irq status/enable %#x/%#x\n",
+		   vxd_read(vxd, VXD_REG_IRQ_STATUS),
+		   vxd_read(vxd, VXD_REG_IRQ_ENABLE));
+	seq_printf(m, "state            mbox_ready %d irq_armed %d irq_storm %d hw_ready %d fw_panicked %d init_seq %u fence_seq %#x\n",
+		   ready, vxd->irq_armed, vxd->irq_storm, vxd->hw_ready,
+		   vxd->fw_panicked, vxd->init_seq, vxd->fence_seq);
+	seq_printf(m, "stats            sent %u received %u irqs %u spurious %u completions %u unknown_fences %u faults %u contiguity %u panics %u unknown %u malformed %u last_irq_status %#x\n",
+		   st.sent, st.received, st.irqs, st.spurious, st.completions,
+		   st.unknown_fences, st.faults, st.contiguity, st.panics,
+		   st.unknown, st.malformed, st.last_irq_status);
+	for (i = 0; i < APPLE_VXD_NUM_FENCES; i++)
+		if (fences[i].state != APPLE_VXD_FENCE_FREE)
+			seq_printf(m, "fence[%u]         %s id %#x type %#x status %#x%s\n",
+				   i, vxd_fence_state_names[fences[i].state],
+				   fences[i].id, fences[i].type, fences[i].status,
+				   fences[i].error ? " error" : "");
+
+	if (ready) {
+		vxd_dump_ring(m, vxd, "TO_MTX", &to_mtx);
+		vxd_dump_ring(m, vxd, "TO_HOST", &to_host);
+	}
+
+	pm_runtime_put_autosuspend(vxd->dev);
+	return 0;
+}
+
+static int apple_vxd_regs_dump_show(struct seq_file *m, void *v)
+{
+	static const struct { const char *name; u32 off; } regs[] = {
+		{ "core id (0x630)",		VXD_REG_CORE_ID },
+		{ "core rev (0x640)",		VXD_REG_CORE_REV },
+		{ "vec cfg (0x200)",		VXD_REG_VECT_CFG },
+		{ "vec cfg2 (0x208)",		VXD_REG_VECT_CFG2 },
+		{ "entdec size (0x340)",	VXD_REG_ENTDEC_0_SIZE },
+		{ "entdec cfg (0x344)",		VXD_REG_ENTDEC_0_CFG },
+		{ "cmd ctrl (0x400)",		VXD_REG_CMD_CTRL },
+		{ "irq status (0x410)",		VXD_REG_IRQ_STATUS },
+		{ "irq clear (0x414)",		VXD_REG_IRQ_CLEAR },
+		{ "irq enable (0x418)",		VXD_REG_IRQ_ENABLE },
+		{ "man clk enable (0x440)",	VXD_REG_CR_PVDEC_MAN_CLK_ENABLE },
+		{ "mtx mem cfg (0x500)",	VXD_REG_MTX_MEM_CFG },
+		{ "dmac status (0x504)",	VXD_REG_DMAC_STATUS },
+		{ "mtx ctrl (0x1000)",		VXD_REG_MTX_CTRL },
+		{ "mtx clk (0x1008)",		VXD_REG_MTX_MAN_CLK_ENABLE },
+		{ "mmu 0 (0x1010)",		VXD_REG_MTX_MMU_0 },
+		{ "mmu dir (0x1020)",		VXD_REG_MTX_MMU_DIR_ADR },
+		{ "mmu mode (0x1070)",		VXD_REG_MTX_MMU_MODE },
+		{ "mmu cfg0 (0x1080)",		VXD_REG_MTX_MMU_CFG0 },
+		{ "mmu cfg1 (0x1084)",		VXD_REG_MTX_MMU_CFG1 },
+		{ "pipe 4004",			VXD_REG_PIPE_4004 },
+		{ "pipe ctrl (0x4020)",		VXD_REG_PIPE_CTRL },
+		{ "pipe cr0 (0x4060)",		VXD_REG_PIPE_CR0 },
+		{ "pipe cr1 (0x4068)",		VXD_REG_PIPE_CR1 },
+		{ "pipe cr2 (0x4070)",		VXD_REG_PIPE_CR2 },
+		{ "pipe cr3 (0x4078)",		VXD_REG_PIPE_CR3 },
+		{ "pipe status (0x40c0)",	VXD_REG_PIPE_STATUS },
+		{ "pipe status2 (0x40c4)",	VXD_REG_PIPE_STATUS_2 },
+		{ "boot fw adr (0x6a00)",	VXD_REG_MTX_BOOT_FW_ADR },
+		{ "boot 1 (0x6a04)",		VXD_REG_MTX_BOOT_1 },
+		{ "boot 2 (0x6a08)",		VXD_REG_MTX_BOOT_2 },
+		{ "boot 4 (0x6a14)",		VXD_REG_MTX_BOOT_4 },
+		{ "boot 5 (0x6a18)",		VXD_REG_MTX_BOOT_5 },
+	};
+	struct apple_vxd_dev *vxd = m->private;
+	unsigned int i;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(vxd->dev);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++)
+		seq_printf(m, "%-24s %#x\n", regs[i].name, vxd_read(vxd, regs[i].off));
+
+	pm_runtime_put_autosuspend(vxd->dev);
+	return 0;
+}
+
+DEFINE_SHOW_ATTRIBUTE(apple_vxd_mbox_dump);
+DEFINE_SHOW_ATTRIBUTE(apple_vxd_regs_dump);
+
+int apple_vxd_mbox_init(struct apple_vxd_dev *vxd)
+{
+	struct dentry *dir;
+
+	if (!IS_ENABLED(CONFIG_DEBUG_FS))
+		return 0;
+
+	dir = debugfs_create_dir(APPLE_VXD_DRV_NAME, NULL);
+	if (IS_ERR(dir))
+		return 0;	/* debugfs is optional for bring-up */
+
+	vxd->debugfs_dir = dir;
+	debugfs_create_file("mbox", 0444, dir, vxd, &apple_vxd_mbox_dump_fops);
+	debugfs_create_file("regs", 0444, dir, vxd, &apple_vxd_regs_dump_fops);
+	debugfs_create_file("boot", 0200, dir, vxd, &apple_vxd_boot_trigger_fops);
+	debugfs_create_file("ping", 0200, dir, vxd, &apple_vxd_ping_fops);
+	debugfs_create_file("consume_check", 0200, dir, vxd,
+			    &apple_vxd_consume_check_fops);
+	apple_vxd_cmdbufs_debugfs(vxd);
+	return 0;
+}
+
+void apple_vxd_mbox_fini(struct apple_vxd_dev *vxd)
+{
+	debugfs_remove_recursive(vxd->debugfs_dir);
+	vxd->debugfs_dir = NULL;
+}
+
+/* --- self-test: protocol arithmetic only, no MMIO ------------------------ */
+
+int apple_vxd_mbox_selftest(struct apple_vxd_dev *vxd)
+{
+	static const struct { u32 rd, wr, cap, free; } frees[] = {
+		{ 0, 0, 16, 15 }, { 5, 3, 16, 1 }, { 3, 5, 16, 13 },
+		{ 0, 15, 16, 0 }, { 7, 6, 16, 0 },
+	};
+	const struct apple_vxd_msg_ticket t = { .start = 14, .nwords = 4, .end = 2 };
+	u32 msg[VXD_INIT_MSG_WORDS];
+	const char *what;
+	unsigned int i;
+
+	what = "ring free-slot formula";
+	for (i = 0; i < ARRAY_SIZE(frees); i++)
+		if (vxd_ring_free(frees[i].rd, frees[i].wr, frees[i].cap) !=
+		    frees[i].free)
+			goto fail;
+
+	what = "ring wrap";
+	if (vxd_ring_next(15, 16) || vxd_ring_next(3, 16) != 4 ||
+	    vxd_ring_dist(14, 2, 16) != 4)
+		goto fail;
+
+	what = "consumption check";
+	if (vxd_ring_consumed(&t, 14, 2, 16) ||		/* untouched */
+	    vxd_ring_consumed(&t, 0, 2, 16) ||		/* half taken */
+	    vxd_ring_consumed(&t, 10, 2, 16) ||		/* older pending */
+	    !vxd_ring_consumed(&t, 2, 2, 16) ||		/* taken */
+	    !vxd_ring_consumed(&t, 4, 6, 16))		/* taken, more queued */
+		goto fail;
+
+	what = "message header";
+	if (apple_vxd_msg_hdr(0xabc0, VXD_MSG_NOP_FIRST, 2) != 0xabc08302 ||
+	    vxd_fence_id(0xabc, 1) != 0xabc2)
+		goto fail;
+
+	what = "init message";
+	apple_vxd_build_init_msg(msg, 0x12345000, 0x17e98, 0x1ff);
+	if (msg[0] != 0x8005 || msg[1] != 0x12345000 || msg[2] != 0xff0017 ||
+	    msg[3] != 0xffff0000 || msg[4])
+		goto fail;
+
+	what = "GART entry";
+	if (VXD_GART_PTE(0x803758000ULL) != 0x08037581 ||
+	    VXD_GART_PTE(0xfffffff000ULL) != 0xfffffff1)
+		goto fail;
+
+	return 0;
+
+fail:
+	dev_err(vxd->dev, "mailbox self-test FAILED at %s\n", what);
+	return -EINVAL;
+}
diff --git a/drivers/media/platform/apple/vxd/apple-vxd-regs.h b/drivers/media/platform/apple/vxd/apple-vxd-regs.h
new file mode 100644
index 0000000000000000000000000000000000000000..44dc742c2664521b50989fa25cd0e6f3c9bbad95
--- /dev/null
+++ b/drivers/media/platform/apple/vxd/apple-vxd-regs.h
@@ -0,0 +1,280 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Apple VXD (Imagination MSVDX, "PowerVR video decoder") register map
+ *
+ * Offsets recovered by mining the iOS 16.7.10 com.apple.driver.AppleD5500
+ * kext (iPad6,11 kernelcache, unslid virtual addresses); every offset below
+ * is reached through CPVDECCore::ReadReg/WriteReg in that kext. See
+ * docs/periph/ds-video-decoder.md. Names follow the public MSVDX layout used
+ * by Imagination-derived drivers; offset are facts, names are inferred.
+ */
+#ifndef __APPLE_VXD_REGS_H__
+#define __APPLE_VXD_REGS_H__
+
+#include <linux/bits.h>
+
+/* Core identification (CPVDECCore::GetCoreRev [E]) */
+#define VXD_REG_CORE_ID			0x0630
+#define  VXD_CORE_ID_MAJOR_SH		16
+#define  VXD_CORE_ID_ENT_PIPES		GENMASK(3, 0)
+#define  VXD_CORE_ID_PIX_PIPES		GENMASK(7, 4)
+#define VXD_REG_CORE_REV		0x0640
+
+/*
+ * Clock enables (CPVDECCore_Clocks.cpp SetClocks [E]).  Written with the
+ * default value first, read back for a sanity check, then written with the
+ * requested value.  A read-back mismatch means the core is not powered or
+ * not clocked ("Core register write differs from read").
+ */
+#define VXD_REG_CR_PVDEC_MAN_CLK_ENABLE	0x0440
+#define  VXD_CLK_ENABLE_DEFAULT		0x00000011
+#define  VXD_CLK_ENABLE_ALL		0xffffffff
+#define  VXD_CLK_ENABLE_FW		0x01010113
+
+/*
+ * MTX (META) block.  MTX_CTRL is read-modify-written with bits 0 and 16
+ * taken from core flags; MTX_MAN_CLK_ENABLE is written with bit 28 set and
+ * polled for equality during the boot sequence.
+ */
+#define VXD_REG_MTX_CTRL		0x1000
+#define  VXD_MTX_CTRL_KEEP_MASK		0xfffefffe
+#define VXD_REG_MTX_MAN_CLK_ENABLE	0x1008
+/*
+ * The same 0x1008 seen from the submit path: the kext writes 0xf00 there
+ * before a decode submit that follows a GART change (+0x27a0 rule,
+ * 0xfffffff00628af2c [E]).  In Imagination's BUS4 MMU layout (PVDEC,
+ * img-vxe-vxd) 0x1000 + 8 is MMU_CONTROL1 and bits 11:8 are MMU_INVALDC,
+ * one directory-cache invalidate per context [I].
+ */
+#define VXD_REG_MMU_CONTROL1		0x1008
+#define  VXD_MMU_INVALDC_ALL		0x00000f00
+#define  VXD_MTX_CLK_SEL		0x10000000
+#define VXD_REG_MTX_MMU_0		0x1010
+#define VXD_REG_MTX_MMU_DIR_ADR		0x1020
+#define VXD_REG_MTX_MMU_MODE		0x1070
+#define  VXD_MTX_MMU_MODE_40BIT		0x10
+#define VXD_REG_MTX_MMU_CFG0		0x1080
+#define  VXD_MTX_MMU_CFG0_40BIT		0x80	/* (cfg0 & 0xf0) == 0x80 */
+#define VXD_REG_MTX_MMU_CFG1		0x1084
+#define  VXD_MTX_MMU_CFG1_TILING_CTX	BIT(29)
+
+/*
+ * MTX boot block, programmed by LoadFirmwareAndStartCore [E].  BOOT_5 (7)
+ * enables the MTX clocks and must be written before the rest of the block;
+ * BOOT_1 is written twice (stage 0 then stage 1) to release the MTX from
+ * reset; BOOT_FW_ADR holds the low 32 bits of the firmware buffer address.
+ */
+#define VXD_REG_MTX_BOOT_FW_ADR		0x6a00
+#define VXD_REG_MTX_BOOT_1		0x6a04
+#define  VXD_MTX_BOOT_1_STAGE0		0x22000000
+#define  VXD_MTX_BOOT_1_STAGE1		0x22010000
+#define VXD_REG_MTX_BOOT_2		0x6a08
+#define  VXD_MTX_BOOT_2_VALUE		0x01000000
+#define VXD_REG_MTX_BOOT_3		0x6a0c
+#define VXD_REG_MTX_BOOT_4		0x6a14
+#define  VXD_MTX_BOOT_4_VALUE		0x00000350
+#define VXD_REG_MTX_BOOT_5		0x6a18
+#define  VXD_MTX_BOOT_5_ENABLE		0x7
+
+/* VEC block and entropy decoder pipes */
+#define VXD_REG_VECT_CFG		0x0200
+#define VXD_REG_VECT_CFG2		0x0208
+#define  VXD_VECT_CFG2_MSGS_MINUS1	0x000000c7	/* core[0xb4] - 1 */
+#define VXD_REG_ENTDEC_0_SIZE		0x0340
+#define VXD_REG_ENTDEC_0_CFG		0x0344
+
+/*
+ * MTX -> host "message consumed" word: the firmware stores the word count
+ * of the message it last took from TO_MTX here (fw 0x1000a90 [E]).
+ */
+#define VXD_REG_MTX_MSG_CONSUMED	0x0000
+
+/* Host -> MTX doorbell, written 1 after every message push [E]. */
+#define VXD_REG_MTX_DOORBELL		0x0088
+
+/*
+ * CMD block control.  The reset value 0xffff0000 is written before and
+ * after firmware load (known state v1/v2 [E]).
+ */
+#define VXD_REG_CMD_CTRL		0x0400
+#define  VXD_CMD_CTRL_RESET		0xffff0000
+
+/*
+ * Host interrupt: status / write-1-to-clear / enable.  The firmware raises
+ * bit 20 by writing it to 0x410 when it posts a TO_HOST message with the
+ * interrupt flag (fw 0x1000fe4 [E]); the kext ISR reads 0x410, clears with
+ * 0x414 = 0x100000 before draining (0xfffffff00629a0ac [E]).  Known state
+ * writes 0 to the enable and all-ones to the clear; boot enables bit 20.
+ */
+#define VXD_REG_IRQ_STATUS		0x0410
+#define VXD_REG_IRQ_CLEAR		0x0414
+#define VXD_REG_IRQ_ENABLE		0x0418
+#define  VXD_IRQ_FW_MSG			BIT(20)
+
+/* DMAC */
+#define VXD_REG_MTX_MEM_CFG		0x0500
+#define  VXD_MTX_MEM_BANK_COUNT		GENMASK(11, 8)
+#define  VXD_MTX_MEM_BANK_SIZE		GENMASK(19, 16)
+#define  VXD_MTX_MEM_LAST_BANK		GENMASK(27, 24)
+#define VXD_REG_DMAC_STATUS		0x0504
+#define  VXD_DMAC_STATUS_FLUSH		0x80000000
+
+/*
+ * Pipe select + per-pipe registers.  The block multiplexes several register
+ * banks behind CMD_KICK: writing the pipe index (1-based) there selects
+ * which pipe the 0x30xx/0x40xx banks talk to.
+ */
+#define VXD_REG_CMD_KICK		0x0460
+#define VXD_REG_PIPE_SET_0		0x3020
+#define VXD_REG_PIPE_SET_1		0x3030
+#define VXD_REG_PIPE_SET_2		0x3038
+#define VXD_REG_PIPE_4004		0x4004
+#define VXD_REG_PIPE_CTRL		0x4020
+#define VXD_REG_PIPE_CR0		0x4060
+#define VXD_REG_PIPE_CR1		0x4068
+#define VXD_REG_PIPE_CR2		0x4070
+#define VXD_REG_PIPE_CR3		0x4078
+#define VXD_REG_PIPE_STATUS		0x40c0
+#define VXD_REG_PIPE_STATUS_2		0x40c4
+
+/*
+ * Host<->MTX message rings (comms), docs/periph/ds-vxd-decode-protocol.md
+ * section 2.  The four indices are confirmed by the kext recovery path:
+ *   0x201c TO_HOST_RD_INDEX (host)   0x2020 TO_HOST_WR_INDEX (fw)
+ *   0x2028 TO_MTX_RD_INDEX  (fw)     0x2030 TO_MTX_WR_INDEX  (host)
+ * FW_READY_MAGIC is polled (0 = the kext clears it, 0xa5a5a5a5 = firmware
+ * alive).  After the magic the firmware has published each ring's geometry
+ * as (base_bytes << 16) | capacity_words: word i of a ring is the register
+ * at VXD_RING_WINDOW + base + 4 * i.  Rounds 1-3 called 0x2018/0x2024
+ * "build halves".
+ */
+#define VXD_REG_COMMS_STATE		0x2000
+#define VXD_REG_COMMS_2008		0x2008	/* cleared at ring setup [E] */
+#define VXD_REG_FW_PC			0x200c	/* fw stores its PC; host clears */
+#define VXD_REG_COMMS_MSG_COUNT		0x2010	/* fw->host messages posted */
+#define VXD_REG_FW_READY_MAGIC		0x2014
+#define  VXD_FW_READY_MAGIC		0xa5a5a5a5
+#define VXD_REG_TO_HOST_RING		0x2018
+#define VXD_REG_TO_HOST_RD_INDEX	0x201c
+#define VXD_REG_TO_HOST_WR_INDEX	0x2020
+#define VXD_REG_TO_MTX_RING		0x2024
+#define VXD_REG_TO_MTX_RD_INDEX		0x2028
+#define VXD_REG_COMMS_FLAGS		0x202c
+#define VXD_REG_TO_MTX_WR_INDEX		0x2030
+
+#define VXD_RING_WINDOW			0x2000
+#define  VXD_RING_BASE			GENMASK(31, 16)
+#define  VXD_RING_CAP			GENMASK(15, 0)
+
+/*
+ * Message header, both directions: (fence << 16) | (type << 8) | nwords,
+ * nwords counting the header.  The firmware drops TO_MTX messages longer
+ * than 0x14 words (fw 0x1000b80) and a zero-length header wedges its
+ * reader (fw 0x1000a4c: it re-publishes the same read index forever).
+ * The kext refuses TO_HOST messages of 0xf0 / 4 = 60 words or more.
+ */
+#define VXD_MSG_NWORDS			GENMASK(6, 0)
+#define VXD_MSG_TYPE			GENMASK(15, 8)
+#define VXD_MSG_FENCE			GENMASK(31, 16)
+#define VXD_MSG_TO_MTX_MAX_WORDS	0x14
+#define VXD_MSG_TO_HOST_MAX_WORDS	(0xf0 / 4 - 1)
+
+/*
+ * Host -> firmware types: the DEVA dispatcher (fw 0x1000ad4) handles
+ * 0x80..0x8b.  0x83..0x85 jump straight back to the reader loop: they are
+ * consumed and dropped, which makes them the benign ping.
+ */
+#define VXD_MSG_INIT			0x80
+#define VXD_MSG_DECODE			0x81
+#define VXD_MSG_NOP_FIRST		0x83
+#define VXD_MSG_NOP_LAST		0x85
+#define VXD_MSG_DEBLOCK			0x87
+#define VXD_MSG_RENDER_TARGET		0x88
+
+/* Firmware -> host types (ProcessFWMessages 0xfffffff006299bb4 [E]). */
+#define VXD_MSG_COMPLETION		0xc0
+#define VXD_MSG_CONTIGUITY		0xc6
+#define VXD_MSG_PANIC			0xc7
+
+/* 0xc0 word 2: fault class, "after core reset", REATTEMPT_SINGLEPIPE. */
+#define VXD_COMPLETION_FAULT		GENMASK(28, 27)
+#define VXD_COMPLETION_AFTER_RESET	BIT(28)
+#define VXD_COMPLETION_REATTEMPT	BIT(31)
+
+/* 0x80 init message (InitMessageBuffers 0xfffffff006298d40 [E]). */
+#define VXD_INIT_MSG_WORDS		5
+#define VXD_INIT_PAGES			GENMASK(15, 0)
+#define VXD_INIT_SEQ			GENMASK(23, 16)
+#define VXD_INIT_SENTINEL		0xffff0000
+
+/*
+ * Decode-family message w1 low-half flags (SubmitCommandBufferInternal
+ * 0xfffffff00628a8d4 [E]): last packet of a submission | interrupt the
+ * host on completion; more packets follow.
+ */
+#define VXD_MSG_FLAG_LAST		0x4004
+#define VXD_MSG_FLAG_MORE		0x2000
+
+/*
+ * MSVDX command stream (docs/periph/ds-vxd-cmdstream.md section 2, the
+ * emitters at 0xfffffff00629a34c..0xfffffff00629b15c [E]).  These words
+ * live in the GART-mapped command buffer and are read by the core's
+ * command processor, not by the DEVA firmware.
+ */
+#define VXD_CMD_REG_RUN			0x10000000	/* | count << 16 | reg */
+#define  VXD_CMD_REG_RUN_ONE		0x00010000	/* count += 1 */
+#define  VXD_CMD_REG_RUN_COUNT		GENMASK(27, 16)
+#define VXD_CMD_REG1			0x000f0000	/* | (flags & 0xf0) << 16 | reg */
+#define  VXD_CMD_REG1_FLAGS		GENMASK(7, 4)
+#define VXD_CMD_REG_ADDR		GENMASK(15, 0)
+#define VXD_CMD_SLICE_BLOCK		0x90000000	/* + 9 zero words */
+#define  VXD_CMD_SLICE_BLOCK_WORDS	10
+#define VXD_CMD_SLICE_DESC		0xb0000001	/* + 2 words */
+#define VXD_CMD_LOAD			0xa0000000	/* | bytes, + device address */
+#define  VXD_CMD_LOAD_MAX		GENMASK(27, 0)
+#define VXD_CMD_TABLE_XFER		0xf0000000	/* | bytes, + address, + dest */
+#define VXD_CMD_END_SLICE		0x60000000
+/*
+ * AVC additions (ds-vxd-cmdstream.md section 16.3-16.6; Imagination's
+ * DXVA control-allocation names from psb_video's dxva_fw_ctrl.h):
+ *   0x5 CMD_RENDEC_BLOCK  0x50000000 | flags | count << 16 | reg, values
+ *   0xe CMD_DMA           0xe0000000 | type | bytes, device address
+ *   0xb CMD_SR_SETUP flag 1 = ENABLE_RBDU_EXTRACTION (the core strips the
+ *                         emulation-prevention bytes itself)
+ */
+#define VXD_CMD_BLOCK			0x50000000
+#define  VXD_CMD_BLOCK_COUNT		GENMASK(26, 16)
+#define  VXD_CMD_BLOCK_FLAG_REFS	0x08000000	/* on the 0x7100 block */
+#define VXD_CMD_DMA			0xe0000000
+#define  VXD_CMD_DMA_BYTES		GENMASK(15, 0)
+#define  VXD_CMD_DMA_TYPE_VLC		0x00000000
+#define VXD_CMD_CHUNK_ALIGN		64		/* zero pad between slices */
+
+/*
+ * Host-side packet list (CmdBuf::addCommand 0xfffffff0062982f8 [E]):
+ * {magic0, payload bytes, magic1} + payload, back to back.  The submit
+ * path walks it from its base, checks both magics (0xfffffff00628ac78) and
+ * turns every packet into one mailbox message; the list itself never
+ * reaches the device.
+ */
+#define VXD_PKT_MAGIC0			0x80000007
+#define VXD_PKT_MAGIC1			0xabcdefab
+#define VXD_PKT_HDR_BYTES		12
+#define VXD_PKT_H264_PAYLOAD		0x78
+/* Payload offsets (header-relative offset - 0xc). */
+#define VXD_PKT_FLAGS			0x04	/* -> w1[15:0] */
+#define VXD_PKT_W4			0x08	/* -> w4 */
+#define VXD_PKT_CMD_BYTES		0x0c	/* -> w1[31:16] (>> 2, kind 4: >> 3) */
+#define VXD_PKT_W2			0x10	/* -> w2 */
+#define VXD_PKT_W5			0x24	/* -> w5 */
+#define VXD_PKT_W6			0x28	/* -> w6, 7-word messages only */
+#define VXD_PKT_KIND			0x4c
+#define  VXD_PKT_KIND_PICTURE		1	/* -> 0x81 */
+#define  VXD_PKT_KIND_DEBLOCK		3	/* -> 0x87 */
+#define  VXD_PKT_KIND_RENDER_TARGET	4	/* -> 0x88 */
+#define VXD_PKT_NOT_REF			0x50	/* AVC: host-side bookkeeping */
+#define VXD_DECODE_MSG_WORDS		6
+
+#define VXD_MMIO_SIZE			0x100000
+
+#endif /* __APPLE_VXD_REGS_H__ */
diff --git a/drivers/media/platform/apple/vxd/apple-vxd-v4l2.c b/drivers/media/platform/apple/vxd/apple-vxd-v4l2.c
new file mode 100644
index 0000000000000000000000000000000000000000..12ff4848f324cdddef90ff03daf908ca78a4f07b
--- /dev/null
+++ b/drivers/media/platform/apple/vxd/apple-vxd-v4l2.c
@@ -0,0 +1,1405 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Apple VXD - V4L2 stateless m2m device (R3/R4 skeleton)
+ *
+ * Structure follows the rkvdec stateless template: one /dev/video node,
+ * media controller entity, mplane m2m queues with the request API
+ * mandatory on the output queue, and the stateless H.264 control set.
+ * The hardware submission layer behind the H.264 backend refuses jobs
+ * until the command-stream generator (R3c) lands; that failure path is
+ * part of the bring-up contract (test plan T6).
+ *
+ * Round 3: every handler body takes the context, not the file, so the
+ * register-time self-test runs the same code as open(), the format ioctls
+ * and release() on a private context before the node is exposed.  Every
+ * V4L2 entry point announces itself with a flushed STEP line; nothing here
+ * touches state that only the firmware boot creates (the only consumer of
+ * hw_ready is the H.264 job path, which fails the job instead).
+ */
+#include <linux/pm_runtime.h>
+#include <linux/sched.h>
+
+#include <media/v4l2-event.h>
+#include <media/v4l2-ioctl.h>
+#include <media/videobuf2-dma-contig.h>
+
+#include "apple-vxd.h"
+
+/* Smallest bitstream buffer handed to userspace. */
+#define APPLE_VXD_MIN_BITSTREAM_SIZE	SZ_1M
+
+/*
+ * The VXD is not DMA-coherent, so coherent dma-contig buffers are mapped
+ * uncached for the CPU.  Every consumer that reads decoded pictures on the
+ * CPU (FFmpeg's hwframe download, GStreamer's videoconvert, Chromium's
+ * NV12->ARGB converter) then reads uncached memory.  capture_cached=1
+ * makes the CAPTURE queues of contexts opened afterwards allocate MMAP
+ * buffers non-coherent (cacheable): vb2 cleans them at QBUF and
+ * invalidates them at DQBUF, and userspace only reads a picture after
+ * DQBUF.  They stay physically contiguous, so the GART path is unchanged.
+ */
+static bool apple_vxd_capture_cached;
+module_param_named(capture_cached, apple_vxd_capture_cached, bool, 0644);
+MODULE_PARM_DESC(capture_cached,
+		 "cacheable MMAP CAPTURE buffers for contexts opened afterwards (vb2 syncs at QBUF/DQBUF)");
+
+static struct apple_vxd_ctx *file_to_vxd_ctx(struct file *file)
+{
+	return container_of(file_to_v4l2_fh(file), struct apple_vxd_ctx, fh);
+}
+
+static void apple_vxd_reset_fmt(struct apple_vxd_ctx *ctx,
+				struct v4l2_format *f, u32 fourcc)
+{
+	memset(f, 0, sizeof(*f));
+	f->fmt.pix_mp.pixelformat = fourcc;
+	f->fmt.pix_mp.field = V4L2_FIELD_NONE;
+	f->fmt.pix_mp.colorspace = V4L2_COLORSPACE_REC709;
+	f->fmt.pix_mp.ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	f->fmt.pix_mp.quantization = V4L2_QUANTIZATION_DEFAULT;
+	f->fmt.pix_mp.xfer_func = V4L2_XFER_FUNC_DEFAULT;
+}
+
+/*
+ * Every MSVDX surface base register (luma and chroma reconstruction,
+ * references) drops the low 12 bits, and the extended row stride counts
+ * 64-byte units.  With single-plane NV12 the chroma plane starts at
+ * bytesperline * height, so the luma stride is rounded up to 256 bytes:
+ * with the height a multiple of 16 that keeps the chroma plane 4 KiB
+ * aligned behind a page-aligned buffer.
+ */
+#define APPLE_VXD_NV12_STRIDE_ALIGN	256
+
+static void apple_vxd_fill_decoded_pixfmt(struct apple_vxd_ctx *ctx,
+					  struct v4l2_pix_format_mplane *pix_mp)
+{
+	struct v4l2_plane_pix_format *plane = &pix_mp->plane_fmt[0];
+
+	v4l2_fill_pixfmt_mp(pix_mp, pix_mp->pixelformat,
+			    pix_mp->width, pix_mp->height);
+	if (pix_mp->pixelformat == V4L2_PIX_FMT_NV12) {
+		plane->bytesperline = ALIGN(pix_mp->width,
+					    APPLE_VXD_NV12_STRIDE_ALIGN);
+		plane->sizeimage = plane->bytesperline * pix_mp->height * 3 / 2;
+	}
+}
+
+static const struct apple_vxd_decoded_fmt_desc *
+apple_vxd_find_decoded_fmt(const struct apple_vxd_coded_fmt_desc *desc,
+			   enum apple_vxd_image_fmt image_fmt)
+{
+	unsigned int i;
+
+	for (i = 0; i < desc->num_decoded_fmts; i++)
+		if (desc->decoded_fmts[i].image_fmt == image_fmt)
+			return &desc->decoded_fmts[i];
+
+	return NULL;
+}
+
+static u32 apple_vxd_enum_decoded_fmt(struct apple_vxd_ctx *ctx, int index,
+				      enum apple_vxd_image_fmt image_fmt)
+{
+	const struct apple_vxd_decoded_fmt_desc *dfmt;
+
+	if (image_fmt == APPLE_VXD_IMG_FMT_ANY)
+		image_fmt = APPLE_VXD_IMG_FMT_420_8BIT;
+	dfmt = apple_vxd_find_decoded_fmt(ctx->coded_fmt_desc, image_fmt);
+	if (dfmt && !index)
+		return dfmt->fourcc;
+	return 0;
+}
+
+static bool apple_vxd_is_valid_fmt(struct apple_vxd_ctx *ctx, u32 fourcc,
+				   enum apple_vxd_image_fmt image_fmt)
+{
+	return apple_vxd_enum_decoded_fmt(ctx, 0, image_fmt) == fourcc;
+}
+
+static const struct apple_vxd_coded_fmt_desc *
+apple_vxd_find_coded_fmt_desc(struct apple_vxd_ctx *ctx, u32 fourcc)
+{
+	struct apple_vxd_dev *vxd = ctx->vxd;
+	unsigned int i;
+
+	for (i = 0; i < vxd->num_coded_fmts; i++)
+		if (vxd->coded_fmts[i].fourcc == fourcc)
+			return &vxd->coded_fmts[i];
+	return NULL;
+}
+
+static void apple_vxd_reset_coded_fmt(struct apple_vxd_ctx *ctx)
+{
+	struct v4l2_format *f = &ctx->coded_fmt;
+
+	/* apple_vxd_ctx_init() checked vxd->coded_fmts before calling us. */
+	ctx->coded_fmt_desc = &ctx->vxd->coded_fmts[0];
+	apple_vxd_reset_fmt(ctx, f, ctx->coded_fmt_desc->fourcc);
+	f->type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+	f->fmt.pix_mp.width = ctx->coded_fmt_desc->frmsize.min_width;
+	f->fmt.pix_mp.height = ctx->coded_fmt_desc->frmsize.min_height;
+	/* Same normalization as TRY_FMT: one plane, a usable bitstream size. */
+	f->fmt.pix_mp.num_planes = 1;
+	f->fmt.pix_mp.plane_fmt[0].sizeimage = APPLE_VXD_MIN_BITSTREAM_SIZE;
+
+	if (ctx->coded_fmt_desc->ops->adjust_fmt)
+		ctx->coded_fmt_desc->ops->adjust_fmt(ctx, f);
+}
+
+static void apple_vxd_reset_decoded_fmt(struct apple_vxd_ctx *ctx)
+{
+	struct v4l2_format *f = &ctx->decoded_fmt;
+	u32 fourcc = apple_vxd_enum_decoded_fmt(ctx, 0, ctx->image_fmt);
+
+	apple_vxd_reset_fmt(ctx, f, fourcc);
+	f->type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+	f->fmt.pix_mp.width = ctx->coded_fmt.fmt.pix_mp.width;
+	f->fmt.pix_mp.height = ctx->coded_fmt.fmt.pix_mp.height;
+	apple_vxd_fill_decoded_pixfmt(ctx, &f->fmt.pix_mp);
+}
+
+static int apple_vxd_image_fmt_changed(struct apple_vxd_ctx *ctx,
+				       enum apple_vxd_image_fmt image_fmt)
+{
+	if (image_fmt == APPLE_VXD_IMG_FMT_ANY)
+		return ctx->image_fmt != image_fmt;
+
+	return apple_vxd_find_decoded_fmt(ctx->coded_fmt_desc, image_fmt) !=
+	       apple_vxd_find_decoded_fmt(ctx->coded_fmt_desc, ctx->image_fmt);
+}
+
+static int apple_vxd_try_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct apple_vxd_ctx *ctx =
+		container_of(ctrl->handler, struct apple_vxd_ctx, ctrl_hdl);
+	const struct apple_vxd_coded_fmt_desc *desc = ctx->coded_fmt_desc;
+
+	if (desc->ops->try_ctrl)
+		return desc->ops->try_ctrl(ctx, ctrl);
+	return 0;
+}
+
+/*
+ * Also runs from v4l2_ctrl_handler_setup() inside apple_vxd_ctx_init(), so
+ * the m2m context (and its queues) must exist before the controls do.
+ */
+static int apple_vxd_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct apple_vxd_ctx *ctx =
+		container_of(ctrl->handler, struct apple_vxd_ctx, ctrl_hdl);
+	const struct apple_vxd_coded_fmt_desc *desc = ctx->coded_fmt_desc;
+	enum apple_vxd_image_fmt image_fmt;
+	struct vb2_queue *vq;
+
+	if (!desc->ops->get_image_fmt)
+		return 0;
+
+	image_fmt = desc->ops->get_image_fmt(ctx, ctrl);
+	if (apple_vxd_image_fmt_changed(ctx, image_fmt)) {
+		vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx,
+				     V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+		if (vb2_is_busy(vq))
+			return -EBUSY;
+
+		ctx->image_fmt = image_fmt;
+		apple_vxd_reset_decoded_fmt(ctx);
+	}
+
+	return 0;
+}
+
+const struct v4l2_ctrl_ops apple_vxd_ctrl_ops = {
+	.try_ctrl = apple_vxd_try_ctrl,
+	.s_ctrl = apple_vxd_s_ctrl,
+};
+
+static int apple_vxd_add_ctrls(struct apple_vxd_ctx *ctx,
+			       const struct apple_vxd_ctrls *ctrls)
+{
+	unsigned int i;
+
+	for (i = 0; i < ctrls->num_ctrls; i++) {
+		v4l2_ctrl_new_custom(&ctx->ctrl_hdl, &ctrls->ctrls[i].cfg, ctx);
+		if (ctx->ctrl_hdl.error)
+			return ctx->ctrl_hdl.error;
+	}
+
+	return 0;
+}
+
+static int apple_vxd_init_ctrls(struct apple_vxd_ctx *ctx)
+{
+	struct apple_vxd_dev *vxd = ctx->vxd;
+	unsigned int i, nctrls = 0;
+	int ret;
+
+	for (i = 0; i < vxd->num_coded_fmts; i++)
+		nctrls += vxd->coded_fmts[i].ctrls->num_ctrls;
+
+	v4l2_ctrl_handler_init(&ctx->ctrl_hdl, nctrls);
+
+	for (i = 0; i < vxd->num_coded_fmts; i++) {
+		ret = apple_vxd_add_ctrls(ctx, vxd->coded_fmts[i].ctrls);
+		if (ret)
+			goto err_free_handler;
+	}
+
+	ret = v4l2_ctrl_handler_setup(&ctx->ctrl_hdl);
+	if (ret)
+		goto err_free_handler;
+
+	ctx->fh.ctrl_handler = &ctx->ctrl_hdl;
+	return 0;
+
+err_free_handler:
+	v4l2_ctrl_handler_free(&ctx->ctrl_hdl);
+	return ret;
+}
+
+/* --- handler bodies (context based; shared with the self-test) --------- */
+
+static int apple_vxd_do_enum_framesizes(struct apple_vxd_ctx *ctx,
+					struct v4l2_frmsizeenum *fsize)
+{
+	const struct apple_vxd_coded_fmt_desc *desc;
+
+	if (fsize->index != 0)
+		return -EINVAL;
+
+	desc = apple_vxd_find_coded_fmt_desc(ctx, fsize->pixel_format);
+	if (!desc)
+		return -EINVAL;
+
+	fsize->type = V4L2_FRMSIZE_TYPE_CONTINUOUS;
+	fsize->stepwise.min_width = 1;
+	fsize->stepwise.max_width = desc->frmsize.max_width;
+	fsize->stepwise.step_width = 1;
+	fsize->stepwise.min_height = 1;
+	fsize->stepwise.max_height = desc->frmsize.max_height;
+	fsize->stepwise.step_height = 1;
+
+	return 0;
+}
+
+/*
+ * The V4L2 core fills device_caps, capabilities and bus_info (from the
+ * node's parent device, "platform:207f00000.vxd", matching the media
+ * device's default) before calling the driver.
+ */
+static void apple_vxd_fill_querycap(struct apple_vxd_dev *vxd,
+				    struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, APPLE_VXD_DRV_NAME, sizeof(cap->driver));
+	strscpy(cap->card, APPLE_VXD_DRV_NAME, sizeof(cap->card));
+}
+
+static int apple_vxd_do_try_capture_fmt(struct apple_vxd_ctx *ctx,
+					struct v4l2_format *f)
+{
+	struct v4l2_pix_format_mplane *pix_mp = &f->fmt.pix_mp;
+	const struct apple_vxd_coded_fmt_desc *coded_desc = ctx->coded_fmt_desc;
+
+	if (!apple_vxd_is_valid_fmt(ctx, pix_mp->pixelformat, ctx->image_fmt))
+		pix_mp->pixelformat =
+			apple_vxd_enum_decoded_fmt(ctx, 0, ctx->image_fmt);
+
+	/* Always apply the frmsize constraint of the coded end. */
+	pix_mp->width = max(pix_mp->width, ctx->coded_fmt.fmt.pix_mp.width);
+	pix_mp->height = max(pix_mp->height, ctx->coded_fmt.fmt.pix_mp.height);
+	v4l2_apply_frmsize_constraints(&pix_mp->width, &pix_mp->height,
+				       &coded_desc->frmsize);
+
+	apple_vxd_fill_decoded_pixfmt(ctx, pix_mp);
+	pix_mp->field = V4L2_FIELD_NONE;
+
+	return 0;
+}
+
+static int apple_vxd_do_try_output_fmt(struct apple_vxd_ctx *ctx,
+				       struct v4l2_format *f)
+{
+	struct v4l2_pix_format_mplane *pix_mp = &f->fmt.pix_mp;
+	const struct apple_vxd_coded_fmt_desc *desc;
+
+	desc = apple_vxd_find_coded_fmt_desc(ctx, pix_mp->pixelformat);
+	if (!desc) {
+		desc = &ctx->vxd->coded_fmts[0];
+		pix_mp->pixelformat = desc->fourcc;
+	}
+
+	v4l2_apply_frmsize_constraints(&pix_mp->width, &pix_mp->height,
+				       &desc->frmsize);
+
+	pix_mp->field = V4L2_FIELD_NONE;
+	/* All coded formats are considered single planar for now. */
+	pix_mp->num_planes = 1;
+
+	if (desc->ops->adjust_fmt) {
+		int ret;
+
+		ret = desc->ops->adjust_fmt(ctx, f);
+		if (ret)
+			return ret;
+	}
+
+	/*
+	 * One access unit per buffer (frame-based decode): one byte per
+	 * pixel covers a level 4.2 1080p intra picture (about 2 MiB),
+	 * userspace such as GStreamer leaves sizeimage to the driver.
+	 */
+	pix_mp->plane_fmt[0].sizeimage =
+		max3(pix_mp->plane_fmt[0].sizeimage,
+		     (u32)APPLE_VXD_MIN_BITSTREAM_SIZE,
+		     (u32)PAGE_ALIGN(pix_mp->width * pix_mp->height));
+	return 0;
+}
+
+static int apple_vxd_do_s_capture_fmt(struct apple_vxd_ctx *ctx,
+				      struct v4l2_format *f)
+{
+	struct vb2_queue *vq;
+	int ret;
+
+	/* Change not allowed if queue is busy */
+	vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx,
+			     V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+	if (vb2_is_busy(vq))
+		return -EBUSY;
+
+	ret = apple_vxd_do_try_capture_fmt(ctx, f);
+	if (ret)
+		return ret;
+
+	ctx->decoded_fmt = *f;
+	return 0;
+}
+
+static int apple_vxd_do_s_output_fmt(struct apple_vxd_ctx *ctx,
+				     struct v4l2_format *f)
+{
+	struct v4l2_m2m_ctx *m2m_ctx = ctx->fh.m2m_ctx;
+	const struct apple_vxd_coded_fmt_desc *desc;
+	struct v4l2_format *cap_fmt;
+	struct vb2_queue *peer_vq, *vq;
+	int ret;
+
+	/*
+	 * The iOS parser is one-stream-configuration-per-instance ("SPS
+	 * changes not supported!"); resolution changes only within the
+	 * same pixelformat.  Never while streaming.
+	 */
+	vq = v4l2_m2m_get_vq(m2m_ctx, V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
+	if (vb2_is_streaming(vq) ||
+	    (vb2_is_busy(vq) &&
+	     f->fmt.pix_mp.pixelformat != ctx->coded_fmt.fmt.pix_mp.pixelformat))
+		return -EBUSY;
+
+	peer_vq = v4l2_m2m_get_vq(m2m_ctx, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+	if (vb2_is_busy(peer_vq))
+		return -EBUSY;
+
+	ret = apple_vxd_do_try_output_fmt(ctx, f);
+	if (ret)
+		return ret;
+
+	desc = apple_vxd_find_coded_fmt_desc(ctx, f->fmt.pix_mp.pixelformat);
+	if (!desc)
+		return -EINVAL;
+	ctx->coded_fmt_desc = desc;
+	ctx->coded_fmt = *f;
+
+	/*
+	 * Reset the decoded format; the user is mandated to set it again
+	 * after we return.
+	 */
+	ctx->image_fmt = APPLE_VXD_IMG_FMT_ANY;
+	apple_vxd_reset_decoded_fmt(ctx);
+
+	/* Propagate colorspace information to capture. */
+	cap_fmt = &ctx->decoded_fmt;
+	cap_fmt->fmt.pix_mp.colorspace = f->fmt.pix_mp.colorspace;
+	cap_fmt->fmt.pix_mp.xfer_func = f->fmt.pix_mp.xfer_func;
+	cap_fmt->fmt.pix_mp.ycbcr_enc = f->fmt.pix_mp.ycbcr_enc;
+	cap_fmt->fmt.pix_mp.quantization = f->fmt.pix_mp.quantization;
+
+	return 0;
+}
+
+static int apple_vxd_do_enum_output_fmt(struct apple_vxd_ctx *ctx,
+					struct v4l2_fmtdesc *f)
+{
+	if (f->index >= ctx->vxd->num_coded_fmts)
+		return -EINVAL;
+	f->pixelformat = ctx->vxd->coded_fmts[f->index].fourcc;
+	return 0;
+}
+
+static int apple_vxd_do_enum_capture_fmt(struct apple_vxd_ctx *ctx,
+					 struct v4l2_fmtdesc *f)
+{
+	u32 fourcc;
+
+	fourcc = apple_vxd_enum_decoded_fmt(ctx, f->index, ctx->image_fmt);
+	if (!fourcc)
+		return -EINVAL;
+	f->pixelformat = fourcc;
+	return 0;
+}
+
+/* --- ioctl entry points ------------------------------------------------ */
+
+/*
+ * Driver-side STEP lines: the ioctl-entry line (apple_vxd_ioctl) names the
+ * command before the V4L2 core runs; these name the driver handler, so a
+ * crash between the two is in core code.
+ */
+static void apple_vxd_step_handler(struct file *file, const char *what)
+{
+	struct apple_vxd_dev *vxd = video_drvdata(file);
+
+	vxd_step_io(vxd->dev, "handler: %s", what);
+}
+
+/*
+ * Only a cached CAPTURE queue has allow_cache_hints set (queue_init); ask
+ * vb2 for non-coherent memory on it whatever the application passed.
+ */
+static bool apple_vxd_cached_queue(struct file *file, u32 type, u32 memory)
+{
+	struct vb2_queue *vq = v4l2_m2m_get_vq(file_to_vxd_ctx(file)->fh.m2m_ctx,
+					       type);
+
+	return vq->allow_cache_hints && memory == V4L2_MEMORY_MMAP;
+}
+
+static int apple_vxd_reqbufs(struct file *file, void *priv,
+			     struct v4l2_requestbuffers *rb)
+{
+	if (apple_vxd_cached_queue(file, rb->type, rb->memory))
+		rb->flags |= V4L2_MEMORY_FLAG_NON_COHERENT;
+	return v4l2_m2m_ioctl_reqbufs(file, priv, rb);
+}
+
+static int apple_vxd_create_bufs(struct file *file, void *priv,
+				 struct v4l2_create_buffers *create)
+{
+	if (apple_vxd_cached_queue(file, create->format.type, create->memory))
+		create->flags |= V4L2_MEMORY_FLAG_NON_COHERENT;
+	return v4l2_m2m_ioctl_create_bufs(file, priv, create);
+}
+
+static int apple_vxd_enum_framesizes(struct file *file, void *priv,
+				     struct v4l2_frmsizeenum *fsize)
+{
+	apple_vxd_step_handler(file, "enum_framesizes");
+	return apple_vxd_do_enum_framesizes(file_to_vxd_ctx(file), fsize);
+}
+
+static int apple_vxd_querycap(struct file *file, void *priv,
+			      struct v4l2_capability *cap)
+{
+	apple_vxd_step_handler(file, "querycap");
+	apple_vxd_fill_querycap(video_drvdata(file), cap);
+	return 0;
+}
+
+static int apple_vxd_try_capture_fmt(struct file *file, void *priv,
+				     struct v4l2_format *f)
+{
+	apple_vxd_step_handler(file, "try_fmt capture");
+	return apple_vxd_do_try_capture_fmt(file_to_vxd_ctx(file), f);
+}
+
+static int apple_vxd_try_output_fmt(struct file *file, void *priv,
+				    struct v4l2_format *f)
+{
+	apple_vxd_step_handler(file, "try_fmt output");
+	return apple_vxd_do_try_output_fmt(file_to_vxd_ctx(file), f);
+}
+
+static int apple_vxd_s_capture_fmt(struct file *file, void *priv,
+				   struct v4l2_format *f)
+{
+	apple_vxd_step_handler(file, "s_fmt capture");
+	return apple_vxd_do_s_capture_fmt(file_to_vxd_ctx(file), f);
+}
+
+static int apple_vxd_s_output_fmt(struct file *file, void *priv,
+				  struct v4l2_format *f)
+{
+	apple_vxd_step_handler(file, "s_fmt output");
+	return apple_vxd_do_s_output_fmt(file_to_vxd_ctx(file), f);
+}
+
+static int apple_vxd_g_output_fmt(struct file *file, void *priv,
+				  struct v4l2_format *f)
+{
+	apple_vxd_step_handler(file, "g_fmt output");
+	*f = file_to_vxd_ctx(file)->coded_fmt;
+	return 0;
+}
+
+static int apple_vxd_g_capture_fmt(struct file *file, void *priv,
+				   struct v4l2_format *f)
+{
+	apple_vxd_step_handler(file, "g_fmt capture");
+	*f = file_to_vxd_ctx(file)->decoded_fmt;
+	return 0;
+}
+
+static int apple_vxd_enum_output_fmt(struct file *file, void *priv,
+				     struct v4l2_fmtdesc *f)
+{
+	apple_vxd_step_handler(file, "enum_fmt output");
+	return apple_vxd_do_enum_output_fmt(file_to_vxd_ctx(file), f);
+}
+
+static int apple_vxd_enum_capture_fmt(struct file *file, void *priv,
+				      struct v4l2_fmtdesc *f)
+{
+	apple_vxd_step_handler(file, "enum_fmt capture");
+	return apple_vxd_do_enum_capture_fmt(file_to_vxd_ctx(file), f);
+}
+
+static const struct v4l2_ioctl_ops apple_vxd_ioctl_ops = {
+	.vidioc_querycap = apple_vxd_querycap,
+	.vidioc_enum_framesizes = apple_vxd_enum_framesizes,
+
+	.vidioc_try_fmt_vid_cap_mplane = apple_vxd_try_capture_fmt,
+	.vidioc_try_fmt_vid_out_mplane = apple_vxd_try_output_fmt,
