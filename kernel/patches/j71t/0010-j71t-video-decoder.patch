+	for (i = 0; i < ARRAY_SIZE(apple_vxd_ioctl_names); i++)
+		if (apple_vxd_ioctl_names[i].cmd == cmd)
+			return apple_vxd_ioctl_names[i].name;
+	return "unknown";
+}
