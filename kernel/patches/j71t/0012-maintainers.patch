From 4dfc90dd91f4e902e9e9405ad7db92a8ee069011 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Tue, 27 Oct 2026 15:47:02 +0000
Subject: [PATCH 12/12] MAINTAINERS: add the T8010/S8003 PCIe and ANS files
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

List the Apple PCIe host and ANS NVMe files.

From the release 2 kernel of the iPad 5 port
(https://github.com/brkosebay/omarchy-ipad5), filtered for OrchardLinux.

Signed-off-by: Berkay Kösebay <brkosebay@users.noreply.github.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 MAINTAINERS | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/MAINTAINERS b/MAINTAINERS
index 7cb94e3bd9b15b3ced63fa1f5b0320e67c713808..ade85b570526e5fc0d7b3dcdcdda7e1cc2d3618f 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -2652,6 +2652,7 @@ F:	Documentation/devicetree/bindings/nvmem/apple,efuses.yaml
 F:	Documentation/devicetree/bindings/nvmem/apple,pmic-nvmem.yaml
 F:	Documentation/devicetree/bindings/nvmem/apple,spmi-nvmem.yaml
 F:	Documentation/devicetree/bindings/pci/apple,pcie.yaml
+F:	Documentation/devicetree/bindings/pci/apple,t8010-pcie.yaml
 F:	Documentation/devicetree/bindings/phy/apple,atcphy.yaml
 F:	Documentation/devicetree/bindings/pinctrl/apple,pinctrl.yaml
 F:	Documentation/devicetree/bindings/power/apple*
@@ -2684,9 +2685,12 @@ F:	drivers/irqchip/irq-apple-aic.c
 F:	drivers/mfd/macsmc.c
 F:      drivers/mfd/simple-mfd-spmi.c
 F:	drivers/nvme/host/apple.c
+F:	drivers/nvme/host/pci-apple-ans.c
+F:	drivers/nvme/host/pci-internal.h
 F:	drivers/nvmem/apple-efuses.c
 F:	drivers/nvmem/apple-spmi-nvmem.c
 F:      drivers/nvmem/simple-mfd-nvmem.c
+F:	drivers/pci/controller/pcie-apple-h9p.c
 F:	drivers/phy/apple/
 F:	drivers/pinctrl/pinctrl-apple-gpio.c
 F:	drivers/power/reset/macsmc-reboot.c
@@ -2702,11 +2706,24 @@ F:	drivers/video/backlight/apple_dwi_bl.c
 F:	drivers/video/backlight/apple_pmic_bl.c
 F:	drivers/watchdog/apple_wdt.c
 F:	include/dt-bindings/interrupt-controller/apple-aic.h
+F:	include/linux/apple-ans.h
 F:	include/dt-bindings/pinctrl/apple.h
 F:	include/linux/mfd/macsmc.h
 F:	include/linux/soc/apple/*
 F:	include/uapi/drm/asahi_drm.h
 
+APPLE T8010 PCIE AND ANS SUPPORT
+M:	Paul Praschl <praschlpaul@g-p.at>
+L:	asahi@lists.linux.dev
+L:	linux-nvme@lists.infradead.org
+L:	linux-pci@vger.kernel.org
+S:	Maintained
+F:	Documentation/devicetree/bindings/pci/apple,t8010-pcie.yaml
+F:	drivers/nvme/host/pci-apple-ans.c
+F:	drivers/nvme/host/pci-internal.h
+F:	drivers/pci/controller/pcie-apple-h9p.c
+F:	include/linux/apple-ans.h
+
 ARM/ARTPEC MACHINE SUPPORT
 M:	Jesper Nilsson <jesper.nilsson@axis.com>
 M:	Lars Persson <lars.persson@axis.com>
