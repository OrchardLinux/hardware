+static int bq27xxx_cached_value(const struct bq27xxx_cached_value *cached,
+				union power_supply_propval *val)
+{
+	if (cached->error)
+		return cached->error;
+
+	val->intval = cached->value;
+	return 0;
+}
+
+/*
+ * Optional measurements must not abort a uevent or attribute walk when the
+ * cache holds no sample for them.
+ */
+static int bq27xxx_cached_optional_value(const struct bq27xxx_cached_value *cached,
+					 union power_supply_propval *val)
+{
+	return bq27xxx_cached_value(cached, val) ? -ENODATA : 0;
+}
+
+static int bq27xxx_battery_get_cached_property(struct power_supply *psy,
+					       struct bq27xxx_device_info *di,
+					       enum power_supply_property psp,
+					       union power_supply_propval *val)
+{
+	int ret;
+
+	mutex_lock(&di->lock);
+	/* Presence is also unknown until the first complete safety sample. */
+	if (!di->cache_ready) {
+		ret = -ENODATA;
+		goto out_unlock;
+	}
+	if (psp != POWER_SUPPLY_PROP_PRESENT && di->cache.flags < 0) {
+		ret = di->cache.flags;
+		goto out_unlock;
+	}
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_STATUS:
+		ret = bq27xxx_cached_value(&di->cache.status, val);
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		ret = bq27xxx_cached_value(&di->cache.voltage, val);
+		break;
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = di->cache.flags < 0 ? 0 : 1;
+		ret = 0;
+		break;
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		ret = bq27xxx_cached_value(&di->cache.current_now, val);
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		ret = bq27xxx_simple_value(di->cache.capacity, val);
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY_LEVEL:
+		ret = bq27xxx_battery_capacity_level(di, val);
+		break;
+	case POWER_SUPPLY_PROP_TIME_TO_EMPTY_NOW:
+		ret = bq27xxx_cached_optional_value(&di->cache.time_to_empty_now, val);
+		break;
+	case POWER_SUPPLY_PROP_TEMP:
+		ret = bq27xxx_cached_value(&di->cache.temperature, val);
+		break;
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		if (di->opts & BQ27XXX_O_MUL_CHEM)
+			val->intval = POWER_SUPPLY_TECHNOLOGY_UNKNOWN;
+		else
+			val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		ret = 0;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_NOW:
+		ret = bq27xxx_cached_optional_value(&di->cache.charge_now, val);
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_FULL:
+		ret = bq27xxx_cached_optional_value(&di->cache.charge_full, val);
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
+		ret = power_supply_battery_info_get_prop(psy->battery_info,
+							 psp, val);
+		break;
+	case POWER_SUPPLY_PROP_CYCLE_COUNT:
+		ret = bq27xxx_cached_optional_value(&di->cache.cycle_count, val);
+		break;
+	case POWER_SUPPLY_PROP_POWER_AVG:
+		ret = bq27xxx_cached_optional_value(&di->cache.power_avg, val);
+		break;
+	case POWER_SUPPLY_PROP_HEALTH:
+		ret = bq27xxx_battery_read_health(di, val);
+		break;
+	case POWER_SUPPLY_PROP_MANUFACTURER:
+		val->strval = BQ27XXX_MANUFACTURER;
+		ret = 0;
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+out_unlock:
+	mutex_unlock(&di->lock);
+	return ret;
+}
