+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/gpio/apple,d2365-pmic-gpio.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple D2365 PMIC GPIO controller
+
+maintainers:
+  - Paul Praschl <praschlpaul@g-p.at>
+
+description: |
+  The Dialog D2365 PMIC used in Apple A9/A10 devices provides 24 GPIOs. The
+  controller is accessed through the regmap exported by the parent Apple I2C
+  PMIC device.
+
+properties:
+  compatible:
+    const: apple,d2365-pmic-gpio
+
+  gpio-controller: true
+
+  "#gpio-cells":
+    const: 2
+
+  gpio-reserved-ranges:
+    minItems: 1
+    maxItems: 12
+
+  apple,enable-hall-irqs:
+    type: boolean
+    description: |
+      Serve the GPIO events of lines 0 and 10 (PMIC events 0x30 and 0x3a,
+      the iPad 5 Smart Cover hall sensors) through the interrupt domain of
+      the parent PMIC, which must then describe its AP interrupt and be an
+      interrupt controller. The line function and edge configuration left by
+      the boot firmware are used as they are. Without this property the
+      driver never reads the event or writes the interrupt mask registers.
+
+required:
+  - compatible
+  - gpio-controller
+  - "#gpio-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    pmic {
+        #address-cells = <1>;
+        #size-cells = <1>;
+
+        gpio {
+            compatible = "apple,d2365-pmic-gpio";
+            #gpio-cells = <2>;
+            gpio-controller;
+        };
+    };
+...
