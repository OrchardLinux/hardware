+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/apple,d2365-charger.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple D2365 PMIC charger
+
+maintainers:
+  - Paul Praschl <praschlpaul@g-p.at>
+
+description: |
+  The Apple D2365 PMIC contains power-source status and charger-control banks.
+  The J172 variant uses a platform-calibrated, guarded input-current policy.
+  J71t has an explicitly armed policy for a verified USB source, requiring
+  private input-current calibration and live Tristar source presence.
+
+properties:
+  compatible:
+    oneOf:
+      - const: apple,d2365-charger
+      - const: apple,j71t-d2365-charger
+      - items:
+          - const: apple,j172-d2365-charger
+          - const: apple,d2365-charger
+
+  reg:
+    items:
+      - description: Charger status register bank.
+      - description: Charger control register bank.
+
+  reg-names:
+    items:
+      - const: status
+      - const: control
+
+  power-supplies:
+    maxItems: 1
+
+  apple,usb-input-limit-max-microamp:
+    description: Board input ceiling, from the ADT usb-input-limit-max value.
+    enum: [500000, 1000000, 2100000, 2400000]
+    default: 500000
+
+  apple,owner-input-limit-microamp:
+    description: |
+      Owner-authorized input ceiling for this development unit's USB host.
+      Requires an enumerated host or a detected brick and valid CBAT codes;
+      the board ceiling still applies. Omission leaves source-based policy.
+    enum: [500000, 1000000, 2100000, 2400000]
+
+required:
+  - compatible
+  - reg
+  - reg-names
+
+allOf:
+  - $ref: power-supply.yaml#
+  - required:
+      - power-supplies
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        usb_power: usb-power@13 {
+            compatible = "apple,bellatrix";
+            reg = <0x13>;
+        };
+    };
+
+    pmic {
+        #address-cells = <1>;
+        #size-cells = <1>;
+
+        charger@180 {
+            compatible = "apple,d2365-charger";
+            reg = <0x180 0x1e>, <0xa00 0x0d>;
+            reg-names = "status", "control";
+            power-supplies = <&usb_power>;
+        };
+    };
