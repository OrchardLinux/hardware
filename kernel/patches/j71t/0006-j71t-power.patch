+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/apple,j71t-cbtl1610-power.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple J71t CBTL1610 USB source detection
+
+maintainers:
+  - linux-a9 <linux-a9@localhost>
+
+description: |
+  VBUS presence, Apple USB host allowances and bounded analog charger
+  signature detection for the CBTL1610 revision used by J71t. Temporary
+  data-pin monitoring restores the saved route after each measurement.
+
+properties:
+  compatible:
+    const: apple,j71t-cbtl1610-power
+
+  reg:
+    maxItems: 1
+
+  usb-controller:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: USB device controller reporting host current allowances.
+
+  apple,usb-role-switch:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: |
+      Shared Lightning USB role switch. With this link, analog charger
+      classification is disabled to avoid rerouting host data pins, and
+      host mode reports no input current allowance.
+
+  apple,pmic:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: D2365 PMIC providing the brick-ID ADC input.
+
+required:
+  - compatible
+  - reg
+  - usb-controller
+  - apple,pmic
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+        power-controller@1a {
+            compatible = "apple,j71t-cbtl1610-power";
+            reg = <0x1a>;
+            usb-controller = <&usbdev>;
+            apple,pmic = <&pmic>;
+        };
+    };
