--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -334,6 +334,47 @@ config BATTERY_BQ27XXX_HDQ
 	  Say Y here to enable support for batteries with BQ27xxx chips
 	  connected over an HDQ bus.
 
+config APPLE_BELLATRIX_POWER
+	tristate "Apple Bellatrix USB power status"
+	depends on I2C
+	help
+	  Say Y here to enable read-only USB input presence reporting for the
+	  Apple Bellatrix power controller found in some T8010 devices.
+
+	  USB input presence is polled and cached so power supply consumers do not
+	  access the I2C bus directly. This driver intentionally does not control
+	  charging, input current, ADC conversion, power roles, or interrupts.
+
+	  This driver can also be built as a module. If so, the module will be
+	  called apple_bellatrix_power.
+
+config APPLE_D2365_CHARGER
+	tristate "Apple D2365 charger status"
+	depends on MFD_SIMPLE_MFD_I2C
+	depends on USB_GADGET || !USB_GADGET
+	depends on USB_ROLES_APPLE_S8000 || !USB_ROLES_APPLE_S8000
+	help
+	  Say Y here to enable charger status reporting and the guarded input-current
+	  policy for the Apple D2365 PMIC found in some T8010 devices.
+
+	  The policy raises the input-current budget only while external power and
+	  safe battery conditions are present, and leaves charge termination to the
+	  PMIC. It does not configure charge current, charge voltage, or interrupts.
+
+	  J71t also provides CBTL1610 source detection and an automatic
+	  current policy using verified Apple USB host grants and resistor
+	  signatures, with a conservative ordinary USB fallback. It requires
+	  private CBAT calibration and safe battery telemetry, preserves the
+	  handoff settings, and restores them on disconnect, suspend or error.
+
+	  On J71t the CBTL1610 driver also identifies Lightning accessories
+	  over the ID bus. For the camera adapter it runs the power handshake
+	  and makes the port a USB host, as iOS does, while charging from the
+	  adapter continues.
+
+	  The modules are apple_d2365_charger, apple_j71t_charger and
+	  apple_tristar_power.
+
 config BATTERY_BQ27XXX_DT_UPDATES_NVM
 	bool "BQ27xxx support for update of NVM/flash data memory"
 	depends on BATTERY_BQ27XXX_I2C
