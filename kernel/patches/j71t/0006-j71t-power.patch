+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/apple,bellatrix.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple Bellatrix USB power controller
+
+maintainers:
+  - Paul Praschl <praschlpaul@g-p.at>
+
+description: |
+  Bellatrix is an I2C power and accessory controller used in some Apple
+  T8010 devices. The Linux driver reports cached USB input presence without
+  changing charging, ADC, power-role, or interrupt configuration.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: apple,bellatrix
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        usb-power@13 {
+            compatible = "apple,bellatrix";
+            reg = <0x13>;
+            interrupts = <13 IRQ_TYPE_LEVEL_LOW>;
+        };
+    };
