+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/thermal/apple,s8003-thermal.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple S8003 die temperature sensors
+
+maintainers:
+  - linux-a9 <linux-a9@localhost>
+
+description: |
+  Three PMGR SOC and three ACC TCC sensors. Sensor IDs 0 through 2 select
+  SOC0 through SOC2; IDs 3 through 5 select TCC0 through TCC2. Calibration
+  is performed in hardware using the boot-programmed per-chip trim. The
+  driver preserves trim, alarm registers and hardware SoCHOT thresholds.
+
+allOf:
+  - $ref: thermal-sensor.yaml#
+
+properties:
+  compatible:
+    const: apple,s8003-thermal
+  reg:
+    maxItems: 2
+  reg-names:
+    items:
+      - const: soc
+      - const: tcc
+  '#thermal-sensor-cells':
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - '#thermal-sensor-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    / {
+        #address-cells = <2>;
+        #size-cells = <2>;
+        thermal-sensor@20e0c0000 {
+            compatible = "apple,s8003-thermal";
+            reg = <0x2 0x0e0c0000 0x0 0x1000>,
+                  <0x2 0x02230000 0x0 0x1000>;
+            reg-names = "soc", "tcc";
+            #thermal-sensor-cells = <1>;
+        };
+    };
