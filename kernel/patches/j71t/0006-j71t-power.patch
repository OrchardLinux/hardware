diff --git a/drivers/power/supply/apple_bellatrix_power.c b/drivers/power/supply/apple_bellatrix_power.c
new file mode 100644
index 0000000000000000000000000000000000000000..0537cf8f91cddbfef73851ec94a54de9357c298e
--- /dev/null
+++ b/drivers/power/supply/apple_bellatrix_power.c
@@ -0,0 +1,273 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Read-only USB power status for the Apple Bellatrix controller
+ */
+
+#include <linux/bits.h>
+#include <linux/devm-helpers.h>
+#include <linux/err.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/power_supply.h>
+
+#define BELLATRIX_VBUS_STATUS		0x16
+#define BELLATRIX_VBUS_EXT_VBUS	BIT(1)
+#define BELLATRIX_STATUS2		0x17
+#define BELLATRIX_STATUS2_PROVIDER	BIT(0)
+#define BELLATRIX_STATUS2_CONSUMER	BIT(1)
+#define BELLATRIX_CHIP_ID		0x73
+#define BELLATRIX_CHIP_ID_VALUE		0x74
+
+#define BELLATRIX_INIT_DELAY_MS		10
+#define BELLATRIX_INIT_RETRY_DELAY_MS	100
+#define BELLATRIX_INIT_ATTEMPTS		10
+#define BELLATRIX_POLL_INTERVAL_MS	1000
+
+struct apple_bellatrix {
+	struct i2c_client *client;
+	struct power_supply *psy;
+	struct delayed_work init_work;
+	/* Protects cached properties. */
+	struct mutex lock;
+	unsigned int init_attempts;
+	bool initialized;
+	int online;
+	int online_error;
+};
+
+static int apple_bellatrix_read(struct i2c_client *client, u8 reg)
+{
+	u8 value;
+	struct i2c_msg msgs[] = {
+		{
+			.addr = client->addr,
+			.flags = I2C_M_STOP,
+			.len = 1,
+			.buf = &reg,
+		},
+		{
+			.addr = client->addr,
+			.flags = I2C_M_RD,
+			.len = 1,
+			.buf = &value,
+		},
+	};
+	int ret;
+
+	/*
+	 * Bellatrix register reads require a STOP after the subaddress. Keep the
+	 * selector write and data read in one locked adapter segment so no other
+	 * transfer can run between them.
+	 */
+	i2c_lock_bus(client->adapter, I2C_LOCK_SEGMENT);
+	ret = __i2c_transfer(client->adapter, msgs, ARRAY_SIZE(msgs));
+	i2c_unlock_bus(client->adapter, I2C_LOCK_SEGMENT);
+
+	if (ret != ARRAY_SIZE(msgs)) {
+		if (ret >= 0)
+			ret = -EIO;
+		return ret;
+	}
+
+	ret = value;
+
+	return ret;
+}
+
+static int apple_bellatrix_update(struct apple_bellatrix *bellatrix,
+				  bool *changed)
+{
+	int old_error;
+	int old_online;
+	int chip_id;
+	int status2;
+	int vbus;
+	int online = 0;
+	int ret = 0;
+
+	*changed = false;
+
+	chip_id = apple_bellatrix_read(bellatrix->client, BELLATRIX_CHIP_ID);
+	if (chip_id < 0) {
+		ret = chip_id;
+		goto out_store;
+	}
+
+	if (chip_id != BELLATRIX_CHIP_ID_VALUE) {
+		dev_err(&bellatrix->client->dev,
+			"unexpected chip id 0x%02x\n", chip_id);
+		ret = -ENODEV;
+		goto out_store;
+	}
+
+	vbus = apple_bellatrix_read(bellatrix->client, BELLATRIX_VBUS_STATUS);
+	if (vbus < 0) {
+		ret = vbus;
+		goto out_store;
+	}
+
+	if (!(vbus & BELLATRIX_VBUS_EXT_VBUS)) {
+		online = 0;
+		goto out_store;
+	}
+
+	status2 = apple_bellatrix_read(bellatrix->client, BELLATRIX_STATUS2);
+	if (status2 < 0) {
+		ret = status2;
+		goto out_store;
+	}
+
+	if (status2 & BELLATRIX_STATUS2_PROVIDER)
+		online = 0;
+	else
+		online = !!(status2 & BELLATRIX_STATUS2_CONSUMER);
+
+out_store:
+	mutex_lock(&bellatrix->lock);
+	old_error = bellatrix->online_error;
+	old_online = bellatrix->online;
+	bellatrix->online_error = ret;
+	if (!ret)
+		bellatrix->online = online;
+	*changed = old_error != ret || (!ret && old_online != online);
+	mutex_unlock(&bellatrix->lock);
+
+	return ret;
+}
+
+static int apple_bellatrix_get_property(struct power_supply *psy,
+					enum power_supply_property property,
+					union power_supply_propval *val)
+{
+	struct apple_bellatrix *bellatrix = power_supply_get_drvdata(psy);
+	int ret;
+
+	mutex_lock(&bellatrix->lock);
+	switch (property) {
+	case POWER_SUPPLY_PROP_ONLINE:
+		ret = bellatrix->online_error;
+		if (!ret)
+			val->intval = bellatrix->online;
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+	mutex_unlock(&bellatrix->lock);
+
+	return ret;
+}
+
+static const enum power_supply_property apple_bellatrix_properties[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+};
+
+static const struct power_supply_desc apple_bellatrix_desc = {
+	.name = "usb",
+	.type = POWER_SUPPLY_TYPE_USB,
+	.properties = apple_bellatrix_properties,
+	.num_properties = ARRAY_SIZE(apple_bellatrix_properties),
+	.get_property = apple_bellatrix_get_property,
+};
+
+static void apple_bellatrix_init_work(struct work_struct *work)
+{
+	struct apple_bellatrix *bellatrix =
+		container_of(to_delayed_work(work), struct apple_bellatrix,
+			     init_work);
+	bool changed;
+	int ret;
+
+	ret = apple_bellatrix_update(bellatrix, &changed);
+	if (changed)
+		power_supply_changed(bellatrix->psy);
+
+	if (!ret) {
+		bellatrix->initialized = true;
+		schedule_delayed_work(&bellatrix->init_work,
+				      msecs_to_jiffies(BELLATRIX_POLL_INTERVAL_MS));
+		return;
+	}
+
+	if (bellatrix->initialized) {
+		schedule_delayed_work(&bellatrix->init_work,
+				      msecs_to_jiffies(BELLATRIX_POLL_INTERVAL_MS));
+		return;
+	}
+
+	bellatrix->init_attempts++;
+
+	if ((ret == -ENXIO || ret == -EIO) &&
+	    bellatrix->init_attempts < BELLATRIX_INIT_ATTEMPTS) {
+		schedule_delayed_work(&bellatrix->init_work,
+				      msecs_to_jiffies(BELLATRIX_INIT_RETRY_DELAY_MS));
+		return;
+	}
+
+	dev_err(&bellatrix->client->dev,
+		"failed to read USB power status after %u attempt(s): %pe\n",
+		bellatrix->init_attempts, ERR_PTR(ret));
+}
+
+static int apple_bellatrix_probe(struct i2c_client *client)
+{
+	struct power_supply_config config = {};
+	struct apple_bellatrix *bellatrix;
+	int ret;
+
+	bellatrix = devm_kzalloc(&client->dev, sizeof(*bellatrix), GFP_KERNEL);
+	if (!bellatrix)
+		return -ENOMEM;
+
+	ret = devm_mutex_init(&client->dev, &bellatrix->lock);
+	if (ret)
+		return ret;
+
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_I2C))
+		return dev_err_probe(&client->dev, -EOPNOTSUPP,
+				     "plain I2C transfers unsupported\n");
+
+	bellatrix->client = client;
+	bellatrix->online_error = -ENODATA;
+
+	config.drv_data = bellatrix;
+	config.fwnode = dev_fwnode(&client->dev);
+	config.no_wakeup_source = true;
+
+	bellatrix->psy = devm_power_supply_register(&client->dev,
+						    &apple_bellatrix_desc,
+						    &config);
+	if (IS_ERR(bellatrix->psy))
+		return PTR_ERR(bellatrix->psy);
+
+	ret = devm_delayed_work_autocancel(&client->dev,
+					   &bellatrix->init_work,
+					   apple_bellatrix_init_work);
+	if (ret)
+		return ret;
+
+	schedule_delayed_work(&bellatrix->init_work,
+			      msecs_to_jiffies(BELLATRIX_INIT_DELAY_MS));
+
+	return 0;
+}
+
+static const struct of_device_id apple_bellatrix_of_match[] = {
+	{ .compatible = "apple,bellatrix" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, apple_bellatrix_of_match);
+
+static struct i2c_driver apple_bellatrix_driver = {
+	.probe = apple_bellatrix_probe,
+	.driver = {
+		.name = "apple-bellatrix-power",
+		.of_match_table = apple_bellatrix_of_match,
+	},
+};
+module_i2c_driver(apple_bellatrix_driver);
+
+MODULE_AUTHOR("Paul Praschl");
+MODULE_DESCRIPTION("Read-only Apple Bellatrix USB power status");
+MODULE_LICENSE("GPL");
diff --git a/drivers/power/supply/apple_d2365_charger.c b/drivers/power/supply/apple_d2365_charger.c
new file mode 100644
index 0000000000000000000000000000000000000000..fa17482ca06064bce9c7ff18c36dcbfa60bfbcf8
--- /dev/null
+++ b/drivers/power/supply/apple_d2365_charger.c
@@ -0,0 +1,772 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Charging status and guarded input-current policy for the Apple D2365 PMIC
+ */
+
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/devm-helpers.h>
+#include <linux/err.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+#include <linux/slab.h>
+#include <linux/workqueue.h>
+
+#define D2365_STATUS_CHARGE	0x0a
+#define D2365_STATUS_CHARGE_STATE	GENMASK(1, 0)
+#define D2365_STATUS_CHARGE_END	BIT(2)
+#define D2365_STATUS_CHARGE_TIMEOUT	BIT(4)
+#define D2365_CONTROL_INPUT	0x00
+#define D2365_CONTROL_INPUT_LIMIT	0x03
+#define D2365_CONTROL_MAX_CHARGE	0x0c
+#define D2365_CONTROL_MAX_CHARGE_MASK	GENMASK(5, 0)
+#define D2365_POLICY_CONTROL	0x00
+#define D2365_POLICY_MIN_TEMP	100
+#define D2365_POLICY_MAX_TEMP	400
+#define D2365_POLICY_MIN_VOLTAGE_UV	3000000
+#define D2365_POLICY_MAX_VOLTAGE_UV	4350000
+#define D2365_POLICY_INTERVAL_MS	5000
+#define D2365_RESTORE_RETRY_MS	100
+#define D2365_STOP_RESTORE_ATTEMPTS	3
+
+struct apple_d2365_config {
+	u8 handoff_input_limit;
+	u8 charging_input_limit;
+	u8 max_charge;
+};
+
+static const struct apple_d2365_config apple_d2365_j172_config = {
+	.handoff_input_limit = 0x02,
+	.charging_input_limit = 0x6c,
+	.max_charge = 0x34,
+};
+
+struct apple_d2365_battery_snapshot {
+	int present;
+	int temperature;
+	int voltage_uv;
+};
+
+struct apple_d2365_charger {
+	/* Protects cached properties while probe completes. */
+	struct mutex lock;
+	/* Serializes policy validation, writes and restore. */
+	struct mutex policy_lock;
+	struct delayed_work charge_policy_work;
+	struct device *dev;
+	struct regmap *regmap;
+	struct power_supply *psy;
+	const struct apple_d2365_config *config;
+	u32 status_base;
+	u32 control_base;
+	unsigned int raw_status;
+	int status_error;
+	unsigned int raw_input_limit;
+	int input_limit_error;
+	u8 policy_old_input_limit;
+	bool policy_old_input_valid;
+	bool policy_enabled;
+	bool restore_pending;
+	bool shutting_down;
+};
+
+static int apple_d2365_charger_online(struct power_supply *psy,
+				      union power_supply_propval *val);
+
+static int apple_d2365_get_bank(struct device *dev, const char *name,
+				u32 min_size, u32 *base)
+{
+	u64 address;
+	u64 size;
+	int index;
+	int ret;
+
+	index = of_property_match_string(dev->of_node, "reg-names", name);
+	if (index < 0)
+		return dev_err_probe(dev, index,
+				     "missing %s register range\n", name);
+
+	ret = of_property_read_reg(dev->of_node, index, &address, &size);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to read %s register range\n", name);
+
+	if (size < min_size || address + min_size - 1 > U32_MAX)
+		return dev_err_probe(dev, -EINVAL,
+				     "invalid %s register range\n", name);
+
+	*base = address;
+	return 0;
+}
+
+static int apple_d2365_battery_status(union power_supply_propval *val)
+{
+	struct power_supply *battery;
+	int ret;
+
+	battery = power_supply_get_by_name("battery");
+	if (!battery)
+		return -ENODEV;
+
+	ret = power_supply_get_property(battery, POWER_SUPPLY_PROP_STATUS, val);
+	power_supply_put(battery);
+
+	return ret;
+}
+
+static void apple_d2365_cache_status(struct apple_d2365_charger *charger,
+				     int ret, unsigned int status)
+{
+	bool changed;
+
+	mutex_lock(&charger->lock);
+	changed = charger->status_error != ret ||
+		  (!ret && charger->raw_status != status);
+	charger->status_error = ret;
+	if (!ret)
+		charger->raw_status = status;
+	mutex_unlock(&charger->lock);
+
+	if (changed && charger->psy)
+		power_supply_changed(charger->psy);
+}
+
+static void
+apple_d2365_cache_input_limit(struct apple_d2365_charger *charger, int ret,
+			      unsigned int input_limit)
+{
+	bool changed;
+
+	mutex_lock(&charger->lock);
+	changed = charger->input_limit_error != ret ||
+		  (!ret && charger->raw_input_limit != input_limit);
+	charger->input_limit_error = ret;
+	if (!ret)
+		charger->raw_input_limit = input_limit;
+	mutex_unlock(&charger->lock);
+
+	if (changed && charger->psy)
+		power_supply_changed(charger->psy);
+}
+
+static int
+apple_d2365_battery_snapshot(struct apple_d2365_battery_snapshot *snapshot)
+{
+	union power_supply_propval val;
+	struct power_supply *battery;
+	int ret;
+
+	battery = power_supply_get_by_name("battery");
+	if (!battery)
+		return -ENODEV;
+
+	ret = power_supply_get_property(battery, POWER_SUPPLY_PROP_PRESENT,
+					&val);
+	if (ret)
+		goto out_put;
+	snapshot->present = val.intval;
+
+	ret = power_supply_get_property(battery, POWER_SUPPLY_PROP_TEMP, &val);
+	if (ret)
+		goto out_put;
+	snapshot->temperature = val.intval;
+
+	ret = power_supply_get_property(battery, POWER_SUPPLY_PROP_VOLTAGE_NOW,
+					&val);
+	if (ret)
+		goto out_put;
+	snapshot->voltage_uv = val.intval;
+
+out_put:
+	power_supply_put(battery);
+	return ret;
+}
+
+static int
+apple_d2365_restore_input_limit(struct apple_d2365_charger *charger,
+				u8 old_input_limit)
+{
+	unsigned int readback;
+	int ret = -EIO;
+	int attempt;
+
+	for (attempt = 1; attempt <= 3; attempt++) {
+		ret = regmap_write(charger->regmap,
+				   charger->control_base + D2365_CONTROL_INPUT_LIMIT,
+				   old_input_limit);
+		if (!ret) {
+			ret = regmap_read(charger->regmap,
+					  charger->control_base +
+					  D2365_CONTROL_INPUT_LIMIT, &readback);
+			if (!ret && readback == old_input_limit) {
+				apple_d2365_cache_input_limit(charger, 0,
+							      old_input_limit);
+				return 0;
+			}
+			if (!ret)
+				ret = -EIO;
+		}
+
+		if (attempt < 3)
+			msleep(20);
+	}
+	apple_d2365_cache_input_limit(charger, ret, 0);
+
+	return ret;
+}
+
+static bool
+apple_d2365_battery_is_safe(const struct apple_d2365_battery_snapshot *snapshot)
+{
+	return snapshot->present == 1 &&
+		snapshot->temperature >= D2365_POLICY_MIN_TEMP &&
+		snapshot->temperature <= D2365_POLICY_MAX_TEMP &&
+		snapshot->voltage_uv >= D2365_POLICY_MIN_VOLTAGE_UV &&
+		snapshot->voltage_uv <= D2365_POLICY_MAX_VOLTAGE_UV;
+}
+
+static int
+apple_d2365_policy_restore_locked(struct apple_d2365_charger *charger,
+				  const char *reason)
+{
+	unsigned int control;
+	int ret;
+
+	if (!charger->restore_pending)
+		return 0;
+	if (!charger->policy_old_input_valid)
+		return -EINVAL;
+
+	charger->policy_enabled = false;
+
+	ret = apple_d2365_restore_input_limit(charger,
+					      charger->policy_old_input_limit);
+	if (ret) {
+		dev_err(charger->dev,
+			"failed to restore input limit (%s): %d\n", reason, ret);
+		return ret;
+	}
+	charger->restore_pending = false;
+	charger->policy_old_input_valid = false;
+	power_supply_changed(charger->psy);
+
+	ret = regmap_read(charger->regmap,
+			  charger->control_base + D2365_CONTROL_INPUT, &control);
+	if (ret || control != D2365_POLICY_CONTROL) {
+		dev_err(charger->dev,
+			"D2365 charging policy control integrity failed (%s): ret=%d control=0x%02x\n",
+			reason, ret, ret ? 0 : control);
+		return ret ?: -EIO;
+	}
+
+	return 0;
+}
+
+static int apple_d2365_policy_read_controls(struct apple_d2365_charger *charger,
+					    unsigned int *control,
+					    unsigned int *input_limit,
+					    unsigned int *max_charge,
+					    unsigned int *status)
+{
+	int ret;
+
+	ret = regmap_read(charger->regmap,
+			  charger->status_base + D2365_STATUS_CHARGE, status);
+	apple_d2365_cache_status(charger, ret, ret ? 0 : *status);
+	if (ret)
+		return ret;
+
+	ret = regmap_read(charger->regmap,
+			  charger->control_base + D2365_CONTROL_INPUT, control);
+	if (ret)
+		return ret;
+
+	ret = regmap_read(charger->regmap,
+			  charger->control_base + D2365_CONTROL_INPUT_LIMIT,
+			  input_limit);
+	apple_d2365_cache_input_limit(charger, ret, ret ? 0 : *input_limit);
+	if (ret)
+		return ret;
+
+	return regmap_read(charger->regmap,
+			   charger->control_base + D2365_CONTROL_MAX_CHARGE,
+			   max_charge);
+}
+
+static void apple_d2365_charge_policy_work(struct work_struct *work)
+{
+	struct apple_d2365_charger *charger;
+	struct apple_d2365_battery_snapshot battery;
+	union power_supply_propval online;
+	unsigned int control;
+	unsigned int input_limit;
+	unsigned int max_charge;
+	unsigned int readback;
+	unsigned int status;
+	const char *reject_reason = NULL;
+	int ret;
+
+	charger = container_of(to_delayed_work(work),
+			       struct apple_d2365_charger, charge_policy_work);
+
+	mutex_lock(&charger->policy_lock);
+	if (charger->shutting_down)
+		goto out_unlock;
+	if (charger->restore_pending && !charger->policy_enabled) {
+		apple_d2365_policy_restore_locked(charger, "retry");
+		goto out_reschedule;
+	}
+
+	if (!charger->config) {
+		ret = regmap_read(charger->regmap,
+				  charger->status_base + D2365_STATUS_CHARGE,
+				  &status);
+		apple_d2365_cache_status(charger, ret, ret ? 0 : status);
+		ret = regmap_read(charger->regmap,
+				  charger->control_base + D2365_CONTROL_INPUT_LIMIT,
+				  &input_limit);
+		apple_d2365_cache_input_limit(charger, ret, ret ? 0 : input_limit);
+		goto out_reschedule;
+	}
+
+	ret = apple_d2365_charger_online(charger->psy, &online);
+	if (ret || online.intval != 1) {
+		reject_reason = "supplier offline";
+		goto out_stop;
+	}
+
+	ret = apple_d2365_battery_snapshot(&battery);
+	if (ret || !apple_d2365_battery_is_safe(&battery)) {
+		reject_reason = "battery guard";
+		goto out_stop;
+	}
+
+	ret = apple_d2365_policy_read_controls(charger, &control, &input_limit,
+					       &max_charge, &status);
+	if (ret) {
+		reject_reason = "control read";
+		goto out_stop;
+	}
+
+	/*
+	 * Keep the input budget in place after charge termination so the system
+	 * can remain externally powered while the PMIC controls battery current.
+	 */
+	if (status & D2365_STATUS_CHARGE_TIMEOUT) {
+		reject_reason = "charge timeout";
+		goto out_stop;
+	}
+
+	if (control != D2365_POLICY_CONTROL ||
+	    (max_charge & D2365_CONTROL_MAX_CHARGE_MASK) !=
+			    charger->config->max_charge) {
+		reject_reason = "control integrity";
+		goto out_stop;
+	}
+
+	if (charger->policy_enabled) {
+		if (input_limit != charger->config->charging_input_limit) {
+			reject_reason = "input-limit integrity";
+			goto out_stop;
+		}
+		goto out_reschedule;
+	}
+
+	if (input_limit != charger->config->handoff_input_limit) {
+		reject_reason = "unexpected handoff input-limit";
+		goto out_stop;
+	}
+
+	charger->policy_old_input_limit = input_limit;
+	charger->policy_old_input_valid = true;
+	charger->restore_pending = true;
+	ret = regmap_write(charger->regmap,
+			   charger->control_base + D2365_CONTROL_INPUT_LIMIT,
+			   charger->config->charging_input_limit);
+	if (ret)
+		goto out_write_error;
+
+	ret = regmap_read(charger->regmap,
+			  charger->control_base + D2365_CONTROL_INPUT_LIMIT,
+			  &readback);
+	apple_d2365_cache_input_limit(charger, ret, ret ? 0 : readback);
+	if (ret || readback != charger->config->charging_input_limit) {
+		if (!ret)
+			ret = -EIO;
+		goto out_write_error;
+	}
+
+	charger->policy_enabled = true;
+	power_supply_changed(charger->psy);
+
+out_reschedule:
+	if (!charger->shutting_down)
+		mod_delayed_work(system_power_efficient_wq,
+				 &charger->charge_policy_work,
+				 msecs_to_jiffies(D2365_POLICY_INTERVAL_MS));
+	goto out_unlock;
+
+out_write_error:
+	dev_err(charger->dev, "D2365 charging policy enable failed: %d\n", ret);
+	apple_d2365_policy_restore_locked(charger, "enable error");
+	goto out_reschedule;
+
+out_stop:
+	if (charger->policy_enabled || charger->restore_pending)
+		apple_d2365_policy_restore_locked(charger, reject_reason);
+	goto out_reschedule;
+
+out_unlock:
+	mutex_unlock(&charger->policy_lock);
+}
+
+static int apple_d2365_charger_online(struct power_supply *psy,
+				      union power_supply_propval *val)
+{
+	return power_supply_get_property_from_supplier(psy,
+						       POWER_SUPPLY_PROP_ONLINE,
+						       val);
+}
+
+static int apple_d2365_charger_status(struct power_supply *psy,
+				      union power_supply_propval *val)
+{
+	struct apple_d2365_charger *charger = power_supply_get_drvdata(psy);
+	union power_supply_propval battery_status;
+	union power_supply_propval online;
+	unsigned int charge_state;
+	unsigned int raw_status;
+	int battery_ret;
+	int ret;
+
+	mutex_lock(&charger->lock);
+	ret = charger->status_error;
+	raw_status = charger->raw_status;
+	mutex_unlock(&charger->lock);
+
+	if (ret)
+		return ret;
+
+	charge_state = raw_status & D2365_STATUS_CHARGE_STATE;
+
+	ret = apple_d2365_charger_online(psy, &online);
+	if (!ret && !online.intval) {
+		val->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		return 0;
+	}
+
+	if (raw_status & D2365_STATUS_CHARGE_TIMEOUT) {
+		val->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		return 0;
+	}
+
+	battery_ret = apple_d2365_battery_status(&battery_status);
+	if (!ret && online.intval == 1 && !battery_ret &&
+	    battery_status.intval == POWER_SUPPLY_STATUS_FULL) {
+		val->intval = POWER_SUPPLY_STATUS_FULL;
+		return 0;
+	}
+
+	if (raw_status & D2365_STATUS_CHARGE_END) {
+		val->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		return 0;
+	}
+
+	/* No Tristar supplier yet: require the HDQ gauge to corroborate. */
+	if (ret && !charger->config && !battery_ret) {
+		if (battery_status.intval == POWER_SUPPLY_STATUS_FULL ||
+		    battery_status.intval == POWER_SUPPLY_STATUS_DISCHARGING ||
+		    (charge_state &&
+		     battery_status.intval == POWER_SUPPLY_STATUS_CHARGING)) {
+			val->intval = battery_status.intval;
+			return 0;
+		}
+	}
+
+	/*
+	 * Apple uses the non-zero D2365 field as IsCharging, but live data shows
+	 * it can remain set while Bellatrix reports USB offline. Require both
+	 * the PMIC state and positive external-power evidence before exporting
+	 * Charging. A missing supplier remains conservative.
+	 */
+	if (!ret)
+		val->intval = charge_state ? POWER_SUPPLY_STATUS_CHARGING :
+			POWER_SUPPLY_STATUS_NOT_CHARGING;
+	else
+		val->intval = charge_state ? POWER_SUPPLY_STATUS_UNKNOWN :
+			POWER_SUPPLY_STATUS_NOT_CHARGING;
+
+	return 0;
+}
+
+static int
+apple_d2365_charger_input_limit(struct power_supply *psy,
+				union power_supply_propval *val)
+{
+	struct apple_d2365_charger *charger = power_supply_get_drvdata(psy);
+	unsigned int input_limit;
+	int ret;
+
+	mutex_lock(&charger->lock);
+	ret = charger->input_limit_error;
+	input_limit = charger->raw_input_limit;
+	mutex_unlock(&charger->lock);
+	if (ret)
+		return ret;
+
+	/* D2365 code 0 is 75 mA; each following step adds 12.5 mA. */
+	val->intval = 75000 + DIV_ROUND_CLOSEST(input_limit * 25000, 2);
+	return 0;
+}
+
+static int apple_d2365_charger_charge_type(struct power_supply *psy,
+					   union power_supply_propval *val)
+{
+	union power_supply_propval status;
+	int ret;
+
+	ret = apple_d2365_charger_status(psy, &status);
+	if (ret)
+		return ret;
+
+	val->intval = status.intval == POWER_SUPPLY_STATUS_CHARGING ||
+		status.intval == POWER_SUPPLY_STATUS_UNKNOWN ?
+		POWER_SUPPLY_CHARGE_TYPE_UNKNOWN : POWER_SUPPLY_CHARGE_TYPE_NONE;
+
+	return 0;
+}
+
+static int apple_d2365_charger_get_property(struct power_supply *psy,
+					    enum power_supply_property property,
+					    union power_supply_propval *val)
+{
+	int ret;
+
+	switch (property) {
+	case POWER_SUPPLY_PROP_ONLINE:
+		ret = apple_d2365_charger_online(psy, val);
+		break;
+	case POWER_SUPPLY_PROP_STATUS:
+		ret = apple_d2365_charger_status(psy, val);
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_TYPE:
+		ret = apple_d2365_charger_charge_type(psy, val);
+		break;
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		ret = apple_d2365_charger_input_limit(psy, val);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	return ret;
+}
+
+static void
+apple_d2365_charger_external_power_changed(struct power_supply *psy)
+{
+	struct apple_d2365_charger *charger = power_supply_get_drvdata(psy);
+
+	if (!READ_ONCE(charger->shutting_down))
+		mod_delayed_work(system_power_efficient_wq,
+				 &charger->charge_policy_work, 0);
+
+	power_supply_changed(psy);
+}
+
+static const enum power_supply_property apple_d2365_charger_properties[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_CHARGE_TYPE,
+	POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
+};
+
+static const struct power_supply_desc apple_d2365_charger_desc = {
+	.name = "charger",
+	.type = POWER_SUPPLY_TYPE_UNKNOWN,
+	.properties = apple_d2365_charger_properties,
+	.num_properties = ARRAY_SIZE(apple_d2365_charger_properties),
+	.get_property = apple_d2365_charger_get_property,
+	.external_power_changed = apple_d2365_charger_external_power_changed,
+};
+
+static const enum power_supply_property apple_d2365_readonly_properties[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_CHARGE_TYPE,
+	POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
+};
+
+static const struct power_supply_desc apple_d2365_readonly_desc = {
+	.name = "charger",
+	.type = POWER_SUPPLY_TYPE_UNKNOWN,
+	.properties = apple_d2365_readonly_properties,
+	.num_properties = ARRAY_SIZE(apple_d2365_readonly_properties),
+	.get_property = apple_d2365_charger_get_property,
+};
+
+static int apple_d2365_charger_probe(struct platform_device *pdev)
+{
+	struct power_supply_config config = {};
+	struct device *dev = &pdev->dev;
+	struct apple_d2365_charger *charger;
+	struct power_supply *psy;
+	struct regmap *regmap;
+	unsigned int status;
+	u32 control_base;
+	u32 status_base;
+	int ret;
+
+	regmap = dev_get_regmap(dev->parent, NULL);
+	if (!regmap)
+		return dev_err_probe(dev, -ENODEV, "parent regmap unavailable\n");
+
+	ret = apple_d2365_get_bank(dev, "status",
+				   D2365_STATUS_CHARGE + 1, &status_base);
+	if (ret)
+		return ret;
+
+	ret = apple_d2365_get_bank(dev, "control",
+				   D2365_CONTROL_MAX_CHARGE + 1,
+				   &control_base);
+	if (ret)
+		return ret;
+
+	charger = devm_kzalloc(dev, sizeof(*charger), GFP_KERNEL);
+	if (!charger)
+		return -ENOMEM;
+
+	ret = devm_mutex_init(dev, &charger->lock);
+	if (ret)
+		return ret;
+	ret = devm_mutex_init(dev, &charger->policy_lock);
+	if (ret)
+		return ret;
+
+	charger->dev = dev;
+	charger->regmap = regmap;
+	charger->config = device_get_match_data(dev);
+	charger->status_base = status_base;
+	charger->control_base = control_base;
+	charger->status_error = -ENODATA;
+	charger->input_limit_error = -ENODATA;
+	ret = devm_delayed_work_autocancel(dev, &charger->charge_policy_work,
+					   apple_d2365_charge_policy_work);
+	if (ret)
+		return ret;
+
+	config.drv_data = charger;
+	config.fwnode = dev_fwnode(dev);
+	config.no_wakeup_source = true;
+
+	psy = devm_power_supply_register(dev,
+		charger->config ? &apple_d2365_charger_desc :
+		&apple_d2365_readonly_desc,
+					 &config);
+	if (IS_ERR(psy))
+		return dev_err_probe(dev, PTR_ERR(psy),
+				     "failed to register power supply\n");
+	charger->psy = psy;
+	platform_set_drvdata(pdev, charger);
+
+	/*
+	 * Do not access the PMIC before all supplier probe deferrals are done.
+	 */
+	ret = regmap_read(regmap, status_base + D2365_STATUS_CHARGE, &status);
+	apple_d2365_cache_status(charger, ret, ret ? 0 : status);
+
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to read charging status\n");
+
+	ret = regmap_read(regmap, control_base + D2365_CONTROL_INPUT_LIMIT,
+			  &status);
+	apple_d2365_cache_input_limit(charger, ret, ret ? 0 : status);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to read input-current limit\n");
+
+	{
+		mod_delayed_work(system_power_efficient_wq,
+				 &charger->charge_policy_work, 0);
+	}
+
+	power_supply_changed(psy);
+
+	return 0;
+}
+
+static void apple_d2365_charger_stop(struct apple_d2365_charger *charger,
+				     const char *reason)
+{
+	bool restore_pending = false;
+	int attempt;
+
+	mutex_lock(&charger->policy_lock);
+	charger->shutting_down = true;
+	mutex_unlock(&charger->policy_lock);
+
+	cancel_delayed_work_sync(&charger->charge_policy_work);
+
+	for (attempt = 1; attempt <= D2365_STOP_RESTORE_ATTEMPTS; attempt++) {
+		mutex_lock(&charger->policy_lock);
+		apple_d2365_policy_restore_locked(charger, reason);
+		restore_pending = charger->restore_pending;
+		mutex_unlock(&charger->policy_lock);
+
+		if (!restore_pending)
+			break;
+		if (attempt < D2365_STOP_RESTORE_ATTEMPTS)
+			msleep(D2365_RESTORE_RETRY_MS);
+	}
+
+	if (restore_pending)
+		dev_crit(charger->dev,
+			 "input-limit restore remains pending after %s\n", reason);
+}
+
+static void apple_d2365_charger_remove(struct platform_device *pdev)
+{
+	struct apple_d2365_charger *charger = platform_get_drvdata(pdev);
+
+	apple_d2365_charger_stop(charger, "remove");
+}
+
+static void apple_d2365_charger_shutdown(struct platform_device *pdev)
+{
+	struct apple_d2365_charger *charger = platform_get_drvdata(pdev);
+
+	apple_d2365_charger_stop(charger, "shutdown");
+}
+
+static const struct of_device_id apple_d2365_charger_of_match[] = {
+	{
+		.compatible = "apple,j172-d2365-charger",
+		.data = &apple_d2365_j172_config,
+	},
+	/* J71t has a separate, explicitly armed charging driver. */
+	{ .compatible = "apple,d2365-charger" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, apple_d2365_charger_of_match);
+
+static struct platform_driver apple_d2365_charger_driver = {
+	.probe = apple_d2365_charger_probe,
+	.remove = apple_d2365_charger_remove,
+	.shutdown = apple_d2365_charger_shutdown,
+	.driver = {
+		.name = "apple-d2365-charger",
+		.of_match_table = apple_d2365_charger_of_match,
+	},
+};
+module_platform_driver(apple_d2365_charger_driver);
+
+MODULE_AUTHOR("Paul Praschl");
+MODULE_DESCRIPTION("Apple D2365 charger status and guarded charging policy");
+MODULE_LICENSE("GPL");
diff --git a/drivers/power/supply/apple_j71t_charger.c b/drivers/power/supply/apple_j71t_charger.c
new file mode 100644
index 0000000000000000000000000000000000000000..630bbc957855548fbbcafcdba98a4fcd77911623
--- /dev/null
+++ b/drivers/power/supply/apple_j71t_charger.c
@@ -0,0 +1,869 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Guarded J71t D2365 charging from verified source-current allowances. */
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/devm-helpers.h>
+#include <linux/firmware.h>
+#include <linux/jiffies.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm.h>
+#include <linux/power_supply.h>
+#include <linux/regmap.h>
+#include <linux/unaligned.h>
+
+#define J71T_STATUS 0x18a
+#define J71T_INPUT_CONTROL 0xa00
+#define J71T_INPUT_SUSPEND BIT(1)
+#define J71T_INPUT_LIMIT 0xa03
+#define J71T_CHARGE_CURRENT 0xa08
+#define J71T_MAX_CHARGE_CURRENT 0xa0c
+#define J71T_CHARGE_TIMEOUT BIT(4)
+#define J71T_CHARGE_END BIT(2)
+#define J71T_CHARGE_CODE 50 /* 2500 mA, still bounded by 0xa0c[5:0]. */
+#define J71T_USB_CHARGE_CODE 8 /* Conservative 400 mA battery ceiling at 500 mA input. */
+#define J71T_REQUEST_UA 2400000
+#define J71T_FLOOR_UA 500000
+#define J71T_EREGREADBACK (-EUCLEAN)
+#define J71T_LINK_GRACE_MS 5000
+#define J71T_SAMPLE_GRACE_MS 60000
+#define J71T_FAULT_RETRY_MS 60000
+#define J71T_OWNER_RETRY_MS 30000
+/*
+ * Battery sanity window. This unit's cell charges above 4.2 V: iOS reports
+ * 4256-4274 mV at 100 % (2026-10-27 capture) and Linux saw 4249 mV at 98 %
+ * while charging. With a 4.2 V ceiling the policy stopped charging near full
+ * every 30 s. The PMIC owns charge voltage and termination; this window only
+ * rejects implausible gauge samples.
+ */
+#define J71T_VBAT_MIN_UV 3000000
+#define J71T_VBAT_MAX_UV 4400000
+/* One budget reassert per window before a register change counts as a fault. */
+#define J71T_REASSERT_WINDOW_MS 10000
+
+static const int j71t_budgets_ua[] = { 500000, 1000000, 2100000, 2400000 };
+
+struct j71t_charger {
+	struct device *dev;
+	struct regmap *map;
+	struct power_supply *psy;
+	/* Serializes policy changes, register transactions and work lifetime. */
+	struct mutex lock;
+	struct delayed_work work;
+	u8 input_code;
+	u8 input_codes[ARRAY_SIZE(j71t_budgets_ua)];
+	u8 charge_code;
+	int budget_ua;
+	int user_limit_ua;
+	int max_limit_ua;
+	bool thermal_limited;
+	bool holding;
+	bool sample_pending;
+	unsigned long hold_until;
+	unsigned long sample_until;
+	unsigned long fault_until;
+	unsigned long retry_after;
+	unsigned long ramp_after;
+	unsigned long reassert_after;
+	u8 old_control;
+	u8 old_input;
+	u8 old_charge;
+	bool calibrated;
+	bool saved;
+	bool active;
+	bool stopping;
+	bool disabled;
+	bool faulted;
+	bool policy_logged;
+	int policy_error;
+	unsigned long policy_log_after;
+};
+
+/* AppleD2365PMU 0x6bc07ec middle/high branches, then 0x6bbff6c. */
+static int j71t_calibrate_budget(const u8 *data, size_t size, int target_ma, u8 *code)
+{
+	s64 point[5], slope, gain, result, ma;
+	int i;
+
+	if (!data || size != 24 || target_ma < 500 || target_ma > 2400 ||
+	    get_unaligned_le32(data + 20) != 1)
+		return -EINVAL;
+	for (i = 0; i < 5; i++) {
+		point[i] = (s32)get_unaligned_le32(data + i * 4);
+		if (point[i] <= 0 || point[i] > (3000LL << 16) ||
+		    (i && point[i] <= point[i - 1]))
+			return -ERANGE;
+	}
+	if (target_ma < 1500) {
+		slope = div_s64(point[2] - point[1], 53);
+		gain = div_s64(point[1] - point[2] + (1025LL << 16), 525);
+		result = ((gain * ((target_ma - 475LL) * 65536)) >> 16) -
+			 point[1] + (925LL << 16);
+	} else {
+		slope = div_s64(point[4] - point[3], 30);
+		gain = div_s64(point[3] - point[4] + (600LL << 16), 300);
+		result = ((gain * ((target_ma - 2100LL) * 65536)) >> 16) -
+			 point[3] + (4125LL << 16);
+	}
+	if (slope < (8LL << 16) || slope > (12LL << 16))
+		return -ERANGE;
+	ma = result >> 16;
+	if (ma < 75 || ma > target_ma)
+		return -ERANGE;
+	*code = div_s64((ma * 8 - 600) & 0xfff8, 100);
+	return *code <= 0xba ? 0 : -ERANGE;
+}
+
+static int j71t_calibrate(const u8 *data, size_t size, u8 *code)
+{
+	return j71t_calibrate_budget(data, size, 2400, code);
+}
+
+static int j71t_choose_budget(int source_ua)
+{
+	int i;
+
+	for (i = ARRAY_SIZE(j71t_budgets_ua) - 1; i >= 0; i--)
+		if (source_ua >= j71t_budgets_ua[i])
+			return i;
+	return -ERANGE;
+}
+
+static int j71t_read(struct j71t_charger *charger, unsigned int reg, u8 *value)
+{
+	unsigned int raw;
+	int ret = regmap_read(charger->map, reg, &raw);
+
+	if (!ret)
+		*value = raw;
+	return ret;
+}
+
+static int j71t_write_checked(struct j71t_charger *charger, unsigned int reg, u8 value)
+{
+	u8 readback;
+	int ret;
+
+	ret = regmap_write(charger->map, reg, value);
+	if (ret)
+		return ret;
+	ret = j71t_read(charger, reg, &readback);
+	if (ret)
+		return ret;
+	return readback == value ? 0 : J71T_EREGREADBACK;
+}
+
+/* Own only bit 1; preserve every other current control-register bit. */
+static int j71t_set_suspend(struct j71t_charger *charger, u8 saved)
+{
+	u8 control;
+	int ret;
+
+	ret = j71t_read(charger, J71T_INPUT_CONTROL, &control);
+	if (ret)
+		return ret;
+	if ((control & J71T_INPUT_SUSPEND) == (saved & J71T_INPUT_SUSPEND))
+		return 0;
+	control = (control & ~J71T_INPUT_SUSPEND) | (saved & J71T_INPUT_SUSPEND);
+	return j71t_write_checked(charger, J71T_INPUT_CONTROL, control);
+}
+
+static int j71t_online(struct j71t_charger *charger)
+{
+	union power_supply_propval value;
+	int ret;
+
+	if (!charger->psy)
+		return -EAGAIN;
+	ret = power_supply_get_property_from_supplier(charger->psy,
+						      POWER_SUPPLY_PROP_ONLINE, &value);
+	return ret ? ret : !!value.intval;
+}
+
+static int j71t_source_limit(struct j71t_charger *charger)
+{
+	union power_supply_propval value;
+	int ret;
+
+	if (!charger->psy)
+		return -EAGAIN;
+	ret = power_supply_get_property_from_supplier(charger->psy,
+						      POWER_SUPPLY_PROP_CURRENT_MAX, &value);
+	return ret ? ret : value.intval;
+}
+
+/* An unknown DT ceiling must never grant an uncalibrated budget. */
+static int j71t_valid_limit(unsigned int limit)
+{
+	int index = j71t_choose_budget(limit);
+
+	return index >= 0 && (unsigned int)j71t_budgets_ua[index] == limit ? limit : J71T_FLOOR_UA;
+}
+
+static int j71t_source_eligible(struct j71t_charger *charger)
+{
+	union power_supply_propval value;
+	int ret;
+
+	ret = power_supply_get_property_from_supplier(charger->psy,
+						      POWER_SUPPLY_PROP_USB_TYPE, &value);
+	if (ret)
+		return -EAGAIN;
+	/* ACA: the identified camera adapter, a source while the iPad is the host. */
+	return value.intval == POWER_SUPPLY_USB_TYPE_SDP ||
+	       value.intval == POWER_SUPPLY_USB_TYPE_APPLE_BRICK_ID ||
+	       value.intval == POWER_SUPPLY_USB_TYPE_ACA;
+}
+
+/* Link PM/reset is not source removal; only ONLINE=0 revokes the owner. */
+static int j71t_policy_limit(struct j71t_charger *charger)
+{
+	int source_ua = j71t_source_limit(charger);
+	int eligible;
+
+	if (source_ua < 0)
+		return -EAGAIN;
+	eligible = j71t_source_eligible(charger);
+	if (eligible < 0)
+		return eligible;
+	/* A reset can temporarily lose classification without losing VBUS. */
+	if (source_ua < J71T_FLOOR_UA || !eligible) {
+		if (!charger->holding) {
+			charger->holding = true;
+			charger->hold_until = jiffies + msecs_to_jiffies(J71T_LINK_GRACE_MS);
+		}
+		if (charger->active && time_before(jiffies, charger->hold_until))
+			return charger->budget_ua;
+		return J71T_FLOOR_UA;
+	}
+	charger->holding = false;
+	return min(charger->max_limit_ua, charger->user_limit_ua ?: source_ua);
+}
+
+static int j71t_charge_code(int budget_ua)
+{
+	return budget_ua == 500000 ? J71T_USB_CHARGE_CODE : J71T_CHARGE_CODE;
+}
+
+static void j71t_revoke_override(struct j71t_charger *charger)
+{
+	if (charger->user_limit_ua)
+		dev_info(charger->dev, "owner input override revoked\n");
+	charger->user_limit_ua = 0;
+}
+
+static int j71t_battery_safe(struct j71t_charger *charger)
+{
+	struct power_supply *battery;
+	union power_supply_propval value;
+	int ret;
+
+	battery = power_supply_get_by_name("battery");
+	if (!battery)
+		return -EAGAIN;
+	ret = power_supply_get_property(battery, POWER_SUPPLY_PROP_PRESENT, &value);
+	if (ret)
+		goto transient;
+	/* PRESENT=0 also means a failed cached flags read in bq27xxx. */
+	ret = power_supply_get_property(battery, POWER_SUPPLY_PROP_VOLTAGE_NOW, &value);
+	if (ret)
+		goto transient;
+	if (value.intval < J71T_VBAT_MIN_UV || value.intval > J71T_VBAT_MAX_UV) {
+		ret = -ERANGE;
+		goto out;
+	}
+	ret = power_supply_get_property(battery, POWER_SUPPLY_PROP_TEMP, &value);
+	if (ret)
+		goto transient;
+	if (value.intval >= 450)
+		charger->thermal_limited = true;
+	else if (value.intval <= 420)
+		charger->thermal_limited = false;
+	ret = value.intval < 100 ? -ERANGE :
+		charger->thermal_limited ? -EOVERFLOW : 0;
+	goto out;
+transient:
+	ret = -EAGAIN;
+out:
+	power_supply_put(battery);
+	return ret;
+}
+
+/* Match the iOS order without using input suspend as a transaction lock. */
+static int j71t_apply(struct j71t_charger *charger, u8 charge, u8 input)
+{
+	int ret = j71t_write_checked(charger, J71T_CHARGE_CURRENT, charge);
+
+	if (!ret)
+		ret = j71t_write_checked(charger, J71T_INPUT_LIMIT, input);
+	return ret;
+}
+
+static int j71t_restore(struct j71t_charger *charger)
+{
+	int ret;
+
+	charger->active = false;
+	if (!charger->saved)
+		return 0;
+	ret = j71t_apply(charger, charger->old_charge, charger->old_input);
+	if (!ret)
+		charger->saved = false;
+	return ret;
+}
+
+static bool j71t_is_fault(int error)
+{
+	return error == J71T_EREGREADBACK;
+}
+
+static void j71t_fault(struct j71t_charger *charger, int error)
+{
+	if (j71t_is_fault(error)) {
+		charger->faulted = true;
+		charger->fault_until = jiffies + msecs_to_jiffies(J71T_FAULT_RETRY_MS);
+	}
+}
+
+static int j71t_guard(struct j71t_charger *charger)
+{
+	u8 status, cap;
+	int ret = j71t_online(charger);
+
+	if (ret != 1)
+		return ret < 0 ? ret : -ENOLINK;
+	ret = j71t_policy_limit(charger);
+	if (ret < charger->budget_ua)
+		return ret < 0 ? ret : -ERANGE;
+	ret = j71t_battery_safe(charger);
+	if (ret == -EOVERFLOW && charger->budget_ua == J71T_FLOOR_UA)
+		ret = 0;
+	if (ret)
+		return ret;
+	ret = j71t_read(charger, J71T_STATUS, &status);
+	if (ret)
+		return ret;
+	ret = j71t_read(charger, J71T_MAX_CHARGE_CURRENT, &cap);
+	if (ret)
+		return ret;
+	if ((cap & 0x3f) < charger->charge_code)
+		return -ERANGE;
+	if (status & J71T_CHARGE_TIMEOUT)
+		return -ETIME;
+	return status & J71T_CHARGE_END ? -EBUSY : 0;
+}
+
+static int j71t_enable(struct j71t_charger *charger)
+{
+	int ret;
+
+	if (!charger->calibrated)
+		return -ENODATA;
+	ret = j71t_guard(charger);
+	if (charger->budget_ua == J71T_FLOOR_UA && (ret == -ETIME || ret == -EBUSY))
+		ret = 0;
+	if (ret)
+		return ret;
+	if (!charger->saved) {
+		ret = j71t_read(charger, J71T_INPUT_CONTROL, &charger->old_control);
+		if (!ret)
+			ret = j71t_read(charger, J71T_INPUT_LIMIT, &charger->old_input);
+		if (!ret)
+			ret = j71t_read(charger, J71T_CHARGE_CURRENT, &charger->old_charge);
+		if (ret)
+			return ret;
+		charger->saved = true;
+	}
+	ret = j71t_apply(charger, charger->charge_code, charger->input_code);
+	if (!ret) {
+		ret = j71t_guard(charger);
+		if (charger->budget_ua == J71T_FLOOR_UA && (ret == -ETIME || ret == -EBUSY))
+			ret = 0;
+	}
+	/* Clear a genuine handoff/owner disable only after the budgets are valid. */
+	if (!ret && (charger->old_control & J71T_INPUT_SUSPEND)) {
+		ret = j71t_set_suspend(charger, 0);
+		if (!ret)
+			charger->old_control &= ~J71T_INPUT_SUSPEND;
+	}
+	if (ret) {
+		int restore = j71t_restore(charger);
+
+		j71t_fault(charger, ret);
+		j71t_fault(charger, restore);
+		return ret;
+	}
+	charger->active = true;
+	charger->faulted = false;
+	charger->fault_until = 0;
+	dev_info(charger->dev, "%s budget %d mA: input 0x%02x, battery limit %d mA\n",
+		 charger->user_limit_ua ? "owner override" : "source",
+		 charger->budget_ua / 1000, charger->input_code, charger->charge_code * 50);
+	return 0;
+}
+
+/* Log transitions immediately and persistent deferred decisions every 30 s. */
+static void j71t_policy_log(struct j71t_charger *charger, int error)
+{
+	if (charger->policy_logged && charger->policy_error == error &&
+	    time_before(jiffies, charger->policy_log_after))
+		return;
+	charger->policy_logged = true;
+	charger->policy_error = error;
+	charger->policy_log_after = jiffies + msecs_to_jiffies(30000);
+	if (charger->faulted)
+		dev_info(charger->dev, "charging policy ownership fault; automatic retry in 60 s\n");
+	else if (charger->disabled)
+		dev_info(charger->dev, "charging policy disabled by owner\n");
+	else if (!charger->calibrated)
+		dev_info(charger->dev, "charging policy blocked: valid CBAT required\n");
+	else if (error == -EAGAIN)
+		dev_info(charger->dev, "charging policy waiting for valid battery/source sample; retry in 1000 ms\n");
+	else if (error)
+		dev_info(charger->dev, "charging policy deferred: %d; retry scheduled\n", error);
+}
+
+static int j71t_check_owned(struct j71t_charger *charger, u8 *input, u8 *control, u8 *charge)
+{
+	int ret = j71t_read(charger, J71T_INPUT_LIMIT, input);
+
+	if (!ret)
+		ret = j71t_read(charger, J71T_INPUT_CONTROL, control);
+	if (!ret)
+		ret = j71t_read(charger, J71T_CHARGE_CURRENT, charge);
+	if (!ret && (*input != charger->input_code ||
+		     (*control & J71T_INPUT_SUSPEND) || *charge != charger->charge_code))
+		ret = J71T_EREGREADBACK;
+	return ret;
+}
+
+/*
+ * The PMIC changes the input settings on its own shortly after a source
+ * attaches (seen 0.15 s and about 1 s after the first enable, 2026-10-26/27).
+ * Put the active budget back once per window; a second change within the
+ * window is a real ownership fault.
+ */
+static int j71t_reassert(struct j71t_charger *charger, u8 input, u8 control, u8 charge)
+{
+	int ret;
+
+	if (time_before(jiffies, charger->reassert_after))
+		return J71T_EREGREADBACK;
+	charger->reassert_after = jiffies + msecs_to_jiffies(J71T_REASSERT_WINDOW_MS);
+	dev_info(charger->dev,
+		 "charger registers changed (input 0x%02x, control 0x%02x, charge 0x%02x); reasserting the %d mA budget\n",
+		 input, control, charge, charger->budget_ua / 1000);
+	ret = j71t_apply(charger, charger->charge_code, charger->input_code);
+	if (!ret && (control & J71T_INPUT_SUSPEND))
+		ret = j71t_set_suspend(charger, 0);
+	if (!ret)
+		ret = j71t_check_owned(charger, &input, &control, &charge);
+	return ret;
+}
+
+/* A readable hot pack must still trip while another supplier read fails. */
+static int j71t_thermal_floor(struct j71t_charger *charger)
+{
+	u8 cap;
+	int ret = j71t_read(charger, J71T_MAX_CHARGE_CURRENT, &cap);
+
+	if (ret)
+		return ret;
+	if ((cap & 0x3f) < J71T_USB_CHARGE_CODE)
+		return -ERANGE;
+	ret = j71t_apply(charger, J71T_USB_CHARGE_CODE, charger->input_codes[0]);
+	if (!ret) {
+		charger->budget_ua = J71T_FLOOR_UA;
+		charger->charge_code = J71T_USB_CHARGE_CODE;
+		charger->input_code = charger->input_codes[0];
+		charger->retry_after = jiffies + msecs_to_jiffies(J71T_OWNER_RETRY_MS);
+		dev_warn(charger->dev, "thermal floor while another safety sample is unavailable\n");
+	}
+	return ret;
+}
+
+static void j71t_policy_work(struct work_struct *work)
+{
+	struct j71t_charger *charger = container_of(to_delayed_work(work),
+							  struct j71t_charger, work);
+	int ret = 0, target, index, online, previous;
+
+	mutex_lock(&charger->lock);
+	if (charger->stopping)
+		goto out;
+	if (charger->faulted && !time_before(jiffies, charger->fault_until))
+		charger->faulted = false;
+	online = j71t_online(charger);
+	if (!online) {
+		j71t_revoke_override(charger);
+		charger->holding = false;
+		charger->sample_pending = false;
+		ret = j71t_restore(charger);
+		if (!ret)
+			ret = j71t_set_suspend(charger, J71T_INPUT_SUSPEND);
+		goto report;
+	}
+	if (charger->disabled || charger->faulted || !charger->calibrated) {
+		ret = j71t_restore(charger);
+		goto report;
+	}
+	/* A failed rollback must finish before taking a fresh snapshot. */
+	if (charger->saved && !charger->active) {
+		ret = j71t_restore(charger);
+		if (ret)
+			goto report;
+	}
+	if (charger->active) {
+		u8 input = 0, control = 0, charge = 0;
+
+		ret = j71t_check_owned(charger, &input, &control, &charge);
+		if (j71t_is_fault(ret))
+			ret = j71t_reassert(charger, input, control, charge);
+		if (j71t_is_fault(ret))
+			goto restore;
+		if (ret)
+			goto transient;
+	}
+	if (online < 0)
+		goto transient;
+	target = j71t_policy_limit(charger);
+	if (target < 0)
+		goto transient;
+	ret = j71t_battery_safe(charger);
+	if (ret == -EAGAIN)
+		goto transient;
+	if (ret && ret != -EOVERFLOW)
+		goto restore;
+	if (ret == -EOVERFLOW)
+		target = J71T_FLOOR_UA;
+	/* Guard the existing budget before considering a new one. */
+	if (charger->active) {
+		ret = j71t_guard(charger);
+		if (ret == -EOVERFLOW || ret == -ETIME || ret == -EBUSY)
+			target = J71T_FLOOR_UA;
+		else if (ret == -ERANGE && target < charger->budget_ua)
+			ret = 0;
+		else if (ret == -EAGAIN || (ret && ret != -ERANGE && ret != -ENOLINK))
+			goto transient;
+		else if (ret)
+			goto restore;
+	}
+	charger->sample_pending = false;
+	previous = charger->active ? charger->budget_ua : 0;
+	if (target < previous)
+		charger->retry_after = jiffies + msecs_to_jiffies(J71T_OWNER_RETRY_MS);
+	else if (previous && target > previous &&
+		 time_before(jiffies, charger->retry_after))
+		target = previous;
+	index = j71t_choose_budget(target);
+	/* At most one upward step per second, including supplier notifications. */
+	if (index >= 0 && target > previous) {
+		int next = previous ? j71t_choose_budget(previous) + 1 : 0;
+
+		if (previous && time_before(jiffies, charger->ramp_after))
+			goto report;
+		index = min(index, next);
+	}
+	if (index >= 0 && (!charger->active || j71t_budgets_ua[index] != previous)) {
+		charger->budget_ua = j71t_budgets_ua[index];
+		charger->input_code = charger->input_codes[index];
+		charger->charge_code = j71t_charge_code(charger->budget_ua);
+		ret = j71t_enable(charger);
+		if (ret)
+			goto restore;
+		charger->ramp_after = jiffies + msecs_to_jiffies(1000);
+	}
+	goto report;
+transient:
+	/* Source/PMIC transport grace must not mask a valid pack guard. */
+	ret = j71t_battery_safe(charger);
+	if (ret == -ERANGE)
+		goto restore;
+	if (ret == -EOVERFLOW && charger->active && charger->budget_ua > J71T_FLOOR_UA) {
+		ret = j71t_thermal_floor(charger);
+		if (ret)
+			goto restore;
+	}
+	ret = -EAGAIN;
+	if (!charger->sample_pending) {
+		charger->sample_pending = true;
+		charger->sample_until = jiffies + msecs_to_jiffies(J71T_SAMPLE_GRACE_MS);
+	}
+	if (!charger->active || time_before(jiffies, charger->sample_until))
+		goto report;
+	dev_warn(charger->dev, "source/battery sample unavailable for 60 s; restoring handoff\n");
+restore:
+	j71t_fault(charger, ret);
+	if (charger->active)
+		dev_warn(charger->dev, "charging policy stepped down: %d\n", ret);
+	j71t_fault(charger, j71t_restore(charger));
+	charger->retry_after = jiffies + msecs_to_jiffies(J71T_OWNER_RETRY_MS);
+report:
+	j71t_fault(charger, ret);
+	if (charger->faulted)
+		ret = J71T_EREGREADBACK;
+	else if (charger->disabled)
+		ret = -ECANCELED;
+	else if (!charger->calibrated)
+		ret = -ENODATA;
+	j71t_policy_log(charger, ret);
+	mod_delayed_work(system_power_efficient_wq, &charger->work,
+			 msecs_to_jiffies(1000));
+out:
+	mutex_unlock(&charger->lock);
+	if (charger->psy)
+		power_supply_changed(charger->psy);
+}
+
+static int j71t_get_property(struct power_supply *psy, enum power_supply_property prop,
+			     union power_supply_propval *value)
+{
+	struct j71t_charger *charger = power_supply_get_drvdata(psy);
+	u8 raw;
+	int ret, online;
+
+	mutex_lock(&charger->lock);
+	switch (prop) {
+	case POWER_SUPPLY_PROP_ONLINE:
+		online = j71t_online(charger);
+		ret = online < 0 ? online : 0;
+		value->intval = online == 1;
+		break;
+	case POWER_SUPPLY_PROP_USB_TYPE:
+		ret = power_supply_get_property_from_supplier(psy,
+							      POWER_SUPPLY_PROP_USB_TYPE, value);
+		break;
+	case POWER_SUPPLY_PROP_SCOPE:
+		value->intval = POWER_SUPPLY_SCOPE_SYSTEM;
+		ret = 0;
+		break;
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		ret = j71t_read(charger, J71T_INPUT_LIMIT, &raw);
+		if (!ret)
+			value->intval = 75000 + raw * 12500;
+		break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+		ret = j71t_read(charger, J71T_CHARGE_CURRENT, &raw);
+		if (!ret)
+			value->intval = raw * 50000;
+		break;
+	case POWER_SUPPLY_PROP_STATUS:
+		ret = j71t_read(charger, J71T_STATUS, &raw);
+		online = j71t_online(charger);
+		if (!ret) {
+			value->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
+			if (online == 1 && !(raw & (J71T_CHARGE_TIMEOUT | J71T_CHARGE_END)) &&
+			    (raw & 3))
+				value->intval = POWER_SUPPLY_STATUS_CHARGING;
+		}
+		break;
+	default:
+		ret = -EINVAL;
+	}
+	mutex_unlock(&charger->lock);
+	return ret;
+}
+
+static int j71t_set_property(struct power_supply *psy, enum power_supply_property prop,
+			     const union power_supply_propval *value)
+{
+	struct j71t_charger *charger = power_supply_get_drvdata(psy);
+	int ret = 0;
+
+	if (prop != POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT || value->intval < 0 ||
+	    (value->intval && j71t_valid_limit(value->intval) != value->intval))
+		return -EINVAL;
+	mutex_lock(&charger->lock);
+	if (charger->stopping) {
+		ret = -ESHUTDOWN;
+	} else if (value->intval > charger->max_limit_ua) {
+		ret = -EINVAL;
+	} else if (!value->intval) {
+		charger->disabled = true;
+		j71t_revoke_override(charger);
+		ret = j71t_restore(charger);
+		/* Target zero is a real disable, never a budget-change ritual. */
+		if (!ret)
+			ret = j71t_set_suspend(charger, J71T_INPUT_SUSPEND);
+	} else {
+		charger->disabled = false;
+		charger->user_limit_ua = value->intval;
+		/* Authorization persists across deferred guards; work applies it. */
+		dev_info(charger->dev, "owner authorizes %d mA input\n", value->intval / 1000);
+	}
+	j71t_fault(charger, ret);
+	if (!charger->stopping)
+		mod_delayed_work(system_power_efficient_wq, &charger->work, 0);
+	mutex_unlock(&charger->lock);
+	power_supply_changed(psy);
+	return ret;
+}
+
+static int j71t_property_writeable(struct power_supply *psy, enum power_supply_property prop)
+{
+	return prop == POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT;
+}
+
+static void j71t_external_power_changed(struct power_supply *psy)
+{
+	struct j71t_charger *charger = power_supply_get_drvdata(psy);
+
+	mutex_lock(&charger->lock);
+	if (!charger->stopping)
+		mod_delayed_work(system_power_efficient_wq, &charger->work, 0);
+	mutex_unlock(&charger->lock);
+}
+
+static const enum power_supply_property j71t_properties[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_USB_TYPE,
+	POWER_SUPPLY_PROP_SCOPE,
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
+	POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT,
+};
+
+static const struct power_supply_desc j71t_desc = {
+	.name = "charger",
+	.type = POWER_SUPPLY_TYPE_USB,
+	.usb_types = BIT(POWER_SUPPLY_USB_TYPE_UNKNOWN) | BIT(POWER_SUPPLY_USB_TYPE_SDP) |
+		     BIT(POWER_SUPPLY_USB_TYPE_APPLE_BRICK_ID) | BIT(POWER_SUPPLY_USB_TYPE_ACA),
+	.properties = j71t_properties,
+	.num_properties = ARRAY_SIZE(j71t_properties),
+	.get_property = j71t_get_property,
+	.set_property = j71t_set_property,
+	.property_is_writeable = j71t_property_writeable,
+	.external_power_changed = j71t_external_power_changed,
+};
+
+static int j71t_probe(struct platform_device *pdev)
+{
+	struct power_supply_config config = {};
+	const struct firmware *fw;
+	struct j71t_charger *charger;
+	u32 limit;
+	int ret, i;
+
+	charger = devm_kzalloc(&pdev->dev, sizeof(*charger), GFP_KERNEL);
+	if (!charger)
+		return -ENOMEM;
+	charger->dev = &pdev->dev;
+	charger->map = dev_get_regmap(pdev->dev.parent, NULL);
+	if (!charger->map)
+		return -ENODEV;
+	ret = devm_mutex_init(&pdev->dev, &charger->lock);
+	if (ret)
+		return ret;
+	ret = devm_delayed_work_autocancel(&pdev->dev, &charger->work, j71t_policy_work);
+	if (ret)
+		return ret;
+	ret = request_firmware_direct(&fw, "apple/j71t-CBAT.bin", &pdev->dev);
+	if (!ret) {
+		for (i = 0; i < ARRAY_SIZE(j71t_budgets_ua); i++) {
+			if (j71t_budgets_ua[i] == J71T_REQUEST_UA)
+				ret = j71t_calibrate(fw->data, fw->size, &charger->input_codes[i]);
+			else
+				ret = j71t_calibrate_budget(fw->data, fw->size,
+							    j71t_budgets_ua[i] / 1000,
+							    &charger->input_codes[i]);
+			if (ret)
+				break;
+		}
+		release_firmware(fw);
+		charger->calibrated = !ret;
+	}
+	if (ret)
+		dev_warn(&pdev->dev,
+			 "CBAT unavailable/unsupported (%d): charging writes disabled\n", ret);
+	charger->reassert_after = jiffies;
+	charger->max_limit_ua = J71T_FLOOR_UA;
+	if (!of_property_read_u32(pdev->dev.of_node,
+				  "apple,usb-input-limit-max-microamp", &limit))
+		charger->max_limit_ua = j71t_valid_limit(limit);
+	if (!of_property_read_u32(pdev->dev.of_node,
+				  "apple,owner-input-limit-microamp", &limit))
+		charger->user_limit_ua = min(charger->max_limit_ua, j71t_valid_limit(limit));
+	config.drv_data = charger;
+	config.fwnode = dev_fwnode(&pdev->dev);
+	charger->psy = devm_power_supply_register(&pdev->dev, &j71t_desc, &config);
+	if (IS_ERR(charger->psy))
+		return dev_err_probe(&pdev->dev, PTR_ERR(charger->psy),
+				     "charger supply registration\n");
+	platform_set_drvdata(pdev, charger);
+	mod_delayed_work(system_power_efficient_wq, &charger->work, 0);
+	dev_info(&pdev->dev, "J71t charger: automatic guarded source-current policy\n");
+	return 0;
+}
+
+static int j71t_quiesce(struct device *dev)
+{
+	struct j71t_charger *charger = dev_get_drvdata(dev);
+	int attempt, ret = 0;
+
+	mutex_lock(&charger->lock);
+	charger->stopping = true;
+	mutex_unlock(&charger->lock);
+	cancel_delayed_work_sync(&charger->work);
+	for (attempt = 0; attempt < 3; attempt++) {
+		mutex_lock(&charger->lock);
+		ret = j71t_restore(charger);
+		mutex_unlock(&charger->lock);
+		if (!ret)
+			break;
+		msleep(20);
+	}
+	if (ret)
+		dev_crit(charger->dev, "charger restore failed at shutdown/remove: %d\n", ret);
+	return ret;
+}
+
+static void j71t_stop(struct platform_device *pdev)
+{
+	j71t_quiesce(&pdev->dev);
+}
+
+static int j71t_resume(struct device *dev)
+{
+	struct j71t_charger *charger = dev_get_drvdata(dev);
+
+	mutex_lock(&charger->lock);
+	charger->stopping = false;
+	mod_delayed_work(system_power_efficient_wq, &charger->work, 0);
+	mutex_unlock(&charger->lock);
+	return 0;
+}
+
+static int j71t_suspend(struct device *dev)
+{
+	int ret = j71t_quiesce(dev);
+
+	/* A failed suspend need not receive resume; keep rollback retries alive. */
+	if (ret)
+		j71t_resume(dev);
+	return ret;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(j71t_pm_ops, j71t_suspend, j71t_resume);
+
+static const struct of_device_id j71t_match[] = {
+	{ .compatible = "apple,j71t-d2365-charger" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, j71t_match);
+
+static struct platform_driver j71t_driver = {
+	.probe = j71t_probe,
+	.remove = j71t_stop,
+	.shutdown = j71t_stop,
+	.driver = {
+		.name = "apple-j71t-charger",
+		.of_match_table = j71t_match,
+		.pm = pm_sleep_ptr(&j71t_pm_ops),
+	},
+};
+module_platform_driver(j71t_driver);
+MODULE_DESCRIPTION("Source-aware guarded Apple J71t D2365 charging policy");
+MODULE_LICENSE("GPL");
diff --git a/drivers/power/supply/apple_tristar_auto.h b/drivers/power/supply/apple_tristar_auto.h
new file mode 100644
index 0000000000000000000000000000000000000000..1b34eb423913f7c7e86fd0ef77960c523092c772
--- /dev/null
+++ b/drivers/power/supply/apple_tristar_auto.h
@@ -0,0 +1,326 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * J71t Lightning accessory policy: camera adapter to USB host mode.
+ *
+ * iOS 16.7.10 on this unit (2026-10-27 capture, DigitalID 11 f0 00 00 00 00):
+ * about 1 s after the ID, IOAccessoryManagerUserClient selector 1 calls
+ * configureUSBMode(2). IOAccessoryManager_updateUSBConnectType maps mode 2
+ * to ConnectType 4 "Device", the connect shim publishes AppleUSBCableType
+ * USBDevice, and the arbitrator applies publish mask 5: EHCI and OHCI are
+ * published and the device nub stays. The adapter's hub enumerates at high
+ * speed. There is no device-mode or iAP phase. The power handshake follows,
+ * and the input limit is then 2100 mA at 5 V while the iPad is the host.
+ *
+ * This file holds only the decisions, so the offline harness runs the same
+ * code as the kernel. The driver does all I/O and reports the results.
+ * Times are milliseconds and may wrap.
+ */
+#ifndef APPLE_TRISTAR_AUTO_H
+#define APPLE_TRISTAR_AUTO_H
+
+/* CBTL1610 0x0c: both low bits are strict VBUS, bit 7 an attached plug. */
+#define TRISTAR_AUTO_VBUS		0x03
+#define TRISTAR_AUTO_PRESENT		0x80
+#define TRISTAR_AUTO_ORIENTATION	0x40
+#define TRISTAR_AUTO_ID_LEN		6
+
+enum tristar_auto_phase {
+	TRISTAR_AUTO_OFF,	/* policy disabled */
+	TRISTAR_AUTO_EMPTY,	/* nothing attached */
+	TRISTAR_AUTO_DEVICE,	/* attached, device role, GetID pending */
+	TRISTAR_AUTO_OTHER,	/* identified, not a host-mode accessory */
+	TRISTAR_AUTO_HANDSHAKE,	/* host adapter identified, 0x72/0x70 next */
+	TRISTAR_AUTO_ENTER,	/* switch to host requested */
+	TRISTAR_AUTO_HOST,	/* host role, owned by this policy */
+	TRISTAR_AUTO_INHIBIT,	/* role taken over or entry failed; wait for unplug */
+};
+
+enum tristar_auto_action {
+	TRISTAR_AUTO_NONE,
+	TRISTAR_AUTO_PROBE,		/* GetID without reorient */
+	TRISTAR_AUTO_POWER_HANDSHAKE,
+	TRISTAR_AUTO_TO_HOST,
+	TRISTAR_AUTO_TO_DEVICE,
+};
+
+struct tristar_auto_cfg {
+	unsigned int probe_ms;		/* GetID period, no active USB link */
+	unsigned int busy_probe_ms;	/* ... while a USB host uses the gadget */
+	unsigned int verify_ms;		/* host role: re-check the ID */
+	unsigned int settle_ms;		/* after a plug edge */
+	unsigned int detach_polls;	/* consecutive empty 0x0c reads */
+	unsigned int handshake_tries;
+	int input_ua;			/* host role, after a good power handshake */
+	int floor_ua;			/* host role, no power handshake */
+};
+
+struct tristar_auto {
+	enum tristar_auto_phase phase;
+	int status;			/* last good 0x0c, or -1 */
+	unsigned int empty;		/* consecutive empty 0x0c reads */
+	bool was_empty;			/* the previous read was empty */
+	unsigned long next_probe;
+	u8 id[TRISTAR_AUTO_ID_LEN];
+	bool id_valid;
+	bool adapter;			/* id selects host mode */
+	int id_status;			/* last GetID result */
+	int ph_status;			/* last power handshake, 1 = not run */
+	unsigned int ph_tries;
+	bool ph_ok;
+	unsigned int probes;
+	unsigned int probe_errors;
+	unsigned int host_entries;
+	unsigned int role_errors;
+	unsigned int detaches;
+	unsigned int inhibits;
+};
+
+struct tristar_auto_in {
+	unsigned long now;
+	int status;		/* 0x0c or -errno */
+	bool enabled;
+	bool host;		/* the role switch is in host mode */
+	bool owned;		/* ... on this policy's request */
+	bool link_active;	/* a USB host configured the gadget, not suspended */
+};
+
+static inline bool tristar_auto_due(unsigned long now, unsigned long when)
+{
+	return (long)(now - when) >= 0;
+}
+
+/* The camera adapter, DigitalID 11 f0 ..: USB=2 UART=1 PWR=0xf. */
+static inline bool tristar_auto_is_host_adapter(const u8 *id)
+{
+	return id[0] == 0x11 && id[1] == 0xf0;
+}
+
+static inline bool tristar_auto_attached(int status)
+{
+	return status >= 0 && (status & (TRISTAR_AUTO_PRESENT | TRISTAR_AUTO_VBUS));
+}
+
+static inline const char *tristar_auto_phase_name(enum tristar_auto_phase phase)
+{
+	static const char *const names[] = {
+		[TRISTAR_AUTO_OFF] = "off",
+		[TRISTAR_AUTO_EMPTY] = "empty",
+		[TRISTAR_AUTO_DEVICE] = "device",
+		[TRISTAR_AUTO_OTHER] = "other",
+		[TRISTAR_AUTO_HANDSHAKE] = "handshake",
+		[TRISTAR_AUTO_ENTER] = "enter-host",
+		[TRISTAR_AUTO_HOST] = "host",
+		[TRISTAR_AUTO_INHIBIT] = "inhibit",
+	};
+
+	return (unsigned int)phase < ARRAY_SIZE(names) ? names[phase] : "?";
+}
+
+static inline void tristar_auto_forget(struct tristar_auto *ta)
+{
+	ta->id_valid = false;
+	ta->adapter = false;
+	ta->ph_ok = false;
+	ta->ph_status = 1;
+	ta->ph_tries = 0;
+}
+
+static inline void tristar_auto_init(struct tristar_auto *ta)
+{
+	*ta = (struct tristar_auto){ .phase = TRISTAR_AUTO_OFF, .status = -1, .ph_status = 1 };
+}
+
+/* One poll. The caller then runs the returned action and reports back. */
+static inline enum tristar_auto_action
+tristar_auto_step(struct tristar_auto *ta, const struct tristar_auto_cfg *cfg,
+		  const struct tristar_auto_in *in)
+{
+	const int plug_bits = TRISTAR_AUTO_PRESENT | TRISTAR_AUTO_ORIENTATION;
+	bool attached, edge, replug;
+	int prev;
+
+	if (!in->enabled) {
+		ta->phase = TRISTAR_AUTO_OFF;
+		return TRISTAR_AUTO_NONE;
+	}
+	if (ta->phase == TRISTAR_AUTO_OFF) {
+		ta->phase = TRISTAR_AUTO_EMPTY;
+		ta->empty = 0;
+		ta->was_empty = false;
+		ta->status = -1;
+		tristar_auto_forget(ta);
+	}
+	/* An I2C error is no evidence either way. */
+	if (in->status < 0)
+		return TRISTAR_AUTO_NONE;
+
+	attached = tristar_auto_attached(in->status);
+	prev = ta->status;
+	ta->status = in->status;
+	replug = attached && ta->was_empty;
+	ta->was_empty = !attached;
+	ta->empty = attached ? 0 : ta->empty + 1;
+	edge = replug || (prev >= 0 && attached && ((prev ^ in->status) & plug_bits));
+
+	if (ta->empty >= cfg->detach_polls && ta->phase != TRISTAR_AUTO_EMPTY) {
+		bool release = ta->phase == TRISTAR_AUTO_HOST && in->host && in->owned;
+
+		ta->phase = TRISTAR_AUTO_EMPTY;
+		tristar_auto_forget(ta);
+		if (release) {
+			ta->detaches++;
+			return TRISTAR_AUTO_TO_DEVICE;
+		}
+		return TRISTAR_AUTO_NONE;
+	}
+
+	switch (ta->phase) {
+	case TRISTAR_AUTO_EMPTY:
+		if (attached) {
+			ta->phase = TRISTAR_AUTO_DEVICE;
+			ta->next_probe = in->now + cfg->settle_ms;
+		}
+		return TRISTAR_AUTO_NONE;
+	case TRISTAR_AUTO_DEVICE:
+	case TRISTAR_AUTO_OTHER:
+		/* A host role someone else asked for is theirs to end. */
+		if (!attached || in->host)
+			return TRISTAR_AUTO_NONE;
+		if (edge) {
+			ta->phase = TRISTAR_AUTO_DEVICE;
+			ta->next_probe = in->now + cfg->settle_ms;
+		}
+		if (!tristar_auto_due(in->now, ta->next_probe))
+			return TRISTAR_AUTO_NONE;
+		ta->next_probe = in->now + (in->link_active ? cfg->busy_probe_ms : cfg->probe_ms);
+		ta->probes++;
+		return TRISTAR_AUTO_PROBE;
+	case TRISTAR_AUTO_HANDSHAKE:
+		return TRISTAR_AUTO_POWER_HANDSHAKE;
+	case TRISTAR_AUTO_ENTER:
+		if (in->host && in->owned) {
+			ta->phase = TRISTAR_AUTO_HOST;
+			return TRISTAR_AUTO_NONE;
+		}
+		return TRISTAR_AUTO_TO_HOST;
+	case TRISTAR_AUTO_HOST:
+		if (!in->host || !in->owned) {
+			ta->phase = TRISTAR_AUTO_INHIBIT;
+			ta->inhibits++;
+			return TRISTAR_AUTO_NONE;
+		}
+		if (!attached)
+			return TRISTAR_AUTO_NONE;
+		if (edge || tristar_auto_due(in->now, ta->next_probe)) {
+			ta->next_probe = in->now + cfg->verify_ms;
+			ta->probes++;
+			return TRISTAR_AUTO_PROBE;
+		}
+		return TRISTAR_AUTO_NONE;
+	case TRISTAR_AUTO_INHIBIT:
+	case TRISTAR_AUTO_OFF:
+		break;
+	}
+	return TRISTAR_AUTO_NONE;
+}
+
+/* GetID finished: ret 0 with a valid id, or -errno. */
+static inline enum tristar_auto_action
+tristar_auto_probed(struct tristar_auto *ta, const struct tristar_auto_cfg *cfg,
+		    unsigned long now, int ret, const u8 *id)
+{
+	bool adapter;
+
+	ta->id_status = ret;
+	if (ta->phase != TRISTAR_AUTO_DEVICE && ta->phase != TRISTAR_AUTO_OTHER &&
+	    ta->phase != TRISTAR_AUTO_HOST)
+		return TRISTAR_AUTO_NONE;
+	if (ret) {
+		ta->probe_errors++;
+		return TRISTAR_AUTO_NONE;
+	}
+	adapter = tristar_auto_is_host_adapter(id);
+	memcpy(ta->id, id, TRISTAR_AUTO_ID_LEN);
+	ta->id_valid = true;
+	if (ta->phase == TRISTAR_AUTO_HOST) {
+		if (adapter)
+			return TRISTAR_AUTO_NONE;
+		/* A fast swap to another accessory, e.g. the Mac cable. */
+		ta->adapter = false;
+		ta->ph_ok = false;
+		ta->phase = TRISTAR_AUTO_OTHER;
+		ta->next_probe = now + cfg->probe_ms;
+		ta->detaches++;
+		return TRISTAR_AUTO_TO_DEVICE;
+	}
+	ta->adapter = adapter;
+	if (!adapter) {
+		ta->phase = TRISTAR_AUTO_OTHER;
+		return TRISTAR_AUTO_NONE;
+	}
+	ta->phase = TRISTAR_AUTO_HANDSHAKE;
+	ta->ph_status = 1;
+	ta->ph_tries = 0;
+	ta->ph_ok = false;
+	return TRISTAR_AUTO_POWER_HANDSHAKE;
+}
+
+/*
+ * Power handshake finished. iOS enumerated the hub before its handshake
+ * completed, so host mode does not wait for it: after the last try the port
+ * becomes a host anyway, with the floor input budget.
+ */
+static inline enum tristar_auto_action
+tristar_auto_handshake_done(struct tristar_auto *ta, const struct tristar_auto_cfg *cfg,
+			    int ret)
+{
+	if (ta->phase != TRISTAR_AUTO_HANDSHAKE)
+		return TRISTAR_AUTO_NONE;
+	ta->ph_tries++;
+	ta->ph_status = ret;
+	ta->ph_ok = !ret;
+	if (ret && ta->ph_tries < cfg->handshake_tries)
+		return TRISTAR_AUTO_NONE;
+	ta->phase = TRISTAR_AUTO_ENTER;
+	return TRISTAR_AUTO_TO_HOST;
+}
+
+static inline void tristar_auto_role_done(struct tristar_auto *ta,
+					  const struct tristar_auto_cfg *cfg,
+					  unsigned long now, bool to_host, int ret)
+{
+	if (!to_host)
+		return;
+	if (ta->phase != TRISTAR_AUTO_ENTER)
+		return;
+	if (ret) {
+		/* No retry loop: the next unplug starts over. */
+		ta->role_errors++;
+		ta->phase = TRISTAR_AUTO_INHIBIT;
+		return;
+	}
+	ta->phase = TRISTAR_AUTO_HOST;
+	ta->host_entries++;
+	ta->next_probe = now + cfg->verify_ms;
+}
+
+/*
+ * Input power while the adapter is ours. iOS: PowerHandshake Yes, USBPower
+ * Yes, 2100 mA at 5 V in host mode. Returns false when the ordinary
+ * device-mode rules apply.
+ */
+static inline bool tristar_auto_supply(const struct tristar_auto *ta,
+				       const struct tristar_auto_cfg *cfg, int status,
+				       int *online, int *current_ua)
+{
+	if (!ta->id_valid || !ta->adapter)
+		return false;
+	if (ta->phase != TRISTAR_AUTO_HANDSHAKE && ta->phase != TRISTAR_AUTO_ENTER &&
+	    ta->phase != TRISTAR_AUTO_HOST)
+		return false;
+	*online = status >= 0 && (status & TRISTAR_AUTO_VBUS) == TRISTAR_AUTO_VBUS;
+	*current_ua = !*online ? 0 : ta->ph_ok ? cfg->input_ua : cfg->floor_ua;
+	return true;
+}
+
+#endif /* APPLE_TRISTAR_AUTO_H */
diff --git a/drivers/power/supply/apple_tristar_idbus.h b/drivers/power/supply/apple_tristar_idbus.h
new file mode 100644
index 0000000000000000000000000000000000000000..ed20e4d8a28093b1e35ed4dfd7ac9bee24e64f38
--- /dev/null
+++ b/drivers/power/supply/apple_tristar_idbus.h
@@ -0,0 +1,957 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * CBTL1610 (Tristar) Lightning ID-bus master, driven over I2C, as
+ * reconstructed from the iOS 16.7.10 J71t kernelcache (AppleCBTL1610 and
+ * AppleTriStarIC) and corrected by the 2026-10-26 hardware trial. Tristar
+ * clocks the wire, frames BREAKs and appends the request CRC itself. The
+ * host prepares the engine (0x60 = 0x01), loads the TX window that ends at
+ * 0x60 (request bytes reversed, then the RX length byte at 0x60), reads it
+ * back, writes GO to 0x61 and reads the response forward from the RX window
+ * at 0x20.
+ *
+ * The RX window is never written: on this IC a write there overwrites the
+ * retained response. 0x20/0x40/0x41 are another Tristar generation's
+ * transfer registers and are inert here.
+ *
+ * All register access goes through struct tristar_idbus_ops so that the
+ * offline harness runs this exact code against a fake register file. The
+ * includer provides u8, bool, size_t, memcpy, memcmp, memset, snprintf,
+ * __printf and the errno values.
+ *
+ * Safety envelope: only volatile registers 0x05, 0x0a and the TX window
+ * 0x5d..0x61 are written. The RX window 0x20..0x27, 0x17 (AID switch
+ * config), 0x0e (detect latch), the mux registers 0x01..0x03 and every
+ * OTP/ESN request stay untouched.
+ */
+#ifndef APPLE_TRISTAR_IDBUS_H
+#define APPLE_TRISTAR_IDBUS_H
+
+#define TRISTAR_IDBUS_REG_DXCTRL	0x01
+#define TRISTAR_IDBUS_REG_ACCMUX	0x02
+/* bit 0 VBUS sink, bit 1 reorient, bit 2 BREAK, bit 3 ID-bus reset hold */
+#define TRISTAR_IDBUS_REG_CTRL		0x05
+#define TRISTAR_IDBUS_CTRL_REORIENT	0x02
+#define TRISTAR_IDBUS_CTRL_RESET	0x08
+/* Pin faults: bit 0 ACC1, bit 3 ACC2, bit 1 DP1/DN1, bit 2 DP2/DN2 */
+#define TRISTAR_IDBUS_REG_FAULT		0x0a
+#define TRISTAR_IDBUS_FAULT_PINS	0x0f
+#define TRISTAR_IDBUS_REG_STATUS	0x0c
+#define TRISTAR_IDBUS_REG_EVENT		0x0d
+#define TRISTAR_IDBUS_REG_REVISION	0x0f
+#define TRISTAR_IDBUS_REG_AIDSW		0x17
+#define TRISTAR_IDBUS_REG_RX		0x20	/* response, forward; read only */
+#define TRISTAR_IDBUS_REG_TX_END	0x60	/* RX length byte; prepare */
+#define TRISTAR_IDBUS_REG_GO		0x61	/* ((tx - 1) << 1) | 1 */
+#define TRISTAR_IDBUS_TX_PREPARE	0x01
+#define TRISTAR_IDBUS_REVISION_J71T	0x8a
+
+#define TRISTAR_IDBUS_EV_DETECT		0x01
+#define TRISTAR_IDBUS_EV_WAKE		0x02
+#define TRISTAR_IDBUS_EV_RESET		0x04
+#define TRISTAR_IDBUS_EV_DIGITAL_ID	0x08
+#define TRISTAR_IDBUS_EV_DONE		0x10
+#define TRISTAR_IDBUS_EV_ERROR		0x20
+#define TRISTAR_IDBUS_EV_TIMEOUT	0x40
+#define TRISTAR_IDBUS_EV_FAULT		0x80
+#define TRISTAR_IDBUS_EV_DONE_MASK	0x38
+
+#define TRISTAR_IDBUS_GET_ID		0x74
+#define TRISTAR_IDBUS_ID		0x75
+#define TRISTAR_IDBUS_ID_LEN		6
+#define TRISTAR_IDBUS_HOSTID		0x0002	/* IOAccessoryManagerSystemID */
+#define TRISTAR_IDBUS_POWER		0x70
+#define TRISTAR_IDBUS_POWER_ACK		0x71
+#define TRISTAR_IDBUS_GET_STATE		0x72
+#define TRISTAR_IDBUS_STATE		0x73
+#define TRISTAR_IDBUS_POWER_RETRY	0x08	/* 0x70 flags bit on iOS's retry path */
+#define TRISTAR_IDBUS_MAX_TX		3	/* 0x5d..0x5f; 0x60 holds the RX length */
+#define TRISTAR_IDBUS_MAX_FRAME		8
+
+#define TRISTAR_IDBUS_POLL_MS		10
+#define TRISTAR_IDBUS_POLL_STEPS	10	/* 100 ms per transfer */
+#define TRISTAR_IDBUS_SETTLE_MS		20
+#define TRISTAR_IDBUS_REORIENT_STEPS	3	/* 20 + 3 * 10 = 50 ms after a reorient */
+#define TRISTAR_IDBUS_RESET_HOLD_MS	500	/* AppleCBTL1610 reset pulse */
+#define TRISTAR_IDBUS_CMDID_GAP_MS	100	/* iOS idCommandTooFast */
+
+/* Identify mode flags (manual variants; never applied automatically) */
+#define TRISTAR_IDBUS_SWAP_HOSTID	0x1
+#define TRISTAR_IDBUS_NO_REORIENT	0x2
+
+/* Link recovery steps (ds-lightning-host-idbus.md 9.6) */
+#define TRISTAR_IDBUS_RECOVER_REORIENT	0
+#define TRISTAR_IDBUS_RECOVER_RESET	1
+#define TRISTAR_IDBUS_RECOVER_FAULT_ACK	2
+
+struct tristar_idbus_ops {
+	/* One register: value 0..255 or -errno */
+	int (*read)(void *ctx, u8 reg);
+	int (*write)(void *ctx, u8 reg, u8 val);
+	/* Bus-atomic read, write (old & ~clear) | set; returns old or -errno */
+	int (*update)(void *ctx, u8 reg, u8 clear, u8 set);
+	/* len bytes upward from reg, one I2C transaction each; 0 or -errno */
+	int (*block_read)(void *ctx, u8 reg, u8 *buf, unsigned int len);
+	int (*block_write)(void *ctx, u8 reg, const u8 *buf, unsigned int len);
+	void (*sleep_ms)(void *ctx, unsigned int ms);
+	void (*log)(void *ctx, const char *fmt, ...) __printf(2, 3);
+};
+
+struct tristar_idbus {
+	const struct tristar_idbus_ops *ops;
+	void *ctx;
+	/* First I/O error of the current run; every later access is refused */
+	int io_error;
+	/* Most recent values seen; 0 until read */
+	u8 last_ctrl;
+	u8 last_event;
+	u8 last_fault;
+	u8 events;		/* OR of every event-register read */
+	unsigned int faults;	/* pin-fault acknowledgements */
+};
+
+static const u8 tristar_idbus_baseline_regs[] = {
+	TRISTAR_IDBUS_REG_STATUS, TRISTAR_IDBUS_REG_EVENT, TRISTAR_IDBUS_REG_CTRL,
+	TRISTAR_IDBUS_REG_DXCTRL, TRISTAR_IDBUS_REG_ACCMUX, TRISTAR_IDBUS_REG_AIDSW,
+	TRISTAR_IDBUS_REG_FAULT,
+};
+
+#define TRISTAR_IDBUS_NBASE	ARRAY_SIZE(tristar_idbus_baseline_regs)
+
+struct tristar_idbus_id_result {
+	int status;
+	unsigned int flags;
+	unsigned int attempts;			/* GetID commands started */
+	bool released_reset;
+	bool reoriented;
+	bool autonomous;			/* ID from the reorient-armed exchange */
+	u8 baseline[TRISTAR_IDBUS_NBASE];
+	u8 retained[TRISTAR_IDBUS_MAX_FRAME];	/* RX window before this run */
+	bool retained_ok;			/* ... and a valid 0x75 frame */
+	u8 reorient_frame[TRISTAR_IDBUS_MAX_FRAME];	/* RX right after the reorient */
+	bool reorient_read;
+	int reorient_status;			/* verdict, or -ESTALE */
+	u8 reorient_events;			/* 0x0d OR after the reorient */
+	u8 frame[TRISTAR_IDBUS_MAX_FRAME];	/* the response, kept if bad */
+	unsigned int frame_len;
+	int frame_status;			/* header/CRC verdict */
+	u8 orientation;				/* 0x0c read with the frame */
+	u8 id[TRISTAR_IDBUS_ID_LEN];
+	bool id_valid;
+};
+
+struct tristar_idbus_ph_result {
+	int status;
+	u8 state[6];		/* 0x73 + 4 bytes + CRC */
+	bool state_ok;
+	u8 request[3];		/* the 0x70 frame sent */
+	u8 ack[2];		/* 0x71 + CRC */
+	bool ack_ok;
+};
+
+struct tristar_idbus_recover_result {
+	int status;
+	unsigned int action;
+	int status_before;	/* 0x0c, or -1 if not read */
+	int status_after;
+	u8 events;		/* 0x0d OR after a reorient */
+	u8 fault;		/* 0x0a read by fault_ack */
+	u8 before[TRISTAR_IDBUS_MAX_FRAME];	/* RX window before a reorient */
+	u8 frame[TRISTAR_IDBUS_MAX_FRAME];	/* ... and after */
+	bool frame_read;
+	int frame_status;
+};
+
+struct tristar_idbus_fields {
+	u8 usb, accx, db, mb, uart;
+	u8 pwr, hv, ai, au;
+	u8 pu, bp, cc, bd;
+	u8 po, hs, hpm;
+};
+
+/* Generator 0x8c (0x31 reflected), LSB first. Seed 0xff on the wire. */
+static u8 tristar_idbus_crc8_seed(u8 crc, const u8 *buf, unsigned int len)
+{
+	unsigned int i;
+
+	while (len--) {
+		crc ^= *buf++;
+		for (i = 0; i < 8; i++)
+			crc = (crc >> 1) ^ ((crc & 1) ? 0x8c : 0);
+	}
+	return crc;
+}
+
+static u8 tristar_idbus_crc8(const u8 *buf, unsigned int len)
+{
+	return tristar_idbus_crc8_seed(0xff, buf, len);
+}
+
+/* A response is type + rx_len - 1 data bytes + CRC over the first rx_len. */
+static int tristar_idbus_check_frame(const u8 *frame, unsigned int rx_len, u8 type)
+{
+	if (frame[0] != type)
+		return -EPROTO;
+	if (tristar_idbus_crc8(frame, rx_len) != frame[rx_len])
+		return -EBADMSG;
+	return 0;
+}
+
+static const char *tristar_idbus_verdict(int verdict)
+{
+	return verdict == -EPROTO ? "bad header" : verdict == -EBADMSG ? "bad CRC" :
+	       verdict == -ESTALE ? "same as the retained frame, no completion event" :
+	       verdict ? "not read" : "header and CRC ok";
+}
+
+static const char *tristar_idbus_recover_name(unsigned int action)
+{
+	return action == TRISTAR_IDBUS_RECOVER_REORIENT ? "reorient" :
+	       action == TRISTAR_IDBUS_RECOVER_RESET ? "idbus_reset" :
+	       action == TRISTAR_IDBUS_RECOVER_FAULT_ACK ? "fault_ack" : "unknown";
+}
+
+/* IOAccessoryManagerAID::handleDigitalID field split */
+static void tristar_idbus_decode(const u8 *id, struct tristar_idbus_fields *f)
+{
+	f->accx = id[0] >> 6;
+	f->db = (id[0] >> 5) & 1;
+	f->usb = (id[0] >> 3) & 3;
+	f->mb = (id[0] >> 2) & 1;
+	f->uart = id[0] & 3;
+	f->pwr = id[1] >> 4;
+	f->hv = (id[1] >> 2) & 3;
+	f->ai = (id[1] >> 1) & 1;
+	f->au = id[1] & 1;
+	f->pu = id[2] >> 7;
+	f->bp = (id[2] >> 6) & 1;
+	f->cc = (id[2] >> 3) & 1;
+	f->bd = id[2] & 1;
+	f->po = id[3] >> 7;
+	f->hs = (id[3] >> 4) & 7;
+	f->hpm = id[3] & 7;
+}
+
+/* iOS's own log order and names */
+static int tristar_idbus_format_fields(const u8 *id, char *buf, size_t size)
+{
+	struct tristar_idbus_fields f;
+
+	tristar_idbus_decode(id, &f);
+	return snprintf(buf, size,
+			"USB=%x ACCx=%x DB=%x MB=%x UART=%x PWR=%x HV=%x AI=%x AU=%x PU=%x BP=%x PO=%x CC=%x BD=%x HS=%x HPM=%x",
+			f.usb, f.accx, f.db, f.mb, f.uart, f.pwr, f.hv, f.ai, f.au,
+			f.pu, f.bp, f.po, f.cc, f.bd, f.hs, f.hpm);
+}
+
+static int tristar_idbus_format_hex(const u8 *data, unsigned int len, char *buf, size_t size)
+{
+	unsigned int i;
+	int n = 0;
+
+	if (size)
+		buf[0] = '\0';
+	for (i = 0; i < len && (size_t)n + 3 < size; i++)
+		n += snprintf(buf + n, size - n, i ? " %02x" : "%02x", data[i]);
+	return n;
+}
+
+static void tristar_idbus_log_status(struct tristar_idbus *ib, const char *when, int val)
+{
+	ib->ops->log(ib->ctx, "0x0c %s: 0x%02x (VBUS %s, bit7 %u, orientation bit6 %u)", when, val,
+		     (val & 3) == 3 ? "present" : "absent", (val >> 7) & 1, (val >> 6) & 1);
+}
+
+/*
+ * Register access. The first I/O error is kept in ib->io_error and refuses
+ * every later access of the run, so nothing is written after a failure.
+ */
+static int tristar_idbus_fail(struct tristar_idbus *ib, int err)
+{
+	if (!ib->io_error)
+		ib->io_error = err;
+	return err;
+}
+
+static int tristar_idbus_read(struct tristar_idbus *ib, u8 reg)
+{
+	int ret;
+
+	if (ib->io_error)
+		return ib->io_error;
+	ret = ib->ops->read(ib->ctx, reg);
+	if (ret < 0) {
+		ib->ops->log(ib->ctx, "read 0x%02x failed: %d", reg, ret);
+		return tristar_idbus_fail(ib, ret);
+	}
+	if (reg == TRISTAR_IDBUS_REG_CTRL)
+		ib->last_ctrl = ret;
+	else if (reg == TRISTAR_IDBUS_REG_FAULT)
+		ib->last_fault = ret;
+	return ret;
+}
+
+static int tristar_idbus_write(struct tristar_idbus *ib, u8 reg, u8 val)
+{
+	int ret;
+
+	if (ib->io_error)
+		return ib->io_error;
+	ret = ib->ops->write(ib->ctx, reg, val);
+	if (ret) {
+		ib->ops->log(ib->ctx, "write 0x%02x = 0x%02x failed: %d", reg, val, ret);
+		return tristar_idbus_fail(ib, ret);
+	}
+	return 0;
+}
+
+static int tristar_idbus_block_read(struct tristar_idbus *ib, u8 reg, u8 *buf, unsigned int len)
+{
+	int ret;
+
+	if (ib->io_error)
+		return ib->io_error;
+	ret = ib->ops->block_read(ib->ctx, reg, buf, len);
+	if (ret) {
+		ib->ops->log(ib->ctx, "read of %u bytes at 0x%02x failed: %d", len, reg, ret);
+		return tristar_idbus_fail(ib, ret);
+	}
+	return 0;
+}
+
+static int tristar_idbus_block_write(struct tristar_idbus *ib, u8 reg, const u8 *buf,
+				     unsigned int len)
+{
+	int ret;
+
+	if (ib->io_error)
+		return ib->io_error;
+	ret = ib->ops->block_write(ib->ctx, reg, buf, len);
+	if (ret) {
+		ib->ops->log(ib->ctx, "write of %u bytes at 0x%02x failed: %d", len, reg, ret);
+		return tristar_idbus_fail(ib, ret);
+	}
+	return 0;
+}
+
+/*
+ * Read-modify-write; returns the value read back afterwards. *old gets the
+ * value the write was computed from.
+ */
+static int tristar_idbus_update_logged(struct tristar_idbus *ib, u8 reg, u8 clear, u8 set,
+				       u8 *old)
+{
+	int before, after;
+
+	if (ib->io_error)
+		return ib->io_error;
+	before = ib->ops->update(ib->ctx, reg, clear, set);
+	if (before < 0) {
+		ib->ops->log(ib->ctx, "update 0x%02x (clear 0x%02x, set 0x%02x) failed: %d",
+			     reg, clear, set, before);
+		return tristar_idbus_fail(ib, before);
+	}
+	*old = before;
+	after = tristar_idbus_read(ib, reg);
+	if (after < 0)
+		return after;
+	ib->ops->log(ib->ctx, "write 0x%02x: before 0x%02x, wrote 0x%02x, after 0x%02x",
+		     reg, before, (u8)((before & ~clear) | set), after);
+	return after;
+}
+
+static void tristar_idbus_log_fault_names(struct tristar_idbus *ib, const char *what, u8 fault)
+{
+	ib->ops->log(ib->ctx, "pin fault 0x%02x %s:%s%s%s%s", fault, what,
+		     fault & 0x01 ? " ACC1" : "", fault & 0x08 ? " ACC2" : "",
+		     fault & 0x02 ? " DP1/DN1" : "", fault & 0x04 ? " DP2/DN2" : "");
+}
+
+/* 0x0d bit 7: report, then acknowledge by echoing exactly the value read. */
+static int tristar_idbus_ack_fault(struct tristar_idbus *ib)
+{
+	u8 fault;
+	int ret = tristar_idbus_update_logged(ib, TRISTAR_IDBUS_REG_FAULT, 0, 0, &fault);
+
+	if (ret < 0)
+		return ret;
+	ib->faults++;
+	tristar_idbus_log_fault_names(ib, "acknowledged", fault);
+	return 0;
+}
+
+static int tristar_idbus_read_event(struct tristar_idbus *ib)
+{
+	int ev = tristar_idbus_read(ib, TRISTAR_IDBUS_REG_EVENT);
+
+	if (ev < 0)
+		return ev;
+	ib->last_event = ev;
+	ib->events |= ev;
+	return ev;
+}
+
+static int tristar_idbus_check_revision(struct tristar_idbus *ib)
+{
+	int ret = tristar_idbus_read(ib, TRISTAR_IDBUS_REG_REVISION);
+
+	if (ret < 0)
+		return ret;
+	if (ret != TRISTAR_IDBUS_REVISION_J71T) {
+		ib->ops->log(ib->ctx, "revision 0x%02x is not CBTL1610 0x8a; nothing written", ret);
+		return -ENODEV;
+	}
+	return 0;
+}
+
+/*
+ * getIdBusData: the response sits forward in the RX window at 0x20 until
+ * the next transfer replaces it. Read rx_len + 1 bytes (CRC last) and, when
+ * asked, 0x0c for the orientation. Never writes. Returns 0 or -errno; the
+ * header/CRC verdict goes to *verdict.
+ */
+static int tristar_idbus_read_rx(struct tristar_idbus *ib, const char *what, u8 *frame,
+				 unsigned int rx_len, u8 type, int *orientation, int *verdict)
+{
+	char hex[3 * TRISTAR_IDBUS_MAX_FRAME + 1];
+	int ret, val;
+
+	ret = tristar_idbus_block_read(ib, TRISTAR_IDBUS_REG_RX, frame, rx_len + 1);
+	if (ret)
+		return ret;
+	*verdict = tristar_idbus_check_frame(frame, rx_len, type);
+	tristar_idbus_format_hex(frame, rx_len + 1, hex, sizeof(hex));
+	if (!orientation) {
+		ib->ops->log(ib->ctx, "%s RX 0x20: [%s] %s", what, hex,
+			     tristar_idbus_verdict(*verdict));
+		return 0;
+	}
+	val = tristar_idbus_read(ib, TRISTAR_IDBUS_REG_STATUS);
+	if (val < 0)
+		return val;
+	*orientation = val;
+	ib->ops->log(ib->ctx, "%s RX 0x20: [%s] %s; 0x0c = 0x%02x (orientation bit6 %u)", what, hex,
+		     tristar_idbus_verdict(*verdict), val, (val >> 6) & 1);
+	return 0;
+}
+
+/*
+ * One command (AppleCBTL1610 sendIDBusCommand, the J71t dock path):
+ * prepare 0x60 = 0x01, write the request reversed plus the RX length byte
+ * (rx_len - 1) << 1 so that it ends at 0x60, read the window back and
+ * compare (no GO on a mismatch), then GO at 0x61. Nothing else touches the
+ * bus in between. Poll 0x0d every 10 ms for at most 100 ms. Completion is
+ * the transfer-done code ((0x0d & 0x38) == 0x10) or, for GetID only, the
+ * EVENT_DIGITAL_ID bit (hardware: 0x18), whose iOS handler reads the same
+ * frame. The response (rx_len + CRC byte) is read back and kept even when
+ * its header or CRC is wrong. *waited accumulates the poll sleeps.
+ */
+static int tristar_idbus_transfer(struct tristar_idbus *ib, const u8 *tx, unsigned int tx_len,
+				  unsigned int rx_len, u8 rx_type, bool digital_id,
+				  u8 *frame, unsigned int *frame_len, int *orientation,
+				  unsigned int *waited)
+{
+	u8 win[TRISTAR_IDBUS_MAX_TX + 1], back[TRISTAR_IDBUS_MAX_TX + 1];
+	char req[3 * TRISTAR_IDBUS_MAX_TX + 1], hex[3 * TRISTAR_IDBUS_MAX_FRAME + 1];
+	u8 base = TRISTAR_IDBUS_REG_TX_END - tx_len, go = ((tx_len - 1) << 1) | 1;
+	unsigned int i, step;
+	int ev, ret, verdict;
+
+	*frame_len = 0;
+	if (!tx_len || tx_len > TRISTAR_IDBUS_MAX_TX || !rx_len ||
+	    rx_len >= TRISTAR_IDBUS_MAX_FRAME)
+		return -EINVAL;
+	for (i = 0; i < tx_len; i++)
+		win[i] = tx[tx_len - 1 - i];
+	win[tx_len] = (rx_len - 1) << 1;
+	tristar_idbus_format_hex(tx, tx_len, req, sizeof(req));
+	tristar_idbus_format_hex(win, tx_len + 1, hex, sizeof(hex));
+
+	ret = tristar_idbus_write(ib, TRISTAR_IDBUS_REG_TX_END, TRISTAR_IDBUS_TX_PREPARE);
+	if (ret)
+		return ret;
+	ib->ops->log(ib->ctx, "write 0x60 = 0x01 (prepare)");
+	ret = tristar_idbus_block_write(ib, base, win, tx_len + 1);
+	if (ret)
+		return ret;
+	ib->ops->log(ib->ctx,
+		     "write TX 0x%02x: [%s] (request [%s] reversed, RX length 0x%02x; Tristar appends CRC 0x%02x)",
+		     base, hex, req, win[tx_len], tristar_idbus_crc8(tx, tx_len));
+	ret = tristar_idbus_block_read(ib, base, back, tx_len + 1);
+	if (ret)
+		return ret;
+	if (memcmp(back, win, tx_len + 1)) {
+		tristar_idbus_format_hex(back, tx_len + 1, hex, sizeof(hex));
+		ib->ops->log(ib->ctx, "readback mismatch at 0x%02x: [%s]; no GO", base, hex);
+		return -EREMOTEIO;
+	}
+	ib->ops->log(ib->ctx, "readback TX 0x%02x matches", base);
+	ret = tristar_idbus_write(ib, TRISTAR_IDBUS_REG_GO, go);
+	if (ret)
+		return ret;
+	ib->ops->log(ib->ctx, "write 0x61 = 0x%02x (GO)", go);
+
+	for (step = 0; ; step++) {
+		ev = tristar_idbus_read_event(ib);
+		if (ev < 0)
+			return ev;
+		if (ev)
+			ib->ops->log(ib->ctx, "poll %u ms: 0x0d = 0x%02x", *waited, ev);
+		if (ev & TRISTAR_IDBUS_EV_FAULT) {
+			ret = tristar_idbus_ack_fault(ib);
+			if (ret)
+				return ret;
+		}
+		if ((digital_id && (ev & TRISTAR_IDBUS_EV_DIGITAL_ID)) ||
+		    (ev & TRISTAR_IDBUS_EV_DONE_MASK) == TRISTAR_IDBUS_EV_DONE)
+			break;
+		if (ev & TRISTAR_IDBUS_EV_ERROR) {
+			ib->ops->log(ib->ctx, "transfer error event; no retry");
+			return -EIO;
+		}
+		if (ev & TRISTAR_IDBUS_EV_RESET) {
+			ib->ops->log(ib->ctx, "ID-bus reset/detach event during transfer");
+			return -ECONNRESET;
+		}
+		if (ev & TRISTAR_IDBUS_EV_TIMEOUT) {
+			ib->ops->log(ib->ctx, "Tristar timeout event after %u ms", *waited);
+			return -ETIMEDOUT;
+		}
+		if (step == TRISTAR_IDBUS_POLL_STEPS) {
+			ib->ops->log(ib->ctx, "no completion after %u ms (last 0x0d 0x%02x)",
+				     *waited, ev);
+			return -ETIMEDOUT;
+		}
+		ib->ops->sleep_ms(ib->ctx, TRISTAR_IDBUS_POLL_MS);
+		*waited += TRISTAR_IDBUS_POLL_MS;
+	}
+
+	ret = tristar_idbus_read_rx(ib, "read", frame, rx_len, rx_type, orientation, &verdict);
+	if (ret)
+		return ret;
+	*frame_len = rx_len + 1;
+	return verdict;
+}
+
+/*
+ * Reorient (0x05 |= 0x02, VBUS-sink bit kept; the bit self-clears), then
+ * wait 20 ms and poll 0x0d for up to 30 ms more for the exchange it re-arms.
+ * Only 0x05 and, on a pin fault, 0x0a are written.
+ */
+static int tristar_idbus_reorient(struct tristar_idbus *ib, u8 *events, unsigned int *waited)
+{
+	unsigned int step, elapsed = TRISTAR_IDBUS_SETTLE_MS;
+	int ev, ret;
+	u8 old;
+
+	ret = tristar_idbus_update_logged(ib, TRISTAR_IDBUS_REG_CTRL, 0,
+					  TRISTAR_IDBUS_CTRL_REORIENT, &old);
+	if (ret < 0)
+		return ret;
+	ib->ops->sleep_ms(ib->ctx, TRISTAR_IDBUS_SETTLE_MS);
+	for (step = 0; ; step++) {
+		ev = tristar_idbus_read_event(ib);
+		if (ev < 0)
+			return ev;
+		*events |= ev;
+		if (ev)
+			ib->ops->log(ib->ctx, "%u ms after reorient: 0x0d = 0x%02x", elapsed, ev);
+		if (ev & TRISTAR_IDBUS_EV_FAULT) {
+			ret = tristar_idbus_ack_fault(ib);
+			if (ret)
+				return ret;
+		}
+		if (ev & (TRISTAR_IDBUS_EV_DIGITAL_ID | TRISTAR_IDBUS_EV_DONE))
+			break;
+		if (step == TRISTAR_IDBUS_REORIENT_STEPS) {
+			ib->ops->log(ib->ctx, "no completion event %u ms after reorient", elapsed);
+			break;
+		}
+		ib->ops->sleep_ms(ib->ctx, TRISTAR_IDBUS_POLL_MS);
+		elapsed += TRISTAR_IDBUS_POLL_MS;
+	}
+	*waited += elapsed;
+	return 0;
+}
+
+/*
+ * After the reorient, read what the re-armed exchange left in the RX window
+ * before writing anything. Accept it only if it is valid and fresh: a
+ * completion event since the reorient, or bytes that differ from the frame
+ * retained before this run (that one may be an older accessory's). Returns
+ * 0 when accepted, 1 to send GetID again, or -errno.
+ */
+static int tristar_idbus_after_reorient(struct tristar_idbus *ib,
+					struct tristar_idbus_id_result *res, unsigned int *waited)
+{
+	int ret, verdict, orientation;
+	bool event;
+
+	ret = tristar_idbus_reorient(ib, &res->reorient_events, waited);
+	if (ret)
+		return ret;
+	ret = tristar_idbus_read_rx(ib, "after reorient", res->reorient_frame, 7,
+				    TRISTAR_IDBUS_ID, &orientation, &verdict);
+	if (ret)
+		return ret;
+	res->reorient_read = true;
+	event = res->reorient_events & (TRISTAR_IDBUS_EV_DIGITAL_ID | TRISTAR_IDBUS_EV_DONE);
+	if (!verdict && !event &&
+	    !memcmp(res->reorient_frame, res->retained, sizeof(res->retained)))
+		verdict = -ESTALE;
+	res->reorient_status = verdict;
+	if (verdict) {
+		ib->ops->log(ib->ctx, "frame after reorient not accepted (%s); sending GetID again",
+			     tristar_idbus_verdict(verdict));
+		return 1;
+	}
+	memcpy(res->frame, res->reorient_frame, sizeof(res->frame));
+	res->frame_len = sizeof(res->frame);
+	res->frame_status = 0;
+	res->orientation = orientation;
+	res->autonomous = true;
+	ib->ops->log(ib->ctx, "accepted the frame from the reorient-armed exchange (%s)",
+		     event ? "completion event" : "differs from the retained frame");
+	return 0;
+}
+
+/*
+ * The manual GetID sequence of ds-lightning-host-idbus.md 9.2. Only the
+ * reorient retry is automatic, once, and only after a timeout with VBUS.
+ */
+static int tristar_idbus_identify(struct tristar_idbus *ib, unsigned int flags,
+				  struct tristar_idbus_id_result *res)
+{
+	char text[160];
+	u8 tx[3] = { TRISTAR_IDBUS_GET_ID, TRISTAR_IDBUS_HOSTID >> 8, TRISTAR_IDBUS_HOSTID & 0xff };
+	unsigned int i, waited;
+	int ret, val, orientation;
+	u8 old;
+
+	memset(res, 0, sizeof(*res));
+	ib->io_error = 0;
+	res->flags = flags;
+	if (flags & TRISTAR_IDBUS_SWAP_HOSTID) {
+		tx[1] = TRISTAR_IDBUS_HOSTID & 0xff;
+		tx[2] = TRISTAR_IDBUS_HOSTID >> 8;
+	}
+	ib->ops->log(ib->ctx, "identify: HOSTID bytes %02x %02x%s", tx[1], tx[2],
+		     flags & TRISTAR_IDBUS_NO_REORIENT ? ", reorient disabled" : "");
+	ret = tristar_idbus_check_revision(ib);
+	if (ret)
+		goto out;
+
+	/* 0. Baseline, then the RX window's retained frame (read only). */
+	for (i = 0; i < TRISTAR_IDBUS_NBASE; i++) {
+		u8 reg = tristar_idbus_baseline_regs[i];
+
+		val = reg == TRISTAR_IDBUS_REG_EVENT ? tristar_idbus_read_event(ib) :
+						       tristar_idbus_read(ib, reg);
+		if (val < 0) {
+			ret = val;
+			goto out;
+		}
+		res->baseline[i] = val;
+		ib->ops->log(ib->ctx, "baseline 0x%02x = 0x%02x", reg, val);
+	}
+	ret = tristar_idbus_block_read(ib, TRISTAR_IDBUS_REG_RX, res->retained,
+				       TRISTAR_IDBUS_MAX_FRAME);
+	if (ret)
+		goto out;
+	tristar_idbus_format_hex(res->retained, TRISTAR_IDBUS_MAX_FRAME, text, sizeof(text));
+	res->retained_ok = !tristar_idbus_check_frame(res->retained, 7, TRISTAR_IDBUS_ID);
+	ib->ops->log(ib->ctx, "baseline RX 0x20 = [%s]%s", text,
+		     res->retained_ok ? " (retained valid ID frame; may be stale)" : "");
+	tristar_idbus_log_status(ib, "baseline", res->baseline[0]);
+	if (ib->last_event & TRISTAR_IDBUS_EV_FAULT) {
+		ret = tristar_idbus_ack_fault(ib);
+		if (ret)
+			goto out;
+	}
+
+	/* 1. Release a latched ID-bus reset hold. */
+	if (ib->last_ctrl & TRISTAR_IDBUS_CTRL_RESET) {
+		val = tristar_idbus_update_logged(ib, TRISTAR_IDBUS_REG_CTRL,
+						  TRISTAR_IDBUS_CTRL_RESET, 0, &old);
+		if (val < 0) {
+			ret = val;
+			goto out;
+		}
+		res->released_reset = true;
+		ib->ops->sleep_ms(ib->ctx, TRISTAR_IDBUS_SETTLE_MS);
+		if (val & TRISTAR_IDBUS_CTRL_RESET) {
+			ib->ops->log(ib->ctx, "ID-bus reset hold still set; giving up");
+			ret = -EBUSY;
+			goto out;
+		}
+	}
+
+	/* 2./3. GetID; after a timeout with VBUS, one reorient, then at most once more. */
+	for (;;) {
+		waited = 0;
+		res->attempts++;
+		ret = tristar_idbus_transfer(ib, tx, sizeof(tx), 7, TRISTAR_IDBUS_ID, true,
+					     res->frame, &res->frame_len, &orientation, &waited);
+		res->frame_status = ret;
+		if (!ret)
+			res->orientation = orientation;
+		if (ret != -ETIMEDOUT || ib->io_error || res->reoriented ||
+		    (flags & TRISTAR_IDBUS_NO_REORIENT))
+			break;
+		val = tristar_idbus_read(ib, TRISTAR_IDBUS_REG_STATUS);
+		if (val < 0) {
+			ret = val;
+			break;
+		}
+		if ((val & 3) != 3) {
+			ib->ops->log(ib->ctx, "timeout without VBUS (0x0c = 0x%02x): no reorient",
+				     val);
+			break;
+		}
+		res->reoriented = true;
+		ret = tristar_idbus_after_reorient(ib, res, &waited);
+		if (ret <= 0)
+			break;
+		if (waited < TRISTAR_IDBUS_CMDID_GAP_MS)
+			ib->ops->sleep_ms(ib->ctx, TRISTAR_IDBUS_CMDID_GAP_MS - waited);
+	}
+	if (!ret) {
+		memcpy(res->id, res->frame + 1, TRISTAR_IDBUS_ID_LEN);
+		res->id_valid = true;
+		tristar_idbus_format_hex(res->id, TRISTAR_IDBUS_ID_LEN, text, sizeof(text));
+		ib->ops->log(ib->ctx, "digital ID %s (%s)", text,
+			     res->autonomous ? "reorient-armed exchange" : "GetID command");
+		tristar_idbus_format_fields(res->id, text, sizeof(text));
+		ib->ops->log(ib->ctx, "%s", text);
+	}
+out:
+	res->status = ret;
+	ib->ops->log(ib->ctx, "identify %s (%d) after %u GetID command(s)%s",
+		     ret ? "failed" : "ok", ret, res->attempts,
+		     res->reoriented ? ", reoriented once" : "");
+	return ret;
+}
+
+/*
+ * Optional power handshake (ds-lightning-host-idbus.md 6): VBUS-gated 0x72
+ * GetState, expecting 0x73 + 4 bytes, then one 3-byte 0x70 frame
+ * {0x70, state[1] & ~8, state[2]} expecting 0x71. Which state bytes iOS
+ * echoes is inferred. Same TX window as GetID; no retries.
+ */
+static int tristar_idbus_power_handshake(struct tristar_idbus *ib,
+					 struct tristar_idbus_ph_result *res)
+{
+	const u8 get_state = TRISTAR_IDBUS_GET_STATE;
+	unsigned int len, waited = 0;
+	int ret, val;
+
+	memset(res, 0, sizeof(*res));
+	ib->io_error = 0;
+	ret = tristar_idbus_check_revision(ib);
+	if (ret)
+		goto out;
+	val = tristar_idbus_read(ib, TRISTAR_IDBUS_REG_STATUS);
+	if (val < 0) {
+		ret = val;
+		goto out;
+	}
+	if ((val & 3) != 3) {
+		ib->ops->log(ib->ctx,
+			     "no VBUS detected when starting powerhandshake (0x0c = 0x%02x)", val);
+		ret = -ENODEV;
+		goto out;
+	}
+	val = tristar_idbus_read(ib, TRISTAR_IDBUS_REG_CTRL);
+	if (val < 0) {
+		ret = val;
+		goto out;
+	}
+	if (val & TRISTAR_IDBUS_CTRL_RESET) {
+		ib->ops->log(ib->ctx, "ID-bus in reset (0x05 = 0x%02x); run identify first", val);
+		ret = -EBUSY;
+		goto out;
+	}
+	ret = tristar_idbus_transfer(ib, &get_state, 1, 5, TRISTAR_IDBUS_STATE, false,
+				     res->state, &len, NULL, &waited);
+	if (ret)
+		goto out;
+	res->state_ok = true;
+	res->request[0] = TRISTAR_IDBUS_POWER;
+	res->request[1] = res->state[1] & ~TRISTAR_IDBUS_POWER_RETRY;
+	res->request[2] = res->state[2];
+	waited = 0;
+	ret = tristar_idbus_transfer(ib, res->request, sizeof(res->request), 1,
+				     TRISTAR_IDBUS_POWER_ACK, false, res->ack, &len, NULL, &waited);
+	res->ack_ok = !ret;
+out:
+	res->status = ret;
+	ib->ops->log(ib->ctx, "power handshake %s (%d)", ret ? "failed" : "ok", ret);
+	return ret;
+}
+
+/*
+ * ID-bus reset pulse (AppleCBTL1610 5ff5930): 0x05 |= 0x08, 500 ms, then
+ * clear bit 3. Once the hold may have been set, the release is sent even
+ * after an I/O error, with two retries: a held reset blocks every ID-bus
+ * operation and must not outlive the pulse.
+ */
+static int tristar_idbus_reset_pulse(struct tristar_idbus *ib)
+{
+	int ret = 0, old, release = 0, err = 0, val, i;
+
+	if (ib->io_error)
+		return ib->io_error;
+	old = ib->ops->update(ib->ctx, TRISTAR_IDBUS_REG_CTRL, 0, TRISTAR_IDBUS_CTRL_RESET);
+	if (old < 0) {
+		ib->ops->log(ib->ctx, "update 0x05 (set 0x08) failed: %d", old);
+		ret = tristar_idbus_fail(ib, old);
+	} else {
+		ib->ops->log(ib->ctx, "write 0x05: before 0x%02x, wrote 0x%02x (reset hold)", old,
+			     old | TRISTAR_IDBUS_CTRL_RESET);
+		ib->ops->sleep_ms(ib->ctx, TRISTAR_IDBUS_RESET_HOLD_MS);
+	}
+	for (i = 0; i < 3; i++) {
+		if (i)
+			ib->ops->sleep_ms(ib->ctx, TRISTAR_IDBUS_SETTLE_MS);
+		release = ib->ops->update(ib->ctx, TRISTAR_IDBUS_REG_CTRL,
+					  TRISTAR_IDBUS_CTRL_RESET, 0);
+		if (release >= 0)
+			break;
+		ib->ops->log(ib->ctx, "ID-bus reset release failed: %d", release);
+		if (!err)
+			err = release;
+	}
+	if (release < 0) {
+		ib->ops->log(ib->ctx, "ID-bus reset hold may still be set; run idbus_reset again");
+		return tristar_idbus_fail(ib, ret ?: release);
+	}
+	ib->ops->log(ib->ctx, "write 0x05: before 0x%02x, wrote 0x%02x (release)", release,
+		     release & ~TRISTAR_IDBUS_CTRL_RESET);
+	if (ret)
+		return ret;
+	val = tristar_idbus_read(ib, TRISTAR_IDBUS_REG_CTRL);
+	if (val < 0)
+		return val;
+	if (val & TRISTAR_IDBUS_CTRL_RESET) {
+		ib->ops->log(ib->ctx, "0x05 = 0x%02x: ID-bus reset hold still set", val);
+		return -EBUSY;
+	}
+	ib->ops->log(ib->ctx, "0x05 after release: 0x%02x", val);
+	ib->ops->sleep_ms(ib->ctx, TRISTAR_IDBUS_SETTLE_MS);
+	/* Released on a retry: still report the I/O error. */
+	return err ? tristar_idbus_fail(ib, err) : 0;
+}
+
+/* Read 0x0a; only if a pin fault is latched, write back exactly that value. */
+static int tristar_idbus_fault_ack(struct tristar_idbus *ib,
+				   struct tristar_idbus_recover_result *res)
+{
+	int val, ret;
+
+	val = tristar_idbus_read(ib, TRISTAR_IDBUS_REG_FAULT);
+	if (val < 0)
+		return val;
+	res->fault = val;
+	if (!(val & TRISTAR_IDBUS_FAULT_PINS)) {
+		ib->ops->log(ib->ctx, "0x0a = 0x%02x: no pin fault latched; nothing written", val);
+		return 0;
+	}
+	ret = tristar_idbus_write(ib, TRISTAR_IDBUS_REG_FAULT, val);
+	if (ret)
+		return ret;
+	ib->faults++;
+	tristar_idbus_log_fault_names(ib, "written back", val);
+	val = tristar_idbus_read(ib, TRISTAR_IDBUS_REG_FAULT);
+	if (val < 0)
+		return val;
+	ib->ops->log(ib->ctx, "0x0a after: 0x%02x", val);
+	return 0;
+}
+
+/* Reorient again and consume the RX window read only (9.6 step 1). */
+static int tristar_idbus_recover_reorient(struct tristar_idbus *ib,
+					  struct tristar_idbus_recover_result *res)
+{
+	char hex[3 * TRISTAR_IDBUS_MAX_FRAME + 1], text[160];
+	unsigned int waited = 0;
+	int ret, val, orientation;
+
+	val = tristar_idbus_read(ib, TRISTAR_IDBUS_REG_CTRL);
+	if (val < 0)
+		return val;
+	if (val & TRISTAR_IDBUS_CTRL_RESET) {
+		ib->ops->log(ib->ctx, "0x05 = 0x%02x: ID-bus reset hold set; use idbus_reset", val);
+		return -EBUSY;
+	}
+	ret = tristar_idbus_block_read(ib, TRISTAR_IDBUS_REG_RX, res->before, sizeof(res->before));
+	if (ret)
+		return ret;
+	tristar_idbus_format_hex(res->before, sizeof(res->before), hex, sizeof(hex));
+	ib->ops->log(ib->ctx, "before RX 0x20: [%s]", hex);
+	ret = tristar_idbus_reorient(ib, &res->events, &waited);
+	if (ret)
+		return ret;
+	ret = tristar_idbus_read_rx(ib, "after reorient", res->frame, 7, TRISTAR_IDBUS_ID,
+				    &orientation, &res->frame_status);
+	if (ret)
+		return ret;
+	res->frame_read = true;
+	ib->ops->log(ib->ctx, "RX %s; completion event %s",
+		     memcmp(res->frame, res->before, sizeof(res->frame)) ? "changed" : "unchanged",
+		     res->events & (TRISTAR_IDBUS_EV_DIGITAL_ID | TRISTAR_IDBUS_EV_DONE) ?
+		     "seen" : "not seen");
+	if (!res->frame_status) {
+		tristar_idbus_format_fields(res->frame + 1, text, sizeof(text));
+		ib->ops->log(ib->ctx, "%s", text);
+	}
+	return 0;
+}
+
+/* The volatile link recovery levers of ds-lightning-host-idbus.md 9.6. */
+static int tristar_idbus_recover(struct tristar_idbus *ib, unsigned int action,
+				 struct tristar_idbus_recover_result *res)
+{
+	int ret, val;
+
+	memset(res, 0, sizeof(*res));
+	ib->io_error = 0;
+	res->action = action;
+	res->status_before = -1;
+	res->status_after = -1;
+	ib->ops->log(ib->ctx, "recover: %s", tristar_idbus_recover_name(action));
+	if (action > TRISTAR_IDBUS_RECOVER_FAULT_ACK) {
+		ret = -EINVAL;
+		goto out;
+	}
+	ret = tristar_idbus_check_revision(ib);
+	if (ret)
+		goto out;
+	val = tristar_idbus_read(ib, TRISTAR_IDBUS_REG_STATUS);
+	if (val < 0) {
+		ret = val;
+		goto out;
+	}
+	res->status_before = val;
+	tristar_idbus_log_status(ib, "before", val);
+	if (action == TRISTAR_IDBUS_RECOVER_REORIENT)
+		ret = tristar_idbus_recover_reorient(ib, res);
+	else if (action == TRISTAR_IDBUS_RECOVER_RESET)
+		ret = tristar_idbus_reset_pulse(ib);
+	else
+		ret = tristar_idbus_fault_ack(ib, res);
+	if (!ib->io_error) {
+		val = tristar_idbus_read(ib, TRISTAR_IDBUS_REG_STATUS);
+		if (val >= 0) {
+			res->status_after = val;
+			tristar_idbus_log_status(ib, "after", val);
+		} else if (!ret) {
+			ret = val;
+		}
+	}
+out:
+	res->status = ret;
+	ib->ops->log(ib->ctx, "recover %s %s (%d)", tristar_idbus_recover_name(action),
+		     ret ? "failed" : "done", ret);
+	return ret;
+}
+
+#endif /* APPLE_TRISTAR_IDBUS_H */
