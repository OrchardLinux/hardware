@@ -47,6 +47,8 @@
 /* One budget reassert per window before a register change counts as a fault. */
 #define J71T_REASSERT_WINDOW_MS 10000
 #define J71T_BACKOFF_HOLD_MS 60000
+#define J71T_ATTACH_RESET_MS 15000
+#define J71T_ATTACH_INPUT_DEFAULT 0x02
 
 static const int j71t_budgets_ua[] = { 500000, 1000000, 2100000, 2400000 };
 
@@ -69,6 +71,8 @@ struct j71t_charger {
 	int adaptive_ua;
 	unsigned int attach_id;
 	unsigned int backoffs;
+	unsigned int attach_resets;
+	unsigned long attach_until;
 	unsigned long adaptive_after;
 	const char *backoff_cause;
 	bool thermal_limited;
@@ -228,6 +232,7 @@ static int j71t_source_eligible(struct j71t_charger *charger)
 	return value.intval == POWER_SUPPLY_USB_TYPE_SDP ||
 	       value.intval == POWER_SUPPLY_USB_TYPE_CDP ||
 	       value.intval == POWER_SUPPLY_USB_TYPE_DCP ||
+	       value.intval == POWER_SUPPLY_USB_TYPE_C ||
 	       value.intval == POWER_SUPPLY_USB_TYPE_APPLE_BRICK_ID ||
 	       value.intval == POWER_SUPPLY_USB_TYPE_ACA;
 }
@@ -303,6 +308,8 @@ static void j71t_new_attach(struct j71t_charger *charger, unsigned int id)
 	charger->ceiling_ua = 0;
 	charger->source_type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
 	charger->attach_id = id;
+	charger->attach_resets = 0;
+	charger->attach_until = jiffies + msecs_to_jiffies(J71T_ATTACH_RESET_MS);
 }
 
 static int j71t_battery_safe(struct j71t_charger *charger)
@@ -430,6 +437,7 @@ static int j71t_enable(struct j71t_charger *charger)
 		if (ret)
 			return ret;
 		charger->saved = true;
+		charger->attach_until = jiffies + msecs_to_jiffies(J71T_ATTACH_RESET_MS);
 	}
 	ret = j71t_apply(charger, charger->charge_code, charger->input_code);
 	if (!ret) {
@@ -523,7 +531,8 @@ static int j71t_reassert(struct j71t_charger *charger, u8 input, u8 control, u8
 }
 
 /*
- * Do not fight a lower PMU input setting. Its electrical cause is unknown:
+ * Reduce the policy step after a non-default lower PMU setting; then assert
+ * the calibrated code for that step. Its electrical cause is unknown:
  * D2365's iOS isInputLimited callback (6bc038c) is constant false. This is
  * an observed setpoint reduction, not a fabricated VBUS/droop measurement.
  */
@@ -541,7 +550,7 @@ static int j71t_input_reduced(struct j71t_charger *charger, u8 input)
 	charger->backoff_cause = "pmic-input-reduced";
 	charger->backoffs++;
 	charger->budget_ua = charger->adaptive_ua;
-	charger->input_code = min(charger->input_codes[index], input);
+	charger->input_code = charger->input_codes[index];
 	charger->charge_code = j71t_charge_code(charger->budget_ua);
 	ret = j71t_enable(charger);
 	dev_warn_ratelimited(charger->dev,
@@ -577,6 +586,7 @@ static void j71t_policy_work(struct work_struct *work)
 							  struct j71t_charger, work);
 	int ret = 0, target, index, online, previous;
 	unsigned int id;
+	bool attach_reset = false;
 
 	mutex_lock(&charger->lock);
 	if (charger->stopping)
@@ -613,6 +623,13 @@ static void j71t_policy_work(struct work_struct *work)
 		u8 input = 0, control = 0, charge = 0;
 
 		ret = j71t_check_owned(charger, &input, &control, &charge);
+		if (j71t_is_fault(ret) && input == J71T_ATTACH_INPUT_DEFAULT &&
+		    time_before(jiffies, charger->attach_until) &&
+		    !(control & J71T_INPUT_SUSPEND) && charge == charger->charge_code) {
+			/* D2365 attach reset, observed 26 ms after applying the floor. */
+			attach_reset = true;
+			ret = 0;
+		}
 		if (j71t_is_fault(ret) && input < charger->input_code &&
 		    !(control & J71T_INPUT_SUSPEND) && charge == charger->charge_code) {
 			ret = j71t_input_reduced(charger, input);
@@ -669,17 +686,27 @@ static void j71t_policy_work(struct work_struct *work)
 	if (index >= 0 && target > previous) {
 		int next = previous ? j71t_choose_budget(previous) + 1 : 0;
 
-		if (previous && time_before(jiffies, charger->ramp_after))
-			goto report;
+		if (previous && time_before(jiffies, charger->ramp_after)) {
+			if (!attach_reset)
+				goto report;
+			next = j71t_choose_budget(previous);
+		}
 		index = min(index, next);
 	}
-	if (index >= 0 && (!charger->active || j71t_budgets_ua[index] != previous)) {
+	if (index >= 0 &&
+	    (!charger->active || j71t_budgets_ua[index] != previous || attach_reset)) {
 		charger->budget_ua = j71t_budgets_ua[index];
 		charger->input_code = charger->input_codes[index];
 		charger->charge_code = j71t_charge_code(charger->budget_ua);
 		ret = j71t_enable(charger);
 		if (ret)
 			goto restore;
+		if (attach_reset) {
+			charger->attach_resets++;
+			dev_info_ratelimited(charger->dev,
+					     "attach default 0x02: restored policy input 0x%02x\n",
+					     charger->input_code);
+		}
 		charger->ramp_after = jiffies + msecs_to_jiffies(1000);
 	}
 	goto report;
@@ -837,7 +864,8 @@ static const struct power_supply_desc j71t_desc = {
 	.type = POWER_SUPPLY_TYPE_USB,
 	.usb_types = BIT(POWER_SUPPLY_USB_TYPE_UNKNOWN) | BIT(POWER_SUPPLY_USB_TYPE_SDP) |
 		     BIT(POWER_SUPPLY_USB_TYPE_CDP) | BIT(POWER_SUPPLY_USB_TYPE_DCP) |
-		     BIT(POWER_SUPPLY_USB_TYPE_APPLE_BRICK_ID) | BIT(POWER_SUPPLY_USB_TYPE_ACA),
+		     BIT(POWER_SUPPLY_USB_TYPE_APPLE_BRICK_ID) | BIT(POWER_SUPPLY_USB_TYPE_ACA) |
+		     BIT(POWER_SUPPLY_USB_TYPE_C),
 	.properties = j71t_properties,
 	.num_properties = ARRAY_SIZE(j71t_properties),
 	.get_property = j71t_get_property,
@@ -855,12 +883,13 @@ static ssize_t charge7_state_show(struct device *dev, struct device_attribute *a
 	mutex_lock(&charger->lock);
 	ret = j71t_read(charger, J71T_INPUT_LIMIT, &input);
 	len = sysfs_emit(buf,
-			 "attach=%u source_type=%d ceiling_ua=%d step_ua=%d live_ua=%d override_ua=%d adaptive_ua=%d backoffs=%u last_backoff=%s vbus_mv=unavailable policy_error=%d active=%d\n",
+			 "attach=%u source_type=%d ceiling_ua=%d step_ua=%d live_ua=%d override_ua=%d adaptive_ua=%d backoffs=%u last_backoff=%s vbus_mv=unavailable policy_error=%d active=%d attach_resets=%u\n",
 			 charger->attach_id, charger->source_type, charger->ceiling_ua,
 			 charger->active ? charger->budget_ua : 0,
 			 ret ? ret : 75000 + input * 12500, charger->user_limit_ua,
 			 charger->adaptive_ua, charger->backoffs,
-			 charger->backoff_cause ?: "none", charger->policy_error, charger->active);
+			 charger->backoff_cause ?: "none", charger->policy_error, charger->active,
+			 charger->attach_resets);
 	mutex_unlock(&charger->lock);
 	return len;
 }
diff --git a/drivers/power/supply/apple_tristar_power.c b/drivers/power/supply/apple_tristar_power.c
index 2f58419da71a6e59b94d496b5d3138c5285e9261..c97848d8fa4a498713fcc2dc5bd8dc7e656a7e6b 100644
--- a/drivers/power/supply/apple_tristar_power.c
+++ b/drivers/power/supply/apple_tristar_power.c
@@ -90,6 +90,20 @@ struct apple_tristar {
 	struct notifier_block usb_notifier;
 	atomic_t reset_generation;
 	int seen_generation;
+	atomic_t usb_session;
+	atomic_t computer_seen;
+	atomic_t usb_events;
+	atomic_t usb_idle_events;
+	unsigned long usb_event_source;
+	int bc_ua;
+	int bc_type;
+	int cc_first_mv;
+	int bc_primary_mv;
+	int bc_secondary_mv;
+	u8 source_id[TRISTAR_AUTO_ID_LEN];
+	bool source_id_valid;
+	bool epoch_notify;
+	const char *epoch_reason;
 	struct delayed_work work;
 	/* Serializes register reads and protects the cached source state. */
 	struct mutex lock;
@@ -109,11 +123,28 @@ struct apple_tristar {
 	bool computer;
 	bool detach_role;
 	unsigned long classify_after;
+	unsigned long classify_log_after;
+	const char *detect_stage;
+	const char *detect_pin;
+	int detect_error;
+	int monitor_error;
+	int sample_status;
+	int route_before;
+	int adc_status;
+	int dp_mv;
+	int dm_mv;
+	int cc_mv;
+	unsigned int detect_attempts;
+	unsigned int detect_failures;
+	unsigned int retry_ms;
+	bool detect_logged;
 	u8 saved_route;
 	bool restore_pending;
 	bool dcp_pending;
 	bool brick_sampled;
 	bool adc_poisoned;
+	const char *adc_fault_stage;
+	unsigned int adc_fault_attach;
 	bool stopping;
 	bool notifier_registered;
 	bool sleeping;
@@ -187,21 +218,27 @@ static int apple_tristar_adc_mv(struct apple_tristar *ts)
 	if (ts->adc_poisoned)
 		return -EIO;
 	/* Observe the completion latch LOW before starting a new sample. */
+	ts->detect_stage = "adc-idle";
 	ret = read_poll_timeout(apple_tristar_pmic_read, status,
 				status < 0 || !(status & 1), 1000, 20000,
 				false, ts, D2365_ADC_DONE);
+	ts->adc_status = status;
 	if (ret || status < 0)
 		return ret ?: status;
+	ts->detect_stage = "adc-trigger";
 	ret = regmap_write(ts->pmic, D2365_ADC_START, 1);
 	if (ret)
 		goto poison;
+	ts->detect_stage = "adc-done";
 	ret = read_poll_timeout(apple_tristar_pmic_read, status,
 				status < 0 || (status & 1), 1000, 1000000,
 				false, ts, D2365_ADC_DONE);
+	ts->adc_status = status;
 	if (ret || status < 0) {
 		ret = ret ?: status;
 		goto poison;
 	}
+	ts->detect_stage = "adc-result";
 	ret = regmap_bulk_read(ts->pmic, D2365_ADC_RESULT, result, sizeof(result));
 	if (ret)
 		return ret;
@@ -214,46 +251,93 @@ static int apple_tristar_adc_mv(struct apple_tristar *ts)
 poison:
 	/* A late completion must never be mistaken for the next pin's sample. */
 	ts->adc_poisoned = true;
+	ts->adc_fault_stage = ts->detect_stage;
+	ts->adc_fault_attach = ts->attach_id;
 	return ret;
 }
 
+/* Caller holds the role hardware lock and ts->lock. */
 static bool apple_tristar_sample_valid(struct apple_tristar *ts)
 {
 	struct usb_gadget_current_budget budget;
+	int ret = usb_gadget_get_current_budget(ts->usb_node, &budget);
 
-	return !usb_gadget_get_current_budget(ts->usb_node, &budget) &&
-	       !budget.connected && !budget.configured && !budget.host_grant &&
-	       ts->seen_generation == atomic_read(&ts->reset_generation);
+	if (ret) {
+		ts->detect_stage = "usb-budget";
+		return false;
+	}
+	if (budget.connected || budget.configured || budget.host_grant ||
+	    atomic_read(&ts->computer_seen)) {
+		ts->detect_stage = "usb-active";
+		return false;
+	}
+	if (ts->seen_generation != atomic_read(&ts->reset_generation)) {
+		ts->detect_stage = "usb-event";
+		return false;
+	}
+	return true;
 }
 
-static int apple_tristar_pin_mv(struct apple_tristar *ts, bool dm, bool dcp)
+static int apple_tristar_sample_vbus(struct apple_tristar *ts)
 {
-	int ret, restore;
-	u8 route;
+	int status;
 
 	if (!apple_tristar_sample_valid(ts))
 		return -EAGAIN;
+	ts->detect_stage = "vbus";
+	status = apple_tristar_read(ts->client, TRISTAR_VBUS);
+	if (status < 0)
+		return status;
+	if ((status & 3) != 3)
+		return -ENOLINK;
+	ts->detect_stage = "orientation";
+	if (!(status & TRISTAR_AUTO_PRESENT) ||
+	    ((status ^ ts->sample_status) & TRISTAR_AUTO_ORIENTATION))
+		return -EAGAIN;
+	return apple_tristar_sample_valid(ts) ? 0 : -EAGAIN;
+}
+
+/*
+ * Normal USB: monitor the oriented pair. Type-C CC: D+ on the OTHER pair
+ * (iOS 5e23a90 -> 5fe52dc -> 5ff5ed0), never a fixed cable-ID allowance.
+ * A zero mux is valid after replug: the direct iOS lane monitor also accepts
+ * it. Only touch an idle or USB-selected nibble; restore the exact byte.
+ */
+static int apple_tristar_pin_mv(struct apple_tristar *ts, bool dm, bool dcp, bool cc)
+{
+	int ret, restore, nibble;
+	bool high = !!(ts->sample_status & TRISTAR_AUTO_ORIENTATION) ^ cc;
+	u8 route;
+
+	ts->detect_pin = cc ? "cc" : dcp ? dm ? "primary" : "secondary" : dm ? "dm" : "dp";
+	ret = apple_tristar_sample_vbus(ts);
+	if (ret)
+		return ret;
+	ts->detect_stage = "route-read";
 	ret = apple_tristar_read(ts->client, TRISTAR_DX_CONTROL);
+	ts->route_before = ret;
 	if (ret < 0)
 		return ret;
 	ts->saved_route = ret;
-	if ((ret & 7) == 1)
-		route = (ret & 0xf0) | (dm ? 0x0d : 0x0c);
-	else if ((ret & 0x70) == 0x10)
-		route = (ret & 0x0f) | (dm ? 0xd0 : 0xc0);
-	else
+	nibble = high ? ret >> 4 : ret & 15;
+	ts->detect_stage = "route-select";
+	if (nibble != 0 && (nibble & 7) != 1)
 		return -EOPNOTSUPP;
+	route = high ? (ret & 0x0f) | (dm ? 0xd0 : 0xc0) :
+		       (ret & 0xf0) | (dm ? 0x0d : 0x0c);
+	if (!apple_tristar_sample_valid(ts))
+		return -EAGAIN;
 	ts->restore_pending = true;
+	ts->detect_stage = "route-write";
 	ret = apple_tristar_write_checked(ts, route);
 	if (!ret) {
 		usleep_range(5000, 6000);
 		if (dcp) {
 			/* iOS 5ff5a08: monitor 4 (D-), 5 (D+), 40 ms pulse. */
-			u8 pulse = dm ? 9 : 10;
+			u8 pulse = (dm ? 9 : 10) + (high ? 2 : 0);
 
-			if ((ts->saved_route & 7) != 1)
-				pulse += 2;
 			ts->dcp_pending = true;
+			ts->detect_stage = "dcp-write";
 			ret = apple_tristar_write_reg_checked(ts, TRISTAR_DCP_CONTROL, pulse);
 			if (!ret)
 				msleep(40);
@@ -262,11 +346,33 @@ static int apple_tristar_pin_mv(struct apple_tristar *ts, bool dm, bool dcp)
 			ret = apple_tristar_sample_valid(ts) ? apple_tristar_adc_mv(ts) : -EAGAIN;
 	}
 	restore = apple_tristar_restore_route(ts);
-	if (!restore && !apple_tristar_sample_valid(ts))
-		return -EAGAIN;
+	if (restore) {
+		ts->detect_stage = "restore";
+		return restore;
+	}
+	/* Preserve the original error/stage unless the conversion succeeded. */
+	if (ret < 0)
