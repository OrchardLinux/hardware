index 7b92ba8cbb9fbdd5b73ffa976036f2a0aa159289..91f454010a996e0be18ec2beb0ef1b4da3719f05 100644
--- a/Documentation/devicetree/bindings/iio/light/tsl2583.yaml
+++ b/Documentation/devicetree/bindings/iio/light/tsl2583.yaml
@@ -10,14 +10,23 @@ maintainers:
   - Brian Masney <masneyb@onstation.org>
 
 description: |
-  Ambient light sensing with an i2c interface.
+  Ambient light sensing with an i2c interface. The Apple CT819 and CT821
+  factory calibration is stored in SysCfg. On systems where the SysCfg NVMEM
+  provider is created by boot firmware, the static board tree omits the
+  NVMEM link and firmware adds both NVMEM properties before kernel handoff.
 
 properties:
   compatible:
-    enum:
-      - amstaos,tsl2580
-      - amstaos,tsl2581
-      - amstaos,tsl2583
+    oneOf:
+      - enum:
+          - amstaos,tsl2580
+          - amstaos,tsl2581
+          - amstaos,tsl2583
+      - items:
+          - enum:
+              - apple,ct819
+              - apple,ct821
+          - const: amstaos,tsl2581
 
   reg:
     maxItems: 1
@@ -28,10 +37,45 @@ properties:
   vcc-supply:
     description: Regulator that provides power to the sensor
 
+  firmware-name:
+    description: Private LSCI record from this device, when NVMEM is unavailable.
+    maxItems: 1
+
+  nvmem-cells:
+    description:
+      Apple factory LSCI ambient-light calibration data. Boot firmware must
+      populate this together with nvmem-cell-names when the provider is not
+      statically representable.
+    maxItems: 1
+
+  nvmem-cell-names:
+    items:
+      - const: calibration
+
 required:
   - compatible
   - reg
 
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - apple,ct819
+              - apple,ct821
+    then:
+      dependentRequired:
+        nvmem-cells:
+          - nvmem-cell-names
+        nvmem-cell-names:
+          - nvmem-cells
+    else:
+      properties:
+        firmware-name: false
+        nvmem-cells: false
+        nvmem-cell-names: false
+
 additionalProperties: false
 
 examples:
@@ -41,8 +85,10 @@ examples:
         #size-cells = <0>;
 
         light-sensor@29 {
-                compatible = "amstaos,tsl2581";
-                reg = <0x29>;
+            compatible = "apple,ct821", "amstaos,tsl2581";
+            reg = <0x29>;
+            nvmem-cells = <&als_calibration>;
+            nvmem-cell-names = "calibration";
         };
     };
