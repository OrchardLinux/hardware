+
 /* Per-device data */
 struct tsl2583_als_info {
 	u16 als_ch0;
@@ -102,6 +131,10 @@ struct tsl2583_chip {
 	struct tsl2583_settings als_settings;
 	int als_time_scale;
 	int als_saturation;
+	const struct tsl2583_chip_info *info;
+	struct apple_als_calibration cal;
