 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/rtc/apple,pmic-rtc.yaml b/Documentation/devicetree/bindings/rtc/apple,pmic-rtc.yaml
index de0635797..79613b5d9 100644
