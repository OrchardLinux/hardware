From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nick Chan <towinchenmi@gmail.com>
Date: Sat, 7 Feb 2026 01:23:57 +0800
Subject: [PATCH 20/21] arm64: dts: apple: t8015: Add poweroff nodes

Add the nodes required to power-off the system.

Signed-off-by: Nick Chan <towinchenmi@gmail.com>
---
 arch/arm64/boot/dts/apple/t8015-common.dtsi | 2 ++
 arch/arm64/boot/dts/apple/t8015.dtsi        | 9 +++++++++
 2 files changed, 11 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8015-common.dtsi b/arch/arm64/boot/dts/apple/t8015-common.dtsi
index 694e184f5..f1d68046a 100644
--- a/arch/arm64/boot/dts/apple/t8015-common.dtsi
+++ b/arch/arm64/boot/dts/apple/t8015-common.dtsi
@@ -13,6 +13,8 @@
 	aliases {
 		ausbphy0 = &ausbphy0;
 		serial0 = &serial0;
+		/* Used by loader to fill properties*/
+		smc = &smc;
 	};
 
 	chosen {
diff --git a/arch/arm64/boot/dts/apple/t8015.dtsi b/arch/arm64/boot/dts/apple/t8015.dtsi
index e8b025d90..95c602e62 100644
--- a/arch/arm64/boot/dts/apple/t8015.dtsi
+++ b/arch/arm64/boot/dts/apple/t8015.dtsi
@@ -591,6 +591,15 @@
 			smc_hwmon: hwmon {
 				compatible = "apple,smc-hwmon";
 			};
+
+			smc_reboot: reboot {
+				compatible = "apple,t8015-smc-reboot";
+				nvmem-cells = <&shutdown_flag>, <&boot_stage>,
+					<&boot_error_count>, <&panic_count>;
+				nvmem-cell-names = "shutdown_flag", "boot_stage",
+					"boot_error_count", "panic_count";
+				/* To be filled by loader */
+			};
 		};
 
 		pinctrl_smc: pinctrl@236024000 {
