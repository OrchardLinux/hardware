From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Wed, 28 Oct 2026 21:40:30 +0800
Subject: [PATCH] arm64: dts: apple: t8010-ipad6: Route PMU events through the
 PMIC GPIO controller

The PMIC GPIO node now owns the D2365 PMU event block and the PMU line (AP
GPIO 38 on J71b). Make it the interrupt controller and let the Tristar
charger take its events from it: the PMU line (240), ADC conversion
complete, and the events the iPadOS charger callback subscribes to (16,
40-43, 72, 77). The charger no longer maps the event block.

Event 73 stays out although iPadOS's initial mask enables it: on J71b it
latches every few seconds while the input current approaches 2 A, with
the same source attached, and would restart identification each time.
Detach still shows as event 72 and in the charger status.

The iPad 7 keeps the PMU line undescribed until it is checked there.

J71t ledger 5.1 (one shared D2365 event interrupt controller).

Signed-off-by: Henrik Klee <henrik@goat-code.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/apple/t8010-ipad6.dtsi | 22 +++++++++++++++++++---
 arch/arm64/boot/dts/apple/t8010-ipad7.dtsi |  7 +++++++
 2 files changed, 26 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi b/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
index aaa903f54..23b92d308 100644
--- a/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
@@ -100,6 +100,9 @@
 			gpio-controller;
 			#gpio-cells = <2>;
 			gpio-reserved-ranges = <0 13>, <15 9>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupts-extended = <&pinctrl_ap 38 IRQ_TYPE_LEVEL_LOW>;
 		};
 
 		rtc@500 {
@@ -111,9 +114,22 @@
 
 		tristar_charger: charger@180 {
 			compatible = "apple,j71b-tristar-charger", "apple,tristar-charger";
-			reg = <0x180 0x10>, <0xa00 0x04>, <0x140 0x1e>, <0x4000 0x03>;
-			reg-names = "status", "control", "event", "adc";
-			interrupts-extended = <&pinctrl_ap 38 IRQ_TYPE_LEVEL_LOW>;
+			reg = <0x180 0x10>, <0xa00 0x04>, <0x4000 0x03>;
+			reg-names = "status", "control", "adc";
+			interrupt-parent = <&pmu_gpio>;
+			/*
+			 * The PMU line, ADC done, then the events the iPadOS
+			 * charger subscribes to.
+			 */
+			interrupts = <240 IRQ_TYPE_EDGE_RISING>,
+				     <176 IRQ_TYPE_EDGE_RISING>,
+				     <16 IRQ_TYPE_EDGE_RISING>,
+				     <40 IRQ_TYPE_EDGE_RISING>,
+				     <41 IRQ_TYPE_EDGE_RISING>,
+				     <42 IRQ_TYPE_EDGE_RISING>,
+				     <43 IRQ_TYPE_EDGE_RISING>,
+				     <72 IRQ_TYPE_EDGE_RISING>,
+				     <77 IRQ_TYPE_EDGE_RISING>;
 			apple,tristar = <&tristar>;
 			input-current-limit-microamp = <2400000>;
 		};
diff --git a/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi b/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi
index 5f2a2118b..3f530a1b4 100644
--- a/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi
@@ -17,6 +17,13 @@
 /delete-node/ &tristar_charger;
 /delete-node/ &tristar;
 
+/* The PMU event line of the iPad 7 is not described yet. */
+&pmu_gpio {
+	/delete-property/ interrupt-controller;
+	/delete-property/ #interrupt-cells;
+	/delete-property/ interrupts-extended;
+};
+
 &battery_info {
 	charge-full-design-microamp-hours = <8557000>;
 };
