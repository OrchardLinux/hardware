-
 	touch_display_sync_active: touch-display-sync-active-pins {
 		pinmux = <APPLE_PINMUX(176, 1)>,
 			 <APPLE_PINMUX(177, 1)>;
 	};
 };
 
-&serial3 {
-	pinctrl-0 = <&bluetooth_uart3_pins>;
-	pinctrl-names = "default";
-	uart-has-rtscts;
-	status = "okay";
-
-	bluetooth: bluetooth {
-		compatible = "apple,j172-bcm4355c1-bt",
-			     "brcm,bcm4355c1-bt";
-		current-speed = <115200>;
-		max-speed = <3000000>;
-		shutdown-gpios = <&pmu_gpio 13 GPIO_ACTIVE_HIGH>;
-		device-wakeup-gpios = <&pinctrl_ap 88 GPIO_ACTIVE_HIGH>;
-	};
+&bluetooth {
+	compatible = "apple,j172-bcm4355c1-bt",
+		     "brcm,bcm4355c1-bt";
 };
 
-&serial5 {
-	pinctrl-0 = <&battery_swi_pins>;
-	pinctrl-names = "default";
-	status = "okay";
-
-	onewire {
-		compatible = "ti,hdq-uart";
-
-		battery: fuel-gauge {
-			compatible = "ti,bq27545-hdq";
-			monitored-battery = <&ipad7_battery>;
-		};
-	};
+&battery {
+	compatible = "ti,bq27545-hdq";
 };
 
 &i2c1 {
@@ -200,40 +88,17 @@
 	};
 };
 
-&spi3 {
-	cs-gpios = <&pinctrl_ap 85 GPIO_ACTIVE_LOW>;
-	clocks = <&spi3_nclk>;
-	dmas = <&sio 0x1a>;
-	dma-names = "tx";
-	status = "okay";
