From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Orchard migration <noreply@orchardlinux>
Date: Wed, 28 Oct 2026 11:31:01 +0800
Subject: [PATCH] arm64: dts: apple: t8010: Describe the iPad 6 board; derive
 the iPad 7

t8010-ipad6.dtsi only held the buttons and PMIC, and t8010-ipad7.dtsi
carried the whole board description. The iPad 6 (J71b/J72b) and iPad 7
(J171/J172) share their Wi-Fi PCIe port, Wi-Fi regulator and platform
control, PMIC GPIO controller, Bluetooth UART, HDQ gauge UART and
touchscreen SPI wiring. Pins, GPIOs and interrupts match between the
iPad 6 device tree from iBoot and the validated iPad 7 description.

Describe the iPad 6 board completely in t8010-ipad6.dtsi: BQ27540 gauge,
battery capacity, SPI3 clock, Bluetooth and the generation-1 touchscreen
(4 MHz, no display-sync pins). t8010-ipad7.dtsi now only overrides what
differs on the iPad 7. Its resulting device trees are unchanged apart
from the wifi0 and bluetooth0 aliases, which let the loader attach MAC
addresses and Wi-Fi calibration.

Move the WLAN UART platform-control block into t8010.dtsi as a disabled
SoC node, and enable it from the board. Put the PMIC GPIO controller
inside the PMIC node.

The Wi-Fi board type and touch firmware name stay per model.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/apple/t8010-ipad6.dtsi | 157 +++++++++++++++++
 arch/arm64/boot/dts/apple/t8010-ipad7.dtsi | 187 +++------------------
 arch/arm64/boot/dts/apple/t8010-j71b.dts   |   8 +
 arch/arm64/boot/dts/apple/t8010-j72b.dts   |   8 +
 arch/arm64/boot/dts/apple/t8010.dtsi       |   7 +
 5 files changed, 206 insertions(+), 161 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi b/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
index 98b3d82b3..e9a61f617 100644
--- a/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
@@ -12,6 +12,11 @@
 / {
 	chassis-type = "tablet";
 
+	aliases {
+		bluetooth0 = &bluetooth;
+		wifi0 = &wifi;
+	};
+
 	gpio-keys {
 		compatible = "gpio-keys";
 
@@ -41,6 +46,26 @@
 			linux,code = <KEY_VOLUMEUP>;
 		};
 	};
+
+	battery_info: battery {
+		compatible = "simple-battery";
+		charge-full-design-microamp-hours = <8827000>;
+	};
+
+	spi3_nclk: clock-spi3-nclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <61538461>;
+		clock-output-names = "spi3-nclk";
+	};
+
+	wlan_vdd: regulator-wlan-vdd {
+		compatible = "regulator-fixed";
+		regulator-name = "wlan-vdd";
+		gpio = <&pmu_gpio 14 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		off-on-delay-us = <100000>;
+	};
 };
 
 &framebuffer0 {
@@ -64,6 +89,13 @@
 		#address-cells = <1>;
 		#size-cells = <1>;
 
+		pmu_gpio: gpio {
+			compatible = "apple,d2365-pmic-gpio";
+			gpio-controller;
+			#gpio-cells = <2>;
+			gpio-reserved-ranges = <0 13>, <15 9>;
+		};
+
 		rtc@500 {
 			compatible = "apple,angel-pmic-rtc", "apple,antigua-pmic-rtc";
 			reg = <0x500 0x10>;
@@ -87,3 +119,128 @@
 		};
 	};
 };
+&pcie0 {
+	iommu-map = <0x100 &pcie0_dart0 0 1>,
+		    <0x200 &pcie0_dart3 0 1>;
+	pinctrl-0 = <&wifi_clkreq>;
+	pinctrl-names = "default";
+
+	pci@3,0 {
+		device_type = "pci";
+		reg = <0x1800 0x0 0x0 0x0 0x0>;
+		bus-range = <2 2>;
+		max-link-speed = <1>;
+		apple,manual-availability-iommu = <&pcie0_dart3 0>;
+		apple,link-retry-after-power-cycle;
+		apple,hardware-trained-phy-lane;
+		apple,endpoint-power-after-link-setup;
+		apple,inherited-perst-before-link-setup;
+		reset-gpios = <&pinctrl_ap 15 GPIO_ACTIVE_LOW>;
+
+		#address-cells = <3>;
+		#size-cells = <2>;
+		ranges;
+
+		wifi: wifi@0,0 {
+			compatible = "pci14e4,43dc";
+			reg = <0x20000 0x0 0x0 0x0 0x0>;
+			interrupts-extended = <&pinctrl_ap 147 IRQ_TYPE_EDGE_FALLING>;
+			interrupt-names = "host-wake";
+			apple,wlan-uart = <&wlan_uart2>;
+			device-wake-gpios = <&pinctrl_ap 23 GPIO_ACTIVE_HIGH>;
+			vdd-supply = <&wlan_vdd>;
+		};
+	};
+};
+
+&pcie0_dart3 {
+	status = "okay";
+};
+
+&pinctrl_ap {
+	battery_swi_pins: battery-swi-pins {
+		pinmux = <APPLE_PINMUX(173, 1)>;
+	};
+
+	bluetooth_uart3_pins: bluetooth-uart3-pins {
+		pinmux = <APPLE_PINMUX(134, 1)>,
+			 <APPLE_PINMUX(135, 1)>,
+			 <APPLE_PINMUX(136, 1)>,
+			 <APPLE_PINMUX(137, 1)>;
+	};
+
+	wifi_clkreq: wifi-clkreq-pins {
+		pinmux = <APPLE_PINMUX(19, 1)>;
+	};
+
+	wlan_uart2_pins: wlan-uart2-pins {
+		pinmux = <APPLE_PINMUX(148, 1)>,
+			 <APPLE_PINMUX(150, 1)>;
+	};
+};
+
+&serial3 {
+	pinctrl-0 = <&bluetooth_uart3_pins>;
+	pinctrl-names = "default";
+	uart-has-rtscts;
+	status = "okay";
+
+	bluetooth: bluetooth {
+		compatible = "apple,j71b-bcm4355c1-bt",
+			     "brcm,bcm4355c1-bt";
+		current-speed = <115200>;
+		max-speed = <3000000>;
+		shutdown-gpios = <&pmu_gpio 13 GPIO_ACTIVE_HIGH>;
+		device-wakeup-gpios = <&pinctrl_ap 88 GPIO_ACTIVE_HIGH>;
+	};
+};
+
+&serial5 {
+	pinctrl-0 = <&battery_swi_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	onewire {
+		compatible = "ti,hdq-uart";
+
+		battery: fuel-gauge {
+			compatible = "ti,bq27540-hdq";
+			monitored-battery = <&battery_info>;
+		};
+	};
+};
+
+&spi3 {
+	clocks = <&spi3_nclk>;
+	cs-gpios = <&pinctrl_ap 85 GPIO_ACTIVE_LOW>;
+	dmas = <&sio 0x1a>;
+	dma-names = "tx";
+	status = "okay";
+
+	touchscreen: touchscreen@0 {
+		compatible = "apple,j71b-touchscreen";
+		reg = <0>;
+		spi-max-frequency = <4000000>;
+		spi-cpol;
+		spi-cpha;
+		apple,z2-bpw16-min-len = <17>;
+		apple,z2-no-init-ack;
+		interrupts-extended = <&pinctrl_ap 21 IRQ_TYPE_EDGE_FALLING>;
+		power-ldo-gpios = <&pinctrl_ap 29 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&pinctrl_ap 31 GPIO_ACTIVE_LOW>;
+		power-ana-gpios = <&pinctrl_ap 145 GPIO_ACTIVE_HIGH>;
+		clocks = <&touchclk>;
+		touchscreen-size-x = <1536>;
+		touchscreen-size-y = <2048>;
+	};
+};
+
+&sio {
+	status = "okay";
+};
+
+&wlan_uart2 {
+	pinctrl-0 = <&wlan_uart2_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi b/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi
