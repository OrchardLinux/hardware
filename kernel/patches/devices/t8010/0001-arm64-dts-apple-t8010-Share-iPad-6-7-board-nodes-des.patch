From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Orchard migration <noreply@orchardlinux>
Date: Wed, 28 Oct 2026 10:23:01 +0800
Subject: [PATCH] arm64: dts: apple: t8010: Share iPad 6/7 board nodes;
 describe iPad 6

The iPad 6 (J71b/J72b) and iPad 7 (J171/J172) share their Wi-Fi PCIe
port, Wi-Fi regulator and platform control, PMIC GPIO controller,
Bluetooth UART, HDQ gauge UART and touchscreen SPI wiring; pins, GPIOs
and interrupts match between the iPad 6 device tree from iBoot and the
validated iPad 7 description. Move those nodes into t8010-ipad6.dtsi,
which the iPad 7 already includes, and keep only real differences in
t8010-ipad7.dtsi. No property of any iPad 7 node changes; both gain a
wifi0 alias so the loader can attach the MAC address and calibration.

Describe the iPad 6 in a new t8010-j7xb.dtsi: BQ27540 gauge, battery
capacity, SPI3 clock, Bluetooth and the generation-1 touchscreen
(4 MHz, no display-sync pins). The Wi-Fi board type and touch firmware
name are per model.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/apple/t8010-ipad6.dtsi | 135 +++++++++++++++++++++
 arch/arm64/boot/dts/apple/t8010-ipad7.dtsi | 133 ++------------------
 arch/arm64/boot/dts/apple/t8010-j71b.dts   |  10 +-
 arch/arm64/boot/dts/apple/t8010-j72b.dts   |  10 +-
 arch/arm64/boot/dts/apple/t8010-j7xb.dtsi  |  54 +++++++++
 5 files changed, 217 insertions(+), 125 deletions(-)
 create mode 100644 arch/arm64/boot/dts/apple/t8010-j7xb.dtsi

diff --git a/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi b/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
index 98b3d82b3..6266a60bb 100644
--- a/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
@@ -87,3 +87,138 @@
 		};
 	};
 };
+
+/* Board wiring shared by the iPad 6 (J71b/J72b) and iPad 7 (J171/J172). */
+
+/ {
+	aliases {
+		bluetooth0 = &bluetooth;
+		wifi0 = &wifi;
+	};
+
+	wlan_vdd: regulator-wlan-vdd {
+		compatible = "regulator-fixed";
+		regulator-name = "wlan-vdd";
+		gpio = <&pmu_gpio 14 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		off-on-delay-us = <100000>;
+	};
+};
+
+&d2365_pmic {
+	pmu_gpio: gpio {
+		compatible = "apple,d2365-pmic-gpio";
+		gpio-controller;
+		#gpio-cells = <2>;
+		gpio-reserved-ranges = <0 13>, <15 9>;
+	};
+};
+
+&{/soc} {
+	wlan_uart2: wlan-platform-control@20a0c8000 {
+		compatible = "apple,t8010-wlan-uart-provider";
+		reg = <0x2 0x0a0c8000 0x0 0x4000>;
+		pinctrl-0 = <&wlan_uart2_pins>;
+		pinctrl-names = "default";
+		power-domains = <&ps_uart2>;
+		status = "okay";
+	};
+};
+
+&pcie0 {
+	iommu-map = <0x100 &pcie0_dart0 0 1>,
+		    <0x200 &pcie0_dart3 0 1>;
+	pinctrl-0 = <&wifi_clkreq>;
+	pinctrl-names = "default";
+
+	pci@3,0 {
+		device_type = "pci";
+		reg = <0x1800 0x0 0x0 0x0 0x0>;
+		bus-range = <2 2>;
+		max-link-speed = <1>;
+		apple,manual-availability-iommu = <&pcie0_dart3 0>;
+		apple,link-retry-after-power-cycle;
+		apple,hardware-trained-phy-lane;
+		apple,endpoint-power-after-link-setup;
+		apple,inherited-perst-before-link-setup;
+		reset-gpios = <&pinctrl_ap 15 GPIO_ACTIVE_LOW>;
+
+		#address-cells = <3>;
+		#size-cells = <2>;
+		ranges;
+
+		wifi: wifi@0,0 {
+			compatible = "pci14e4,43dc";
+			reg = <0x20000 0x0 0x0 0x0 0x0>;
+			interrupts-extended = <&pinctrl_ap 147 IRQ_TYPE_EDGE_FALLING>;
+			interrupt-names = "host-wake";
+			apple,wlan-uart = <&wlan_uart2>;
+			device-wake-gpios = <&pinctrl_ap 23 GPIO_ACTIVE_HIGH>;
+			vdd-supply = <&wlan_vdd>;
+		};
+	};
+};
+
+&pcie0_dart3 {
+	status = "okay";
+};
+
+&pinctrl_ap {
+	battery_swi_pins: battery-swi-pins {
+		pinmux = <APPLE_PINMUX(173, 1)>;
+	};
+
+	bluetooth_uart3_pins: bluetooth-uart3-pins {
+		pinmux = <APPLE_PINMUX(134, 1)>,
+			 <APPLE_PINMUX(135, 1)>,
+			 <APPLE_PINMUX(136, 1)>,
+			 <APPLE_PINMUX(137, 1)>;
+	};
+
+	wifi_clkreq: wifi-clkreq-pins {
+		pinmux = <APPLE_PINMUX(19, 1)>;
+	};
+
+	wlan_uart2_pins: wlan-uart2-pins {
+		pinmux = <APPLE_PINMUX(148, 1)>,
+			 <APPLE_PINMUX(150, 1)>;
+	};
+};
+
+&serial3 {
+	pinctrl-0 = <&bluetooth_uart3_pins>;
+	pinctrl-names = "default";
+	uart-has-rtscts;
+	status = "okay";
+
+	bluetooth: bluetooth {
+		current-speed = <115200>;
+		max-speed = <3000000>;
+		shutdown-gpios = <&pmu_gpio 13 GPIO_ACTIVE_HIGH>;
+		device-wakeup-gpios = <&pinctrl_ap 88 GPIO_ACTIVE_HIGH>;
+	};
+};
+
+&serial5 {
+	pinctrl-0 = <&battery_swi_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	onewire {
+		compatible = "ti,hdq-uart";
+
+		battery: fuel-gauge {
+		};
+	};
+};
+
+&spi3 {
+	cs-gpios = <&pinctrl_ap 85 GPIO_ACTIVE_LOW>;
+	dmas = <&sio 0x1a>;
+	dma-names = "tx";
+	status = "okay";
+};
+
+&sio {
+	status = "okay";
+};
