From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Thu, 29 Oct 2026 04:57:02 +0800
Subject: [PATCH] arm64: dts: apple: iPad 5: Add the per-model Wi-Fi module and
 touch firmware
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The iPad 5 models differ only in their Wi-Fi module and SoC:

- J71t and J72t (S8003) enable the shared board's PCIe section: storage
  and Wi-Fi. Their Wi-Fi board types are the ADT module-instance names,
  "feara" on J71t and "fearb" on J72t, as brcmfmac's Apple firmware
  names expect.
- J71s and J72s (S8000) build without it, as the S8000's root complex
  isn't described: no storage and no Wi-Fi.

Each model names its touchscreen firmware, which the firmware recipe
builds from the model's mtprops as apple/<board>-fwstart.z2fw.

Signed-off-by: Berkay Kösebay <brkosebay@users.noreply.github.com>
[Orchard: from brkosebay/linux ea4ca97c, e40d2403 (J71t ledger 14.1, 14.4, 14.9, 15.5); the model files keep only the module and the firmware name; J72t gets Wi-Fi (fearb) like J71t instead of a disabled port 1, untested; no apple,lane-cfg, nvmmu-invalidate-fifo, SEP or /memreserve/ lines]
Co-developed-by: Henrik Klee <henrik@goat-code.com>
Signed-off-by: Henrik Klee <henrik@goat-code.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/apple/s8000-j71s.dts |  4 ++++
 arch/arm64/boot/dts/apple/s8000-j72s.dts |  4 ++++
 arch/arm64/boot/dts/apple/s8003-j71t.dts | 11 +++++++++++
 arch/arm64/boot/dts/apple/s8003-j72t.dts | 11 +++++++++++
 4 files changed, 30 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/s8000-j71s.dts b/arch/arm64/boot/dts/apple/s8000-j71s.dts
index b5a2dfa11..e7dbefd07 100644
--- a/arch/arm64/boot/dts/apple/s8000-j71s.dts
+++ b/arch/arm64/boot/dts/apple/s8000-j71s.dts
@@ -13,3 +13,7 @@
 	compatible = "apple,j71s", "apple,s8000", "apple,arm-platform";
 	model = "Apple iPad 5 (Wi-Fi) (Samsung)";
 };
+
+&touchscreen {
+	firmware-name = "apple/j71s-fwstart.z2fw";
+};
diff --git a/arch/arm64/boot/dts/apple/s8000-j72s.dts b/arch/arm64/boot/dts/apple/s8000-j72s.dts
index 8f3dea5ad..5115e291a 100644
--- a/arch/arm64/boot/dts/apple/s8000-j72s.dts
+++ b/arch/arm64/boot/dts/apple/s8000-j72s.dts
@@ -13,3 +13,7 @@
 	compatible = "apple,j72s", "apple,s8000", "apple,arm-platform";
 	model = "Apple iPad 5 (Cellular) (Samsung)";
 };
+
+&touchscreen {
+	firmware-name = "apple/j72s-fwstart.z2fw";
+};
diff --git a/arch/arm64/boot/dts/apple/s8003-j71t.dts b/arch/arm64/boot/dts/apple/s8003-j71t.dts
index 0d906ae80..733cefc66 100644
--- a/arch/arm64/boot/dts/apple/s8003-j71t.dts
+++ b/arch/arm64/boot/dts/apple/s8003-j71t.dts
@@ -6,6 +6,8 @@
 
 /dts-v1/;
 
+#define S800X_IPAD5_PCIE
+
 #include "s8003.dtsi"
 #include "s800x-ipad5.dtsi"
 
@@ -13,3 +15,12 @@
 	compatible = "apple,j71t", "apple,s8003", "apple,arm-platform";
 	model = "Apple iPad 5 (Wi-Fi) (TSMC)";
 };
+
+&touchscreen {
+	firmware-name = "apple/j71t-fwstart.z2fw";
+};
+
+/* ADT uart2/wlan module-instance */
+&wifi {
+	brcm,board-type = "apple,feara";
+};
diff --git a/arch/arm64/boot/dts/apple/s8003-j72t.dts b/arch/arm64/boot/dts/apple/s8003-j72t.dts
index 0cd7d88e9..bc36459cf 100644
--- a/arch/arm64/boot/dts/apple/s8003-j72t.dts
+++ b/arch/arm64/boot/dts/apple/s8003-j72t.dts
@@ -6,6 +6,8 @@
 
 /dts-v1/;
 
+#define S800X_IPAD5_PCIE
+
 #include "s8003.dtsi"
 #include "s800x-ipad5.dtsi"
 
@@ -13,3 +15,12 @@
 	compatible = "apple,j72t", "apple,s8003", "apple,arm-platform";
 	model = "Apple iPad 5 (Cellular) (TSMC)";
 };
+
+&touchscreen {
+	firmware-name = "apple/j72t-fwstart.z2fw";
+};
+
+/* ADT uart2/wlan module-instance */
+&wifi {
+	brcm,board-type = "apple,fearb";
+};
