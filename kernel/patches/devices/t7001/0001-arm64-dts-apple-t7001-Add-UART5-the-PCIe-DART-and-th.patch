From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Martin=20Pu=C5=A1k=C3=A1=C4=8D?= <martin@icebear.sk>
Date: Thu, 29 Oct 2026 17:18:23 +0800
Subject: [PATCH] arm64: dts: apple: t7001: Add UART5, the PCIe DART and the
 PCIe controller

Describe the A8X blocks the iPad Air 2's Wi-Fi and battery gauge need,
disabled until a board enables them: UART5 (the HDQ line to the gauge),
the DART in front of PCIe port 1 with its error reflector, fetch and
diag configuration from the ADT, and the PCIe root complex with its MSI
range and power domains.

[Orchard: from mattonik/ipad-nixos b94d42f kernel/patches/0005-t7001-add-uart5-node.patch, 0016-pcie-apple-t7000-compile-only-skeleton.patch, 0090-t7001-air2-pcie-dart-options-and-wifi-node.patch, handed to Orchard by micro23 (ipadair2-omarchy 7ea2b2b); the DART takes the five-cell window binding and 0x2000 of registers (the ADT range covers the port 1 window), the reflector as an address, PCIe the H9P binding with all three power domains; UART3 and SPI3 stay out until Bluetooth and touch.]
Signed-off-by: Martin Puškáč <martin@icebear.sk>
Co-developed-by: Henrik Klee <henrik@goat-code.com>
Signed-off-by: Henrik Klee <henrik@goat-code.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/apple/t7001.dtsi | 63 ++++++++++++++++++++++++++++
 1 file changed, 63 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t7001.dtsi b/arch/arm64/boot/dts/apple/t7001.dtsi
index 711cfaf1d..c3ff5e058 100644
--- a/arch/arm64/boot/dts/apple/t7001.dtsi
+++ b/arch/arm64/boot/dts/apple/t7001.dtsi
@@ -146,6 +146,18 @@
 			status = "disabled";
 		};
 
+		serial5: serial@20a0d4000 {
+			compatible = "apple,t7000-uart", "apple,t8010-uart", "apple,s5l-uart";
+			reg = <0x2 0x0a0d4000 0x0 0x4000>;
+			reg-io-width = <4>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 163 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clkref>, <&clkref>;
+			clock-names = "uart", "clk_uart_baud0";
+			power-domains = <&ps_uart5>;
+			status = "disabled";
+		};
+
 		i2c0: i2c@20a110000 {
 			compatible = "apple,t7000-i2c", "apple,i2c";
 			reg = <0x2 0x0a110000 0x0 0x1000>;
@@ -329,6 +341,57 @@
 				pinmux = <APPLE_PINMUX(135, 1)>,
 					 <APPLE_PINMUX(134, 1)>;
 			};
+
+			uart5_pins: uart5-pins {
+				pinmux = <APPLE_PINMUX(34, 1)>;
+			};
+		};
+
+		/*
+		 * The ADT gives this DART 2 MiB, which covers the PCIe port 1
+		 * window at 0x602004000; its registers end below 0x100.
+		 */
+		pcie_dart1: iommu@602002000 {
+			compatible = "apple,t7000-dart", "apple,s5l8960x-dart";
+			reg = <0x6 0x02002000 0x0 0x2000>;
+			#iommu-cells = <5>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 216 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_pcie>;
+			/* ADT dart-apcie1: error-reflector, fetch-config, diag-config */
+			apple,error-reflector = /bits/ 64 <0x20ffff000>;
+			apple,fetch-config = <0x000e0303>;
+			apple,diag-config = <0x00000100>;
+			status = "disabled";
+		};
+
+		pcie: pcie@610000000 {
+			compatible = "apple,t7000-pcie";
+			device_type = "pci";
+			reg = <0x6 0x10000000 0x0 0x1000000>,
+			      <0x6 0x00000000 0x0 0x2000>,
+			      <0x6 0x01004000 0x0 0x1000>,
+			      <0x6 0x02004000 0x0 0x1000>,
+			      <0x6 0x03004000 0x0 0x1000>,
+			      <0x6 0x04004000 0x0 0x1000>;
+			reg-names = "config", "rc", "port0", "port1", "port2", "port3";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 212 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 215 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 218 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 221 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "port0", "port1", "port2", "port3";
+			msi-controller;
+			msi-parent = <&pcie>;
+			msi-ranges = <&aic AIC_IRQ 224 IRQ_TYPE_EDGE_RISING 32>;
+			apple,msi-doorbell = <0xbffff000>;
+			bus-range = <0 4>;
+			#address-cells = <3>;
+			#size-cells = <2>;
+			ranges = <0x43000000 0x6 0x20000000 0x6 0x20000000 0x1 0xa0000000>,
+				 <0x02000000 0x0 0xc0000000 0x7 0xc0000000 0x0 0x40000000>;
+			power-domains = <&ps_pcie>, <&ps_pcie_ref>, <&ps_pcie_aux>;
+			status = "disabled";
 		};
 	};
 
