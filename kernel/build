#!/usr/bin/env bash
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
device=${1:-}
[[ $# -gt 0 ]] && shift
if [[ ! "$device" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
  echo 'Usage: ./kernel/build DEVICE|PLATFORM --output DIRECTORY [--work-dir DIRECTORY]' >&2
  exit 2
fi
resolution=$(python3 "$here/series.py" --resolve "$device") || exit 1
read -r platform device_dtb <<< "$resolution"
producer=$(python3 "$here/series.py" --producer "$device") || exit 1
case "$producer" in
  linux-arm64) ;;
  *) exec python3 "$here/$producer" "$@";;
esac
dest=
work=
while (($#)); do
  case "$1" in
    --output) [[ $# -ge 2 ]] || { echo 'Missing --output value' >&2; exit 2; }; dest=$2; shift 2;;
    --work-dir) [[ $# -ge 2 ]] || { echo 'Missing --work-dir value' >&2; exit 2; }; work=$2; shift 2;;
    --resume) shift;; # every build continues its tree; kept for older callers
    *) echo "Unknown argument: $1" >&2; exit 2;;
  esac
done
if [[ -z "$dest" || -e "$dest" ]]; then
  echo 'Usage: ./kernel/build DEVICE|PLATFORM --output DIRECTORY [--work-dir DIRECTORY]' >&2
  exit 2
fi
# One kernel per platform; a device only selects which DTB is also copied
# to DIRECTORY/DEVICE.dtb. All platform DTBs land in DIRECTORY/dtbs/.
config="$here/configs/$platform/config"
patches=()
while IFS= read -r patch; do
  patches+=("$patch")
done < <(python3 "$here/series.py" "$device")
[[ -f "$config" ]] || { echo "Missing kernel config for platform $platform" >&2; exit 1; }
command -v git >/dev/null || { echo 'Git is required' >&2; exit 1; }
if [[ ${ORCHARD_BUILD_NATIVE:-0} != 1 ]]; then
  podman info >/dev/null || { echo 'Podman is unavailable' >&2; exit 1; }
fi
url=$(awk -F= '$1=="url" {print substr($0,5)}' "$here/upstream.lock")
commit=$(awk -F= '$1=="commit" {print $2}' "$here/upstream.lock")
[[ "$url" == https://github.com/torvalds/linux.git && "$commit" =~ ^[0-9a-f]{40}$ ]] || {
  echo 'Unexpected kernel/upstream.lock' >&2; exit 1;
}
# One incremental tree per platform and upstream pin, shared by every hardware
# checkout and worktree in the Orchard cache: a new checkout continues from the
# last build, and a patch change recompiles only the files it touches.
cache=${ORCHARD_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/orchard}
work=${work:-"$cache/kernel-work/$platform-${commit:0:12}"}
source="$work/source"
build_output="$work/output"
applied="$work/applied-patches"
prepared="$work/prepared-tree"
mkdir -p "$work"
# One build per tree at a time; a second one waits. A caller that already
# holds the lock names the tree in ORCHARD_KERNEL_WORK_LOCKED.
exec 9>>"$work/.lock"
if [[ ${ORCHARD_KERNEL_WORK_LOCKED:-} != "$work" ]]; then
  python3 -c '
import fcntl, sys
try:
    fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    print("Waiting for another kernel build to finish with this tree...", file=sys.stderr, flush=True)
    fcntl.flock(9, fcntl.LOCK_EX)
'
fi

patch_list() {
  for patch in "${patches[@]}"; do
    printf '%s %s\n' "$(git hash-object "$patch")" "${patch#"$here"/}"
  done
}

# Content of the source tree, tracked and untracked, without touching its index.
snapshot() {
  local index="$work/snapshot-index.$$"
  rm -f "$index"
  cp "$(git -C "$source" rev-parse --absolute-git-dir)/index" "$index" 2>/dev/null ||
    GIT_INDEX_FILE=$index git -C "$source" read-tree HEAD
  GIT_INDEX_FILE=$index git -C "$source" add --all -- .
  GIT_INDEX_FILE=$index git -C "$source" write-tree
  rm -f "$index"
}

# Tree the patch series produces, built in a temporary index without
# touching any file. It runs in $(...), where set -e does not apply, so
# every step must fail the function explicitly.
desired_tree() {
  local index="$work/desired-index.$$" patch tree
  rm -f "$index"
  GIT_INDEX_FILE=$index git -C "$source" read-tree HEAD || return
  for patch in "${patches[@]}"; do
    GIT_INDEX_FILE=$index git -C "$source" apply --cached "$patch" || { rm -f "$index"; return 1; }
  done
  tree=$(GIT_INDEX_FILE=$index git -C "$source" write-tree) || { rm -f "$index"; return 1; }
  rm -f "$index"
  printf '%s\n' "$tree"
}

apply_patches() {
  echo 'Applying kernel patches...'
  for patch in "${patches[@]}"; do
    git -C "$source" apply --check "$patch"
    git -C "$source" apply "$patch"
  done
  patch_list > "$applied"
  snapshot > "$prepared"
}

if [[ ! -d "$source/.git" ]]; then
  rm -rf "$source"
  mkdir -p "$source"
  git -C "$source" init -q
  git -C "$source" remote add origin "$url"
  echo "Fetching kernel source at $commit (this may take a while)..."
  git -C "$source" fetch --progress --depth 1 origin "$commit"
  git -C "$source" checkout -q --detach FETCH_HEAD
  apply_patches
else
  [[ $(git -C "$source" remote get-url origin) == "$url" &&
     $(git -C "$source" rev-parse HEAD) == "$commit" ]] || {
    echo "Unexpected kernel source in $source" >&2; exit 1;
  }
  # Trees from before this record take it while still matching their patches.
  if [[ ! -f "$prepared" ]] && cmp -s "$applied" <(patch_list); then
    snapshot > "$prepared"
  fi
  if ! cmp -s "$applied" <(patch_list); then
    # Patches are the only way kernel changes enter the tree; refuse to throw
    # away hand edits made since the last build.
    if [[ ! -f "$prepared" || $(snapshot) != "$(cat "$prepared")" ]]; then
      echo "Kernel tree $source has changes that are not in the patch series;" \
           'turn them into patches or remove the tree' >&2
      exit 1
    fi
    echo 'Kernel patches changed; applying only the difference to the tree...'
    # Only files whose content changes are written, so the others keep their
    # timestamps and make recompiles just what the new series changes.
    desired=$(desired_tree) || { echo 'The new kernel patch series does not apply; the tree is unchanged' >&2; exit 1; }
    git -C "$source" diff --binary "$(cat "$prepared")" "$desired" |
      git -C "$source" apply --whitespace=nowarn -
    [[ $(snapshot) == "$desired" ]] || { echo 'Kernel tree update did not produce the patch series' >&2; exit 1; }
    patch_list > "$applied"
    printf '%s\n' "$desired" > "$prepared"
  fi
fi
mkdir -p "$build_output"
cp "$config" "$build_output/.config"
echo 'Preparing kernel build container...'
python3 -m orchard_hardware.buildenv build --file "$here/Containerfile" \
  --image localhost/orchard-hardware-kernel-toolchain:bookworm --context "$here"
echo 'Compiling kernel image, modules and device trees...'
# shellcheck disable=SC2016 # Variables below belong to the recipe shell.
python3 -m orchard_hardware.buildenv run \
  --bind "$source:/src:ro" --bind "$build_output:/out:rw" --bind "$here/configs:/config:ro" \
  --image localhost/orchard-hardware-kernel-toolchain:bookworm -- bash -euc '
    platform=$1
    export KBUILD_BUILD_USER=orchard KBUILD_BUILD_HOST=builder
    export KBUILD_BUILD_VERSION=1 KBUILD_BUILD_TIMESTAMP="2026-10-22T00:00:00Z"
    make -C "$ORCHARD_SRC" O="$ORCHARD_OUT" LLVM=-19 ARCH=arm64 olddefconfig
    cmp "$ORCHARD_OUT/.config" "$ORCHARD_CONFIG/$platform/config"
    make -C "$ORCHARD_SRC" O="$ORCHARD_OUT" -j"$2" LLVM=-19 ARCH=arm64 \
      LOCALVERSION="-orchard-$platform" DTC_FLAGS=-@ Image.gz modules dtbs
  ' bash "$platform" "${ORCHARD_KERNEL_JOBS:-2}"
echo 'Staging kernel modules and device trees...'
stage=$(mktemp -d "$work/stage.XXXXXX")
trap 'rm -rf "$stage"' EXIT
external=()
if [[ -d "$here/modules/$platform" ]]; then
  "$here/build-modules" --source "$source" --build "$build_output" \
    --modules "$here/modules/$platform" --localversion "-orchard-$platform" \
    --output "$stage/external"
  external=(--external "$stage/external")
fi
python3 "$here/stage-modules.py" --build "$build_output" \
  ${external[@]+"${external[@]}"} --output "$stage/module-root"
mkdir -p "$dest/dtbs"
cp "$build_output/arch/arm64/boot/dts/apple/"*.dtb "$dest/dtbs/"
if [[ "$device_dtb" != - ]]; then
  [[ -f "$dest/dtbs/$device_dtb.dtb" ]] || { echo "Missing DTB $device_dtb for $device" >&2; exit 1; }
  cp "$dest/dtbs/$device_dtb.dtb" "$dest/$device.dtb"
fi
cp "$build_output/arch/arm64/boot/Image.gz" "$dest/Image.gz"
cp -R "$stage/module-root/lib" "$dest/lib"
cp "$build_output/include/config/kernel.release" "$dest/kernel.release"
echo "Kernel output: $dest"
