#!/usr/bin/env bash
set -euo pipefail
packages=(bc bison ca-certificates clang-19 cpio device-tree-compiler flex gcc git kmod libelf-dev libssl-dev lld-19 llvm-19 make python3 xz-utils zstd)
# Kconfig checks whether the target compiler can link a userspace program.
# Clang needs the AArch64 libc and GCC runtime when cross-compiling on x86.
case "$(uname -m)" in
  x86_64) packages+=(gcc-aarch64-linux-gnu libc6-dev-arm64-cross) ;;
esac
if [[ ${1:-} == --packages ]]; then printf '%s\n' "${packages[@]}"; exit 0; fi
apt-get update
apt-get install -y --no-install-recommends "${packages[@]}"
