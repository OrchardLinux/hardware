#!/usr/bin/env bash
set -euo pipefail
packages=(bc bison ca-certificates ccache clang-19 cpio device-tree-compiler flex gcc git kmod libelf-dev libssl-dev lld-19 llvm-19 make python3 xz-utils zstd)
# Kconfig's CC_CAN_LINK probe links an arm64 userspace program. Native arm64
# hosts can; elsewhere it needs a cross libc and binutils, or olddefconfig
# drops CONFIG_CC_CAN_LINK and the build's config check fails.
if [[ $(uname -m) != aarch64 ]]; then
  packages+=(binutils-aarch64-linux-gnu libc6-dev-arm64-cross libgcc-12-dev-arm64-cross)
fi
if [[ ${1:-} == --packages ]]; then printf '%s\n' "${packages[@]}"; exit 0; fi
apt-get update
apt-get install -y --no-install-recommends "${packages[@]}"
