/dts-v1/;
/plugin/;
/* J71b fresh-boot PCIe root0+root3 diagnostic. Root0 only enumerates ANS;
 * NVMe modules are NEVER loaded. Root3 probes BCM4355. No J172 board data.
 * This DTB is assembled offline, not applied to a running storage host.
 */
/ {
	compatible = "apple,j71b";
	fragment@0 {
		target-path = "/soc";
		__overlay__ {
			#address-cells = <2>;
			#size-cells = <2>;
			pcie0_dart3: iommu@604008000 {
				compatible = "apple,t8010-dart", "apple,s5l8960x-dart";
				reg = <0x6 0x04008000 0 0x4000>;
				#iommu-cells = <1>;
				interrupt-parent = <&aic>;
				interrupts = <0 280 4>;
				power-domains = <&ps_pcie>;
				apple,dma-range = <0 0x80000000 0 0x3ffff000>;
				status = "okay";
			};
			wlan_uart2: wlan-platform-control@20a0c8000 {
				compatible = "apple,t8010-wlan-uart-provider";
				reg = <2 0x0a0c8000 0 0x4000>;
				pinctrl-0 = <&wlan_uart2_pins>;
				pinctrl-names = "default";
				power-domains = <&ps_uart2>;
				status = "okay";
			};
		};
	};
	fragment@1 {
		target-path = "/soc/i2c@20a110000/pmic@3c";
		__overlay__ {
			pmu_gpio: gpio {
				compatible = "apple,d2365-pmic-gpio";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-reserved-ranges = <0 13>, <15 9>;
			};
		};
	};
	fragment@2 {
		target-path = "/";
		__overlay__ {
			wlan_vdd: regulator-wlan-vdd {
				compatible = "regulator-fixed";
				regulator-name = "wlan-vdd";
				gpio = <&pmu_gpio 14 0>;
				enable-active-high;
				off-on-delay-us = <100000>;
			};
		};
	};
	fragment@3 {
		target = <&pinctrl_ap>;
		__overlay__ {
			wifi_clkreq: wifi-clkreq-pins {
				pinmux = <0x10013>; /* AP GPIO19 function1 */
			};
			wlan_uart2_pins: wlan-uart2-pins {
				pinmux = <0x10094 0x10096>; /* AP GPIO148,150 function1 */
			};
		};
	};
	fragment@4 {
		target = <&pcie0>;
		__overlay__ {
			#address-cells = <3>;
			#size-cells = <2>;
			iommu-map = <0x100 &pcie0_dart0 0 1>,
				    <0x200 &pcie0_dart3 0 1>;
			pinctrl-0 = <&wifi_clkreq>;
			pinctrl-names = "default";
			pci@3,0 {
				device_type = "pci";
				reg = <0x1800 0 0 0 0>;
				bus-range = <2 2>;
				max-link-speed = <1>;
				apple,manual-availability-iommu = <&pcie0_dart3 0>;
				apple,link-retry-after-power-cycle;
				apple,hardware-trained-phy-lane;
				apple,endpoint-power-after-link-setup;
				apple,inherited-perst-before-link-setup;
				reset-gpios = <&pinctrl_ap 15 1>;
				#address-cells = <3>;
				#size-cells = <2>;
				ranges;
				wifi@0,0 {
					compatible = "pci14e4,43dc";
					reg = <0x20000 0 0 0 0>;
					interrupts-extended = <&pinctrl_ap 147 2>;
					interrupt-names = "host-wake";
					apple,wlan-uart = <&wlan_uart2>;
					device-wake-gpios = <&pinctrl_ap 23 0>;
					vdd-supply = <&wlan_vdd>;
					/* Do not copy J172 antenna SKU or board type. */
				};
			};
		};
	};
};
