#!/usr/bin/env bash
# J71b's DTB is the kernel's own t8010-j71b.dtb; board nodes live in the
# device patch series (kernel/patches/devices/j71b), not in overlays.
set -euo pipefail
kernel_build='' headers='' output=''
while (($#)); do
  case "$1" in
    --kernel-build) kernel_build=$2; shift 2;;
    --headers) headers=$2; shift 2;;
    --output) output=$2; shift 2;;
    *) echo "Unknown argument: $1" >&2; exit 2;;
  esac
done
dtb="$kernel_build/arch/arm64/boot/dts/apple/t8010-j71b.dtb"
if [[ ! -f "$dtb" || -z "$output" || -e "$output" ]]; then
  echo 'Usage: ./kernel/devicetree/j71b/build --kernel-build KERNEL_OUTPUT --headers KERNEL_SOURCE/include --output J71B.dtb' >&2
  exit 2
fi
mkdir -p "$(dirname "$output")"
cp "$dtb" "$output"
echo "DTB: $output"
