#!/bin/sh
# Public device-owned hardware preparation. No association or filesystem mounts.
# PCIe, Wi-Fi power and platform control, PMIC GPIO and the supply regulator
# are built into the platform kernel; only the drivers below are modules.
set -eu
phase=preflight
failed() {
 rc=$?
 [ "$rc" = 0 ] && return
 printf 'Hardware failed: %s (exit %s); inspect, do not retry\n' "$phase" "$rc" >&2
 dmesg > /run/orchard/hardware-failed.dmesg 2>/dev/null || true
 exit "$rc"
}
trap failed EXIT
step() { phase=$1; echo "$phase"; }
[ "$(awk '$2=="/" {print $3}' /proc/mounts)" = rootfs ]
[ ! -d /sys/module/nvme ]
[ "$(grep -c '/dev/nvme' /proc/mounts || true)" = 0 ]
step boot-readiness
[ "$(cat /sys/class/power_supply/battery/present)" = 1 ]
sha256sum -c /etc/orchard/public.SHA256SUMS > /run/orchard/public-verification.log
step wifi
modprobe cfg80211
modprobe brcmutil
modprobe brcmfmac
n=0
while [ ! -d /sys/class/net/wlan0 ]; do n=$((n+1)); [ "$n" -le 20 ]; sleep 1; done
step storage-fence
modprobe nvme
n=0
while [ "$(cat /sys/class/nvme/nvme0/state 2>/dev/null)" != live ]; do n=$((n+1)); [ "$n" -le 20 ]; sleep 1; done
# Every NVMe disk and partition stays read-only. The installer opens only its
# verified target, and only while writing (storage.py).
found=0
for block in /sys/class/block/nvme*; do
 [ -d "$block" ] || continue
 found=1
 blockdev --setro "/dev/${block##*/}"
 [ "$(cat "$block/ro")" = 1 ]
done
[ "$found" = 1 ]
step touch
modprobe apple-sio
modprobe apple-sio-dma
modprobe apple_z2
n=0
while ! grep -q '^N: Name=".*Touchscreen"' /proc/bus/input/devices; do n=$((n+1)); [ "$n" -le 20 ]; sleep 1; done
step bluetooth
modprobe bluetooth
modprobe btbcm
modprobe hci_uart
n=0
while [ ! -d /sys/class/bluetooth/hci0 ]; do n=$((n+1)); [ "$n" -le 20 ]; sleep 1; done
[ "$(dmesg | grep -c 'apple-dart.*translation fault' || true)" = 0 ]
echo hardware-ready
