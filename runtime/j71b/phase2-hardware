#!/bin/sh
# Public device-owned hardware preparation. No association or filesystem mounts.
# PCIe, Wi-Fi power and platform control, PMIC GPIO and the supply regulator
# are built into the platform kernel; only the drivers below are modules.
set -eu
phase=preflight
failed() {
 rc=$?
 [ "$rc" = 0 ] && return
 printf 'Hardware failed: %s (exit %s); inspect, do not retry\n' "$phase" "$rc" >&2
 dmesg > /run/orchard/hardware-failed.dmesg 2>/dev/null || true
 exit "$rc"
}
trap failed EXIT
step() { phase=$1; echo "$phase"; }
# Storage and its read-only fence are required. Wi-Fi, touch and Bluetooth
# are best effort: experimental boards may lack drivers, firmware or DT nodes,
# and the install does not need them. Results go to /run/orchard/hardware.txt.
report() { echo "$1: $2" | tee -a /run/orchard/hardware.txt; }
optional() {
 name=$1; shift
 if ( "$@" ) >/run/orchard/"$name".log 2>&1; then report "$name" ready; else report "$name" missing; fi
}
wait_for() { n=0; while ! eval "$1"; do n=$((n+1)); [ "$n" -le 20 ] || return 1; sleep 1; done; }
wifi_up() { modprobe cfg80211 && modprobe brcmutil && modprobe brcmfmac && wait_for '[ -d /sys/class/net/wlan0 ]'; }
touch_up() {
 modprobe apple-sio && modprobe apple-sio-dma && modprobe apple_z2 &&
  wait_for 'grep -q "^N: Name=\".*Touchscreen\"" /proc/bus/input/devices'
}
bluetooth_up() { modprobe bluetooth && modprobe btbcm && modprobe hci_uart && wait_for '[ -d /sys/class/bluetooth/hci0 ]'; }
[ "$(awk '$2=="/" {print $3}' /proc/mounts)" = rootfs ]
[ ! -d /sys/module/nvme ]
[ "$(grep -c '/dev/nvme' /proc/mounts || true)" = 0 ]
step boot-readiness
# bq27xxx caches a failed early HDQ read as present=0 until its next poll
# (poll_interval, 360 s by default); rewriting the parameter forces a refresh.
battery_present() {
 p=/sys/module/bq27xxx_battery/parameters/poll_interval
 [ ! -w "$p" ] || cat "$p" > "$p"
 [ "$(cat /sys/class/power_supply/battery/present)" = 1 ]
}
wait_for battery_present
sha256sum -c /etc/orchard/public.SHA256SUMS > /run/orchard/public-verification.log
step wifi
optional wifi wifi_up
step storage-fence
modprobe nvme
n=0
while [ "$(cat /sys/class/nvme/nvme0/state 2>/dev/null)" != live ]; do n=$((n+1)); [ "$n" -le 20 ]; sleep 1; done
# Every NVMe partition stays read-only. The installer opens only its verified
# target, and only while writing (storage.py). The whole disk stays writable:
# a read-only disk would keep its partitions read-only after blockdev --setrw.
found=0
for block in /sys/class/block/nvme*n*p*; do
 [ -d "$block" ] || continue
 found=1
 blockdev --setro "/dev/${block##*/}"
 [ "$(cat "$block/ro")" = 1 ]
done
[ "$found" = 1 ]
# Other namespaces hold Apple system data and are never written: fence the
# whole namespace, not only its partitions.
for block in /sys/class/block/nvme*n*; do
 [ -d "$block" ] && [ ! -e "$block/partition" ] && [ "${block##*/}" != nvme0n1 ] || continue
 blockdev --setro "/dev/${block##*/}"
 [ "$(cat "$block/ro")" = 1 ]
done
step touch
optional touch touch_up
step bluetooth
optional bluetooth bluetooth_up
[ "$(dmesg | grep -c 'apple-dart.*translation fault' || true)" = 0 ]
echo hardware-ready
