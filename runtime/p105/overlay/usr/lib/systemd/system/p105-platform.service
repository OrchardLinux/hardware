[Unit]
Description=Verify Cascadia P105 hardware and current boot payload
After=systemd-udev-trigger.service
Before=p105-touch.service p105-keys.service

[Service]
Type=oneshot
RuntimeDirectory=p105
RuntimeDirectoryMode=0755
ExecStart=/usr/libexec/p105/check-platform
RemainAfterExit=yes
