-int main(void)
+/* A separate device keeps the real buttons grabbed and leaves the desktop's
+ * action to its own key binding. is_buttons() matches only "gpio-keys". */
+#define DESKTOP_HOME_NAME "Cascadia P105 Home"
+
+static int desktop_home_open(void)
+{
+	struct uinput_setup setup = { 0 };
+	int fd = open("/dev/uinput", O_WRONLY | O_CLOEXEC);
+
+	if (fd < 0)
+		return -1;
+	setup.id.bustype = BUS_VIRTUAL;
+	setup.id.vendor = 0x0001;
+	setup.id.product = 0x0105;
+	setup.id.version = 1;
+	snprintf(setup.name, sizeof(setup.name), "%s", DESKTOP_HOME_NAME);
+	if (ioctl(fd, UI_SET_EVBIT, EV_KEY) < 0 ||
+	    ioctl(fd, UI_SET_KEYBIT, KEY_HOMEPAGE) < 0 ||
+	    ioctl(fd, UI_DEV_SETUP, &setup) < 0 ||
+	    ioctl(fd, UI_DEV_CREATE) < 0) {
+		int saved = errno;
+
+		close(fd);
+		errno = saved;
+		return -1;
+	}
+	return fd;
+}
+
+static int desktop_home_tap(int fd)
+{
+	const struct input_event events[] = {
+		{ .type = EV_KEY, .code = KEY_HOMEPAGE, .value = 1 },
+		{ .type = EV_SYN, .code = SYN_REPORT },
+		{ .type = EV_KEY, .code = KEY_HOMEPAGE, .value = 0 },
+		{ .type = EV_SYN, .code = SYN_REPORT },
+	};
+	const char *bytes = (const char *)events;
+	size_t left = sizeof(events);
+
+	while (left) {
+		ssize_t n = write(fd, bytes, left);
+
+		if (n < 0 && errno == EINTR)
+			continue;
+		if (n <= 0) {
+			if (!n)
+				errno = EIO;
+			return -1;
+		}
+		bytes += n;
+		left -= n;
+	}
+	return 0;
+}
